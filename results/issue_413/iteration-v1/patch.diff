+def _check_rollup(pr_url: str) -> str:
+    """Classify PR ``pr_url``'s FULL check rollup (issue #413), via
+    ``gh pr checks <pr> --json name,bucket``:
+
+    * ``"green"``   — every reported check is a completed non-failure (pass or
+      skipped/neutral).
+    * ``"pending"`` — one or more checks are still running/queued.
+    * ``"failing"`` — one or more checks failed (or ``gh`` itself could not be read —
+      fail-closed, never guess green).
+    * ``"empty"``   — no checks were reported at all (absence of evidence is not green).
+    """
+    r = subprocess.run(["gh", "pr", "checks", str(pr_url), "--json", "name,bucket"],
+                       capture_output=True, text=True)
+    # `gh pr checks` exits 0 (all pass), 1 (a check failed OR gh itself errored — e.g. no
+    # checks reported also exits 1 on some gh versions), or 8 (checks pending). Any OTHER
+    # exit code means gh couldn't even enumerate the checks (auth, network, bad PR) —
+    # fail-closed, the same doctrine as a failing check.
+    if r.returncode not in (0, 1, 8):
+        return "failing"
+    try:
+        checks = json.loads(r.stdout or "[]")
+    except ValueError:
+        return "failing"  # unparsable output — fail-closed, never guess green
+    if not checks:
+        return "empty"
+    buckets = {c.get("bucket") for c in checks}
+    if buckets - _ROLLUP_OK - _ROLLUP_PENDING:
+        return "failing"
+    if buckets & _ROLLUP_PENDING:
+        return "pending"
+    return "green"
+
