+def _closure(cfg: Config, d: Path, *, waves_of: Mapping[str, int],
+             paths: Mapping[str, Path], conflicts: Mapping[str, Collection[str]]) -> set[str]:
+    """The names of the bundles ``d`` is ordered after by a declared edge, transitively: the
+    bundles whose work its base carries (#463). ``waves_of`` maps each bundle of the run's
+    schedule to its wave; ``paths`` maps each bundle of the run — those, and the finished
+    ids the pre-wave carry carried (:func:`_carry_finished`, #646), which come before every
+    wave — to its directory. From ``d``, and from each bundle reached, an edge is followed
+    when it is
+
+    * a plain ``Depends on`` or a legacy ``Stacks on``, to a bundle of ``paths``;
+    * a ``Depends on (merged)``, to a bundle of the schedule. One outside it is ready only
+      once merged into the dependent's base (:func:`_runnable`, #186), so its work is on
+      the real base; one inside it is ordered before the dependent and merged nowhere;
+    * a ``Conflicts with`` (``conflicts``: either side declared it, among the run's live
+      bundles), to a bundle of the schedule in an earlier wave than the one it is
+      followed from.
+
+    Following each bundle reached matters: a member's branch was cut from a base holding
+    ITS closure, so a base without that work would hold commits that are no member's own
+    (``integrate.build_bundle_base`` refuses one). Which of them have work to carry is
+    :func:`_bundle_bases`' to judge."""
+    found: set[str] = set()
+    todo = [d]
+    while todo:
+        m = todo.pop()
+        bp = m / "brief.md"
+        edges: list[str] = []
+        if bp.exists():
+            edges += [n for n in (cfg.bundle(x).name
+                                  for x in brief.depends_on(bp) + brief.stacks_on(bp))
+                      if n in paths]
+            edges += [n for n in (cfg.bundle(x).name for x in brief.depends_on_merged(bp))
+                      if n in waves_of]
+        if m.name in waves_of:
+            edges += [n for n in conflicts.get(m.name, ())
+                      if n in waves_of and waves_of[n] < waves_of[m.name]]
+        for n in edges:
+            if n != d.name and n not in found:
+                found.add(n)
+                todo.append(paths[n])
+    return found
+
+
+def _bundle_bases(cfg: Config, runnable: list[Path], *, wave_list: list[list[Path]],
+                  bundles: list[Path], carried: Sequence[Path], accepted: Sequence[Path],
+                  held: Collection[str], heads: Mapping[str, str],
+                  batch: list[str]) -> tuple[dict[str, str], dict[str, str | None]]:
+    """Build the base each bundle of ``runnable`` is built on (#463): ``(bases, tips)``,
+    the branch and the commit it was pushed at, by bundle name, for each one whose
+    closure (:func:`_closure`) has work to carry on its own target. Its members are the
+    bundles of the closure that are carried before wave 0 (``carried``, first, in the order
+    asked for) or accepted this run (``accepted``, in wave then name order), that are not in
+    ``held`` and that the fold carries (:func:`integrate._fold_candidates`: a patch and a
+    target) on the bundle's own ``(repo, base)``. A held one already holds its dependents
+    (:func:`_runnable`); a patchless one, or one on another target, adds nothing.
+
+    The base is :func:`integrate.build_bundle_base` of those members, started fresh from
+    the base as fetched. ``heads`` (name → the head a fold of this run, or the carry, put on
+    the run's line) is passed as its ``carried``, so a member's branch rewritten since is
+    refused (#633), and as its ``excluded``, so a commit no member owns is named by the
+    bundle of the run that has it. A bundle with no members, or no usable target, gets
+    nothing: it is built on the real base. Every base of the wave is built before any is
+    returned; an :class:`integrate.IntegrationError` names the bundle and its members and
+    propagates, so the caller stops the run before the wave builds and records nothing."""
+    waves_of = {b.name: i for i, w in enumerate(wave_list) for b in w}
+    conflicts = waves.conflict_map(cfg, bundles)
+    paths = {b.name: b for w in wave_list for b in w} | {b.name: b for b in carried}
+    order = list({b.name: b for b in [*carried, *accepted] if b.name not in held}.values())
+    cands = {b.name: (b, (repo, base))
+             for b, repo, base, _slug, _ref in integrate._fold_candidates(order)}
+    bases: dict[str, str] = {}
+    tips: dict[str, str | None] = {}
+    for d in runnable:
+        target = publish._resolve_target(d)[:2]
+        if not all(target):
+            continue
+        closure = _closure(cfg, d, waves_of=waves_of, paths=paths, conflicts=conflicts)
+        members = [b for n, (b, t) in cands.items() if n in closure and t == target]
+        if not members:
+            continue
+        try:
+            bases[d.name], tips[d.name] = integrate.build_bundle_base(
+                cfg, d, members, batch=batch, carried=heads, excluded=heads)
+        except integrate.IntegrationError as exc:
+            raise integrate.IntegrationError(
+                f"could not build {d.name}'s base from {', '.join(b.name for b in members)}: "
+                f"{exc}", cause=exc.cause) from exc
+    return bases, tips
+
