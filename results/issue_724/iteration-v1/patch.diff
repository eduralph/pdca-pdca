     def _show(self, rev: str, path: str) -> str:
         return _git(self.origin, "show", f"{rev}:{path}")
 
+    def _beyond(self, tip: str, base: str, heads: list[str]) -> list[str]:
+        """The commits ``tip`` holds that neither ``base`` nor any of ``heads`` has, other
+        than the merge commits on ``tip``'s own first-parent chain above ``base`` — the
+        merges made building it (#463). Empty: ``tip`` is ``base`` plus the work of
+        ``heads`` and nothing else, so no other branch's own commit is on it (a commit it
+        shares with one of ``heads`` is that head's work)."""
+        extra = _git(self.origin, "rev-list", tip, "--not", base, *heads).split()
