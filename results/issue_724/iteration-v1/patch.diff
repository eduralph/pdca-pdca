+                     "--not", base).split()
+        return [c for c in extra if c not in chain]
+
+    def _own(self, iid: str, *, base: str, beside: list[str]) -> list[str]:
+        """Bundle ``iid``'s own work on origin: the commits of ``fix/<iid>`` that neither
+        ``base``, nor the commit its branch was cut from (its recorded ``stack-base-tip``,
+        when it has one), nor any of ``beside`` has. Empty when it has no branch."""
+        if not self._has(f"fix/{iid}"):
+            return []
+        cut = publish.read_stack_base_tip(self.cfg.bundle(iid))
+        return _git(self.origin, "rev-list", f"fix/{iid}", "--not", base, *beside,
+                    *([cut] if cut else [])).split()
+
     def _diff_files(self, base: str, head: str) -> list[str]:
         """What the PR view shows: the three-dot diff of ``head`` against ``base``."""
