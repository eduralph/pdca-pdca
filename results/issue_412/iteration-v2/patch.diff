+def _report_groups(cfg: Config, groups: Mapping[str, Collection[str]], *,
+                   landed: Collection[str], wave_of: Mapping[str, int], dry: bool) -> None:
+    """Name, at the end of a merge-mode run, each ``Merges with`` group (#412) the run did
+    not merge whole — one stderr line per group, with why and what to do. ``groups`` is
+    :func:`waves.merge_groups` of the run's drive set, ``landed`` the members
+    ``merge.merge_wave`` merged. A group is left when a member of it is COMPLETE with a
+    patch and not in ``landed``; its members are listed in the order to merge them in
+    (wave, then name). Then either:
+
+    * the group cannot land together in this run — a member is not COMPLETE
+      (DISCONTINUED, never built, or the run stopped first), or has a record merge mode
+      refuses (``merge.group_blocker``: no recorded PR, say);
+    * it landed in part — the host refused a member's merge after another merged, which
+      stopped the run (``merge_wave`` said so then), or a split child joined the group
+      after the rest had merged;
+    * or nothing blocks it, but no wave boundary of the run merged it: its last member
+      finished in the final wave, whose PRs merge mode leaves as drafts — the whole group
+      may have been in it, never held — or the run stopped first. The human merges it
+      together, in that order."""
+    seen: set[str] = set()
+    for name in sorted(groups):
+        if name in seen or not groups[name]:
+            continue
+        members = {name, *groups[name]}
+        seen |= members
+        order = sorted(members, key=lambda m: (wave_of.get(m, len(wave_of)), m))
+        left = [m for m in order if m not in landed
+                and state.state(cfg.bundle_root / m) == state.COMPLETE
+                and integrate._has_patch(cfg.bundle_root / m)]
+        if not left:
+            continue
+        group = ", ".join(order)
+        missing = [(m, state.state(cfg.bundle_root / m)) for m in order]
+        why = (", ".join(f"{m} is {st}" for m, st in missing if st != state.COMPLETE)
+               or merge.group_blocker(cfg, members, dry_run=dry)[0])
+        part = [m for m in order if m in landed]
+        if why:
+            print(f"flow: `Merges with` group {group} was not merged — {why}, so it cannot "
+                  f"land together in this run. Not merged: {', '.join(left)}. Merge the "
+                  f"group together once that is resolved, or drop the `Merges with` edge to "
+                  f"land them alone.", file=sys.stderr)
+        elif part:
+            print(f"flow: `Merges with` group {group} landed only in part — "
+                  f"{', '.join(part)} merged, {', '.join(left)} not: merge the rest, or "
+                  f"revert {', '.join(part)}.", file=sys.stderr)
+        else:
+            print(f"flow: `Merges with` group {group} was not merged — every member is "
+                  f"COMPLETE, but no wave boundary of this run merged it (its last member "
+                  f"finished in the final wave, whose PRs merge mode leaves as drafts, or the "
+                  f"run stopped first). Merge its PRs together, back to back, in this order: "
+                  f"{', '.join(left)}.", file=sys.stderr)
+
+
