+def _back_to_back(cfg: Config, bundles: list[Path], groups: Mapping[str, Collection[str]], *,
+                  pull: Collection[str] = frozenset()) -> list[Path]:
+    """``bundles`` in order, except that a ``Merges with`` group's members follow its first
+    one directly (issue #412), each group in ``bundles`` order — so nothing of the wave
+    merges between two members of one group. A member named in ``pull`` (its group is
+    released here) that is not in ``bundles`` — built at an earlier wave, or finished by an
+    earlier run — is read from disk (``waves.member_path``) and goes first in its group, by
+    name."""
+    names = {d.name for d in bundles}
+    out: list[Path] = []
+    seen: set[str] = set()
+    for d in bundles:
+        members = groups.get(d.name, ())
+        extra = [waves.member_path(cfg, m) for m in sorted(members)
+                 if m in pull and m not in names]
+        for m in [*extra, d, *(x for x in bundles if x.name in members)]:
+            if m.name not in seen:
+                seen.add(m.name)
+                out.append(m)
+    return out
