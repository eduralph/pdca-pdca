+            or publish._merge_base_refusal(cfg, d, repo_spec, pr_base, base)):
+        return (f"has a PR an earlier run opened on {rec.get('repo') or '?'} @ "
+                f"`{pr_base or '?'}`, and merge mode merges a PR only into its brief's own "
+                f"target ({repo_spec or '?'} @ `{base or '?'}`), on a branch no other bundle "
+                f"produced")
+    return ""
