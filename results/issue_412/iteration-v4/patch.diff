+def _foreign_refusal(cfg: Config, d: Path) -> str:
+    """Why merge mode may not merge the PR of COMPLETE bundle ``d``, which an earlier run
+    opened (issue #412), or "". Merge mode merges a PR into whatever base it carries, so
+    publish lets a merge-mode run open one only on a base that exists independently of the
+    run (#411, ``publish._merge_base_refusal``). A PR an earlier run opened — a stack-mode
+    run, say — never met that guard: it may target another bundle's branch, or its branch
+    may be cut from another bundle's branch or a stack-mode line, so that merging it lands
+    their work too. So it is merged only if merge mode could have opened it: a
+    ``"new-pr"`` record, in its brief's own repo, on a base ``_merge_base_refusal`` lets
+    through. A bundle with nothing to merge (no patch), or a record ``_premerge`` refuses
+    anyway (no PR, an ``Onto branch`` commit), is left to it."""
+    rec = publish._publish_record(d)
+    if (not integrate._has_patch(d) or not isinstance(rec, dict) or not rec.get("pr_url")
