+
+    def _lines(self, *needles: str) -> list[str]:
+        return [x for x in self.err.splitlines() if all(n in x for n in needles)]
+
+    # -- fixture (a): A + B one group across waves 0 and 1 ----------------------------------
+
+    def _group_across_waves(self, **a_fields: str) -> list[str]:
