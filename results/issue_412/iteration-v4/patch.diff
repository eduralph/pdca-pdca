+def group_blocker(cfg: Config, members: Collection[str], *, dry_run: bool = False,
+                  landed: Collection[str] = frozenset(),
+                  opened: Collection[str] = frozenset()) -> tuple[str, bool]:
+    """Why the ``Merges with`` group ``members`` (bundle names) cannot all be merged now
+    (issue #412), as ``(why, waiting)``; ``("", False)`` when nothing local stops it.
+    ``waiting`` is True when a member is not COMPLETE yet but still in flight — a later
+    boundary may release the group. A member that ended otherwise (DISCONTINUED, RESOLVED)
+    never will. Else ``why`` names each member not in ``landed`` (merged already) whose PR
+    merge mode will not merge: one an earlier run opened — not in ``opened`` — that merge
+    mode could not have opened (``_foreign_refusal``), or one ``_merge_one`` refuses before
+    readying anything (``_premerge``, the very function it decides with). Neither changes
+    within a run, so merging the others first would land the group in part. Not asked in
+    a dry run, which merges nothing: there ``_merge_one`` refuses such a record as it
+    always has. A member is read where it is (``waves.member_path``): one an earlier run
+    finished may be archived."""
+    names = sorted(set(members))
+    at = {m: waves.member_path(cfg, m) for m in names}
+    states = [(m, state.state(at[m])) for m in names]
+    ended = [(m, st) for m, st in states if st in state.TERMINAL and st != state.COMPLETE]
+    if ended:
+        return ", ".join(f"{m} is {st}" for m, st in ended), False
+    waiting = [(m, st) for m, st in states if st != state.COMPLETE]
+    if waiting:
+        return (f"{', '.join(f'{m} ({st})' for m, st in waiting)} "
+                f"{'is' if len(waiting) == 1 else 'are'} not COMPLETE yet"), True
