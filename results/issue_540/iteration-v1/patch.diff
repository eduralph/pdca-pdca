+def leaf_ran_and_failed(error_log: Path) -> bool:
+    """True iff ``error_log`` is the account of a leaf that ran and SPENT its attempts.
+
+    The engine's one failed-leaf discriminator (#138 / #369 / #540) — see
+    :data:`UNSETTLED_MARKER` for why every reader asks this rather than testing the
+    path's existence. False for a log that is absent, unreadable, or still carrying the
+    marker: an unsettled record recovers its leaf exactly as an absent one does, so a
+    leaf the death window merely INTERRUPTED is re-run rather than retired — the shape
+    that would otherwise carry a bundle to sign-off with no review of the diff at all.
+    Unreadable errs the same way, towards re-running: a re-run costs a leaf, a wrong
+    "ran and failed" costs the review.
+    """
+    try:
+        text = error_log.read_text(encoding="utf-8", errors="replace")
+    except OSError:  # absent, unreadable, a directory — no settled account either way
+        return False
+    return not _unsettled(text)
+
+
+def _unsettled(text: str) -> bool:
+    """True iff ``text``'s LAST non-blank line is :data:`UNSETTLED_MARKER`, alone.
+
+    Deliberately not a substring or mid-line test. These records embed each failed
+    attempt's captured stderr verbatim, so a looser rule would let a leaf's own output
+    impersonate the harness's account of its own run — and the harness would then
+    re-run a leaf that genuinely ran and failed. The writer side of that pair is
+    :func:`neutralize_leaf_text`.
+    """
+    for line in reversed(text.splitlines()):
+        if line.strip():
+            return line.strip() == UNSETTLED_MARKER
+    return False
+
+
+def unsettled_record(records: str) -> str:
+    """``records`` marked unsettled — what a leaf's error log holds BETWEEN attempts.
+    Writing the records without the marker (the retry loop's final write) settles them."""
+    return records + UNSETTLED_MARKER + "\n"
+
+
+def neutralize_leaf_text(text: str) -> str:
+    """A leaf's captured output with any line that would read as :data:`UNSETTLED_MARKER`
+    defused, so the leaf cannot impersonate the harness's account of its own run.
+
+    Only a line that IS the marker (bar surrounding whitespace) can be read as one, so
+    only such a line is rewritten — and it is rewritten, never dropped: the text stays in
+    the post-mortem, including anything riding the same channel (the #420 memory
+    telemetry), it simply can no longer be the log's marker line.
+    """
+    if UNSETTLED_MARKER not in text:
+        return text
+    out = "\n".join(f"{line} {_QUOTED_SUFFIX}" if line.strip() == UNSETTLED_MARKER else line
+                    for line in text.splitlines())
+    return out + "\n" if text.endswith("\n") else out
+
