+++ b/template/tests/test_attempt_ownership.py
@@ -0,0 +1,260 @@
+"""Per-attempt record ownership (issue #540) — stdlib unittest, no deps.
+
+Run from the template root:
+    PYTHONPATH=src python -m unittest tests.test_attempt_ownership -v
+
+A retried reviewer/advisory leaf's ``*.error.log`` used to be written only once the
+retry loop ENDED, so two things were broken at once and neither could be fixed alone:
+
+1. while attempt 2 ran there was nothing on disk explaining attempt 1, and a run killed
+   mid-retry lost every attempt's account — the file never existed;
+2. the *presence* of that file meant "the leaf ran and FAILED" to four readers, so
+   flushing it earlier made that sentence false at every one of them — including two
+   executable recovery discriminators, which would then retire a leaf the death window
+   merely INTERRUPTED and carry the bundle to sign-off with no review of the diff.
+
+These tests drive the shipped wrapper with a stub "leaf" (a Python interpreter that
+dies at invocation, i.e. the transient/retry path) and assert the end state from
+BEHAVIOUR only — the mid-retry bytes are taken from the production write itself, and
+the settlement marker is read off those bytes, so nothing here re-implements or names
+the mechanism under test.
+"""
+
+from __future__ import annotations
+
+import shutil
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from pdca_harness import assemble, leaves, state
+from pdca_harness.config import Config, LeafConfig
+
+# A claude-family leaf so the stream path engages (the only path yielding the "did a
+# session start" signal); argv is a Python interpreter running this script. It writes to
+# stderr only and exits non-zero — no stdout, so no session started: the transient-infra
+# signal the wrapper retries. On its SECOND invocation it copies the bundle's error log
+# for this leaf aside, which is a leaf OBSERVING the bundle while attempt 1's account
+# should already be there. $SAY overrides the line it prints last on stderr.
+_STUB = """
+import os, shutil, sys
+
+counter, log, snap = os.environ["CNT"], os.environ["LOG"], os.environ["SNAP"]
+runs = len(open(counter).read()) if os.path.exists(counter) else 0
+open(counter, "a").write("x")
+if runs == 1 and os.path.exists(log):
+    shutil.copyfile(log, snap)
+sys.stderr.write(os.environ.get("SAY", "overloaded_error 529") + "\\n")
+sys.exit(1)
+"""
+
+# The same leaf, transient ONCE and then healthy: the retry recovers it, so the run
+# must leave no record behind at all (a leaf that succeeded is not a failed one).
+_RECOVERS_ON_RETRY = """
+import os, sys
+
+counter = os.environ["CNT"]
+runs = len(open(counter).read()) if os.path.exists(counter) else 0
+open(counter, "a").write("x")
+if runs == 0:
+    sys.stderr.write("overloaded_error 529\\n")
+    sys.exit(1)
+print('{"type": "result"}')
+"""
+
+ADVISORY_ID = "code-review"
+
+
+def _stub_config(root: Path) -> Config:
+    return Config(
+        root=root,
+        bundle_root=root / "results",
+        process_dir=root / "process",
+        templates_dir=root / "templates",
+        default_branch="main",
+        tracker_system="github",
+        tracker_url="",
+        issue_id_example="#1",
+        builder=LeafConfig(mode="stub", family="claude"),
+        reviewer=LeafConfig(mode="stub", family="codex"),
+    )
+
+
+class AttemptOwnershipBase(unittest.TestCase):
+    def setUp(self) -> None:
+        self.tmp = Path(tempfile.mkdtemp())
+        self.cnt = self.tmp / "count.txt"
+        self.snap = self.tmp / "mid-retry-snapshot"
+        self.error_log = self.tmp / state.REVIEW_ERROR_LOG
+
+    def tearDown(self) -> None:
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def _runs(self) -> int:
+        return len(self.cnt.read_text(encoding="utf-8")) if self.cnt.exists() else 0
+
+    def _run_failing_leaf(self, say: str = "") -> Exception | None:
+        """One full run of the SHIPPED wrapper against the retrying stub leaf."""
+        env = {"CNT": str(self.cnt), "LOG": str(self.error_log), "SNAP": str(self.snap)}
+        if say:
+            env["SAY"] = say
+        leaf = LeafConfig(mode="command", family="claude",
+                          argv=[sys.executable, "-c", _STUB], interactive=False)
+        return leaves._invoke_leaf_resilient(
+            leaf, self.tmp, "review please", error_log=self.error_log,
+            attempts=3, backoff=0.0, stream_json=True, env=env)
+
+    def _mid_retry_bytes(self) -> str:
+        """What the leaf's error log held DURING the retry loop — captured by the stub
+        itself, so the fixture is byte-for-byte the state a mid-retry kill leaves and
+        cannot drift from the production shape."""
+        self._run_failing_leaf()
+        self.assertTrue(
+            self.snap.exists(),
+            "attempt 2 observed the bundle and found NO record of attempt 1: a run "
+            "killed inside the retry loop leaves no post-mortem at all")
+        return self.snap.read_text(encoding="utf-8")
+
+    def _bundle(self) -> Path:
+        d = self.tmp / "bundle"
+        d.mkdir(exist_ok=True)
+        return d
+
+
+class EachAttemptsRecordIsOnDiskBeforeTheNext(AttemptOwnershipBase):
+    """Criterion 1 — a leaf observing the bundle during attempt 2 finds attempt 1's
+    account already there."""
+
+    def test_attempt_two_finds_attempt_ones_account(self) -> None:
+        err = self._run_failing_leaf()
+        self.assertIsInstance(err, leaves.LeafError)
+        self.assertEqual(self._runs(), 3)   # the shipped attempt budget, unchanged
+        self.assertTrue(
+            self.snap.exists(),
+            "attempt 2 observed the bundle and found NO record of attempt 1: a run "
+            "killed inside the retry loop leaves no post-mortem at all")
+        text = self.snap.read_text(encoding="utf-8")
+        self.assertIn("attempt 1", text)                # whose attempt it accounts for
+        self.assertIn("overloaded_error 529", text)     # attempt 1's captured stderr
+        self.assertNotIn("attempt 2", text)             # …and only the spent attempt
+
+    def test_a_leaf_that_recovers_on_retry_leaves_no_record_behind(self) -> None:
+        # The shipped contract's other edge (criterion 4): the flushed record describes
+        # a leaf that has since SUCCEEDED, so the successful run must clear it — a
+        # bundle carrying an error log beside a produced artifact would be a lie.
+        flaky = LeafConfig(mode="command", family="claude", interactive=False,
+                           argv=[sys.executable, "-c", _RECOVERS_ON_RETRY])
+        err = leaves._invoke_leaf_resilient(
+            flaky, self.tmp, "review please", error_log=self.error_log,
+            attempts=3, backoff=0.0, stream_json=True, env={"CNT": str(self.cnt)})
+        self.assertIsNone(err)
+        self.assertEqual(self._runs(), 2)          # failed once, then recovered
+        self.assertFalse(self.error_log.exists(),
+                         "a leaf that SUCCEEDED left an error log behind")
+
+    def test_an_unwritable_record_does_not_narrow_the_retry_contract(self) -> None:
+        # Criterion 5: the shipped stop rule is the ONLY stop rule. A record that
+        # cannot be written (here: a bundle dir that is not there — the same OSError
+        # family a read-only dir or ENOSPC raises, through the same call) must not end
+        # the run early; the records stay in hand for the loop's final write, which
+        # fails exactly as it does on the base. What must NOT change is the attempts.
+        self.error_log = self.tmp / "vanished" / state.REVIEW_ERROR_LOG
+        with self.assertRaises(OSError):
+            self._run_failing_leaf()
+        self.assertEqual(self._runs(), 3, "a failed record flush cost the leaf attempts")
+
+
+class AnUnsettledAccountDoesNotReadAsRanAndFailed(AttemptOwnershipBase):
+    """Criterion 2 — every reader treats a record whose leaf has attempts left exactly
+    as it treats an absent one, and the operator-facing wording names both shapes."""
+
+    def test_reviewer_with_an_unsettled_record_is_recovered(self) -> None:
+        d = self._bundle()
+        (d / state.REVIEW_ERROR_LOG).write_text(self._mid_retry_bytes(), encoding="utf-8")
+        self.assertTrue(
+            leaves.review_never_ran(d),
+            "a reviewer interrupted mid-retry was retired as 'ran and FAILED' — the "
+            "bundle would reach sign-off with no review of the diff at all")
+        text = assemble._missing_review_text(d)
+        self.assertNotIn("RAN AND FAILED", text)   # …and §6 does not assert it either
+        self.assertIn(state.REVIEW_ERROR_LOG, text)  # while still naming the record
+
+    def test_advisory_with_an_unsettled_record_is_not_skipped(self) -> None:
+        d = self._bundle()
+        cfg = _stub_config(self.tmp)
+        cfg.advisory_leaves = [{"id": ADVISORY_ID, "role": "x", "mode": "stub"}]
+        leaves.advisory_error_log(d, ADVISORY_ID).write_text(
+            self._mid_retry_bytes(), encoding="utf-8")
+        leaves.run_advisory_leaves(d, cfg, only_missing=True)
+        self.assertTrue(
+            leaves.advisory_artifact(d, ADVISORY_ID).exists(),
+            "the CHECKED-resume skipped an advisory leaf that was only INTERRUPTED")
+
+    def test_a_settled_record_still_means_ran_and_failed(self) -> None:
+        # The other half of the same sentence, and the shipped behaviour (#138/#369):
+        # once the attempts ARE spent, the log retires the leaf exactly as before.
+        self._run_failing_leaf()
+        settled = self.error_log.read_text(encoding="utf-8")
+        d = self._bundle()
+        cfg = _stub_config(self.tmp)
+        cfg.advisory_leaves = [{"id": ADVISORY_ID, "role": "x", "mode": "stub"}]
+        (d / state.REVIEW_ERROR_LOG).write_text(settled, encoding="utf-8")
+        leaves.advisory_error_log(d, ADVISORY_ID).write_text(settled, encoding="utf-8")
+        self.assertFalse(leaves.review_never_ran(d))
+        self.assertIn("RAN AND FAILED", assemble._missing_review_text(d))
+        leaves.run_advisory_leaves(d, cfg, only_missing=True)
+        self.assertFalse(leaves.advisory_artifact(d, ADVISORY_ID).exists(),
+                         "a leaf that ran and spent its attempts was re-run")
+
+
+class ALeafsOwnTextCannotImpersonateTheDistinction(AttemptOwnershipBase):
+    """Criterion 3 — whatever distinguishes an unsettled account from a spent one is
+    neutralised in the captured stderr the record embeds, and is recognised only as the
+    log's LAST NON-BLANK LINE, alone."""
+
+    def _last_line(self, text: str) -> str:
+        """The distinguishing line of a mid-retry record: its last non-blank line.
+        Derived, never named — the test knows only where it sits."""
+        lines = [ln for ln in text.splitlines() if ln.strip()]
+        self.assertTrue(lines, "the mid-retry record was empty")
+        return lines[-1].strip()
+
+    def test_a_leaf_emitting_that_line_last_does_not_read_as_unsettled(self) -> None:
+        line = self._last_line(self._mid_retry_bytes())
+        # A second run whose stub prints exactly that line, alone, last on stderr —
+        # the impersonation: the leaf's own text landing in the harness's account of
+        # the leaf's own run. Its attempts ARE spent when the run returns.
+        self._run_failing_leaf(say=line)
+        settled = self.error_log.read_text(encoding="utf-8")
+        d = self._bundle()
+        (d / state.REVIEW_ERROR_LOG).write_text(settled, encoding="utf-8")
+        self.assertFalse(
+            leaves.review_never_ran(d),
+            "a leaf's own output impersonated the harness's unfinished-attempts "
+            "distinction: a reviewer that ran and failed would be re-run as if it "
+            "had been interrupted")
+        self.assertIn("RAN AND FAILED", assemble._missing_review_text(d))
+        # Neutralised, not dropped: the leaf's account survives in the post-mortem
+        # (the #420 memory telemetry rides this same channel).
+        self.assertIn(line, settled)
+
+    def test_the_line_is_recognised_only_whole_and_last(self) -> None:
+        mid_retry = self._mid_retry_bytes()
+        line = self._last_line(mid_retry)
+        d = self._bundle()
+        log = d / state.REVIEW_ERROR_LOG
+        # Mid-line, and as a substring of a longer line: not the distinction.
+        for impostor in (f"boom {line} boom\n", f"{line} — quoted by a leaf\n",
+                         f"{mid_retry}\ntrailing chatter from a later write\n"):
+            log.write_text(impostor, encoding="utf-8")
+            self.assertFalse(leaves.review_never_ran(d),
+                             f"read as unsettled from a non-final/partial line: {impostor!r}")
+        # …while the real thing is recognised through trailing blank lines.
+        log.write_text(mid_retry + "\n\n  \n", encoding="utf-8")
+        self.assertTrue(leaves.review_never_ran(d),
+                        "trailing blank lines hid the unfinished-attempts record")
+
+
+if __name__ == "__main__":
+    unittest.main()
