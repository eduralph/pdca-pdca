+        (d / "patch.diff").write_text("diff --git a/feat.txt b/feat.txt\n", encoding="utf-8")
+        (d / "publish.json").write_text(json.dumps(
+            {"mode": "stacked", "branch": "feat", "base": "upstream/feat",
