+    def test_a_merged_prerequisite_whose_branch_is_gone_still_reaches_the_line(self) -> None:
+        # Between two folds the maintainer merges A's and B's PRs and deletes B's branch. B's
+        # work must still reach the continued line (else the next wave builds without it):
