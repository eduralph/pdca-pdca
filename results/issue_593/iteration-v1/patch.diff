index 0000000..3cb5490
--- /dev/null
+++ b/template/tests/test_integrate_stack_bases.py
@@ -0,0 +1,308 @@
+"""Stack mode, own-repo target (#593): every wave PR targets the real base, and the fold
+builds the integration line out of the PUBLISHED PR branches — merged, never re-applied as
+new commits — append-only and unforced within one run.
+
+Two halves. Real git against a bare ``origin`` + a primary checkout (the ``FoldGit`` shape in
+``tests/test_integrate.py``): each bundle's PR branch is a real branch on ``origin`` with its
+``publish.json`` naming it, exactly what ``publish.publish`` leaves behind. And the publish
+dry-run for the PR base a wave>0 bundle opens against. Offline: no network, no ``gh``.
+
+Run from template/:
+    PYTHONPATH=src python -m unittest tests.test_integrate_stack_bases
+"""
+
+from __future__ import annotations
+
+import io
+import json
+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+from pathlib import Path
+from unittest import mock
+
+from pdca_harness import integrate, merged, publish, signoff
+from pdca_harness.config import Config, LeafConfig
+
+TEMPLATES = Path(__file__).resolve().parents[1] / "templates"
+TARGET = ("org/repo", "main")
+LINE = "pdca-integration/main"
+
+
+def _git_out(repo: Path, *args: str) -> str:
+    return subprocess.run(["git", "-C", str(repo), *args], check=True,
+                          capture_output=True, text=True).stdout.strip()
+
+
+class FoldPublishedBranches(unittest.TestCase):
+    """The fold merges each accepted bundle's published branch onto the run's line."""
+
+    def setUp(self) -> None:
+        self.tmp = Path(tempfile.mkdtemp())
+        self.addCleanup(shutil.rmtree, self.tmp, ignore_errors=True)
+        self.origin = self.tmp / "origin.git"
+        self.primary = self.tmp / "repo"
+        subprocess.run(["git", "init", "--bare", "-q", str(self.origin)], check=True)
+        subprocess.run(["git", "init", "-q", "-b", "main", str(self.primary)], check=True)
+        for k, v in (("user.email", "t@example.com"), ("user.name", "Tester"),
+                     ("commit.gpgsign", "false")):
+            self._git("config", k, v)
+        (self.primary / "base.txt").write_text("base\n", encoding="utf-8")
+        self._git("add", "-A")
+        self._git("commit", "-q", "-m", "base")
+        self._git("remote", "add", "origin", str(self.origin))
+        self._git("push", "-q", "origin", "main")
+        self.cfg = Config(
+            root=self.tmp, bundle_root=self.tmp / "results", process_dir=self.tmp / "process",
+            templates_dir=self.tmp / "templates", default_branch="main",
+            tracker_system="github", tracker_url="", issue_id_example="#1",
+            builder=LeafConfig(mode="stub"), reviewer=LeafConfig(mode="stub"),
+            base_remote="origin", repo_checkouts={"org/repo": str(self.primary)})
+
+    # -- fixture ------------------------------------------------------------------------
+
+    def _git(self, *args: str) -> str:
+        return _git_out(self.primary, *args)
+
+    def _sha(self, ref: str) -> str:
+        return self._git("rev-parse", ref)
+
+    def _origin_sha(self, branch: str) -> str:
+        return _git_out(self.origin, "rev-parse", f"refs/heads/{branch}")
+
+    def _is_ancestor(self, older: str, newer: str) -> bool:
+        return subprocess.run(["git", "-C", str(self.primary), "merge-base", "--is-ancestor",
+                               older, newer]).returncode == 0
+
+    def _bundle(self, iid: str, *, patch: str = "x") -> Path:
+        d = self.cfg.bundle(iid)
+        d.mkdir(parents=True)
+        (d / "brief.md").write_text(
+            f"- **Slug:** {iid.lower()}\n- **Repo + branch target:** org/repo @ main\n",
+            encoding="utf-8")
+        (d / "patch.diff").write_text(patch, encoding="utf-8")
+        return d
+
+    def _published(self, iid: str, files: dict[str, str], *, cut_from: str = "origin/main",
+                   branch: str | None = None) -> tuple[Path, str]:
+        """A bundle as `publish.publish` leaves it: its fix committed (signed off) on a PR
+        branch cut from ``cut_from``, pushed to origin, and named in its ``publish.json``.
+        Returns the bundle and that branch commit's SHA."""
+        branch = branch or f"fix/{iid}"
+        self._git("fetch", "-q", "origin")
+        self._git("checkout", "-q", "-B", branch, cut_from)
+        for name, content in files.items():
+            (self.primary / name).write_text(content, encoding="utf-8")
+        self._git("add", "-A")
+        diff = self._git("diff", "--cached")
+        self._git("commit", "-q", "-s", "-m", f"fix {iid}")
+        sha = self._sha("HEAD")
+        self._git("push", "-q", "--force", "origin", branch)
+        self._git("checkout", "-q", "main")
+        d = self._bundle(iid, patch=diff + "\n")
+        (d / "publish.json").write_text(json.dumps({"branch": branch, "mode": "new-pr"}),
+                                        encoding="utf-8")
+        return d, sha
+
+    def _fold(self, accepted: list[Path], **kw) -> dict:
+        # Each fold at its own commit time, as in a real run (a whole wave of Do/Check lies
+        # between two folds). Without it two folds inside one second can write
+        # byte-identical commits, hiding a rebuilt line behind an unchanged SHA.
+        self._clock = getattr(self, "_clock", 1_700_000_000) + 3600
+        when = {"GIT_AUTHOR_DATE": f"@{self._clock} +0000",
+                "GIT_COMMITTER_DATE": f"@{self._clock} +0000"}
+        with mock.patch.dict(os.environ, when), \
+                redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
+            return integrate.fold(self.cfg, accepted, **kw)
+
+    def _fold_no_raise(self, accepted: list[Path]) -> dict:
+        try:
+            return self._fold(accepted)
+        except integrate.IntegrationError as exc:
+            self.fail(f"the fold was refused: {exc}")
+
+    # -- (ii)/(iii): append-only, real commits ---------------------------------------------
+
+    def test_second_fold_continues_the_first_and_carries_the_real_commits(self) -> None:
+        # Wave 0 = [A]; wave 1 = [B], built off the first fold's tip T1. The second fold must
+        # FAST-FORWARD T1 (B's open PR is cut from it), and the line must hold A's and B's own
+        # PR commits — the same SHAs — not `pdca-integrate:` copies of their patches.
+        a, a_sha = self._published("A", {"a.txt": "a\n"})
+        self._fold_no_raise([a])
+        t1 = self._origin_sha(LINE)
+        b, b_sha = self._published("B", {"b.txt": "b\n"}, cut_from=f"origin/{LINE}")
+        self._fold_no_raise([a, b])
+        self._git("fetch", "-q", "origin")
+        tip = self._sha(f"origin/{LINE}")
+        self.assertTrue(self._is_ancestor(t1, tip),
+                        "the second fold rewrote the first fold's tip — B's PR base is gone")
+        self.assertTrue(self._is_ancestor(a_sha, tip), "A's PR commit is not in the line")
+        self.assertTrue(self._is_ancestor(b_sha, tip), "B's PR commit is not in the line")
+        log = self._git("log", "--format=%s", f"origin/main..{tip}")
+        self.assertNotIn("pdca-integrate: issue_", log)        # no re-applied patch commits
+
+    def test_later_folds_push_without_force(self) -> None:
+        # The same two folds against an origin that refuses non-fast-forwards: every fold
+        # after the run's first is an unforced fast-forward, so the push is accepted.
+        a, _ = self._published("A", {"a.txt": "a\n"})
+        self._fold_no_raise([a])
+        t1 = self._origin_sha(LINE)
+        subprocess.run(["git", "-C", str(self.origin), "config",
+                        "receive.denyNonFastForwards", "true"], check=True)
+        b, b_sha = self._published("B", {"b.txt": "b\n"}, cut_from=f"origin/{LINE}")
+        self._fold_no_raise([a, b])
+        self.assertTrue(self._is_ancestor(t1, self._origin_sha(LINE)))
+        self.assertEqual(self._origin_sha(LINE), b_sha)        # a plain fast-forward to B
+
+    def test_sibling_merge_commit_is_signed_off(self) -> None:
+        # Two wave-0 siblings both cut from main: the second cannot fast-forward, so the fold
+        # makes a merge commit — and a DCO check reading a dependent PR's commits sees it, so
+        # it carries a Signed-off-by trailer (#405's intent, kept).
+        a, a_sha = self._published("A", {"a.txt": "a\n"})
+        c, c_sha = self._published("C", {"c.txt": "c\n"})
+        self._fold_no_raise([a, c])
+        tip = self._origin_sha(LINE)
+        self.assertTrue(self._is_ancestor(a_sha, tip))
+        self.assertTrue(self._is_ancestor(c_sha, tip))
+        parents = _git_out(self.origin, "log", "-1", "--format=%P", tip).split()
+        self.assertEqual(len(parents), 2, "expected a merge of the second sibling")
+        trailer = _git_out(self.origin, "log", "-1",
+                           "--format=%(trailers:key=Signed-off-by,valueonly)", tip)
+        self.assertEqual(trailer, "Tester <t@example.com>")
+
+    def test_a_new_runs_first_fold_restarts_from_the_base(self) -> None:
+        # A previous run left its line on origin; main has moved on since. This run's first
+        # fold (nothing folded yet) starts from the current origin/main, not the old line.
+        self._git("checkout", "-q", "-B", "old-line", "origin/main")
+        (self.primary / "old.txt").write_text("abandoned\n", encoding="utf-8")
+        self._git("add", "-A")
+        self._git("commit", "-q", "-m", "old run")
+        self._git("push", "-q", "origin", f"old-line:{LINE}")
+        self._git("checkout", "-q", "main")
+        old_tip = self._origin_sha(LINE)
+        (self.primary / "base.txt").write_text("base v2\n", encoding="utf-8")
+        self._git("commit", "-q", "-am", "main moves on")
+        self._git("push", "-q", "origin", "main")
+        a, a_sha = self._published("A", {"a.txt": "a\n"})
+        self._fold([a], folded_this_run=set())
+        tip = self._origin_sha(LINE)
+        self.assertFalse(self._is_ancestor(old_tip, tip), "built on the previous run's line")
+        self.assertTrue(self._is_ancestor(self._origin_sha("main"), tip))
+        self.assertTrue(self._is_ancestor(a_sha, tip))
+        # …and a target the run HAS folded continues instead (no restart mid-run).
+        b, b_sha = self._published("B", {"b.txt": "b\n"}, cut_from=f"origin/{LINE}")
+        self._fold([a, b], folded_this_run={TARGET})
+        self.assertTrue(self._is_ancestor(tip, self._origin_sha(LINE)))
+
+    # -- (iv): fail closed ------------------------------------------------------------------
+
+    def test_an_accepted_patched_bundle_with_no_published_branch_stops_the_fold(self) -> None:
+        # A bundle whose publish texts failed is still accepted, but has no PR branch — the
+        # next wave cannot build on it. Loud, naming the bundle and the remedy.
+        a, _ = self._published("A", {"a.txt": "a\n"})
+        u = self._bundle("U", patch=("diff --git a/u.txt b/u.txt\nnew file mode 100644\n"
+                                     "--- /dev/null\n+++ b/u.txt\n@@ -0,0 +1 @@\n+u\n"))
+        with self.assertRaises(integrate.IntegrationError) as cm:
+            self._fold([a, u])
+        self.assertIn("issue_U", str(cm.exception))
+        self.assertIn("publish U", str(cm.exception))
+        self.assertFalse(self._git("ls-remote", "--heads", "origin", LINE))  # nothing pushed
+
+    def test_a_published_branch_gone_from_origin(self) -> None:
+        # The recorded branch no longer exists on origin. Unmerged: a loud stop naming the
+        # bundle and the branch. Merged (its work is in the base): skipped. Deleted on the
+        # origin side (as a host's delete-on-merge does), so the primary's `origin/fix/A`
+        # tracking ref is left stale until a pruning fetch.
+        a, _ = self._published("A", {"a.txt": "a\n"})
+        _git_out(self.origin, "branch", "-D", "fix/A")
+        b, b_sha = self._published("B", {"b.txt": "b\n"})
+        with mock.patch.object(merged, "is_merged", return_value=False):
+            with self.assertRaises(integrate.IntegrationError) as cm:
+                self._fold([a, b])
+        self.assertIn("issue_A", str(cm.exception))
+        self.assertIn("fix/A", str(cm.exception))
+        with mock.patch.object(merged, "is_merged", return_value=True) as is_merged:
+            self._fold_no_raise([a, b])
+        is_merged.assert_called_once_with(self.cfg, "A")
+        self.assertEqual(self._origin_sha(LINE), b_sha)        # A skipped, B folded
+
+    def test_overlap_raises_and_leaves_the_pushed_line_alone(self) -> None:
+        # A branch that does not merge cleanly onto the line (an undeclared cross-wave
+        # overlap) stops the run; the line already on origin is untouched.
+        a, _ = self._published("A", {"base.txt": "one\n"})
+        self._fold_no_raise([a])
+        t1 = self._origin_sha(LINE)
+        b, _ = self._published("B", {"base.txt": "two\n"})      # cut from main, not the line
+        with self.assertRaises(integrate.IntegrationError):
+            self._fold([a, b])
+        self.assertEqual(self._origin_sha(LINE), t1)
+
