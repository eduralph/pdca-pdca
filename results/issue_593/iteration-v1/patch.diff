+class WavePrTargetsTheRealBase(unittest.TestCase):
+    """(i) A wave>0 bundle is cut from the integration line but its PR targets the base."""
+
+    def setUp(self) -> None:
+        self.tmp = Path(tempfile.mkdtemp())
+        self.addCleanup(shutil.rmtree, self.tmp, ignore_errors=True)
+        self.cfg = Config(
+            root=self.tmp, bundle_root=self.tmp / "results", process_dir=self.tmp / "process",
+            templates_dir=TEMPLATES, default_branch="main", tracker_system="github",
+            tracker_url="https://example.org/issues", issue_id_example="1",
+            builder=LeafConfig(mode="stub"), reviewer=LeafConfig(mode="stub"),
+            planner=LeafConfig(mode="stub", interactive=True),
+            signoff=LeafConfig(mode="stub", interactive=True),
+            publisher=LeafConfig(mode="stub", interactive=True),
+            act=LeafConfig(mode="stub", interactive=True),
+            gates_checks=[], base_remote="origin",
+            repo_checkouts={"example-org/example-repo": str(self.tmp / "example-repo")})
+
+    def _accepted(self, iid: str, extra: str = "") -> Path:
+        d = self.cfg.bundle(iid)
+        d.mkdir(parents=True)
+        (d / "brief.md").write_text(
+            "- **Slug:** my-fix\n"
+            "- **Repo + branch target:** example-org/example-repo @ main\n" + extra,
+            encoding="utf-8")
+        (d / "patch.diff").write_text("diff --git a/x b/x\n", encoding="utf-8")
+        (d / "check-gates.json").write_text("{}", encoding="utf-8")
+        shutil.copyfile(TEMPLATES / "SUMMARY.md.tpl", d / "SUMMARY.md")
+        signoff.record(d / "SUMMARY.md", action="accept", by="Tester", date="2026-10-02")
+        return d
+
+    def _dry_run(self, iid: str) -> str:
+        out = io.StringIO()
+        with redirect_stdout(out), redirect_stderr(io.StringIO()):
+            rc = publish.publish(self.cfg, iid, dry_run=True, by="T", today="2026-10-02")
+        self.assertEqual(rc, 0)
+        return out.getvalue()
+
+    def test_wave_bundle_is_cut_from_the_line_but_opens_against_main(self) -> None:
+        d = self._accepted("W1")
+        publish.write_stack_base(d, LINE)                     # the wave driver's stamp
+        out = self._dry_run("W1")
+        self.assertIn(f"checkout -B fix/W1-my-fix origin/{LINE}", out)   # carries predecessors
+        self.assertIn("--base main", out)
+        self.assertNotIn(f"--base {LINE}", out)
+
+    def test_stack_base_wins_over_a_stacks_on_parent(self) -> None:
+        # A `Stacks on` line becomes a dependency edge in a flow run, so the bundle lands in
+        # a later wave and gets a stack-base stamp too: the stamp decides both the branch
+        # (already so) and now the PR base.
+        parent = self.cfg.bundle("PARENT")
+        parent.mkdir(parents=True)
+        (parent / "publish.json").write_text(json.dumps({"branch": "fix/PARENT-my-fix"}),
+                                             encoding="utf-8")
+        d = self._accepted("BOTH", "- **Stacks on:** PARENT\n")
+        publish.write_stack_base(d, LINE)
+        out = self._dry_run("BOTH")
+        self.assertIn(f"checkout -B fix/BOTH-my-fix origin/{LINE}", out)
+        self.assertIn("--base main", out)
+        self.assertNotIn("--base fix/PARENT-my-fix", out)
+        self.assertNotIn(f"--base {LINE}", out)
+
