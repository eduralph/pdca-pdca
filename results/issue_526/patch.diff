+            elif (ev.get("type") == "user" and block.get("type") == "tool_result"
+                    and block.get("tool_use_id") in self._bash_ids):
+                if block.get("is_error"):
+                    self.errors.append(_tool_result_text(block.get("content")))
+                else:
