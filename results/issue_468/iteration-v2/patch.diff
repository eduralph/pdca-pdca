+        finally:
+            leaves._stub_signoff = orig
+        self.assertEqual(rc, 0)                      # stop-for-the-human is not a failure
+        printed = out.getvalue()
+        self.assertTrue(printed.startswith(f"{state.AWAITING_SIGNOFF}\t"))
+        d = cfg.bundle("AWSF468")
