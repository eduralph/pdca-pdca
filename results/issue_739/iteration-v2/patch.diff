+                     f"{'does' if one else 'do'} not merge cleanly onto {base_ref} itself: "
+                     f"{base_ref} moved since {'it was' if one else 'they were'} cut, and "
+                     f"{name} was built on the new {base_ref}")
+        fixes.append(f"rebuild {whose} {'branch' if one else 'branches'} on the new "
+                     f"{base_ref} (update {'it' if one else 'each'} from {base_ref} and "
+                     f"resolve the conflicts there)")
+    if own:
