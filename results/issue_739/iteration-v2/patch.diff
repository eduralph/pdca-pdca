+    base_ref = f"{cfg.base_remote}/{publish._resolve_target(d)[1] or cfg.default_branch}"
+    moved = [p for p in partners if p in stranded]
+    own = [p for p in partners if p not in stranded and p in prereqs]
+    other = [p for p in partners if p not in stranded and p not in prereqs]
+    whats: list[str] = []
+    fixes: list[str] = []
