+
+
+def _together(wt: Path, branch: str, head: str, onto: str,
+              on: Sequence[tuple[str, str]], under: Mapping[str, Sequence[str]]) -> list[str]:
+    """The bundles of ``on`` (``(name, head)``, in merge order) whose change branch tip
+    ``head`` conflicts with only together with others of them (#739: no one of them accounts
+    for the clash alone, :func:`_partners`). ``head`` must conflict after all of them merged
+    onto ``onto``, and each one named is needed for that, judged by leaving it out while
+    every other one is merged as it is:
+
+    * its own change: with what it was built on (``under``, :func:`_built_on`) merged in its
+      place — as :func:`_partners` judges a bundle for its own change — ``head`` merges
+      cleanly;
+    * else its change as the bundles built on it carry it, none of them named for its own
+      change: with it and them left out, ``head`` merges cleanly. One whose change reaches
+      the line through a bundle named for its own change is not named: that one's rebuild
+      takes it along, and the two cannot be told apart.
+
+    So a bundle on the line whose change the clash has nothing to do with is never named,
+    and neither is one ``head`` already holds (its prerequisite): ``head`` brings its change
+    back. ``[]`` when ``head`` merges after them all, when one of them does not merge there,
+    or when no one of them is needed: the clash takes any of several combinations, and the
+    fold does not guess between them. Raises as :func:`_trial` and :func:`_in_line` do; the
+    trials never move the line."""
+    revs = [h for _n, h in on]
+    if _trial(wt, branch, onto, [*revs, head])[0] != len(revs):
+        return []
+    own = {n for i, (n, _h) in enumerate(on)
+           if _trial(wt, branch, onto, [*revs[:i], *under.get(n, ()), *revs[i + 1:], head])[0]
+           is None}
+    named: list[str] = []
+    for n, its in on:
+        if n in own:
+            named.append(n)
+            continue
+        on_it = {m for m, h in on        # the bundles built on it, which carry its change
+                 if m != n and _in_line(wt, its, f"{n}'s head", f"{m}'s branch", of=h)}
+        rest = [h for m, h in on if m != n and m not in on_it]
+        if on_it and not on_it & own and _trial(wt, branch, onto, [*rest, head])[0] is None:
+            named.append(n)
+    return named
+
+
