+        heads = dict(on)
+        stranded = [n for n in partners    # its own change, after what it was built on
+                    if _trial(wt, branch, base_ref, [*under.get(n, ()), heads[n]])[0]
+                    == len(under.get(n, ()))]
+        return partners, stranded
+    except (IntegrationTreeError, _LineBroken):
