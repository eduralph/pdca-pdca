+def _parent_split_brief(source: Path, created: list[Path]) -> str:
+    """The parent's post-accept Plan artifact, built from the archived original.
+
+    Restores the invariant the CLOSE_MARKER contract depends on (state.py:40-44: the
+    close marker is the Do-era stand-in for patch.diff, so the state machine reads a
+    bundle carrying it as "past Do" — which presumes a Plan artifact exists). Only
+    the Defect / Success criterion are rewritten to describe the split outcome and name
+    every child this accept created (the accept transaction's own record, mirrored
+    from the ``build-notes.md`` breadcrumb below); Slug and Repo + branch target travel
+    unchanged from ``source`` so `handoff.check_planner`'s three mandatory fields are
+    filled with the same values a human already authored, not re-derived.
+    """
+    bundle_rel = source.relative_to(source.parent.parent)
+    slug = brief_mod.whole_field(source, "slug")
+    repo_target = brief_mod.whole_field(source, "repo + branch target")
+    children = ", ".join(d.name for d in created)
+    return (
+        f"# Brief — {source.parent.parent.name} / {slug} (split parent)\n\n"
+        "> The Plan artifact (docs 02 §PLAN). Written by `split.accept`, not a human: "
+        f"the original brief was archived to `{bundle_rel}` by an earlier iterate-to-Plan "
+        "before this slice was split (issue #481), so without this file the bundle would "
+        "carry a Do-era artifact (the close marker) with no Plan artifact behind it.\n\n"
+        f"- **Slug:** {slug}\n"
+        "- **Defect:** this slice was judged too large to build as one cycle and was "
+        f"decomposed rather than fixed directly here; see `{PROPOSAL}` for the accepted "
+        f"split and `{bundle_rel}` for the original defect this parent used to describe.\n"
+        "- **Success criterion:** the split is complete when every child bundle below "
+        f"reaches COMPLETE — {children}. This parent bundle has no fix of its own left to "
+        "verify; `build-notes.md` names the same children.\n"
+        f"- **Repo + branch target:** {repo_target}\n"
+    )
