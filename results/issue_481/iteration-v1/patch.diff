+class SplitParentKeepsAPlanArtifact(unittest.TestCase):
+    """issue #481: a split parent that `iterate-plan` archived BEFORE it was split must
+    not end up terminal (the close marker) and UNPLANNED at the same time.
+
+    The realistic case (split.py:824-826's own name for it): the parent failed an
+    attempt, sign-off chose iterate-to-Plan (archiving `brief.md` to
+    `iteration-v<N>/brief.md`, `driver.py:140`), and the Plan session that reopens it
+    decides to split rather than re-author a brief — so `split.accept` runs with
+    `brief.md` already gone.
+    """
+
+    def setUp(self) -> None:
+        self.tmp = Path(tempfile.mkdtemp())
+        self.cfg = Config(
+            root=self.tmp, bundle_root=self.tmp / "results",
+            process_dir=self.tmp / "process", templates_dir=TEMPLATES,
+            default_branch="main", tracker_system="github", tracker_url="",
+            issue_id_example="#1",
+            builder=LeafConfig(mode="stub"), reviewer=LeafConfig(mode="stub"),
+        )
+        self.parent = self.cfg.bundle("500")
+        self.parent.mkdir(parents=True)
+
+    def tearDown(self) -> None:
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    #: A COMPLETE authored brief — not `Accepting.setUp`'s bare `- **Slug:** parent`,
+    #: which `check_planner` would rightly reject as a source for the rebuilt Plan
+    #: artifact (brief's own Test file note).
+    _COMPLETE_BRIEF = (
+        "- **Slug:** widget-overflow\n"
+        "- **Defect:** the widget overflows its container on narrow screens\n"
+        "- **Success criterion:** the widget never exceeds its container's width at any "
+        "viewport down to 320px\n"
+        "- **Repo + branch target:** acme/widgets @ main\n"
+    )
+
+    def _make_realistic_parent(self) -> None:
+        """Brief authored, then archived by the driver's OWN iterate-plan path — never
+        hand-placed — so this follows `_archive_iteration` if it changes (Test file
+        note)."""
+        (self.parent / "brief.md").write_text(self._COMPLETE_BRIEF, encoding="utf-8")
+        driver._archive_iteration(self.parent, 1, include_brief=True)
+        self.assertFalse((self.parent / "brief.md").exists(),
+                         "setup did not reproduce the realistic shape")
+        self.assertTrue((self.parent / "iteration-v1" / "brief.md").exists(),
+                        "setup did not reproduce the realistic shape")
+
+    def _accept(self) -> list[Path]:
+        (self.parent / split.PROPOSAL).write_text(_proposal(_ONE, _TWO_INDEP),
+                                                   encoding="utf-8")
+        return split.accept(self.parent, ["601", "602"], self.cfg)
+
+    # -- (a) ------------------------------------------------------------------------
+
+    def test_a_realistic_parent_is_not_unplanned_or_resolved_after_accept(self) -> None:
+        self._make_realistic_parent()
+        self._accept()
+        st = state.state(self.parent)
+        self.assertNotEqual(st, state.UNPLANNED)
+        self.assertNotEqual(st, state.RESOLVED)
+
+    # -- (b) ------------------------------------------------------------------------
+
+    def test_a_realistic_parent_gets_a_complete_plan_artifact(self) -> None:
+        self._make_realistic_parent()
+        self._accept()
+        bp = self.parent / "brief.md"
+        self.assertTrue(bp.exists())
+        self.assertFalse(brief.is_placeholder(bp))
+        self.assertEqual(handoff.check_planner(self.parent, self.cfg), [])
+
+    # -- (c) ------------------------------------------------------------------------
+
+    def test_the_new_parent_brief_names_every_child(self) -> None:
+        self._make_realistic_parent()
+        created = self._accept()
+        text = (self.parent / "brief.md").read_text(encoding="utf-8")
+        for d in created:
+            self.assertIn(d.name, text,
+                          f"the rebuilt parent brief does not name child {d.name}")
+
+    # -- (d) ------------------------------------------------------------------------
+
+    def test_build_notes_still_names_the_children(self) -> None:
+        self._make_realistic_parent()
+        created = self._accept()
+        text = (self.parent / "build-notes.md").read_text(encoding="utf-8")
+        for d in created:
+            self.assertIn(d.name, text)
+
+    # -- (e) ------------------------------------------------------------------------
+
+    def test_close_marker_with_no_brief_never_derives_unplanned_however_it_arose(
+            self) -> None:
+        """Built directly (Test file note), not through `split.accept`: this is a
+        separate, general invariant on `state.state` — any close-marker bundle with no
+        brief, however it got that way."""
+        bundle = self.cfg.bundle("999")
+        bundle.mkdir(parents=True)
+        (bundle / state.CLOSE_MARKER).write_text("split\n", encoding="utf-8")
+        self.assertNotEqual(state.state(bundle), state.UNPLANNED)
+
+    def test_a_bare_close_marker_bundle_is_still_not_unplanned_without_notes_json(
+            self) -> None:
+        """The plainest shape from the brief's Falsifiability section: 'a bare bundle
+        holding only close-disposition also derives UNPLANNED' on main."""
+        bundle = self.cfg.bundle("998")
+        bundle.mkdir(parents=True)
+        (bundle / state.CLOSE_MARKER).write_text("split\n", encoding="utf-8")
+        self.assertEqual(list(bundle.iterdir()), [bundle / state.CLOSE_MARKER])
+        self.assertNotEqual(state.state(bundle), state.UNPLANNED)
+
+    # -- (f) ------------------------------------------------------------------------
+
+    def test_a_parent_with_its_own_brief_is_untouched(self) -> None:
+        """No iterate-plan archive here — the parent still has brief.md at accept time,
+        the shape every OTHER test in `Accepting` exercises. Byte-identical before and
+        after, and the rest of the suite (this module) stays green."""
+        (self.parent / "brief.md").write_text(self._COMPLETE_BRIEF, encoding="utf-8")
+        before = (self.parent / "brief.md").read_bytes()
+        self._accept()
+        after = (self.parent / "brief.md").read_bytes()
+        self.assertEqual(before, after)
+
+
