+def _archived_brief_source(parent: Path) -> Path | None:
+    """The most recently archived ORIGINAL brief still on disk, or ``None``.
+
+    Read from the highest-numbered ``iteration-v<N>/brief.md`` that exists and is
+    authored (never a placeholder). Used only when ``parent/brief.md`` itself is
+    missing at accept time — the realistic split-parent shape (issue #481): an
+    ``iterate-plan`` archived the brief to ``iteration-v<N>/`` *before* this slice was
+    split, so the parent's only remaining record of its own Slug / Repo + branch target
+    is inside that archive.
+    """
+    numbered = []
+    for d in parent.glob("iteration-v*"):
+        m = _ITERATION_RE.match(d.name)
+        if m:
+            numbered.append((int(m.group(1)), d))
+    for _, d in sorted(numbered, reverse=True):
+        bp = d / "brief.md"
+        if bp.exists() and not brief_mod.is_placeholder(bp):
+            return bp
+    return None
