+        self.assertEqual(results.get("D"), state.COMPLETE, err)
+        self.assertEqual(self.seen["issue_D"], ("", ""))
+        self.assertEqual(pushes, [])
+        self.assertIsNone(self._tip(self.line))
+        self.assertEqual(self._hold_lines(err, "issue_P"), [])
