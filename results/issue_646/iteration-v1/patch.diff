+def pr_state(d: Path) -> tuple[str | None, str]:
+    """The state of bundle ``d``'s recorded PR — ``("OPEN" | "CLOSED" | "MERGED", "")`` —
+    or ``(None, why)`` when it cannot be read (#646).
+
+    Asks ``gh pr view <pr_url> --json state`` for the PR in ``publish.json``. Fail-closed
+    like :func:`merged_head`, whose missing-``gh`` guard this copies, but it says WHY:
+    the flow holds a finished prerequisite it cannot read and must name what went wrong.
+    No recorded PR, a ``gh`` failure, ``gh`` missing (an ``OSError``) or output that is
+    not one of the three states all give ``None``; nothing raises."""
+    rec = _publish_record(d)
+    pr_url = rec.get("pr_url") if isinstance(rec, dict) else None
+    if not pr_url:
+        return None, "no PR on record (its publish.json names no pr_url)"
+    try:
+        r = subprocess.run(["gh", "pr", "view", str(pr_url), "--json", "state"],
+                           capture_output=True, text=True)
+    except OSError as exc:
+        return None, f"`gh` could not be run ({exc})"
+    if r.returncode != 0:
+        tail = (r.stderr or "").strip().splitlines()
+        return None, (f"`gh pr view {pr_url}` exited {r.returncode}"
+                      + (f": {tail[-1]}" if tail else ""))
+    try:
+        info = json.loads(r.stdout or "{}")
+    except ValueError:
+        info = None
+    st = info.get("state") if isinstance(info, dict) else None
+    if st not in ("OPEN", "CLOSED", "MERGED"):
+        return None, f"`gh pr view {pr_url}` reported no PR state"
+    return st, ""
+
+
 def _publish_record(d: Path) -> dict | None:
     """The bundle's ``publish.json`` (the recorded PR), or ``None`` if absent/unreadable."""
     pj = d / "publish.json"
