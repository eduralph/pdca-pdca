+def _fold_and_regate(cfg: Config, bundles: list[Path], *, dry: bool,
+                     folded_this_run: Mapping[tuple[str, str], str | None] | None,
+                     batch: list[str], integ: dict[tuple[str, str], str],
+                     folded_tips: dict[tuple[str, str], str | None],
+                     vouch: Mapping[tuple[str, str], Mapping[str, str | None]] | None = None,
+                     ) -> tuple[str, str] | None:
+    """Fold ``bundles`` onto their integration lines (:func:`integrate.fold`), record each
+    folded target's pushed tip in ``folded_tips`` and its branch in ``integ``, then — with
+    ``[driver].regate_between_waves`` — re-gate each folded line, all in ONE lock scope
+    (#297 review round 10): no other fold, and no sweep, can move or remove the worktree
+    between the fold, the read of its tip and the re-gate. The fold after every wave and
+    the carry before wave 0 (#646) both go through here, so the two cannot drift apart.
+
+    None when it all went through; ``("fold", why)`` when the fold raised, ``("regate",
+    "")`` when a re-gate is red — the caller stops the run. :class:`integrate.LineRefused`
+    (``vouch``) is not a failure of the fold, so it propagates for the caller to decide."""
+    with contextlib.ExitStack() as locks:
+        try:
+            folded = integrate.fold(cfg, bundles, dry_run=dry, locks=locks,
+                                    folded_this_run=folded_this_run, batch=batch, vouch=vouch)
+            # Record each target's pushed tip at once, before any re-gate: the next fold
+            # continues from exactly that tip and refuses a line another run moved (#593).
+            # A dry-run pushes nothing (None).
+            for tgt, (_branch, wt) in folded.items():
+                folded_tips[tgt] = integrate.pushed_tip(wt) if wt is not None else None
+        except integrate.LineRefused:
+            raise
+        except integrate.IntegrationError as exc:
+            return "fold", str(exc)
+        if folded and not dry:
+            # Added to, not replaced: a target only the carry folded keeps its line (#646).
+            integ.update({tgt: branch for tgt, (branch, _wt) in folded.items()})
+            # Optional re-gate (#wave-model): validate EACH folded combination over its
+            # integration tip before the next wave builds on it; any red ⇒ STOP.
+            # hold_lock=False: the locks stack already holds this tree's lock
+            # (re-acquiring would deadlock on our own flock).
+            if cfg.regate_between_waves and any(
+                    wt is not None
+                    and gates.run_integration(cfg, wt, hold_lock=False).get("overall") == "fail"
+                    for _tgt, (_branch, wt) in folded.items()):
+                return "regate", ""
+    return None
+
+
+def _carry_finished(cfg: Config, bundles: list[Path], run_batch: list[str],
+                    batch_names: set[str], *, dry: bool, held: set[str],
+                    blocked: set[tuple[str, str]], integ: dict[tuple[str, str], str],
+                    folded_tips: dict[tuple[str, str], str | None],
+                    carried: list[Path]) -> bool:
+    """Before wave 0, put the ids the run was asked for that ALREADY finished on the batch's
+    integration line (#646). False means the run stops before any wave is driven: a fold
+    failed, or the re-gate of a carried line is red.
+
+    A re-issued ``pdca flow <ids>`` — the recovery for a run that stopped part-way — skips
+    an id an earlier run finished (COMPLETE), so the in-run fold never sees it, and a
+    dependent of it would build on the plain base, without it. So when a bundle in the
+    drive set names such an id in its plain ``Depends on`` (``Stacks on`` and ``Depends on
+    (merged)`` edges never trigger this, #123 / #186), every finished id of the request the
+    fold can carry — a non-empty ``patch.diff``, a usable target, a branch on record and a
+    PR open or merged (:func:`merged.pr_state`) — is folded onto the batch's line, as the
+    in-run fold carries every accepted bundle. The fold CONTINUES origin's line, without
+    force — the earlier run's, under the same batch-scoped name (#591), so every commit an
+    earlier run recorded as a build base (``stack-base-tip``) stays on it — and starts it
+    fresh only when origin has none. It continues it only when it can vouch for all of it
+    (``integrate.fold``'s ``vouch``, by commit, under the fold's lock): every commit beyond
+    the base must be a fold's own merge or the work of a bundle carried now, at the head it
+    has now. The fold, the read of its pushed tip and the optional re-gate share one lock
+    scope (:func:`_fold_and_regate`, the same as after every wave). Its tip goes into
+    ``folded_tips``, its branch into ``integ`` and its bundles into ``carried``: the wave loop
+    points every same-target wave-0 bundle at the line (an unrelated one too — its PR shows
+    the carried changes until they merge, as any later-wave PR does), and every later fold
+    continues it and carries them again, so a fixup pushed onto a carried PR's branch
+    reaches the line at the next fold.
+
+    A finished id the fold does not carry goes into ``held`` — its plain dependents are held
+    (:func:`_runnable`) — and is named on stderr with them, the reason and what to do: no
+    branch on record (its publish pushed none), a PR that is CLOSED (and no PR of its branch
+    replaced it: none open, no newer one merged), no PR at all, or a PR state that cannot
+    be read; a closed PR's branch must not ride the shared line. A merged PR is carried
+    (the fold decides one whose branch is gone, ``integrate._gone_branch`` — through the
+    base for a squash or rebase merge, too). An id with nothing to carry (no patch, no
+    target) is neither carried nor held. Each target of a finished id is checked this way,
+    even one with nothing to carry (origin's line is then kept as it is). A line it cannot
+    vouch for — it holds a closed or unreadable PR's work, an earlier version of a bundle
+    (one this run rebuilds, or one re-pushed since), work of a bundle whose head this clone
+    lacks, a commit made outside the harness — is neither continued nor built on: its
+    target goes into ``blocked`` and no bundle of that target is built this run (a
+    later-wave one would start the line fresh over it). One stderr line names the line,
+    what it holds — which bundle, by commit, or that the run cannot tell — and how to go
+    on. A dry-run (stub publisher) reads no PR state and no line, holds nothing, and only
+    prints the plan.
+
+    Not covered: a split child an earlier run ADOPTED is not one of the ids asked for, so it
+    is never carried here — a dependent of it is gated as out-of-batch (COMPLETE), as before,
+    and a line holding its work is refused; and a prerequisite that is not one of the
+    requested ids is not carried."""
+    requested = [cfg.find_bundle(i)
+                 for i in dict.fromkeys(str(i).removeprefix("issue_") for i in run_batch)]
+    finished = [d for d in requested
+                if d.name not in batch_names and state.state(d) == state.COMPLETE]
+    dependents: dict[str, set[str]] = {}
+    for b in bundles:
+        bp = b / "brief.md"
+        for dep in (brief.depends_on(bp) if bp.exists() else []):
+            dependents.setdefault(cfg.bundle(dep).name, set()).add(b.name)
+    if not any(dependents.get(d.name) for d in finished):
+        return True   # nothing this run drives depends on a finished id: nothing to carry
+    candidates = integrate._fold_candidates(finished)   # a patch and a target
+    if dry:   # rehearse: ask no host, hold nothing, print the plan
+        carry = [d for d, *_rest in candidates]
+        names = ", ".join(d.name for d in carry)
+        if carry:
+            print(f"flow: dry-run — would carry {names} (finished in an earlier run) onto "
+                  f"the batch's integration line before wave 0, continuing origin's line "
+                  f"only if all it holds beyond the base is their work or the folds' own "
+                  f"merges.", file=sys.stderr)
+            stop = _fold_and_regate(cfg, carry, dry=True, folded_this_run=None,
+                                    batch=run_batch, integ=integ, folded_tips=folded_tips)
+            if stop is not None:
+                print(f"flow: the finished prerequisite(s) {names} did not integrate "
+                      f"({stop[1]}); STOPPING — no wave run.", file=sys.stderr)
+                return False
+            carried += carry
+        return True
+    target = {d.name: (repo, base) for d, repo, base, _slug, _ref in candidates}
+    why: dict[str, tuple[str, str]] = {}     # not carried: name → (why, what to do)
+    # Every finished id with a branch on record: name → (its state, what to do when
+    # origin's line holds work of it the carry cannot vouch for).
+    about: dict[str, tuple[str, str]] = {}
+    host: dict[str, str | None] = {}         # name → its PR's head, as the host reports it
+    carry: list[Path] = []
+    for d, repo_spec, base, _slug, ref in candidates:
+        iid = d.name.removeprefix("issue_")
+        if ref is None:
+            why[d.name] = ("it has no published branch on record",
+                           f"publish it with `pdca publish {iid}`, then re-issue the same "
