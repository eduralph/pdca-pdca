+    def test_5_a_squash_merged_prerequisite_whose_branch_is_gone_comes_in_through_the_base(
+            self) -> None:
+        # Sign-off round 3: P was squash-merged into main and its branch deleted, so neither
+        # main nor any line has the head its PR merged with — before, the carry stopped the
+        # run, and the same command stopped again on every re-issue. The commit the merge
+        # made (the host's mergeCommit) is on main, so main carries P's work: the line takes
+        # main in, and D and the unrelated U build on it.
+        self._finished("P", {"p.txt": "p\n"})
+        head = self._tip("fix/P")
+        squash = self._merge_pr("P", squash=True)
+        self.assertFalse(self._ancestor(head, self._tip("main")))
+        d = self._planned("D", _edit_p(), extra="- **Depends on:** P\n")
+        u = self._planned("U", _new_file("u.txt", "u"))
+        line = self._line_of("P", "D", "U")
+        merged_pr = {"state": "MERGED", "headRefOid": head, "mergeCommit": {"oid": squash}}
+        results, err, _out, _pushes, _gh = self._drive(
+            [d, u], ["P", "D", "U"], prs={self._url("P"): merged_pr})
+        self.assertNotIn("STOPPING", err)
+        self.assertEqual(sorted(self.driven), ["issue_D", "issue_U"], err)
+        tip = self.line_at["issue_D"]
+        self.assertTrue(self._ancestor(squash, tip), f"the line lacks P's work\n{err}")
+        self.assertEqual(self.seen["issue_D"], (line, tip))
