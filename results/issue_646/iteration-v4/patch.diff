+        pr = merged.pr_state(cfg, d)   # the recorded PR, or one its branch has
+        host[d.name] = pr.head
+        if pr.state in ("OPEN", "MERGED"):
+            carry.append(d)
+            about[d.name] = (f"its PR is {pr.state}", f"restore {d.name}'s branch")
+        elif pr.state == "CLOSED":   # and no PR of its branch replaced it
+            why[d.name] = (f"its PR {pr.url} is CLOSED (not merged), and its branch has no "
+                           f"open PR, nor a newer merged one",
+                           f"re-open its PR or re-drive {iid}, then re-issue the same command")
+            about[d.name] = (why[d.name][0],
+                             f"re-open {d.name}'s PR (restoring its branch if it was deleted)")
+        elif pr.state == "NONE":   # its branch is pushed, but `gh pr create` failed back then
+            rec = publish._publish_record(d) or {}
+            on = str(rec.get("repo") or repo_spec)
+            head = publish._pr_head(publish._checkout_path(cfg, on), on, str(rec.get("branch")))
+            create = (f"`gh pr create --draft --repo {on} --base {rec.get('base') or base} "
+                      f"--head {head}`")
+            why[d.name] = (f"it has no PR: {pr.why}",
+                           f"open its PR by hand ({create}), then re-issue the same command")
