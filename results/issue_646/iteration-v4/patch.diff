+    def test_5_a_squash_clashing_with_the_lines_older_commit_says_restore_and_that_works(
+            self) -> None:
+        # The squash also holds a fixup pushed after the earlier run's fold carried P, so
+        # main's p.txt clashes with the line's first version of it: taking main in conflicts
+        # and the run stops. Its advice must work: with P's branch restored, the fold merges
