-        step = min(poll_interval, wait_secs - waited)
-        _sleep(step)
-        waited += step
+    while True:
+        while verdict in ("pending", "empty") and waited < wait_secs:
+            step = min(poll_interval, wait_secs - waited)
+            _sleep(step)
+            waited += step
+            verdict, detail = _check_rollup(pr_url)
+        if verdict != "green":
