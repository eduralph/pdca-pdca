diff --git a/template/tests/test_merge_retarget.py b/template/tests/test_merge_retarget.py
new file mode 100644
index 0000000..9e39d76
--- /dev/null
+++ b/template/tests/test_merge_retarget.py
@@ -0,0 +1,207 @@
+"""Merge mode merges a PR only into its bundle's own target base (issue #500).
+
+#411 refuses, at publish, a merge-mode PR opened against a branch this run produced. A PR
+that never passes through that guard again — one an earlier run opened, or one whose base
+was edited on the host since — used to be readied and merged into whatever base it
+carried. `merge._merge_one` now reads the PR's base on the host before the ready-mark and
+compares it with the bundle's resolved target base (`publish._resolve_target`, the one
+parse publish uses):
+
+- equal: no `gh pr edit`, the merge goes on as before;
+- different: `gh pr edit --base <target>`, then a second read; the merge goes on only if
+  the host now reports the target. A failed edit, or a base that did not change, refuses
+  naming both branches — with no `gh pr ready` (nor `--undo`) at all for that PR;
+- a target that is a branch a sibling bundle of the batch published (#411 route 2) is
+  refused before any `gh pr edit`, whatever base the host reports.
+
+Both `merge_requires` values are covered: `"required"` skips the rollup and the behind
+check, not this. A malformed `expected_checks` is still refused first (no `gh pr edit`).
+`gh` and git are stubbed in front of `subprocess.run`, as `test_merge.py` does — offline.
+Run from the template root:
+    PYTHONPATH=src python -m unittest tests.test_merge_retarget
+"""
+
+from __future__ import annotations
+
+import io
+import json
+import shutil
+import tempfile
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+from pathlib import Path
+from types import SimpleNamespace
+from unittest import mock
+
+from pdca_harness import merge, merged, publish, state
+from pdca_harness.config import Config, LeafConfig
+
+PR = "https://github.com/org/repo/pull/7"
+HEAD = "1" * 40
+BASE_TIP = "b" * 40
+REQUIRES = ("all", "required")
+
+
+def _cfg(root: Path, **overrides: object) -> Config:
+    return Config(
+        root=root, bundle_root=root / "results", process_dir=root / "process",
+        templates_dir=root / "templates", default_branch="main", tracker_system="github",
+        tracker_url="", issue_id_example="#1",
+        builder=LeafConfig(mode="stub"), reviewer=LeafConfig(mode="stub"),
+        base_remote="origin", repo_checkouts={"org/repo": str(root / "repo")},
+        wave_mode="merge", merge_wait_secs=0, **overrides)
+
+
+def _res(code: int = 0, out: str = "", err: str = "") -> SimpleNamespace:
+    return SimpleNamespace(returncode=code, stdout=out, stderr=err)
+
+
+class _Host:
+    """A fake `gh` + git for one PR whose base the host reports as ``base``. ``gh pr edit
+    --base X`` fails when ``edit_fails``; otherwise it moves the base to X unless
+    ``edit_ignored`` (the host accepts the edit but keeps reporting the old base). The
+    rollup is green and the head up to date with its base, so a PR that gets past the
+    base check merges."""
+
+    def __init__(self, base: str, *, edit_fails: bool = False,
+                 edit_ignored: bool = False) -> None:
+        self.base = base
+        self.edit_fails = edit_fails
+        self.edit_ignored = edit_ignored
+        self.calls: list[list[str]] = []
+
+    def __call__(self, cmd: list[str], **kw) -> SimpleNamespace:
+        self.calls.append(list(cmd))
+        if cmd[:3] == ["gh", "pr", "view"]:
+            return _res(out=json.dumps({"headRefOid": HEAD, "baseRefName": self.base}))
+        if cmd[:3] == ["gh", "pr", "edit"]:
+            if self.edit_fails:
+                return _res(1, err="GraphQL: Proposed base branch was not found")
+            if not self.edit_ignored:
+                self.base = cmd[cmd.index("--base") + 1]
+            return _res()
+        if cmd[:3] == ["gh", "pr", "checks"]:
+            return _res(out=json.dumps([{"name": "ci", "bucket": "pass"}]))
+        if cmd[:1] == ["git"] and "rev-parse" in cmd:
+            return _res(out=BASE_TIP + "\n")
+        return _res()                       # ready, merge, fetch, cat-file, merge-base
+
+
+def _index(calls: list[list[str]], prefix: list[str]) -> int:
+    return next((i for i, c in enumerate(calls) if c[:len(prefix)] == prefix), -1)
+
+
+class MergeRetargetsToTheTargetBase(unittest.TestCase):
+    def setUp(self) -> None:
+        self.tmp = Path(tempfile.mkdtemp())
+        self.addCleanup(shutil.rmtree, self.tmp, ignore_errors=True)
+
+    def _bundle(self, cfg: Config, iid: str, *, target: str = "main",
+                record: dict | None = None) -> Path:
+        d = cfg.bundle(iid)
+        d.mkdir(parents=True)
+        (d / "brief.md").write_text(f"- **Repo + branch target:** org/repo @ {target}\n",
+                                    encoding="utf-8")
+        (d / "patch.diff").write_text("diff\n", encoding="utf-8")
+        (d / "publish.json").write_text(
+            json.dumps(record or {"pr_url": PR, "repo": "org/repo"}), encoding="utf-8")
+        return d
+
+    def _run(self, cfg: Config, host: _Host, d: Path) -> tuple[int, str]:
+        # `is_merged` is patched for the bundle under test only: the sibling of the route-2
+        # case is never merged by this run either way.
+        with mock.patch("pdca_harness.merge.subprocess.run", side_effect=host), \
+                mock.patch.object(merge, "_sleep"), \
+                mock.patch.object(state, "state", return_value=state.COMPLETE), \
+                mock.patch.object(merged, "is_merged", return_value=False), \
+                redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()) as err:
+            rc = merge.merge_wave(cfg, [d], method="merge")
+        return rc, err.getvalue()
+
+    def _assert_untouched(self, host: _Host) -> None:
+        """No `gh pr ready` (and so no `--undo`) and no `gh pr merge` for the PR."""
+        self.assertEqual(_index(host.calls, ["gh", "pr", "ready"]), -1, host.calls)
+        self.assertEqual(_index(host.calls, ["gh", "pr", "merge"]), -1, host.calls)
+
+    # (a) — a wrong base that the edit fixes is merged, into the target, after the edit.
+    def test_wrong_base_is_retargeted_then_merged(self) -> None:
+        for requires in REQUIRES:
+            with self.subTest(merge_requires=requires):
+                cfg = _cfg(self.tmp / requires, merge_requires=requires)
+                host = _Host("fix/old-parent")
+                rc, err = self._run(cfg, host, self._bundle(cfg, "500"))
+                self.assertEqual(rc, 0, err)
+                edit = _index(host.calls, ["gh", "pr", "edit", PR, "--base", "main"])
+                ready = _index(host.calls, ["gh", "pr", "ready", PR])
+                merge_at = _index(host.calls, ["gh", "pr", "merge", PR])
+                self.assertNotEqual(edit, -1, host.calls)
+                self.assertNotEqual(merge_at, -1, host.calls)
+                self.assertLess(edit, ready)
+                self.assertLess(ready, merge_at)
+                self.assertEqual(host.base, "main")
+                # The base is read again after the edit, before the ready-mark.
+                self.assertTrue(any(c[:3] == ["gh", "pr", "view"]
+                                    for c in host.calls[edit + 1:ready]), host.calls)
+
+    # (b) — an edit that fails, or one the host ignores, stops the run with the PR as found.
+    def test_retarget_that_fails_or_does_not_take_refuses(self) -> None:
+        for how in ("edit_fails", "edit_ignored"):
+            for requires in REQUIRES:
+                with self.subTest(how=how, merge_requires=requires):
+                    cfg = _cfg(self.tmp / how / requires, merge_requires=requires)
+                    host = _Host("fix/old-parent", **{how: True})
+                    rc, err = self._run(cfg, host, self._bundle(cfg, "500"))
+                    self.assertEqual(rc, 1)
+                    self.assertNotEqual(
+                        _index(host.calls, ["gh", "pr", "edit", PR, "--base", "main"]), -1)
+                    self._assert_untouched(host)
+                    self.assertIn("`fix/old-parent`", err)
+                    self.assertIn("`main`", err)
+                    self.assertIn("NOT merged", err)
+
+    # (d) — a PR already on its target base makes no edit.
+    def test_right_base_makes_no_edit(self) -> None:
+        for requires in REQUIRES:
+            with self.subTest(merge_requires=requires):
+                cfg = _cfg(self.tmp / requires, merge_requires=requires)
+                host = _Host("main")
+                rc, err = self._run(cfg, host, self._bundle(cfg, "500"))
+                self.assertEqual(rc, 0, err)
+                self.assertEqual(_index(host.calls, ["gh", "pr", "edit"]), -1, host.calls)
+                self.assertNotEqual(_index(host.calls, ["gh", "pr", "merge", PR]), -1)
+
+    # (e) — a target that a sibling bundle of this batch produced is refused (#411 route 2),
+    # whether or not the host already reports it as the PR's base.
+    def test_batch_produced_target_is_refused_before_any_edit(self) -> None:
+        for host_base in ("feat/sibling", "main"):
+            for requires in REQUIRES:
+                with self.subTest(host_base=host_base, merge_requires=requires):
+                    cfg = _cfg(self.tmp / host_base.replace("/", "_") / requires,
+                               merge_requires=requires)
+                    self._bundle(cfg, "499", record={
+                        "pr_url": "https://github.com/org/repo/pull/6", "repo": "org/repo",
+                        "branch": "feat/sibling"})
+                    d = self._bundle(cfg, "500", target="feat/sibling")
+                    self.assertEqual(publish._resolve_target(d)[1], "feat/sibling")
+                    host = _Host(host_base)
+                    rc, err = self._run(cfg, host, d)
+                    self.assertEqual(rc, 1)
+                    self.assertEqual(_index(host.calls, ["gh", "pr", "edit"]), -1,
+                                     host.calls)
+                    self._assert_untouched(host)
+                    self.assertIn("issue_499", err)
+                    self.assertIn("`feat/sibling`", err)
+
+    # (f) — a malformed expected_checks is refused first: no edit for a wrong-based PR.
+    def test_expected_checks_error_is_refused_before_the_retarget(self) -> None:
+        cfg = _cfg(self.tmp, expected_checks_error="[driver].expected_checks is not a list")
+        host = _Host("fix/old-parent")
+        rc, err = self._run(cfg, host, self._bundle(cfg, "500"))
+        self.assertEqual(rc, 1)
+        self.assertIn("expected_checks is not a list", err)
+        self.assertEqual(_index(host.calls, ["gh", "pr", "edit"]), -1, host.calls)
+        self._assert_untouched(host)
+
+
+if __name__ == "__main__":
+    unittest.main()
