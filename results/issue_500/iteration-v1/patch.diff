+def _target_base_refusal(cfg: Config, d: Path, pr_url: str) -> str:
+    """Why ``d``'s PR may not be merged into the base it carries, or "" once it targets the
+    bundle's resolved target base (issue #500). The merge-time half of the #411 rule
+    (``publish._merge_base_refusal``), for a PR that rule never saw: one opened by an
+    earlier run, or whose base was edited on the host since.
+
+    The target is ``publish._resolve_target``'s, the one parse publish uses. A target that
+    is a branch another bundle of this batch produced (#411 route 2,
+    ``publish._batch_branch_producer``) is refused before the host is asked anything. A PR
+    the host reports on another base is retargeted (``gh pr edit --base``) and its base read
+    again; only a re-read that reports the target lets the merge go on. Called before the
+    ready-mark, so every refusal here leaves the PR's draft/ready state as it found it."""
+    if not (d / "brief.md").is_file():
+        return ("it has no brief.md, so there is no target base to check its PR's base "
+                "against")
+    repo_spec, target = publish._resolve_target(d)[:2]
+    if not repo_spec or not target:
+        return (f"its brief has no usable `Repo + branch target` (got repo={repo_spec!r} "
+                f"base={target!r}), so there is no target base to check its PR's base "
+                "against")
+    fix = ('`[driver].wave_mode = "merge"` merges this PR into whatever it targets, '
+           "unattended — so it may only target a base that exists independently of this "
+           "run. Point the brief's `Repo + branch target` at the shared base, or use the "
+           'default wave_mode = "stack", where chaining onto a predecessor is correct')
+    producer = publish._batch_branch_producer(cfg, d, repo_spec, target)
+    if producer:
+        return (f"its target base `{target}` is the branch {producer} produced in this "
+                f"batch, not a shared base. {fix}")
+    _, base, why = _pr_head(pr_url)
+    if not base:
+        return f"its base could not be checked against its target base `{target}`: {why}"
+    if base == target:
+        return ""
+    print(f"   PR base `{base}` is not its target base `{target}` — retargeting")
+    print(f"→ gh pr edit {pr_url} --base {target}")
+    edit = subprocess.run(["gh", "pr", "edit", pr_url, "--base", target],
+                          capture_output=True, text=True)
+    if edit.returncode != 0:
+        print((edit.stderr or edit.stdout).strip(), file=sys.stderr)
+        return (f"its PR targets `{base}`, not its target base `{target}`, and could not "
+                f"be retargeted (`gh pr edit --base {target}` failed). {fix}")
+    _, now, why = _pr_head(pr_url)
+    if now != target:
+        seen = f"`{now}`" if now else f"unreadable ({why})"
+        return (f"its PR targeted `{base}`, not its target base `{target}`, and after "
+                f"`gh pr edit --base {target}` the host still reports its base as {seen}. "
+                f"{fix}")
+    print(f"   retargeted {pr_url} from `{base}` to `{target}`")
+    return ""
+
