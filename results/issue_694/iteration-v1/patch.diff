+def _clash(wt: Path, branch: str, head: str, base_ref: str, on_line: Sequence[tuple[str, str]],
+           paths: Sequence[str]) -> tuple[str, list[str], list[str]] | None:
+    """What branch tip ``head``, which just failed to merge onto the line checked out in
+    ``wt`` with conflicts in ``paths``, conflicts with (#694, the pre-wave carry's fold):
+    ``(kind, partners, paths)``.
+
+    ``"base"`` — ``head`` does not merge cleanly onto ``base_ref`` alone: the clash is with
+    the base, so no bundle is named. Else ``"batch"`` — the bundles of ``on_line`` (the ones
+    this fold put on the line, or found there already, ``(name, head)`` in fold order) for
+    which ``head`` merges cleanly onto ``base_ref`` plus that bundle's head but not onto it
+    alone, with the files of those trials. One of them whose head holds another one's (it
+    was built on it) is not named for that one's change. Else ``"line"`` — the conflicting
+    work is on the line but no bundle of ``on_line`` reproduces it: no bundle is named, only
+    ``paths``. The trials never move the line (:func:`_trial`). None: a trial failed with no
+    conflicting path, so nothing is said about the conflict."""
+    try:
+        at, base_paths = _trial(wt, branch, base_ref, [head])
+        if at is not None:
+            return "base", [], base_paths
+        hit: dict[str, tuple[str, list[str]]] = {}
+        for name, its in on_line:
+            at, its_paths = _trial(wt, branch, base_ref, [its, head])
+            if at == 1:
+                hit[name] = (its, its_paths)
+        partners = [n for n, (its, _p) in hit.items()
+                    if not any(m != n and o != its and _in_line(wt, o, f"{m}'s head", branch,
+                                                                 of=its)
+                               for m, (o, _q) in hit.items())]
+    except (IntegrationTreeError, _LineBroken):
+        raise
+    except IntegrationError:
+        return None
+    if not partners:
+        return "line", [], list(paths)
+    found = list(dict.fromkeys(p for n in partners for p in hit[n][1]))
+    return "batch", partners, found
+
+
