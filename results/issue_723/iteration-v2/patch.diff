+    def test_a_member_that_moved_on_since_an_excluded_bundle_was_cut_keeps_its_work(
+            self) -> None:
+        # As above, then A gets one more commit (a fixup the next fold takes, #593). C holds
+        # A's head as the line took it, not A's new one, so only the run's record of that
+        # head says A's first two commits are A's, not C's. They are on B's base and must
+        # not be refused as C's work.
+        record: dict[str, str] = {}
+        a, _z, _t = self._wave0(record)
+        self.fx._publish("C", {"c.txt": "c\n"}, cut_from=f"origin/{self.line}")
+        a3 = self.fx._push_from_human({"a3.txt": "a3\n"}, to="fix/A", off="origin/fix/A")
+        self.assertFalse(self.fx._ancestor(a3, self.fx._tip("fix/C")))
+        excluded = {"issue_C": self.fx._tip("fix/C"), "issue_Z": self.fx._tip("fix/Z")}
+        branch, tip = self._build(self._dest("B"), [a], carried=record, excluded=excluded)
+        self.assertEqual(self.fx._tip(branch), tip)
+        for c in self._commits("refs/heads/main..refs/heads/fix/A"):
+            self.assertTrue(self.fx._ancestor(c, tip), f"A's {c} is missing")
+        self.assertFalse(self.fx._ancestor(self.fx._tip("fix/C"), tip))
+        self.assertFalse(self.fx._ancestor(self.fx._tip("fix/Z"), tip))
