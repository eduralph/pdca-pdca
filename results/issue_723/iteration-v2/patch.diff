+    def test_a_member_cut_from_an_old_line_cannot_bring_an_excluded_bundle_in(self) -> None:
+        x = self.fx._publish("X", {"x.txt": "x\n"})
+        integrate.fold(self.cfg, [x], batch=BATCH, folded_this_run={})
+        p = self.fx._publish("P", {"p.txt": "p\n"}, cut_from=f"origin/{self.line}")
+        msg, _steps = self._refused(self._dest("D"), [p],
+                                    excluded={"issue_X": self.fx._tip("fix/X")})
+        for part in (f"{self.fx._tip('fix/X')[:12]}, which is issue_X's work",
+                     "issue_P's branch origin/fix/P brings it in", "Nothing was pushed"):
+            self.assertIn(part, msg)
