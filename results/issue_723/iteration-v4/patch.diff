+    def test_an_excluded_head_this_clone_lacks_stops_the_build_before_any_merge(
+            self) -> None:
+        # P was cut from a line holding X's commit, and X's newer head is published where
+        # this checkout never fetches (another remote). Without that commit, X's work cannot
+        # be told from P's, so the build refuses instead of pushing a base that holds X's
+        # commit. Once the head is fetched, the same build is refused for that commit.
+        x = self.fx._publish("X", {"x.txt": "x\n"})
+        integrate.fold(self.cfg, [x], batch=BATCH, folded_this_run={})
+        x1 = self.fx._tip("fix/X")
+        p = self.fx._publish("P", {"p.txt": "p\n"}, cut_from=f"origin/{self.line}")
+        elsewhere = self.fx.tmp / "elsewhere.git"
+        subprocess.run(["git", "init", "--bare", "-q", str(elsewhere)], check=True)
+        x2 = self.fx._push_from_human({"x2.txt": "x2\n"}, to="fix/X", url=str(elsewhere),
+                                      off="origin/fix/X")
+        d = self._dest("D")
+        msg, steps = self._refused(d, [p], excluded={"issue_X": x2})
+        self.assertIn(f"does not have issue_X's published head {x2[:12]}", msg)
+        self.assertIn("Nothing was merged or pushed", msg)
+        self.assertNotIn("merge", steps, "the build merged before it refused")
+        sb._git(self.fx.primary, "fetch", "-q", str(elsewhere), "fix/X")
+        msg, _steps = self._refused(d, [p], excluded={"issue_X": x2})
+        self.assertIn(f"{x1[:12]}, which is issue_X's work", msg)
+        self.assertIn("issue_P's branch origin/fix/P brings it in", msg)
