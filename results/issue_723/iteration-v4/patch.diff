@@ -0,0 +1,696 @@
+"""A bundle's own base: exactly the fetched base plus a chosen set of bundles (#723).
+
+``integrate.fold`` could only fold onto the run's one line per target: it names its
+destination itself (``integration_branch``) and every accepted bundle of the target lands
+there. #463's dependency-scoped bases need a branch holding exactly the bundles one bundle
+builds on. These cases pin ``integrate.build_bundle_base``: what the branch holds, its name,
+how it is pushed, and that every safeguard of the run's fold applies to it, plus two more:
+a rewritten carried member (#633), and work of a bundle outside the set brought in by a
+member. Each refusal comes before anything is pushed.
+
+Work outside the set is a commit the members reach only through the own branch of a bundle
+outside it: its first-parent chain (the commits it was built along), down to where it was
+cut from another bundle's head. A commit a member reaches without that, on its own branch
+or merged into it from a topic branch, is the member's, whoever else holds it. So a bundle
+outside the set that was cut from the run's line, which holds the members only through the
+line's merges, never claims their commits: however far a member's branch moves on, whatever
+the run recorded for it, and whatever shape its history has (a topic merged in, an update
+from the base, a merge made the other way). One cut straight from a member's branch does
+not own what it was cut from. A member cut from the line, or from the branch of a bundle
+outside the set, brings that bundle's commits in, and is refused, also when that bundle
+moved on since or merged the member's branch back, and also for work that bundle's author
+merged into its branch from a topic branch, named for that bundle. The harness's own
+branches (the run's line, a bundle base) are no bundle's, so a member cut from one holds
+the bundles on it only through its merges too: it brings a bundle outside the set in even
+once that bundle's commits are off its own first-parent chain (merged the other way round).
+A bundle outside the set whose head this clone does not have cannot be judged at all, so
+the build refuses rather than guess.
+
+Real git: the ``StackFoldGit`` fixture of tests/test_integrate_stack_bases.py (a bare
+``origin``, a primary checkout and a ``human`` clone), loaded by path and used as a helper
+object, as tests/test_integrate_revert_via_branch.py does. It is never subclassed, which
+would re-run that suite's tests here. Only modules are imported, and the new entry points
+are reached inside each test body, so with the production change reverted these cases
+still load and run, and fail.
+    cd template && PYTHONPATH=src python3 -m unittest tests.test_integrate_bundle_base
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import io
+import json
+import subprocess
+import unittest
+from contextlib import redirect_stderr
+from pathlib import Path
+from unittest import mock
+
+from pdca_harness import integrate
+
+_SPEC = importlib.util.spec_from_file_location(
+    "stack_bases_fixture", Path(__file__).with_name("test_integrate_stack_bases.py"))
+sb = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(sb)
+
+BATCH = ["A", "B", "C", "D", "E", "M", "P", "T", "X", "Y", "Z", "12"]
+
+
+class BundleBase(unittest.TestCase):
+
+    def setUp(self) -> None:
+        self.fx = sb.StackFoldGit()          # the fixture's real-git setUp/tearDown and helpers
+        self.fx.setUp()
+        self.addCleanup(self.fx.tearDown)
+        self.cfg = self.fx.cfg
+        self.line = integrate.integration_branch(self.cfg, "main", BATCH)
+
+    # -- helpers -------------------------------------------------------------------------
+
+    def _build(self, d: Path, members: list[Path], *, carried=None, excluded=None):
+        """``integrate.build_bundle_base``, looked up here, so a tree without it fails this
+        case, not the module's import."""
+        return integrate.build_bundle_base(self.cfg, d, members, batch=BATCH,
+                                           carried=carried or {}, excluded=excluded or {})
+
+    def _name(self, iid: str) -> str:
+        """The base branch of bundle ``iid`` (a plain id: nothing for the name to escape)."""
+        return f"{self.line}-b{iid}"
+
+    def _refused(self, d: Path, members: list[Path], **kw) -> tuple[str, list[str]]:
+        """The build of ``d``'s base raises ``IntegrationError`` and pushes nothing: no
+        ``git push`` ran and origin has no base for ``d``. Returns the message and every git
+        step the build ran through ``integrate._git``, the failed ones too."""
+        steps: list[str] = []
+        real = integrate._git
+
+        def spy(repo: Path, *args: str) -> int:
+            steps.append(args[0])
+            return real(repo, *args)
+
+        with mock.patch.object(integrate, "_git", spy), redirect_stderr(io.StringIO()), \
+                self.assertRaises(integrate.IntegrationError) as ctx:
+            self._build(d, members, **kw)
+        self.assertNotIn("push", steps, "the build pushed")
+        self.assertFalse(self.fx._has(self._name(d.name.removeprefix("issue_"))),
+                         "a refused base reached origin")
+        return str(ctx.exception), steps
+
+    def _publish2(self, iid: str, first: dict[str, str], second: dict[str, str], *,
+                  cut_from: str = "origin/main") -> Path:
+        """Publish ``fix/<iid>`` with TWO commits: ``first``, then ``second`` on top."""
+        d = self.fx._publish(iid, first, cut_from=cut_from)
+        self.fx._push_from_human(second, to=f"fix/{iid}", off=f"origin/fix/{iid}")
+        return d
+
+    def _dest(self, iid: str) -> Path:
+        """A bundle that will be built on the base (it needs only its brief's target)."""
+        d = self.cfg.bundle(iid)
+        sb._brief(d)
+        return d
+
+    def _commits(self, rng: str) -> list[str]:
+        return sb._git(self.fx.origin, "rev-list", rng).split()
+
+    def _wave0(self, carried: dict[str, str] | None = None) -> tuple[Path, Path, str]:
+        """Wave 0 = A, Z (unrelated, two commits each on their own files), folded onto the
+        run's line; ``carried`` gets the run's record of the heads the line took. Returns
+        (A, Z, the line tip)."""
+        a = self._publish2("A", {"a1.txt": "a1\n"}, {"a2.txt": "a2\n"})
+        z = self._publish2("Z", {"z1.txt": "z1\n"}, {"z2.txt": "z2\n"})
+        integrate.fold(self.cfg, [a, z], batch=BATCH, folded_this_run={},
+                       **({} if carried is None else {"carried": carried}))
+        return a, z, self.fx._tip(self.line)
+
+    def _c_cut_from_the_line_then_a_moves_on(self, record: dict[str, str] | None = None
+                                             ) -> tuple[Path, Path, Path, str]:
+        """Wave 0 (``_wave0``), then C cut from the run's line (so it holds A and Z through
+        the line's merges), then A gets a third commit, a3: a fixup the next fold takes
+        (#593). C holds A's old head, not a3. Returns (A, Z, C, the line tip of wave 0)."""
+        a, z, line_tip = self._wave0(record)
+        c = self.fx._publish("C", {"c.txt": "c\n"}, cut_from=f"origin/{self.line}")
+        a2 = self.fx._tip("fix/A")
+        a3 = self.fx._push_from_human({"a3.txt": "a3\n"}, to="fix/A", off="origin/fix/A")
+        self.assertTrue(self.fx._ancestor(a2, self.fx._tip("fix/C")))
+        self.assertFalse(self.fx._ancestor(a3, self.fx._tip("fix/C")))
+        return a, z, c, line_tip
+
+    def _assert_a_only(self, branch: str, tip: str, *, count: int = 3) -> None:
+        """B's base is on origin at ``tip`` and holds every commit of A's branch (``count``
+        of them, merges included) and nothing of C's or Z's: neither C's own commit nor any
+        of Z's."""
+        self.assertEqual(self.fx._tip(branch), tip, "the base was not pushed to origin")
+        a_commits = self._commits("refs/heads/main..refs/heads/fix/A")
+        self.assertEqual(len(a_commits), count)
+        for c in a_commits:
+            self.assertTrue(self.fx._ancestor(c, tip), f"A's {c} is missing")
+        self.assertFalse(self.fx._ancestor(self.fx._tip("fix/C"), tip), "C's work leaked in")
+        for c in self._commits("refs/heads/main..refs/heads/fix/Z"):
+            self.assertFalse(self.fx._ancestor(c, tip), f"Z's {c} leaked in")
+
+    def _on_human(self, *steps: tuple[str, ...]) -> None:
+        """Run git ``steps`` in the ``human`` clone, after fetching origin."""
+        sb._git(self.fx.human, "fetch", "-q", "origin")
+        for step in steps:
+            sb._git(self.fx.human, *step)
+
+    def _merge_into(self, branch: str, rev: str) -> None:
+        """``branch``'s author merges ``rev`` into it (``--no-ff``) and pushes it to origin."""
+        self._on_human(("checkout", "-q", "-B", branch, f"origin/{branch}"),
+                       ("merge", "-q", "--no-ff", "--no-edit", rev),
+                       ("push", "-q", "origin", branch))
+
+    def _record(self, iid: str, files: dict[str, str]) -> Path:
+        """Bundle ``iid`` whose branch ``fix/<iid>`` was made on origin by hand: its brief, a
+        patch adding ``files``, and the publish record naming that branch."""
+        d = self.cfg.bundle(iid)
+        sb._brief(d)
+        (d / "patch.diff").write_text("".join(sb._new_file_patch(n, t.rstrip("\n"))
+                                              for n, t in files.items()), encoding="utf-8")
+        (d / "publish.json").write_text(json.dumps(
+            {"mode": "new-pr", "branch": f"fix/{iid}", "base": "main", "repo": "org/repo"}),
+            encoding="utf-8")
+        return d
+
+    def _merge_the_other_way(self, iid: str) -> str:
+        """``fix/<iid>``'s author merges it INTO the base locally and pushes that as
+        ``fix/<iid>`` (a fast-forward of it): the base is the new head's first parent, so the
+        bundle's own commits are off its first-parent chain. Returns the new head."""
+        self._on_human(("checkout", "-q", "-B", "turned", "origin/main"),
+                       ("merge", "-q", "--no-ff", "--no-edit", f"origin/fix/{iid}"),
+                       ("push", "-q", "origin", f"turned:fix/{iid}"))
+        head = self.fx._tip(f"fix/{iid}")
+        self.assertEqual(sb._git(self.fx.origin, "rev-parse", f"{head}^1").strip(),
+                         self.fx._tip("main"), "the base is not the head's first parent")
+        return head
+
+    def _a_with_a_topic(self) -> tuple[Path, str]:
+        """A publishes its own commit, then its author merges a topic branch into ``fix/A``
+        (``--no-ff``): the topic's commit is A's work, but it is not on A's first-parent
+        chain. Returns (A, the topic's commit)."""
+        a = self.fx._publish("A", {"a1.txt": "a1\n"})
+        topic = self.fx._push_from_human({"t.txt": "t\n"}, to="topic-a")
+        self._merge_into("fix/A", "origin/topic-a")
+        return a, topic
