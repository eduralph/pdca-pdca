+    def test_a_member_that_brings_a_revert_of_an_earlier_members_work_stops_the_build(
+            self) -> None:
+        # #623 / #673. A adds a.txt. Another branch on origin, `next`, merges A's PR and
+        # then reverts it, and B's author updates fix/B from `next` (a merge commit on
+        # fix/B), which brings the revert along. Built fresh on main, A puts a.txt on D's
+        # base and B's merge would take it off again, by a change none of B's own commits
