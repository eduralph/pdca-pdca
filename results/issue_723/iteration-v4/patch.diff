+def build_bundle_base(cfg: Config, d: Path, members: Sequence[Path], *,
+                      batch: Collection[str] | None, carried: Mapping[str, str],
+                      excluded: Mapping[str, str]) -> tuple[str, str]:
+    """Build bundle ``d``'s own base (#723, for #463's dependency-scoped bases): a branch
+    on ``origin`` holding exactly the fetched ``<base_remote>/<base>`` plus the published
+    branches of ``members`` (bundle paths, merged in that order), and nothing else of the
+    run. Returns ``(branch, pushed tip)``. The branch is :func:`bundle_base_branch` for
+    ``d``'s target; the run's line, and whatever the caller recorded for it (``carried``
+    included), are never written.
+
+    A sibling of :func:`fold`, sharing its merge path (:func:`_merge_published`, so
+    :func:`_gone_branch`, :func:`_take_in_base` and the #623/#673 revert check), its
+    per-target lock (:func:`integ_lock`) and worktree (:func:`_prepare_worktree`), and its
+    tree reset (:func:`_reset_tree`). It always starts fresh from the base as just fetched.
+    A member with no patch adds nothing (as in a fold). One with a patch but no usable
+    target, on another target than ``d``, or with no published branch raises before any
+    git step: the base is never built without a member the caller named.
+
+    Refused with :class:`IntegrationError`, before anything is pushed:
+
+    * ``carried`` (member name → the head a fold of this run recorded for it, #633): a
+      member whose branch no longer holds that head was rewritten, judged as a fold judges
+      it (:func:`_carried_rewrite`), before anything is merged. Each member's tip is read
+      once, after the fetch, and that commit is the one checked and merged.
+    * A member that does not merge cleanly. When it does not merge onto the fetched base
+      alone, the clash is with the base: the message names ``<remote>/<base>`` and says to
+      rebuild the member's branch on it. Otherwise it names the members merged before it
+      that it clashes with (each tried on its own, as :func:`_held_by` does; all of them
+      when only their combination clashes).
+    * ``excluded`` (name → published head of each bundle of the run that is NOT a member):
+      a head this clone does not have after the fetch, before anything is merged, since
+      whether a member brings that bundle's work in cannot be told without it; and a result
+      that would hold work of one of them, named with the member that brought it in: a
+      non-merge commit of that bundle's that the members' heads reach only through its own
+      branch (its first-parent chain down to where it was cut from another bundle's head: a
+      member's, merged or as ``carried`` records it, or another excluded one) or through a
+      harness branch that merged it, the run's line or a bundle base (:func:`_foreign_work`).
+      A commit a member reaches on its own, on its branch or merged into it, is its work,
+      so a bundle cut from the run's line never makes a member's commits its own, however
+      far that member's branch moved on since.
+
+    A name in ``carried`` or ``excluded`` is a bundle's with or without its ``issue_``
+    prefix (:func:`_bundle_name`); one that is also a member's is a member, not excluded.
+
+    Push: origin without the branch gets a plain push (no force, so an origin with
+    ``receive.denyNonFastForwards`` takes it); origin with it (``d`` built again) gets a
+    force leased on the tip just fetched. A refused push raises, naming the branch and the
+    remedy."""
+    repo_spec, base, _slug = publish._resolve_target(d)
+    if not (repo_spec and base):
+        raise IntegrationError(f"{d.name} has no usable target (Repo + branch target), so "
+                               f"there is no base to build its own base on")
+    branch = bundle_base_branch(cfg, base, batch, d.name)
+    found = _fold_candidates(members)
+    targeted = {c[0] for c in found}
+    lost = [m.name for m in members if _has_patch(m) and m not in targeted]
+    if lost:
+        raise IntegrationError(
+            f"{', '.join(lost)} has a patch but no usable target (Repo + branch target), so "
+            f"none of its work can be part of {branch}: fix its brief, or leave it out of "
+            f"{d.name}'s members, then re-run")
+    refs: dict[str, tuple[str, str, bool]] = {}
+    mine: list[Path] = []
+    for m, m_repo, m_base, _s, ref in found:
+        if (m_repo, m_base) != (repo_spec, base):
+            raise IntegrationError(
+                f"{m.name} targets {m_repo} @ {m_base}, but {d.name} targets {repo_spec} @ "
+                f"{base}: one branch holds one target's work, so {m.name} cannot be part of "
+                f"{branch}")
+        if ref is None:
+            raise IntegrationError(
+                f"{m.name} accepted but not published (no publish.json branch) — there is "
+                f"nothing of it to put on {branch}; publish it, then re-run")
+        refs[m.name] = ref
+        mine.append(m)
+    base_remote = cfg.base_remote
+    base_ref = f"{base_remote}/{base}"
+    line = integration_branch(cfg, base, batch)   # where the run's folds recorded ``carried``
+    names = {_bundle_name(m.name) for m in members}
+    others = {_bundle_name(n): h for n, h in excluded.items() if _bundle_name(n) not in names}
+    took_by = {_bundle_name(n): h for n, h in carried.items()}
+    repo = publish._checkout_path(cfg, repo_spec)
+    with integ_lock(_integ_worktree(repo, base)) as locked:
+        if not locked:
+            raise IntegrationError(
+                f"could not take the integration lock next to "
+                f"{_integ_worktree(repo, base).name} — fix the checkout's parent "
+                f"directory (permissions?), then re-run")
+        wt = _prepare_worktree(repo, base_remote, base, remotes=[r[0] for r in refs.values()])
+        # Each member's tip, read once (#633): a carried one must still hold the recorded head.
+        heads: dict[str, str | None] = {m.name: _rev(wt, refs[m.name][1]) for m in mine}
+        for m in mine:
+            ref, tip, took = refs[m.name][1], heads[m.name], took_by.get(m.name)
+            facts = _carried_rewrite(wt, m.name, ref, took, tip, line) if tip and took else None
+            if facts is not None:
+                raise IntegrationError(
+                    f"{facts} Only commits that extend a carried branch reach a bundle's own "
+                    f"base: merging {tip[:12]} would put the old and the rewritten commits on "
+                    f"{branch} together. Nothing was merged or pushed. Restore {ref} to "
+                    f"{took[:12]} or a commit that contains it, then re-run")
+        unseen = [f"{n}'s published head {h[:12] if h else '(none given)'}"
+                  for n, h in sorted(others.items())
+                  if not (h and _git(wt, "cat-file", "-e", f"{h}^{{commit}}") == 0)]
+        if unseen:
+            raise IntegrationError(
+                f"cannot tell whether {branch} would hold work of a bundle {d.name} does not "
+                f"build on: {repo} does not have {' or '.join(unseen)}, even after fetching, "
+                f"and without a bundle's head its work cannot be told from a member's. "
+                f"Nothing was merged or pushed. Fetch each missing head into {repo} (from the "
+                f"remote its branch is published on), then re-run")
+        existing = _rev(wt, f"origin/{branch}")   # origin's copy, as just fetched
+        _reset_tree(wt, "HEAD")
+        if _git(wt, "checkout", "-B", branch, base_ref) != 0:
+            raise IntegrationError(f"could not start {branch} off {base_ref}")
+        owners = tuple(_owners(cfg, mine, batch).values())
+        merged_in: list[tuple[str, str]] = []   # (member name, head on the branch), in order
+        for m in mine:
+            head = heads[m.name]
+            try:
+                _merge_published(cfg, wt, m, refs[m.name], head, branch=branch, base=base,
+                                 owners=owners)
+            except _Conflict as exc:
+                raise _member_clash(wt, branch, base_ref, m.name, refs[m.name][1], head,
+                                    merged_in, exc) from exc
+            if head is not None:
+                merged_in.append((m.name, head))
+        tip = pushed_tip(wt)
+        recorded = [(n, h) for n, h in took_by.items() if n in refs and h
+                    and _git(wt, "cat-file", "-e", f"{h}^{{commit}}") == 0]
+        foreign = _foreign_work(wt, tip, base_ref, merged_in, recorded, others)
+        if foreign is not None:
+            name, commit, by = foreign
+            via = f"{by}'s branch {refs[by][1]}" if by else "a member's branch"
+            raise IntegrationError(
+                f"{branch} would hold {commit[:12]}, which is {name}'s work, and {name} is "
+                f"not one of the bundles {d.name} builds on: {via} brings it in (cut from, "
+                f"or updated from, a branch that holds it). Nothing was pushed. Rebuild that "
+                f"branch on {base_ref} without {name}'s work, or declare {d.name}'s "
+                f"dependency on {name}, then re-run")
+        push = (("push", "origin", branch) if existing is None else
+                ("push", f"--force-with-lease={branch}:{existing}", "origin", branch))
+        if _git(wt, *push) != 0:
+            why = (f"origin already has {branch} at {existing[:12]}, and building {d.name}'s "
+                   f"base again force-pushes over it: if origin refuses force-pushes, delete "
+                   f"{branch} there or allow force-pushes on pdca-integration/*; or another "
+                   f"run moved it since this build fetched it" if existing is not None else
+                   f"a plain push creating it was refused: check origin's rules for "
+                   f"pdca-integration/*")
+            raise IntegrationError(f"could not push {branch} to origin ({why}) — {d.name} "
+                                   f"cannot be built on it")
+    return branch, tip
+
+
+def _member_clash(wt: Path, branch: str, base_ref: str, name: str, ref: str,
+                  head: str | None, merged_in: Sequence[tuple[str, str]],
+                  exc: _Conflict) -> IntegrationError:
+    """The error for member ``name`` (branch ``ref`` at ``head``) not merging cleanly onto
+    the bundle base ``branch`` (#723). Its trial merges run on a detached HEAD under the
+    caller's lock and leave ``branch`` where it was (:func:`_trial`). A head that does not
+    merge onto ``base_ref`` alone clashes with the base itself: no bundle is to blame, the
+    branch needs rebuilding on the base. Else the members of ``merged_in`` (merged before
+    it, in order) that it clashes with, found as a fold finds a same-wave clash
+    (:func:`_held_by`, with the base as the line before them): each tried on its own after
+    the base; all of them when only their combination clashes. ``exc`` itself when there is
+    none to name, which a branch started from the base never meets: with no member merged,
+    it is the base."""
+    if head is None:
+        return exc
+    at, found = _trial(wt, branch, base_ref, [head])
+    if at is not None:
+        return IntegrationError(
+            f"{name}'s branch {ref} does not merge cleanly onto {base_ref} itself (conflicts "
+            f"in {', '.join(found)}): {base_ref} changed those files since {name}'s branch "
+            f"was cut, so {branch} cannot be built from {base_ref}. Rebuild {name}'s branch "
+            f"on the new {base_ref} (update it from {base_ref} and resolve the conflict), "
+            f"then re-run")
+    clash = _held_by(wt, branch, head, base_ref, merged_in) if merged_in else None
+    if clash is None:
+        return exc
+    partners, paths = clash
+    return IntegrationError(
+        f"{name}'s branch {ref} does not merge cleanly onto {branch} after "
+        f"{', '.join(partners)} (conflicts in {', '.join(paths)}) — an undeclared overlap "
+        f"between {name} and {', '.join(partners)}; declare the conflict / re-order, then "
+        f"re-run")
+
+
+def _foreign_work(wt: Path, tip: str, base_ref: str, members: Sequence[tuple[str, str]],
+                  recorded: Sequence[tuple[str, str]], excluded: Mapping[str, str]
+                  ) -> tuple[str, str, str | None] | None:
+    """Whether a bundle base built at ``tip`` holds work of a bundle outside its set (#723):
+    ``(excluded bundle, commit, member that brings it)`` for the first such commit, newest
+    first; None when there is none. ``members``: each member's name and the head merged;
+    ``recorded``: a member's name and the head a fold of the run recorded for it (#633);
+    ``excluded``: name → head, each one in the clone (the caller refuses a build with a
+    head it lacks).
+
+    :func:`foreign_commit`'s rule turned on the base: a non-merge commit on it is foreign
+    when neither ``base_ref`` nor any member's head reaches it, where a member's head
+    reaches a commit only along a path that does not pass through an excluded bundle's own
+    branch (:func:`_own_commits`, with those commits as the ones it does not pass). A
+    bundle's own branch is its first-parent chain, the commits it was built along: from
+    its head down to ``base_ref``, or down to the first commit on it that is another
+    bundle's head (a member's, merged or recorded, or another excluded one), since it was
+    cut from that bundle's branch there. The harness's own branches, every one under
+    ``pdca-integration/`` on origin (a run's line, a bundle base), are no bundle's: no
+    path passes through their first-parent chains, their fold merges, either.
+
+    So a member that holds an excluded bundle's branch (cut from it, or merging it) or a
+    harness branch that merged it brings that bundle's work, on its branch or merged into
+    it, and the build is refused, also once that work is off the bundle's own branch (a
+    merge made the other way round, base first). A commit a member reaches on its own, on
+    its branch or merged into it, is the member's, whoever else holds it. A bundle cut from
+    a harness branch holds the members on it only through its merges, so it never makes a
+    member's commits its own: however far the member moved on since, whatever the run
+    recorded for it, and whatever shape its history has (a topic merged in, an update from
+    the base, a merge made the other way round).
+
+    A foreign commit is refused when an excluded bundle reaches it from its head without
+    passing through what the members reach, another excluded bundle's own branch, or a
+    harness branch: it is named with the first such bundle, by name. One no excluded bundle
+    reaches that way is no work of theirs (a bundle the caller did not name, say) and is
+    not refused. The member named is the first whose head reaches the commit (None: none
+    does, which the merges of a base started from ``base_ref`` never leave).
+
+    Where git cannot tell, this refuses: an excluded branch cut from a member's branch at a
+    commit that is neither the member's head nor recorded for it holds that commit on its
+    own branch (the member could have been cut from it instead). One case gets through: an
+    excluded branch fast-forwarded onto the head of a member's branch that was cut from it
+    has its commits below that head counted as the member's. A git failure raises."""
+    since = ("--not", base_ref)
+    built = _out(wt, "rev-list", "--no-merges", "--topo-order", tip, *since,
+                 what=f"the commits on {tip[:12]}").split()
+    if not built or not excluded:
+        return None
+    heads = {h for _n, h in (*members, *recorded, *excluded.items())}
+    own: dict[str, set[str]] = {}       # each excluded bundle → its own branch (a fence)
+    for name, head in sorted(excluded.items()):
+        chain = _out(wt, "rev-list", "--first-parent", head, *since,
+                     what=f"the first-parent chain of {name}'s head {head[:12]}").split()
+        cut = next((i for i, c in enumerate(chain) if i and c in heads), len(chain))
+        own[name] = set(chain[:cut])
+    fenced = set().union(*own.values())
+    # The harness's own branches (integration_branch, bundle_base_branch) are no bundle's.
+    ours = _out(wt, "for-each-ref", "--format=%(objectname)",
+                "refs/remotes/origin/pdca-integration/",
+                what="the integration branches on origin").split()
+    lines = set(_out(wt, "rev-list", "--first-parent", *ours, *since,
+                     what="the first-parent chains of the integration branches").split()
+                ) if ours else set()
+    theirs = set().union(*(_own_commits(wt, h, since, fenced | lines, what=f"{n}'s commits")
+                           for n, h in members))
+    foreign = [c for c in built if c not in theirs]
+    if not foreign:
+        return None
+    work = {n: _own_commits(wt, h, since, theirs | lines | (fenced - own[n]),
+                            what=f"{n}'s work") for n, h in sorted(excluded.items())}
+    hit = next(((c, n) for c in foreign for n in work if c in work[n]), None)
+    if hit is None:
+        return None
+    commit, name = hit
+    by = next((n for n, h in members
+               if _in_line(wt, commit, commit[:12], f"{n}'s head", of=h)), None)
+    return name, commit, by
+
+
