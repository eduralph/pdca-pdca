@@ -0,0 +1,245 @@
+"""A bundle's own base: exactly the fetched base plus a chosen set of bundles (#723).
+
+``integrate.fold`` could only fold onto the run's one line per target: it names its
+destination itself (``integration_branch``) and every accepted bundle of the target lands
+there. #463's dependency-scoped bases need a branch holding exactly the bundles one bundle
+builds on. These cases pin ``integrate.build_bundle_base``: what the branch holds, its name,
+how it is pushed, and that every safeguard of the run's fold applies to it, plus two more —
+a rewritten carried member (#633) and work of a bundle outside the set brought in by a
+member — each refused before anything is pushed.
+
+Real git: the ``StackFoldGit`` fixture of tests/test_integrate_stack_bases.py (a bare
+``origin``, a primary checkout and a ``human`` clone), loaded by path and used as a helper
+object, as tests/test_integrate_revert_via_branch.py does — never subclassed, which would
+re-run that suite's tests here. Only modules are imported, and the new entry points are
+reached inside each test body, so with the production change reverted these cases still
+load and run — and fail.
+    cd template && PYTHONPATH=src python3 -m unittest tests.test_integrate_bundle_base
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import io
+import unittest
+from contextlib import redirect_stderr
+from pathlib import Path
+
+from pdca_harness import integrate
+
+_SPEC = importlib.util.spec_from_file_location(
+    "stack_bases_fixture", Path(__file__).with_name("test_integrate_stack_bases.py"))
+sb = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(sb)
+
+BATCH = ["A", "B", "C", "D", "P", "X", "Y", "Z", "12"]
+
+
+class BundleBase(unittest.TestCase):
+
+    def setUp(self) -> None:
+        self.fx = sb.StackFoldGit()          # the fixture's real-git setUp/tearDown and helpers
+        self.fx.setUp()
+        self.addCleanup(self.fx.tearDown)
+        self.cfg = self.fx.cfg
+        self.line = integrate.integration_branch(self.cfg, "main", BATCH)
+
+    # -- helpers -------------------------------------------------------------------------
+
+    def _build(self, d: Path, members: list[Path], *, carried=None, excluded=None):
+        """``integrate.build_bundle_base`` — looked up here, so a tree without it fails
+        this case, not the module's import."""
+        return integrate.build_bundle_base(self.cfg, d, members, batch=BATCH,
+                                           carried=carried or {}, excluded=excluded or {})
+
+    def _publish2(self, iid: str, first: dict[str, str], second: dict[str, str], *,
+                  cut_from: str = "origin/main") -> Path:
+        """Publish ``fix/<iid>`` with TWO commits: ``first``, then ``second`` on top."""
+        d = self.fx._publish(iid, first, cut_from=cut_from)
+        self.fx._push_from_human(second, to=f"fix/{iid}", off=f"origin/fix/{iid}")
+        return d
+
+    def _dest(self, iid: str) -> Path:
+        """A bundle that will be built on the base (it needs only its brief's target)."""
+        d = self.cfg.bundle(iid)
+        sb._brief(d)
+        return d
+
+    def _commits(self, rng: str) -> list[str]:
+        return sb._git(self.fx.origin, "rev-list", rng).split()
+
+    def _wave0(self) -> tuple[Path, Path, str]:
+        """Wave 0 = A, Z (unrelated, two commits each on their own files), folded onto the
+        run's line. Returns (A, Z, the line tip)."""
+        a = self._publish2("A", {"a1.txt": "a1\n"}, {"a2.txt": "a2\n"})
+        z = self._publish2("Z", {"z1.txt": "z1\n"}, {"z2.txt": "z2\n"})
+        integrate.fold(self.cfg, [a, z], batch=BATCH, folded_this_run={})
+        return a, z, self.fx._tip(self.line)
+
+    # -- (1) exact contents ----------------------------------------------------------------
+
+    def test_a_bundle_base_holds_its_members_and_nothing_else(self) -> None:
+        a, _z, line_tip = self._wave0()
+        b = self._dest("B")
+        branch, tip = self._build(b, [a])
+        self.assertTrue(self.fx._has(branch), "the base was not pushed to origin")
+        self.assertEqual(self.fx._tip(branch), tip)
+        a_commits = self._commits("refs/heads/main..refs/heads/fix/A")
+        z_commits = self._commits("refs/heads/main..refs/heads/fix/Z")
+        self.assertEqual(len(a_commits), 2)
+        self.assertEqual(len(z_commits), 2)
+        for c in a_commits:
+            self.assertTrue(self.fx._ancestor(c, tip), f"A's {c} is missing")
+        for c in z_commits:
+            self.assertFalse(self.fx._ancestor(c, tip), f"Z's {c} leaked in")
+        main = self.fx._tip("main")
+        self.assertEqual(sb._git(self.fx.origin, "rev-parse", f"{tip}^1").strip(), main,
+                         "the base does not start from origin/main as fetched")
+        self.assertEqual(self.fx._tip(self.line), line_tip, "the run's line moved")
+
+    # -- (2) name ----------------------------------------------------------------------------
+
+    def test_the_name_is_the_line_plus_b_and_the_flattened_id(self) -> None:
+        a, _z, _t = self._wave0()
+        b = self._dest("12")
+        key = integrate.batch_key(BATCH)
+        expect = f"pdca-integration/main-r{key}-b12"
+        branch, _tip = self._build(b, [a])
+        self.assertEqual(branch, expect)
+        self.assertEqual(branch, self.line + "-b12")
+        self.assertNotIn("/", branch.removeprefix("pdca-integration/"))
+        self.assertTrue(self.fx._has(expect))
+        names = {integrate.bundle_base_branch(self.cfg, "main", BATCH, i)
+                 for i in ("12", "1-2", "1/2")}
+        self.assertEqual(len(names), 3, names)
+        self.assertEqual(integrate.bundle_base_branch(self.cfg, "main", BATCH, "issue_12"),
+                         expect)
+        for n in names:
+            self.assertNotIn("/", n.removeprefix("pdca-integration/"))
+
+    # -- (3) push rule -----------------------------------------------------------------------
+
+    def test_creating_pushes_without_force_and_rebuilding_forces(self) -> None:
+        a, _z, _t = self._wave0()
+        b = self._dest("B")
+        first = self.fx._pushes(lambda: self._build(b, [a]))
+        self.assertEqual(len(first), 1, first)
+        self.assertEqual([x for x in first[0] if x.startswith("--force")], [], first[0])
+        self.assertEqual([x for x in first[0] if x.startswith("+")], [], first[0])
+        again = self.fx._pushes(lambda: self._build(b, [a]))
+        self.assertEqual(len(again), 1, again)
+        self.assertTrue([x for x in again[0] if x.startswith("--force")], again[0])
+
+    def test_a_refused_force_push_names_the_branch_and_the_remedy(self) -> None:
+        a, _z, _t = self._wave0()
+        b = self._dest("B")
+        name = f"{self.line}-bB"
+        stale = self.fx._push_from_human({"stale.txt": "s\n"}, to=name)
+        sb._git(self.fx.origin, "config", "receive.denyNonFastForwards", "true")
+        with self.assertRaises(integrate.IntegrationError) as ctx:
+            self._build(b, [a])
+        msg = str(ctx.exception)
+        for part in (name, "delete", "pdca-integration/*"):
+            self.assertIn(part, msg)
+        self.assertEqual(self.fx._tip(name), stale)
+
+    # -- (4) every fold safeguard ------------------------------------------------------------
+
+    def test_two_members_that_clash_are_both_named(self) -> None:
+        a = self.fx._publish("A", {"c.txt": "from a\n"})
+        y = self.fx._publish("Y", {"c.txt": "from y\n"})
+        d = self._dest("D")
+        with self.assertRaises(integrate.IntegrationError) as ctx:
+            self._build(d, [a, y])
+        msg = str(ctx.exception)
+        for part in ("issue_Y", "issue_A", "c.txt"):
+            self.assertIn(part, msg)
+        self.assertFalse(self.fx._has(f"{self.line}-bD"), "a clashing base was pushed")
+
+    def test_a_clash_with_the_base_says_rebuild_not_reorder(self) -> None:
+        a = self.fx._publish("A", {"base.txt": "a's base\n"})
+        self.fx._push_from_human({"base.txt": "main moved\n"}, to="main")
+        b = self._dest("B")
+        with self.assertRaises(integrate.IntegrationError) as ctx:
+            self._build(b, [a])
+        msg = str(ctx.exception)
+        for part in ("origin/main", "issue_A", "base.txt", "Rebuild"):
+            self.assertIn(part, msg)
+        self.assertNotIn("declare the conflict", msg)
+        self.assertNotIn("re-order", msg)
+        self.assertFalse(self.fx._has(f"{self.line}-bB"))
+
+    def test_a_gone_member_not_known_merged_stops_the_build(self) -> None:
+        a = self.fx._publish("A", {"a.txt": "a\n"})
+        self.fx._delete("fix/A")
+        b = self._dest("B")
+        with sb._merged_heads({}), self.assertRaises(integrate.IntegrationError) as ctx:
+            self._build(b, [a])
+        self.assertIn("issue_A's published branch origin/fix/A does not resolve",
+                      str(ctx.exception))
+        self.assertFalse(self.fx._has(f"{self.line}-bB"))
+
+    def test_a_revert_on_the_base_is_judged_as_the_runs_fresh_fold_judges_it(self) -> None:
+        # #623 / #673's check runs on every member merge (the shared `_merge_published`).
+        # A base built fresh from the fetched base already holds any revert there, below the
+        # cut point (the accepted limit #673 documents), so the build and the run's fresh
+        # fold of the same members must agree: same outcome, same content.
+        a = self.fx._publish("A", {"a.txt": "a\n"})
+        self.fx._merge_pr("A")
+        self.fx._revert_on_main("-m", "1", "HEAD")
+        b = self.fx._publish("B", {"b.txt": "b\n"})        # cut from the reverted main
+        d = self._dest("D")
+        with redirect_stderr(io.StringIO()):
+            _branch, tip = self._build(d, [a, b])
+            integrate.fold(self.cfg, [a, b], batch=BATCH, folded_this_run={})
+        line = self.fx._tip(self.line)
+        for path in ("a.txt", "b.txt"):
+            on_line = sb._run(self.fx.origin, "cat-file", "-e", f"{line}:{path}").returncode
+            on_base = sb._run(self.fx.origin, "cat-file", "-e", f"{tip}:{path}").returncode
+            self.assertEqual(on_base, on_line, path)
