+def bundle_base_branch(cfg: Config, base: str, batch: Iterable[str] | None, name: str) -> str:
+    """The branch :func:`build_bundle_base` builds for bundle ``name`` of a run (#723): the
+    run's line for ``base`` (:func:`integration_branch`, scoped to ``batch``), then ``-b``
+    and the bundle's id (``issue_`` dropped), flattened as the base is
+    (:func:`_flatten_base`). ``-b`` never appears in a flattened base or id (each ``-`` there
+    is ``-h`` or ``-s``) nor in a batch key (hex), so the first ``-b`` ends the line's part
+    and the name decodes to one (base, batch, bundle). A flattened id has no ``/``, so the
+    name is one segment under ``pdca-integration/``: never a ref-path prefix of the line or
+    of another bundle's base, nor under one (git refuses a branch ``x`` beside ``x/y``)."""
+    iid = str(name).removeprefix("issue_")
+    return f"{integration_branch(cfg, base, batch)}-b{_flatten_base(iid)}"
+
