+def _owners(cfg: Config, bundles: Iterable[Path],
+            batch: Collection[str] | None) -> dict[str, Path]:
+    """Who a path the base, or a branch, would undo belongs to (#623, #673): ``bundles``
+    (the ones being folded), then the rest of the run's ``batch`` (folded earlier, absent
+    from this call), found by id as the flow finds them — an archived one too
+    (``find_bundle``) — and each listed once, by name. Shared by :func:`fold` and
+    :func:`build_bundle_base`."""
+    owners: dict[str, Path] = {}
+    for o in [*bundles, *(cfg.find_bundle(str(n).removeprefix("issue_"))
+                          for n in batch or ())]:
+        owners.setdefault(o.name, o)
+    return owners
