+def build_bundle_base(cfg: Config, d: Path, members: Sequence[Path], *,
+                      batch: Collection[str] | None, carried: Mapping[str, str],
+                      excluded: Mapping[str, str]) -> tuple[str, str]:
+    """Build bundle ``d``'s own base (#723, for #463's dependency-scoped bases): a branch
+    on ``origin`` holding exactly the fetched ``<base_remote>/<base>`` plus the published
+    branches of ``members`` (bundle paths, merged in that order), and nothing else of the
+    run. Returns ``(branch, pushed tip)``. The branch is :func:`bundle_base_branch` for
+    ``d``'s target; the run's line, and whatever the caller recorded for it, are never
+    read or written.
+
+    A sibling of :func:`fold`, sharing its merge path (:func:`_merge_published`, so
+    :func:`_gone_branch`, :func:`_take_in_base` and the #623/#673 revert check), its
+    per-target lock (:func:`integ_lock`) and worktree (:func:`_prepare_worktree`), and its
+    tree reset (:func:`_reset_tree`). It always starts fresh from the base as just fetched.
+    A member with no patch adds nothing (as in a fold); one on another target than ``d``,
+    or with no published branch, raises before any git step.
+
+    Refused with :class:`IntegrationError`, before anything is pushed:
+
+    * ``carried`` (member name → the head a fold of this run recorded for it, #633): a
+      member whose branch no longer holds that head was rewritten (:func:`_carried_tips`).
+    * A member that does not merge cleanly. When it does not merge onto the fetched base
+      alone, the clash is with the base: the message names ``<remote>/<base>`` and says to
+      rebuild the member's branch on it. Otherwise it names the members merged before it
+      that it clashes with (each tried on its own, as :func:`_held_by` does; all of them
+      when only their combination clashes).
+    * ``excluded`` (name → published head of each bundle of the run that is NOT a member):
+      the result would hold work of one of them (:func:`_foreign_work`). Named with the
+      member that brought it in.
+
+    Push: origin without the branch gets a plain push (no force, so an origin with
+    ``receive.denyNonFastForwards`` takes it); origin with it (``d`` built again) gets a
+    force leased on the tip just fetched. A refused push raises, naming the branch and the
+    remedy."""
+    repo_spec, base, _slug = publish._resolve_target(d)
+    if not (repo_spec and base):
+        raise IntegrationError(f"{d.name} has no usable target (Repo + branch target), so "
+                               f"there is no base to build its own base on")
+    branch = bundle_base_branch(cfg, base, batch, d.name)
+    refs: dict[str, tuple[str, str, bool]] = {}
+    mine: list[Path] = []
+    for m, m_repo, m_base, _s, ref in _fold_candidates(members):
+        if (m_repo, m_base) != (repo_spec, base):
+            raise IntegrationError(
+                f"{m.name} targets {m_repo} @ {m_base}, but {d.name} targets {repo_spec} @ "
+                f"{base}: one branch holds one target's work, so {m.name} cannot be part of "
+                f"{branch}")
+        if ref is None:
+            raise IntegrationError(
+                f"{m.name} accepted but not published (no publish.json branch) — there is "
+                f"nothing of it to put on {branch}; publish it, then re-run")
+        refs[m.name] = ref
+        mine.append(m)
+    base_remote = cfg.base_remote
+    base_ref = f"{base_remote}/{base}"
+    group = {(repo_spec, base): mine}
+    held = {n: h for n, h in carried.items() if n in refs}
+    checked = _carried_tips(cfg, group, refs, held, batch) if held else {}
+    repo = publish._checkout_path(cfg, repo_spec)
+    with integ_lock(_integ_worktree(repo, base)) as locked:
+        if not locked:
+            raise IntegrationError(
+                f"could not take the integration lock next to "
+                f"{_integ_worktree(repo, base).name} — fix the checkout's parent "
+                f"directory (permissions?), then re-run")
+        wt = _prepare_worktree(repo, base_remote, base, remotes=[r[0] for r in refs.values()])
+        existing = _rev(wt, f"origin/{branch}")   # origin's copy, as just fetched
+        _reset_tree(wt, "HEAD")
+        if _git(wt, "checkout", "-B", branch, base_ref) != 0:
+            raise IntegrationError(f"could not start {branch} off {base_ref}")
+        owners = tuple(_owners(cfg, mine, batch).values())
+        took: list[tuple[str, str]] = []   # (member name, head on the branch), merge order
+        for m in mine:
+            head = checked[m.name] if m.name in checked else _rev(wt, refs[m.name][1])
+            try:
+                _merge_published(cfg, wt, m, refs[m.name], head, branch=branch, base=base,
+                                 owners=owners)
+            except _Conflict as exc:
+                raise _member_clash(wt, branch, base_ref, m.name, refs[m.name][1], head,
+                                    took, exc) from exc
+            if head is not None:
+                took.append((m.name, head))
+        tip = pushed_tip(wt)
+        foreign = _foreign_work(wt, tip, base_ref, took, excluded)
+        if foreign is not None:
+            name, commit, by = foreign
+            raise IntegrationError(
+                f"{branch} would hold {commit[:12]}, which is {name}'s work, and {name} is "
+                f"not one of the bundles {d.name} builds on: {by}'s branch "
+                f"{refs[by][1] if by in refs else ''} brings it in (cut from, or updated "
+                f"from, a branch that holds it). Nothing was pushed. Rebuild {by}'s branch "
+                f"on {base_ref} without {name}'s work, or declare {d.name}'s dependency on "
+                f"{name}, then re-run")
+        push = (("push", "origin", branch) if existing is None else
+                ("push", f"--force-with-lease={branch}:{existing}", "origin", branch))
+        if _git(wt, *push) != 0:
+            why = (f"origin already has {branch} at {existing[:12]}, and building {d.name}'s "
+                   f"base again force-pushes over it: if origin refuses force-pushes, delete "
+                   f"{branch} there or allow force-pushes on pdca-integration/*; or another "
+                   f"run moved it since this build fetched it" if existing is not None else
+                   f"a plain push creating it was refused: check origin's rules for "
+                   f"pdca-integration/*")
+            raise IntegrationError(f"could not push {branch} to origin ({why}) — {d.name} "
+                                   f"cannot be built on it")
+    return branch, tip
+
+
+def _member_clash(wt: Path, branch: str, base_ref: str, name: str, ref: str,
+                  head: str | None, took: Sequence[tuple[str, str]],
+                  exc: _Conflict) -> IntegrationError:
+    """The error for member ``name`` (branch ``ref`` at ``head``) not merging cleanly onto
+    the bundle base ``branch`` (#723). Its trial merges run on a detached HEAD under the
+    caller's lock and leave ``branch`` where it was (:func:`_trial`). A head that does not
+    merge onto ``base_ref`` alone clashes with the base itself: no bundle is to blame, the
+    branch needs rebuilding on the base. Else the members of ``took`` merged before it that
+    it clashes with, each tried on its own after the base; all of them when only their
+    combination clashes."""
+    files = ", ".join(exc.paths)
+    if head is None:
+        return exc
+    at, found = _trial(wt, branch, base_ref, [head])
+    if at is not None:
+        return IntegrationError(
+            f"{name}'s branch {ref} does not merge cleanly onto {base_ref} itself (conflicts "
+            f"in {', '.join(found)}): {base_ref} changed those files since {name}'s branch "
+            f"was cut, so {branch} cannot be built from {base_ref}. Rebuild {name}'s branch "
+            f"on the new {base_ref} (update it from {base_ref} and resolve the conflict), "
+            f"then re-run")
+    partners = [n for n, its in took if _trial(wt, branch, base_ref, [its, head])[0] == 1]
+    partners = partners or [n for n, _its in took]
+    if not partners:
+        return exc
+    return IntegrationError(
+        f"{name}'s branch {ref} does not merge cleanly onto {branch} after "
+        f"{', '.join(partners)} (conflicts in {files}) — an undeclared overlap between "
+        f"{name} and {', '.join(partners)}; declare the conflict / re-order, then re-run")
+
+
+def _foreign_work(wt: Path, tip: str, base_ref: str, members: Sequence[tuple[str, str]],
+                  excluded: Mapping[str, str]) -> tuple[str, str, str] | None:
+    """Whether a bundle base built at ``tip`` holds work of a bundle outside its set (#723):
+    ``(excluded bundle, commit, member that brings it)`` for the first such commit, None
+    when there is none.
+
+    An excluded bundle's work is :func:`foreign_commit`'s rule turned round: the non-merge
+    commits reachable from its head (``excluded[name]``) and from neither ``base_ref`` nor
+    the head of any other bundle (member or excluded) that its own head holds — one cut
+    from the run's line, say, holds the members already on it, and their commits are theirs,
+    not its. A commit two heads share while neither holds the other counts for both (git
+    cannot tell which branch made it), so it is refused, never let through. A head this
+    clone does not have adds nothing. A git failure raises."""
+    names = {n for n, _h in members}
+    present = {n: h for n, h in excluded.items() if n not in names and h
+               and _git(wt, "cat-file", "-e", f"{h}^{{commit}}") == 0}
+    if not present:
+        return None
+    built = set(_out(wt, "rev-list", "--no-merges", tip, "--not", base_ref,
+                     what=f"the commits on {tip[:12]}").split())
+    if not built:
+        return None
+    heads = {**dict(members), **present}
+    for name, head in sorted(present.items()):
+        under = [h for n, h in heads.items() if n != name and h != head
+                 and _in_line(wt, h, f"{n}'s head {h[:12]}", f"{name}'s head", of=head)]
+        work = _out(wt, "rev-list", "--no-merges", head, "--not", base_ref, *under,
+                    what=f"{name}'s work").split()
+        hit = next((c for c in work if c in built), None)
+        if hit is None:
+            continue
+        by = next((n for n, h in members
+                   if _in_line(wt, hit, hit[:12], f"{n}'s head", of=h)), None)
+        return name, hit, by or ", ".join(n for n, _h in members)
+    return None
+
+
 def _carried_tips(cfg: Config, groups: Mapping[tuple[str, str], list[Path]],
                   refs: Mapping[str, tuple[str, str, bool]], carried: Mapping[str, str],
                   batch: Collection[str] | None) -> dict[str, str | None]:
