+def _brief_sha(d: Path) -> str:
+    """sha256 of ``d``'s ``brief.md`` bytes, ``""`` if absent — mirrors
+    ``leaves._brief_sha`` (`leaves.py:3250-3253`) without importing it: this module is
+    kept import-light for the hook (see the module docstring, and `:120`, `:392`)."""
+    bp = d / "brief.md"
+    return hashlib.sha256(bp.read_bytes()).hexdigest() if bp.is_file() else ""
+
+
+def _changed_plan_briefs(cfg: Config, baseline: dict) -> list[Path]:
+    """Every bundle under ``cfg.bundle_root`` whose ``brief.md`` this session created or
+    rewrote, against the pre-session snapshot :func:`session` captured for a planner
+    session that registered no bundle set (the CSV/default batch Plan path, issue #549).
+
+    "Created or changed" mirrors ``leaves._fresh_plan_briefs``'s "new or rewritten" rule
+    (`leaves.py:3652-3669`; matched, not imported — see :func:`_brief_sha`): a bundle
+    whose brief is byte-identical to what it was at session start is not this session's
+    work and is excluded, even if malformed.
+    """
+    before = baseline.get("brief_shas") if isinstance(baseline, dict) else None
+    before = before if isinstance(before, dict) else {}
+    out = []
+    for d in sorted(cfg.bundle_root.glob("issue_*")):
+        sha = _brief_sha(d)
+        if sha and (d.name not in before or before[d.name] != sha):
+            out.append(d)
+    return out
+
