+    # --- issue #549: the CSV/default batch planner re-reads what it wrote ----------
+    def test_csv_batch_reports_a_brief_it_wrote_after_a_handoff_for_another_id(
+            self) -> None:
+        # Criterion (i): the driver registers NO bundle set for a CSV/default batch
+        # Plan (`seeded = []`, `leaves.py:1197`). A `/handoff` passed for issue_7 must
+        # not stand in for issue_8's brief, written by the same session with an empty
+        # Success criterion.
+        def during(env: dict) -> None:
+            handoff.record_pass(Path(env[handoff.ENV_STATE]), "issue_7")
+            (self.bundle("7") / "brief.md").write_text(_AUTHORED_BRIEF,
+                                                        encoding="utf-8")
+            (self.bundle("8") / "brief.md").write_text(_brief_text(criterion=""),
+                                                        encoding="utf-8")
+
+        err = self.reap("planner", None, during=during)
+        self.assertIn("issue_8: brief.md field 'success criterion' is empty", err)
+        self.assertNotIn("issue_7:", err)
+
+    def test_csv_batch_does_not_reread_a_brief_that_predates_the_session(self) -> None:
+        # Criterion (ii): a brief that existed before the session and is
+        # byte-unchanged is not this session's work — not re-read, even malformed.
+        d = self.bundle("8")
+        (d / "brief.md").write_text(_brief_text(criterion=""), encoding="utf-8")
+        err = self.reap("planner", None)
+        self.assertNotIn("issue_8", err)
+        self.assertIn("the planner session registered no bundle set at spawn", err)
+
+    def test_csv_batch_that_changed_no_brief_keeps_todays_behavior(self) -> None:
+        # Criterion (iii), the no-change case: a pre-existing, unchanged brief behaves
+        # exactly as before the fix — a passed /handoff reports nothing about the
+        # session, and no pass keeps the existing "registered no bundle set" item.
+        d = self.bundle("8")
+        (d / "brief.md").write_text(_AUTHORED_BRIEF, encoding="utf-8")
+
+        def named_its_work(env: dict) -> None:
+            handoff.record_pass(Path(env[handoff.ENV_STATE]), "issue_8")
+
+        self.assertEqual(self.reap("planner", None, during=named_its_work), "")
+        err = self.reap("planner", None)
+        self.assertIn("the planner session registered no bundle set at spawn", err)
+        self.assertNotIn("issue_8", err)
+
+    def test_csv_batch_briefs_that_all_pass_report_nothing_even_without_a_handoff(
+            self) -> None:
+        # Criterion (iv): briefs this session created or changed that all pass
+        # check_planner report nothing, and no "verified none" item is added either,
+        # even though no `/handoff` ran.
+        def during(env: dict) -> None:
+            (self.bundle("7") / "brief.md").write_text(_AUTHORED_BRIEF,
+                                                        encoding="utf-8")
+
+        self.assertEqual(self.reap("planner", None, during=during), "")
+
 
