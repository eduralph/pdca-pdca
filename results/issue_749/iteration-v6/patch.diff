+def _where(partners: Collection[str], k: int | None = None, wave: Collection[str] = (),
+           finished: Collection[str] = (), *, branches: bool = False) -> str:
+    """``partners``, held bundle's partners, each said where it is (#747): one of ``wave``,
+    merged before it in the same wave ``k`` (#674); or already on the line, from an earlier
+    wave, or a finished id the carry put there (``finished``). With no ``k`` (#749: a
+    report at the end of the run, or a ``Conflicts with`` partner's line), just already on
+    the line. Named as whose change (``issue_A's``), or with ``branches`` as whose branch
+    (:func:`_branches`)."""
+    form = _branches if branches else _conflict_partners
+    if k is None:
+        return f"{form(partners)}, already on the line"
+    groups = ((f"merged before it in the same wave {k}", [p for p in partners if p in wave]),
+              ("already on the line from an earlier wave",
+               [p for p in partners if p not in wave and p not in finished]),
+              ("already on the line, finished in an earlier run",
+               [p for p in partners if p not in wave and p in finished]))
+    return ", and ".join(f"{form(ps)}, {where}" for where, ps in groups if ps)
+
+
+def _moved_hold(name: str, move: integrate.BaseMove, k: int | None = None,
+                wave: Collection[str] = (), finished: Collection[str] = ()
+                ) -> tuple[str, str, str]:
+    """``(what, fix, wait)`` for bundle ``name``, held out of the line because the base moved
+    under it (#749, :class:`integrate.BaseMove`): what it clashes with, a clause; the step,
+    for whoever can act; and what a bundle tied to it by a ``Conflicts with`` edge waits for
+    (:func:`_runnable`). Its partners are said where they are as :func:`_where` says it
+    (``k``, ``wave``, ``finished``).
+
+    * ``past``: ``name``'s branch holds a base the base has since moved on from, so the step
+      is its own: update that branch from the base.
+    * ``stranded``: the partners' branches no longer merge onto the base ``name``'s branch
+      holds (an older one, maybe, than the base now), nor onto the base now. Their owners
+      rebuild them on the new base; ``name``'s change is not blamed, and it gets no step
+      for that. With ``own``, ``name``'s own change also conflicts with those: said so, and
+      its step for them is an ordinary hold's (:func:`_overlap_step`)."""
+    base = move.base
+    if move.past:
+        do = "does" if len(move.past) == 1 else "do"
+        return (f"{_where(move.past, k, wave, finished, branches=True)}, {do} not merge cleanly "
+                f"onto the {base} {name}'s branch holds, but {do} onto {base} as it is now: "
+                f"{base} has moved on since {name}'s branch was built",
+                f"update {name}'s branch from {base}",
+                f"{name}'s branch is updated from {base}")
+    ps = move.stranded
+    one = len(ps) == 1
+    what = (f"{_where(ps, k, wave, finished, branches=True)}, {'does' if one else 'do'} not "
+            f"merge cleanly onto the {base} {name}'s branch holds: {base} moved since "
+            f"{'it was' if one else 'they were'} cut")
+    wait = f"{_branches(ps)} {'is' if one else 'are'} rebuilt on the new {base}"
+    if move.own:
+        what += (f"; and {name}'s own change also conflicts with "
+                 f"{_where(move.own, k, wave, finished)}")
+        # No "and": _runnable adds ", and <name>'s PR merges", the list's last item.
+        wait += f", {name} is rebuilt on a base that holds {', '.join(move.own)}"
+    else:
+        what += f", and {name}'s own change does not clash with {'it' if one else 'them'}"
+    return what, f"rebuild {_branches(ps)} on the new {base}", wait
+
