+        self._plan("Q", {"q.txt": "q\n"})
+        self._plan("R", {"r.txt": "r\n"})
+        self._plan("W", {"w.txt": "w\n"})
+        self._plan("S", {"s.txt": "s\n"}, stacks_on="R")
+        self._plan("V", {"v.txt": "v\n"}, depends_on="W")
