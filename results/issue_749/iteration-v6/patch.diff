+        self._plan("T", {"t.txt": "t\n"}, depends_on="S")
+        self._plan("U", {"u.txt": "u\n"}, depends_on="V")
+        ids = ["A", "Q", "R", "W", "S", "V", "Y", "T", "U"]
+        if with_x:
