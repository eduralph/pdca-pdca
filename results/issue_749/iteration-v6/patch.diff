+    def _diff3(self, onto: str, iid: str, path: str = "shared.txt") -> str:
+        """``path`` as git leaves it, in its diff3 conflict style, merging ``iid``'s branch
+        onto ``onto`` — a fact of the fixture, tried in the scratch clone."""
