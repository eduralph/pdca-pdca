+        sb._git(human, "checkout", "-q", "-B", "rebuilt", f"origin/fix/{on}")
+        sb._git(human, "merge", "-q", "--no-ff", "--no-edit", "-X", "theirs",
+                f"origin/fix/{iid}")
+        sb._git(human, "push", "-q", "origin", f"HEAD:refs/heads/fix/{name}")
+        sb._git(human, "checkout", "-q", "--detach", "origin/main")
+        return name
