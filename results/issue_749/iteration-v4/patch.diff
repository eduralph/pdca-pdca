+        # is neither their own change nor A's owner's to fix: each is told to update its
+        # branch from origin/main, and none to declare `Conflicts with: A`. Before:
+        # STOPPING on V.
+        self._undone_run(with_x=False)
+
+        self._not_stopped()
+        for iid in ("V", "Y"):
