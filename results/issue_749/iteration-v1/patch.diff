+def _edit(text: str, **lines: str) -> str:
+    """``text`` with line ``n`` (``l<n>=...``) replaced."""
+    out = text.splitlines(keepends=True)
+    for key, new in lines.items():
+        out[int(key.removeprefix("l")) - 1] = new + "\n"
+    return "".join(out)
+
