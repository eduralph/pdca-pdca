+def _verdict_column(lines: list[str], i: int) -> int | None:
+    """The index of the `Verdict` column of the ``|``-table holding line ``i``, read off that
+    table's header (its first row), or None when the header names no such column (#408).
+
+    Taken from the header rather than assumed to be the mandated table's second column, so a
+    reviewer who orders the columns differently is still read by its own Verdict column — a
+    fixed index would read a reordered table's Basis as the verdict and miss the real one.
+    """
+    while i > 0 and lines[i - 1].strip().startswith("|"):
+        i -= 1
+    header = [c.strip().strip("*_`").strip().casefold()
+              for c in lines[i].strip().strip("|").split("|")]
+    return header.index("verdict") if "verdict" in header else None
