+def _cascade_not_clean(cfg: Config, ids: list[Path],
+                       why: dict[str, tuple[str, str]]) -> dict[str, str]:
+    """Spread "not clean" along plain ``Depends on`` edges between the finished ``ids``
+    (#652): a finished id whose brief names a not-clean one (in ``why``) is built on it —
+    its branch carries that work — so it is not clean either, through any number of
+    finished ids. Each id so marked goes into ``why`` with the ``built_on`` hint; returns
+    name → the not-clean id it names (its cause)."""
+    names = {d.name for d in ids}
+    edges: dict[str, list[str]] = {}
+    for d in ids:
+        bp = d / "brief.md"
+        edges[d.name] = [n for n in (cfg.bundle(dep).name for dep in
+                                     (brief.depends_on(bp) if bp.exists() else []))
+                         if n in names]
+    causes: dict[str, str] = {}
+    grew = True
+    while grew:                             # to a fixed point: a chain of any length
+        grew = False
+        for d in ids:
+            cause = next((n for n in edges[d.name] if n in why), None)
+            if d.name not in why and cause:
+                why[d.name] = (f"it was built on {cause} (its `Depends on`), which is not "
+                               f"carried", "built_on")
+                causes[d.name] = cause
+                grew = True
+    return causes
+
