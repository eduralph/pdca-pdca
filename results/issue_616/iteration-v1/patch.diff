+def _prereqs_to_carry(cfg: Config, bundles: list[Path], batch_names: set[str], *,
+                      dry: bool) -> tuple[list[Path], dict[str, list[str]]]:
+    """The earlier runs' prerequisites a stack-mode run must carry on its integration line
+    before wave 0, and those it cannot carry (#616).
+
+    A prerequisite outside the batch is COMPLETE, which means only that its draft PR was
+    opened: until that PR merges its work is in no base, and only the line can carry it. So
+    for every bundle of the drive set, each such prerequisite — a ``Depends on`` / ``Stacks
+    on`` edge; a ``Depends on (merged)`` one keeps its #186 gate in :func:`_runnable` and
+    waits for the merge instead — that is COMPLETE, that the fold would carry (a patch and
+    a usable target: :func:`integrate._fold_candidates`, the fold's own definition) and
+    whose PR is not merged (``merged.is_merged``, asked as :func:`_runnable` asks it) is
+    either
+
+    * **carried** (the first value, in name order) — it has a published branch on record,
+      which the pre-wave fold merges onto the line, as the in-run fold does (#593); or
+    * **held** (the second, prerequisite name → the drive-set bundles that depend on it) —
+      it has none (:func:`integrate.unpublished`), so there is nothing of it to fold, and
+      its dependents must not build. Never in a dry-run, which pushes nothing and plans an
+      unpublished bundle as its would-be branch, as the in-run hold does.
+
+    A merged prerequisite, or one with no patch or no target, is neither: its work (or its
+    lack of one) is already the base. Nor is one of another ``(repo, base)`` target than its
+    dependent's: a line is per target (#187), so none could carry it into that base — the
+    dependent builds as it always has. Each prerequisite is judged once, however many
+    bundles depend on it. A prerequisite's own prerequisites need no walk of their own: its
+    branch was cut from the line it was built on, so it carries them."""
+    def target(b: Path) -> tuple[str, str]:
+        # A COMPLETE bundle may have no brief.md left (#481): it names no target then.
+        return publish._resolve_target(b)[:2] if (b / "brief.md").exists() else ("", "")
+
+    verdict: dict[str, str] = {}
+    carried: list[Path] = []
+    held: dict[str, list[str]] = {}
+    for d in bundles:
+        bp = d / "brief.md"
+        own = target(d)
+        if not all(own):
+            continue  # no target: nothing published, nothing to stack
+        merged_deps = set(brief.depends_on_merged(bp))
+        for dep in waves.declared_deps(bp):
+            name = cfg.bundle(dep).name
+            if name in batch_names or dep in merged_deps:
+                continue
+            p = cfg.find_bundle(dep)  # archived to completed/ too (#171)
+            if target(p) != own:
+                continue
