+def _announce_base_holds(held: Mapping[str, integrate.IntegrationError]) -> None:
+    """One stderr line per bundle held because its own base could not be built (#738):
+    ``held`` as :func:`_bundle_bases` fills it, each error naming the bundle, its members,
+    the cause and the step that fixes that cause — then what the hold does: a bundle that
+    depends on it is skipped (:func:`_runnable` names it, its prerequisite not ready), one
+    tied to it by ``Conflicts with`` is held (:func:`_runnable` names it too), and the rest
+    of the wave goes on. Printed before the rest of the wave builds."""
+    for name, exc in held.items():
+        print(f"flow: {name} held — {exc}. {name} is not built this run: a bundle that "
+              f"depends on it is skipped, one tied to it by `Conflicts with` is held, and the "
+              f"rest of this wave goes on.", file=sys.stderr)
+
+
+#: A member's branch the build of a bundle's own base refused as rewritten (#738,
+#: :class:`integrate._Rewritten`): ``(its ref, the heads it lost, the bundles held for it,
+#: the bundles whose PR those refusals named)``.
+_BaseRewrite = tuple[str, set[str], list[str], set[str]]
+
