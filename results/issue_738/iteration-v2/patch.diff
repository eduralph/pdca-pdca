diff --git a/template/tests/test_flow_bundle_base_holds.py b/template/tests/test_flow_bundle_base_holds.py
new file mode 100644
index 0000000..9fedc79
--- /dev/null
+++ b/template/tests/test_flow_bundle_base_holds.py
@@ -0,0 +1,510 @@
+"""A bundle whose own base cannot be built is held, not the run (#738).
+
+Since #727 a stack-mode bundle is built on a base of its own (``integrate.build_bundle_base``,
+#723) holding only what it declares. When that base could not be built — ``main`` moved
+mid-run and clashes with a prerequisite, an in-batch prerequisite's branch was rewritten
+after the line took it (#633), the fetch failed, origin refused the push of the base's
+branch — the flow printed ``STOPPING`` and dropped the rest of the run, bundles that had
+nothing to do with the failure included. Now that bundle is held, named on one stderr line
+with the cause and a fix that works for that cause; a bundle that declared ``Depends on``
+it is skipped and one that declared ``Conflicts with`` it is held; and the rest of the run
+goes on, through later waves and their folds. A PR the run published on a commit the
+rewritten branch lost is named at the end of the run, and fails it — a bundle that
+published nothing (closed with no patch) has no PR, and does not.
+
+These cases drive ``flow._drive_and_act`` through real folds and real base builds on the
+``StackFoldGit`` fixture of tests/test_integrate_stack_bases.py (a bare ``origin`` and a
+primary checkout), loaded by path exactly as tests/test_flow_same_wave_conflict.py does,
+with that file's stubs: the build and sign-off leaves stubbed (``flow._drive_wave`` writes
+a ``patch.diff`` and accepts), ``flow._publish_bundle`` cutting and pushing each PR branch
+from the recorded stack-base tip, and ``gh`` answered by a stub in front of
+``subprocess.run``. The publisher is NOT a stub (a stub turns every fold into a dry-run). A
+bundle closed with no patch is published by the production ``flow._publish_bundle``. The
+exit code is the one ``cli._flow`` gives the same run: ``cli._results_rc`` over the results
+and holds.
+
+Two failures are injected for one bundle only, each at the git step that fails in the
+field, never at the flow's own handling: the fetch (``integrate._prepare_worktree`` as
+``build_bundle_base`` calls it, run for real with its ``git fetch`` failing) and the push
+of the base's branch (the ``integrate._git`` push of that one branch returns non-zero, so
+``build_bundle_base``'s own refusal fires). Everything else is real git.
+
+Only modules are imported (never a symbol the fix adds), so with the production change
+reverted these cases still load and run — and fail on their assertions.
+    cd template && PYTHONPATH=src python3 -m unittest tests.test_flow_bundle_base_holds
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import importlib.util
+import io
+import json
+import subprocess
+import unittest
+from collections.abc import Callable
+from contextlib import ExitStack, redirect_stderr, redirect_stdout
+from pathlib import Path
+from unittest import mock
+
+from pdca_harness import cli, flow, integrate, publish, state
+
+_SPEC = importlib.util.spec_from_file_location(
+    "stack_bases_fixture", Path(__file__).with_name("test_integrate_stack_bases.py"))
+sb = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(sb)
+
+TODAY = "2026-10-18"
+#: What a base hold's line says the hold does (`flow._announce_base_holds`), after its cause.
+HOLD_DOES = ("is not built this run: a bundle that depends on it is skipped, one tied to it "
+             "by `Conflicts with` is held, and the rest of this wave goes on.")
+#: What iteration 1's line promised and the run does not do: a dependent is skipped (not
+#: held), and a later fold can still stop the run.
+NOT_DONE = ("held with it", "the rest of the run goes on")
+
+
+class BundleBaseHolds(unittest.TestCase):
+
+    def setUp(self) -> None:
+        self.fx = sb.StackFoldGit()          # the fixture's real-git setUp/tearDown and helpers
+        self.fx.setUp()
+        self.addCleanup(self.fx.tearDown)
+        self.cfg = self.fx.cfg
+        self.cfg.publisher = dataclasses.replace(self.cfg.publisher, mode="command")
+        self.changes: dict[str, dict[str, str]] = {}   # id → the files its build adds
+        self.no_patch: set[str] = set()                # ids closed with no patch (no-fix)
+        self.after_fold: list[Callable[[], None]] = []   # run once, after the run's next fold
+        self.before_fold: list[Callable[[], None]] = []  # run once, before the run's next fold
+        self.after_build: dict[str, Callable[[], None]] = {}   # id → run once its base built
+        self.fetch_fails_for: set[str] = set()         # ids whose own base's fetch fails
+        self.push_refused_for: set[str] = set()        # ids whose own base's push is refused
+        self.building: str | None = None               # the bundle whose base is being built
+        self.refused: list[str] = []                   # the base branches a push was refused
+        self.folds = 0                                 # the run's folds so far
+        # bundle → (stack base, recorded tip, the run's folds so far) when it was built
+        self.seen: dict[str, tuple[str, str, int]] = {}
+        self._real_run = subprocess.run
+        self._real_publish = flow._publish_bundle
+
+    # -- fixture ---------------------------------------------------------------------------
+
+    def _plan(self, iid: str, files: dict[str, str], *, depends_on: str = "",
+              conflicts_with: str = "", stacks_on: str = "") -> None:
+        sb._brief(self.cfg.bundle(iid),
+                  extra=(f"- **Depends on:** {depends_on}\n" if depends_on else "")
+                  + (f"- **Conflicts with:** {conflicts_with}\n" if conflicts_with else "")
+                  + (f"- **Stacks on:** {stacks_on}\n" if stacks_on else ""))
+        self.changes[iid] = files
+
+    def _a_z_then_b_w(self) -> list[str]:
+        """``A`` and ``Z`` (wave 0, files of their own); ``B`` (``Depends on: A``) and ``W``
+        (``Depends on: Z``) in wave 1, each built on a base of its own. ``W`` has nothing
+        to do with ``B``. Returns the ids."""
+        self._plan("A", {"a.txt": "a\n"})
+        self._plan("Z", {"z.txt": "z\n"})
+        self._plan("B", {"b.txt": "b\n"}, depends_on="A")
+        self._plan("W", {"w.txt": "w\n"}, depends_on="Z")
+        return ["A", "Z", "B", "W"]
+
+    def _rewrite_a_after_the_fold(self) -> list[str]:
+        """Once the fold after wave 0 has put ``A`` on the line, ``fix/A`` is force-pushed to
+        a commit that does not hold the head the line took (#633). Returns a list that gets
+        that old head."""
+        took: list[str] = []
+
+        def rewrite() -> None:
+            took.append(self._head("A"))
+            self.fx._push_from_human({"a2.txt": "A, rebuilt\n"}, to="fix/A", force=True)
+
+        self.after_fold.append(rewrite)
+        return took
+
+    # -- stubs -----------------------------------------------------------------------------
+
+    def _gh_stub(self, args, *a, **kw):
+        """Any ``gh`` call is answered OPEN with the PR's head, its branch's tip on origin;
+        everything else runs for real."""
+        if not (isinstance(args, list) and args[:1] == ["gh"]):
+            return self._real_run(args, *a, **kw)
+        iid = str(args[3]).rsplit("/", 1)[-1]
+        head = self.fx._tip(f"fix/{iid}") if self.fx._has(f"fix/{iid}") else ""
+        return subprocess.CompletedProcess(
+            args, 0, json.dumps({"state": "OPEN", "headRefOid": head}), "")
+
+    def _drive_wave(self, cfg, wave: list[Path], **_kw) -> int:
+        """Build and accept each bundle, recording what it was built on. One of
+        ``no_patch`` is closed with no patch, as a close / no-fix outcome is."""
+        for d in wave:
+            iid = d.name.removeprefix("issue_")
+            self.seen[d.name] = (publish.read_stack_base(d), publish.read_stack_base_tip(d),
+                                 self.folds)
+            if iid in self.no_patch:
+                (d / state.CLOSE_MARKER).write_text("likely-close\n", encoding="utf-8")
+            else:
+                (d / "patch.diff").write_text("".join(
+                    sb._new_file_patch(n, t.rstrip("\n")) for n, t in self.changes[iid].items()),
+                    encoding="utf-8")
+            sb._accept(d)
+        return 1
+
+    def _publish_bundle(self, cfg, d: Path, **kw) -> bool:
+        """What publish does: cut the PR branch from the recorded stack-base tip (else that
+        branch, else the base), push it, record it. The run's brief is kept as it was. A
+        bundle closed with no patch goes through the production publisher, which publishes
+        nothing for it."""
+        iid = d.name.removeprefix("issue_")
+        if iid in self.no_patch:
+            return self._real_publish(cfg, d, **kw)
+        tip, base = publish.read_stack_base_tip(d), publish.read_stack_base(d)
+        cut = tip or (f"origin/{base}" if base else "origin/main")
+        brief = (d / "brief.md").read_text(encoding="utf-8")
+        self.fx._publish(iid, self.changes[iid], cut_from=cut)
+        (d / "brief.md").write_text(brief, encoding="utf-8")
+        return True
+
+    def _run(self, ids: list[str]) -> None:
+        """One stack-mode run asked for ``ids``, driving all of them."""
+        self.ids = list(ids)
+        self.line = integrate.integration_branch(self.cfg, "main", ids)
+        self.holds: dict[str, str] = {}
+        real_fold, real_build = integrate.fold, integrate.build_bundle_base
+        real_prepare, real_git = integrate._prepare_worktree, integrate._git
+        refuse = {integrate.bundle_base_branch(self.cfg, "main", ids, f"issue_{i}")
+                  for i in self.push_refused_for}
+
+        def fold(*a, **kw):
+            hooks, self.before_fold = self.before_fold, []
+            for hook in hooks:
+                hook()
+            out = real_fold(*a, **kw)
+            self.folds += 1
+            hooks, self.after_fold = self.after_fold, []
+            for hook in hooks:
+                hook()
+            return out
+
+        def build(cfg, d: Path, *a, **kw):
+            """The real base build, noting whose base it is for the two stubs below; then
+            what ``after_build`` names for it happens."""
+            self.building = d.name.removeprefix("issue_")
+            try:
+                out = real_build(cfg, d, *a, **kw)
+            finally:
+                self.building = None
+            self.after_build.pop(d.name.removeprefix("issue_"), lambda: None)()
+            return out
+
+        def prepare(repo: Path, *a, **kw) -> Path:
+            """``_prepare_worktree`` as the build of a base of ``fetch_fails_for`` calls it:
+            run for real, its ``git fetch`` failing (the error is the real one)."""
+            if self.building not in self.fetch_fails_for:
+                return real_prepare(repo, *a, **kw)
+
+            def git(where: Path, *args: str) -> int:
+                return 1 if args[:1] == ("fetch",) else real_git(where, *args)
+
+            with mock.patch.object(integrate, "_git", git):
+                return real_prepare(repo, *a, **kw)
+
+        def git(where: Path, *args: str) -> int:
+            """The push of a base branch of ``push_refused_for`` is refused; any other git
+            step runs for real."""
+            if args[:1] == ("push",) and args[-1] in refuse:
+                self.refused.append(args[-1])
+                return 1
+            return real_git(where, *args)
+
+        self._err = io.StringIO()
+        with ExitStack() as stack:
+            stack.enter_context(mock.patch.object(subprocess, "run", self._gh_stub))
+            stack.enter_context(mock.patch.object(flow, "_drive_wave", self._drive_wave))
+            stack.enter_context(mock.patch.object(flow, "_publish_bundle",
+                                                  self._publish_bundle))
+            stack.enter_context(mock.patch.object(publish, "draft_texts",
+                                                  lambda *a, **k: True))
+            stack.enter_context(mock.patch.object(integrate, "fold", fold))
+            stack.enter_context(mock.patch.object(integrate, "build_bundle_base", build))
+            stack.enter_context(mock.patch.object(integrate, "_prepare_worktree", prepare))
+            stack.enter_context(mock.patch.object(integrate, "_git", git))
+            stack.enter_context(redirect_stdout(io.StringIO()))
+            stack.enter_context(redirect_stderr(self._err))
+            self.results = flow._drive_and_act(
+                self.cfg, [self.cfg.bundle(i) for i in ids], do_publish=True,
+                do_act=False, by="T", today=TODAY, batch=ids, holds=self.holds)
+        self.err = self._err.getvalue()
+        self.rc = cli._results_rc(self.results, holds=self.holds)
+        self.assertNotIn("Traceback", self.err)
+
+    # -- helpers ---------------------------------------------------------------------------
+
+    def _lines(self, *parts: str) -> list[str]:
+        """The stderr lines holding every one of ``parts``."""
+        return [x for x in self.err.splitlines() if all(p in x for p in parts)]
+
+    def _held(self, iid: str, *parts: str) -> str:
+        """``iid`` was never built and is left PLANNED, the run did not stop, and ONE stderr
+        line says it is held, with each of ``parts``. Returns that line."""
+        self.assertNotIn("STOPPING", self.err)
+        self.assertNotIn(f"issue_{iid}", self.seen, self.err)
+        self.assertEqual(self.results[iid], state.PLANNED, self.err)
+        lines = [x for x in self.err.splitlines() if x.startswith(f"flow: issue_{iid} held — ")]
+        self.assertEqual(len(lines), 1, self.err)
+        for part in parts:
+            self.assertIn(part, lines[0])
+        return lines[0]
+
+    def _base_held(self, iid: str, *parts: str) -> str:
+        """As :meth:`_held`, for a bundle whose own base could not be built: its line names
+        that base and each of ``parts``, and ends on what the hold does — no more than the
+        run does. Returns that line."""
+        line = self._held(iid, f"could not build issue_{iid}'s own base from ", *parts)
+        self.assertTrue(line.endswith(f"issue_{iid} {HOLD_DOES}"), line)
+        for words in NOT_DONE:
+            self.assertNotIn(words, line)
+        return line
+
+    def _skipped(self, iid: str, prereq: str) -> None:
+        """``iid`` was never built and is left PLANNED, named on ONE stderr line as skipped
+        for its prerequisite ``prereq``."""
+        self.assertNotIn(f"issue_{iid}", self.seen, self.err)
+        self.assertEqual(self.results[iid], state.PLANNED, self.err)
+        self.assertEqual(len(self._lines(f"flow: issue_{iid} skipped — prerequisite(s) not "
+                                         f"ready ({prereq})")), 1, self.err)
+
+    def _complete(self, *ids: str) -> None:
+        """Each of ``ids`` was built and is COMPLETE."""
+        for iid in ids:
+            self.assertIn(f"issue_{iid}", self.seen, self.err)
+            self.assertEqual(self.results[iid], state.COMPLETE, self.err)
+
+    def _head(self, iid: str) -> str:
+        return self.fx._tip(f"fix/{iid}")
+
+    # -- (1) main moved under a prerequisite, in the last wave -------------------------------
+
+    def test_a_base_that_moved_under_a_prerequisite_holds_only_its_dependent(self):
+        # After wave 0's fold, main gets an a.txt of its own: A's branch no longer merges
+        # onto it, so no base of B's can hold A. Before: STOPPING, and W stayed PLANNED.
+        ids = self._a_z_then_b_w()
+        self.after_fold.append(lambda: self.fx._push_from_human(
+            {"a.txt": "main's own\n"}, to="main"))
+        self._run(ids)
+        line = self._base_held("B", "issue_A", "origin/main")
+        self.assertIn("rebuild issue_a's branch on the new origin/main", line.lower())
+        self._complete("A", "Z", "W")
+        self.assertEqual(self.holds, {"B": "base"})
+        self.assertEqual(self.rc, 3, self.err)
+
+    # -- (2) an in-batch prerequisite rewritten after the line took it ----------------------
+
+    def test_a_prerequisite_rewritten_after_the_fold_holds_only_its_dependent(self):
+        # After the fold carried A, fix/A is force-pushed to another commit (#633): B's base
+        # refuses it, with the restore/re-publish remedy. The rewrite is named once, by B's
+        # hold, and not again by the end-of-run check; only the line holds A's old commits.
+        ids = self._a_z_then_b_w()
+        took = self._rewrite_a_after_the_fold()
+        self._run(ids)
+        rewritten = "issue_A's branch origin/fix/A was rewritten"
+        self._base_held("B", "issue_A", "rewritten", rewritten, took[0][:12],
+                        "Restore origin/fix/A")
+        self.assertEqual(len(self._lines(rewritten)), 1, self.err)
+        self.assertEqual(self._lines("No fold of this run ran after"), [], self.err)
+        self._complete("A", "Z", "W")
+        self.assertEqual(self.holds, {"B": "base"})
+        self.assertEqual(self.rc, 3, self.err)
+
+    # -- (3) the fetch of one bundle's base fails -------------------------------------------
+
+    def test_a_fetch_that_fails_for_one_base_holds_only_that_bundle(self):
+        ids = self._a_z_then_b_w()
+        self.fetch_fails_for.add("B")
+        self._run(ids)
+        line = self._base_held("B", "issue_A", "could not fetch origin", "re-run")
+        self.assertNotIn("rebuild", line.lower())
+        self._complete("A", "Z", "W")
+        self.assertEqual(self.holds, {"B": "base"})
+        self.assertEqual(self.rc, 3, self.err)
+
+    # -- (4) origin refuses the push of one bundle's base -----------------------------------
+
+    def test_a_push_origin_refuses_holds_only_that_bundle(self):
+        ids = self._a_z_then_b_w()
+        self.push_refused_for.add("B")
+        self._run(ids)
+        name = integrate.bundle_base_branch(self.cfg, "main", ids, "issue_B")
+        self.assertEqual(self.refused, [name])
+        self._base_held("B", f"could not push {name} to origin", "check origin's rules")
+        self.assertFalse(self.fx._has(name))
+        self._complete("A", "Z", "W")
+        self.assertEqual(self.holds, {"B": "base"})
+        self.assertEqual(self.rc, 3, self.err)
+
+    # -- (5) a `Conflicts with` partner of a held bundle ------------------------------------
+
+    def test_a_conflicts_with_partner_of_a_held_bundle_is_held(self):
+        # Case (3)'s shape, and X (`Conflicts with: B`), scheduled after B (wave 2): X must be
+        # built on a base holding B's work, and no base or line of this run has it. Before
+        # the fix X was not reached (STOPPING); with B held but X's partner check blind to
+        # it, X would be built on the plain base. Its line asks for what holds whatever ids
+        # a re-run names: B built and its PR merged — never "a re-run builds B first".
+        ids = self._a_z_then_b_w()
+        self._plan("X", {"x.txt": "x\n"}, conflicts_with="B")
+        self.fetch_fails_for.add("B")
+        self._run([*ids, "X"])
+        self._base_held("B", "could not fetch origin")
+        line = self._held("X", "`Conflicts with` issue_B", "held before building it",
+                          "wait until issue_B is built", "its PR merges into main (org/repo)",
+                          "then re-run")
+        for words in ("prerequisite", "re-run builds"):
+            self.assertNotIn(words, line)
+        self._complete("A", "Z", "W")
+        self.assertEqual(self.holds, {"B": "base"})
+        self.assertEqual(self.rc, 1, self.err)          # X is left PLANNED
+
+    # -- (6) a PR cut from the line a rewrite left stale ------------------------------------
+
+    def test_a_pr_cut_from_the_stale_line_after_a_rewrite_hold_is_named(self):
+        # Case (2)'s shape, and S (`Stacks on: A`, a seam) in B's wave: S is cut from the
+        # line, which holds A's old head. S's PR holds commits fix/A no longer has, so a line
+        # names it at the end of the run; A stays out of the end-of-run check, so the
+        # rewrite itself is named once. A PR holds the old commits: the run fails.
+        ids = self._a_z_then_b_w()
+        self._plan("S", {"s.txt": "s\n"}, stacks_on="A")
+        took = self._rewrite_a_after_the_fold()
+        self._run([*ids, "S"])
+        rewritten = "issue_A's branch origin/fix/A was rewritten"
+        self._base_held("B", rewritten)
+        self._complete("A", "Z", "W", "S")
+        self.assertEqual(self.seen["issue_S"][0], self.line)
+        self.assertTrue(self.fx._ancestor(took[0], self._head("S")))     # the fixture's fact
+        named = self._lines(f"flow: issue_S is cut from {self.line}", "issue_A", took[0][:12])
+        self.assertEqual(len(named), 1, self.err)
+        for part in ("that branch was rewritten without it, as the hold line of issue_B above "
+                     "says", "issue_S's PR holds those old commits too",
+                     f"Restore origin/fix/A to {took[0][:12]}",
+                     "rebuild issue_S's PR on the rewritten branch"):
+            self.assertIn(part, named[0])
+        self.assertEqual(len(self._lines(rewritten)), 1, self.err)
+        self.assertEqual(self._lines("No fold of this run ran after"), [], self.err)
+        self.assertEqual(self.holds, {"B": "base", "A": "rewritten"})
+        self.assertEqual(self.rc, 1, self.err)          # a PR holds commits fix/A lost
+
+    def test_a_bundle_closed_with_no_patch_on_the_stale_line_is_no_pr(self):
+        # Case (6), but S is accepted with no patch (a close / no-fix outcome): the
+        # production publisher publishes nothing for it, so no PR of the run holds A's old
+        # commits — only the line does. B's hold stands alone, as in case (2): no line names
+        # S as a PR, and the run exits 3, not 1.
+        ids = self._a_z_then_b_w()
+        self._plan("S", {}, stacks_on="A")
+        self.no_patch.add("S")
+        self._rewrite_a_after_the_fold()
+        self._run([*ids, "S"])
+        self._base_held("B", "issue_A's branch origin/fix/A was rewritten")
+        self._complete("A", "Z", "W", "S")
+        self.assertEqual(self.seen["issue_S"][0], self.line)
+        self.assertFalse((self.cfg.bundle("S") / "publish.json").exists())
+        self.assertFalse(self.fx._has("fix/S"))
+        for words in ("issue_S is cut from", "issue_S's PR"):
+            self.assertEqual(self._lines(words), [], self.err)
+        self.assertEqual(self.holds, {"B": "base"})
+        self.assertEqual(self.rc, 3, self.err)
+
+    def test_a_base_built_before_the_rewrite_in_the_same_wave_is_named(self):
+        # B and E (`Depends on: A`) and W in wave 1; B's base is built first and takes A's
+        # head, then fix/A is force-pushed, so E's base refuses it and E is held. B's base —
+        # and its PR — hold commits fix/A no longer has: a line names B, as (6) names S.
+        ids = self._a_z_then_b_w()
+        self._plan("E", {"e.txt": "e\n"}, depends_on="A")
+        took: list[str] = []
+
+        def rewrite() -> None:
+            took.append(self._head("A"))
+            self.fx._push_from_human({"a2.txt": "A, rebuilt\n"}, to="fix/A", force=True)
+
+        self.after_build["B"] = rewrite
+        self._run([*ids, "E"])
+        self._base_held("E", "issue_A's branch origin/fix/A was rewritten", took[0][:12])
+        self._complete("A", "Z", "B", "W")
+        base = integrate.bundle_base_branch(self.cfg, "main", self.ids, "issue_B")
+        self.assertEqual(self.seen["issue_B"][0], base)
+        self.assertTrue(self.fx._ancestor(took[0], self._head("B")))     # the fixture's fact
+        named = self._lines(f"flow: issue_B is built on its own base {base}", "issue_A",
+                            took[0][:12])
+        self.assertEqual(len(named), 1, self.err)
+        for part in ("as the hold line of issue_E above says",
+                     "issue_B's PR holds those old commits too",
+                     "rebuild issue_B's PR on the rewritten branch"):
+            self.assertIn(part, named[0])
+        self.assertEqual(self.holds, {"E": "base", "A": "rewritten"})
+        self.assertEqual(self.rc, 1, self.err)          # B's PR holds commits fix/A lost
+
+    def test_a_rewrite_mended_before_the_next_fold_fails_nothing(self):
+        # Case (6)'s shape with a wave after it: V (`Depends on: W`) in wave 2. After S is
+        # published, fix/A is put back to the head the line took, as B's hold line says to
+        # do. The fold after wave 1 holds every carried branch to what the line and S's PR
+        # took, finds fix/A mended, and goes on: no PR is named, the end of the run judges
+        # fix/A again and finds nothing, and B's hold stands alone — exit 3.
+        ids = self._a_z_then_b_w()
+        self._plan("S", {"s.txt": "s\n"}, stacks_on="A")
+        self._plan("V", {"v.txt": "v\n"}, depends_on="W")
+        took = self._rewrite_a_after_the_fold()
+        self.after_fold.append(lambda: self.before_fold.append(lambda: sb._git(
+            self.fx.origin, "branch", "-f", "fix/A", took[0])))
+        self._run([*ids, "S", "V"])
+        self._base_held("B", "issue_A's branch origin/fix/A was rewritten", took[0][:12])
+        self._complete("A", "Z", "W", "S", "V")
+        self.assertEqual(self._head("A"), took[0])
+        self.assertTrue(self.fx._ancestor(took[0], self._head("S")))     # the fixture's fact
+        self.assertEqual(self.folds, 2, self.err)
+        self.assertEqual(self.seen["issue_V"][2], 2)        # built after the fold after wave 1
+        for words in ("issue_S is cut from", "issue_S's PR", "No fold of this run ran after"):
+            self.assertEqual(self._lines(words), [], self.err)
+        self.assertEqual(self.holds, {"B": "base"})
+        self.assertEqual(self.rc, 3, self.err)
+
+    # -- (7) a dependent of a held bundle ---------------------------------------------------
+
+    def test_a_dependent_of_a_held_bundle_is_skipped_and_fails_the_run(self):
+        ids = self._a_z_then_b_w()
+        self._plan("C", {"c.txt": "c\n"}, depends_on="B")
+        self.fetch_fails_for.add("B")
+        self._run([*ids, "C"])
+        self._base_held("B", "could not fetch origin")
+        self._skipped("C", "B")
+        self._complete("A", "Z", "W")
+        self.assertEqual(self.holds, {"B": "base"})
+        self.assertEqual(self.rc, 1, self.err)          # human decision 3: C is PLANNED
+
+    # -- a hold before the last wave: the rest of the run goes on, through its folds -------
+
+    def test_a_hold_before_the_last_wave_carries_over_two_folds(self):
+        # B's fetch fails in wave 1 of four. B was never accepted, so the folds after waves
+        # 1 and 2 have nothing of it to merge and run clean. Waves later, what waits on B
+        # still waits: C (`Depends on: B`, wave 2) is skipped, and so is D (`Depends on: C`,
+        # wave 3); X (`Conflicts with: B`, wave 3) is held two folds after B. V and U, which
+        # have nothing to do with B, are built on bases the later folds made possible.
+        self._a_z_then_b_w()
+        self._plan("C", {"c.txt": "c\n"}, depends_on="B")
+        self._plan("V", {"v.txt": "v\n"}, depends_on="W")
+        self._plan("D", {"d.txt": "d\n"}, depends_on="C")
+        self._plan("U", {"u.txt": "u\n"}, depends_on="V")
+        self._plan("X", {"x.txt": "x\n"}, depends_on="V", conflicts_with="B")
+        self.fetch_fails_for.add("B")
+        self._run(["A", "Z", "B", "W", "C", "V", "D", "U", "X"])
+        self._base_held("B", "could not fetch origin", "re-run")
+        self._skipped("C", "B")
+        self._skipped("D", "C")
+        self._held("X", "`Conflicts with` issue_B", "wait until issue_B is built")
+        self._complete("A", "Z", "W", "V", "U")
+        self.assertEqual(self.folds, 3, self.err)            # after waves 0, 1 and 2
+        self.assertEqual(self.seen["issue_V"][2], 2)         # after the fold after B's wave
+        self.assertEqual(self.seen["issue_U"][2], 3)
+        line = self.fx._tip(self.line)
+        for iid in ("A", "Z", "W", "V"):
+            self.assertTrue(self.fx._ancestor(self._head(iid), line), iid)
+        self.assertEqual(self.holds, {"B": "base"})
+        self.assertEqual(self.rc, 1, self.err)               # C, D and X are left PLANNED
+
