+    of ``held`` (:func:`_bundle_bases`) refused as rewritten (#738)."""
+    for name, exc in held.items():
+        if isinstance(exc, integrate._Rewritten):
+            _ref, lost, by, named = rewrites.setdefault(exc.name, (exc.ref, set(), [], set()))
+            lost.update(exc.lost)
+            by.append(name)
+            named.update(exc.prs)
+
+
+def _report_stale_prs(rewrites: Mapping[str, _BaseRewrite],
