+                                                   to="fix/A", off="origin/fix/A")
+            self.after_fold.append(lambda: sb._git(self.fx.origin, "branch", "-f", "fix/A",
+                                                   heads["a1"]))
+
+        self.after_fold.append(move_on)
+        self.after_publish["V"] = lambda: self.fx._push_from_human(
+            {"a2.txt": "A, rebuilt\n"}, to="fix/A", force=True)
+        self._run(["A", "Z", "B", "W", "S", "D", "V"])
+        a1, a2 = heads["a1"], heads["a2"]
+        hold = self._base_held("D", "issue_A's branch origin/fix/A was rewritten", a2[:12],
+                               "issue_B's PR holds commits origin/fix/A no longer has")
+        self.assertNotIn("issue_S", hold)
+        self._complete("A", "Z", "B", "W", "S", "V")
+        self.assertEqual(self.folds, 2, self.err)
+        self.assertEqual(self.seen["issue_S"][0], self.line)
+        self.assertTrue(self.fx._ancestor(a1, self._head("S")))          # the fixture's facts
+        self.assertFalse(self.fx._ancestor(a2, self._head("S")))
+        self.assertTrue(self.fx._ancestor(a2, self._head("B")))
+        self.assertFalse(self.fx._ancestor(a1, self._head("A")))
+        named = self._lines(f"flow: issue_S is cut from {self.line}", "issue_A", a1[:12])
+        self.assertEqual(len(named), 1, self.err)
+        for part in (f"and that branch does not contain {a1[:12]} now: the hold line of "
+                     f"issue_D above names it rewritten",
+                     "issue_S's PR holds commits it no longer has",
+                     "rebuild issue_S's PR on the rewritten branch"):
+            self.assertIn(part, named[0])
+        self.assertEqual(self._lines("flow: issue_B is built on its own base"), [], self.err)
+        self.assertEqual(self._lines("No fold of this run ran after"), [], self.err)
+        self.assertEqual(self.holds, {"D": "base", "A": "rewritten"})
+        self.assertEqual(self.rc, 1, self.err)
+
+    def test_a_branch_no_pr_holds_a_commit_of_is_not_read_again_at_the_end(self):
+        # Case (2)'s shape: only the line holds A's old commits, and B's hold line named
+        # that. Once W is published every fetch fails. The end of the run does not read
+        # fix/A again, as no PR of the run holds a commit of it: nothing is said of A, and A
+        # fails nothing. Z, which the end-of-run check (#695) cannot read either, does; that
+        # check still leaves A out.
+        ids = self._a_z_then_b_w()
+        self._rewrite_a_after_the_fold()
+        self.after_publish["W"] = lambda: setattr(self, "fetch_down", True)
+        self._run(ids)
+        self._base_held("B", "issue_A's branch origin/fix/A was rewritten")
+        self._complete("A", "Z", "W")
+        self.assertEqual(self._lines("could not read issue_A's branch"), [], self.err)
+        unchecked = self._lines("flow: could not check whether a branch this run folded")
+        self.assertEqual(len(unchecked), 1, self.err)
+        self.assertIn("issue_Z's origin/fix/Z", unchecked[0])
+        self.assertEqual(self._lines("issue_A's origin/fix/A"), [], self.err)
+        self.assertEqual(self.holds, {"B": "base", "Z": "unchecked"})
+        self.assertEqual(self.rc, 1, self.err)          # Z could not be checked
+
+    def test_a_rewrite_mended_before_the_next_fold_fails_nothing(self):
+        # Case (6)'s shape with a wave after it: V (`Depends on: W`) in wave 2. After S is
+        # published, fix/A is put back to the head the line took, as B's hold line says to
+        # do. The fold after wave 1 holds every carried branch to what the line and S's PR
+        # took, finds fix/A mended, and goes on: no PR is named, the end of the run judges
+        # fix/A again and finds nothing, and B's hold stands alone — exit 3.
+        ids = self._a_z_then_b_w()
+        self._plan("S", {"s.txt": "s\n"}, stacks_on="A")
+        self._plan("V", {"v.txt": "v\n"}, depends_on="W")
+        took = self._rewrite_a_after_the_fold()
+        self.after_fold.append(lambda: self.before_fold.append(lambda: sb._git(
+            self.fx.origin, "branch", "-f", "fix/A", took[0])))
+        self._run([*ids, "S", "V"])
+        self._base_held("B", "issue_A's branch origin/fix/A was rewritten", took[0][:12])
+        self._complete("A", "Z", "W", "S", "V")
+        self.assertEqual(self._head("A"), took[0])
+        self.assertTrue(self.fx._ancestor(took[0], self._head("S")))     # the fixture's fact
+        self.assertEqual(self.folds, 2, self.err)
+        self.assertEqual(self.seen["issue_V"][2], 2)        # built after the fold after wave 1
+        for words in ("issue_S is cut from", "issue_S's PR", "No fold of this run ran after"):
+            self.assertEqual(self._lines(words), [], self.err)
+        self.assertEqual(self.holds, {"B": "base"})
+        self.assertEqual(self.rc, 3, self.err)
+
+    def test_a_rewrite_after_the_fold_that_found_it_mended_is_named_at_the_end(self):
+        # A, Z / B (`Depends on: A`), W / V (`Depends on: W`). fix/A is force-pushed after
+        # the fold after wave 0, so B is held; it is put back before the fold after wave 1,
+        # which finds it mended and goes on; then it is force-pushed again, and no fold
+        # comes after. No hold line named that second rewrite, so the end-of-run check
+        # (#695) does: the line carries commits fix/A no longer has, and the run fails.
+        ids = self._a_z_then_b_w()
+        self._plan("V", {"v.txt": "v\n"}, depends_on="W")
+        took = self._rewrite_a_after_the_fold()
+
+        def mend_then_rewrite() -> None:     # after the fold after wave 0
+            self.before_fold.append(lambda: sb._git(self.fx.origin, "branch", "-f", "fix/A",
+                                                    took[0]))
+            self.after_fold.append(lambda: self.fx._push_from_human(
+                {"a3.txt": "A, rebuilt again\n"}, to="fix/A", force=True))
+
+        self.after_fold.append(mend_then_rewrite)
+        self._run([*ids, "V"])
+        self._base_held("B", "issue_A's branch origin/fix/A was rewritten", took[0][:12])
+        self._complete("A", "Z", "W", "V")
+        self.assertEqual(self.folds, 2, self.err)
+        self.assertFalse(self.fx._ancestor(took[0], self._head("A")))   # the fixture's fact
+        late = self._lines(f"issue_A's branch origin/fix/A was rewritten after this run folded "
+                           f"it onto {self.line}", "No fold of this run ran after the rewrite")
+        self.assertEqual(len(late), 1, self.err)
+        self.assertIn(f"Restore origin/fix/A to {took[0][:12]}", late[0])
+        self.assertEqual(self.holds, {"B": "base", "A": "rewritten"})
+        self.assertEqual(self.rc, 1, self.err)
+
+    # -- (7) a dependent of a held bundle ---------------------------------------------------
+
+    def test_a_dependent_of_a_held_bundle_is_skipped_and_fails_the_run(self):
+        ids = self._a_z_then_b_w()
+        self._plan("C", {"c.txt": "c\n"}, depends_on="B")
+        self.fetch_fails_for.add("B")
+        self._run([*ids, "C"])
+        self._base_held("B", "could not fetch origin")
+        self._skipped("C", "B")
+        self._complete("A", "Z", "W")
+        self.assertEqual(self.holds, {"B": "base"})
+        self.assertEqual(self.rc, 1, self.err)          # human decision 3: C is PLANNED
+
+    # -- a hold before the last wave: the rest of the run goes on, through its folds -------
+
+    def test_a_hold_before_the_last_wave_carries_over_two_folds(self):
+        # B's fetch fails in wave 1 of four. B was never accepted, so the folds after waves
+        # 1 and 2 have nothing of it to merge and run clean. Waves later, what waits on B
+        # still waits: C (`Depends on: B`, wave 2) is skipped, and so is D (`Depends on: C`,
+        # wave 3); X (`Conflicts with: B`, wave 3) is held two folds after B. V and U, which
+        # have nothing to do with B, are built on bases the later folds made possible.
+        self._a_z_then_b_w()
+        self._plan("C", {"c.txt": "c\n"}, depends_on="B")
+        self._plan("V", {"v.txt": "v\n"}, depends_on="W")
+        self._plan("D", {"d.txt": "d\n"}, depends_on="C")
+        self._plan("U", {"u.txt": "u\n"}, depends_on="V")
+        self._plan("X", {"x.txt": "x\n"}, depends_on="V", conflicts_with="B")
+        self.fetch_fails_for.add("B")
+        self._run(["A", "Z", "B", "W", "C", "V", "D", "U", "X"])
+        self._base_held("B", "could not fetch origin", "re-run")
+        self._skipped("C", "B")
+        self._skipped("D", "C")
+        self._held("X", "`Conflicts with` issue_B", "wait until issue_B is built")
+        self._complete("A", "Z", "W", "V", "U")
+        self.assertEqual(self.folds, 3, self.err)            # after waves 0, 1 and 2
+        self.assertEqual(self.seen["issue_V"][2], 2)         # after the fold after B's wave
+        self.assertEqual(self.seen["issue_U"][2], 3)
+        line = self.fx._tip(self.line)
+        for iid in ("A", "Z", "W", "V"):
+            self.assertTrue(self.fx._ancestor(self._head(iid), line), iid)
+        self.assertEqual(self.holds, {"B": "base"})
+        self.assertEqual(self.rc, 1, self.err)               # C, D and X are left PLANNED
+
+
+if __name__ == "__main__":
+    unittest.main()
