--- /dev/null
+++ b/template/tests/test_flow_bundle_base_holds.py
@@ -0,0 +1,791 @@
+"""A bundle whose own base cannot be built is held, not the run (#738).
+
+Since #727 a stack-mode bundle is built on a base of its own (``integrate.build_bundle_base``,
+#723) holding only what it declares. When that base could not be built — ``main`` moved
+mid-run and clashes with a prerequisite, an in-batch prerequisite's branch was rewritten
+after the line took it (#633), the checkout was missing, its fetch failed or its worktree
+could not be made, origin refused the push of the base's branch — the flow printed
+``STOPPING`` and dropped the rest of the run, bundles that had nothing to do with the
+failure included. Now that bundle is held, named on one stderr line with the cause and a
+fix that works for that cause; a bundle that declared ``Depends on`` it is skipped and one
+that declared ``Conflicts with`` it is held; and the rest of the wave goes on.
+
+How far the run goes after that depends on the cause. A failure only that base's build
+meets (its fetch, here) leaves the line as it was, so later waves and their folds go on
+too; a checkout or remote still broken when the next fold runs stops the run there, as a
+failed fold always has. A cause in a prerequisite the line carries is read again by the
+next fold: a branch rewritten and not restored stops the run there (#633, as before), and
+``main`` moved under it can stop it too (a clash at the line fold, #739). So the cases with
+those two causes hold the bundle in the run's last wave, or restore the branch before the
+next fold.
+
+At the end of the run the rewritten branch is read again, and each PR the run published on
+a commit it does not contain then fails the run, and is named unless a hold line named it
+already. That covers a PR on a commit the branch still had when it was refused and lost
+after (rewritten again), and one no refusal saw: published after it, or built on a base
+that took a newer commit of the branch than the line did. A branch restored while the rest
+of the run built, as the hold line asks, fails nothing; one that cannot be read again is
+named to check by hand; one no PR holds a commit of (only the line does, and the hold named
+that) is not read again. A fold after the hold that finds the branch mended hands it back
+to the end-of-run check of every carried branch (#695), which names a rewrite after that
+fold. A bundle that published nothing (closed with no patch) has no PR, and is never named.
+
+These cases drive ``flow._drive_and_act`` through real folds and real base builds on the
+``StackFoldGit`` fixture of tests/test_integrate_stack_bases.py (a bare ``origin`` and a
+primary checkout), loaded by path exactly as tests/test_flow_same_wave_conflict.py does,
+with that file's stubs: the build and sign-off leaves stubbed (``flow._drive_wave`` writes
+a ``patch.diff`` and accepts), ``flow._publish_bundle`` cutting and pushing each PR branch
+from the recorded stack-base tip, and ``gh`` answered by a stub in front of
+``subprocess.run``. The publisher is NOT a stub (a stub turns every fold into a dry-run). A
+bundle closed with no patch is published by the production ``flow._publish_bundle``. The
+exit code is the one ``cli._flow`` gives the same run: ``cli._results_rc`` over the results
+and holds.
+
+Failures are made for one bundle's base only, never at the flow's own handling. Two at the
+git step that fails in the field: the fetch (``integrate._prepare_worktree`` as
+``build_bundle_base`` calls it, run for real with its ``git fetch`` failing) and the push
+of the base's branch (the ``integrate._git`` push of that one branch returns non-zero, so
+``build_bundle_base``'s own refusal fires). Two by changing the files on disk while that one
+base is built, put back after it: the checkout moved away, and a plain directory left
+where the integration worktree goes. And late in the run every fetch the integrate module
+makes fails: for the case where the rewritten branch cannot be read again, and for the one
+where it is not read again at all. Everything else is real git.
+
+Only modules are imported (never a symbol the fix adds), so with the production change
+reverted these cases still load and run — and fail on their assertions.
+    cd template && PYTHONPATH=src python3 -m unittest tests.test_flow_bundle_base_holds
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import importlib.util
+import io
+import json
+import shutil
+import subprocess
+import unittest
+from collections.abc import Callable, Iterator
+from contextlib import ExitStack, contextmanager, redirect_stderr, redirect_stdout
+from pathlib import Path
+from unittest import mock
+
+from pdca_harness import cli, flow, integrate, publish, state
+
+_SPEC = importlib.util.spec_from_file_location(
+    "stack_bases_fixture", Path(__file__).with_name("test_integrate_stack_bases.py"))
+sb = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(sb)
+
+TODAY = "2026-10-18"
+#: What a base hold's line says the hold does (`flow._announce_base_holds`), after its cause.
+HOLD_DOES = ("is not built this run: a bundle that depends on it is skipped, one tied to it "
+             "by `Conflicts with` is held, and the rest of this wave goes on.")
+#: What a hold line must not promise, since the run does not do it: a dependent is skipped
+#: (not held), and a later fold can still stop the run.
+NOT_DONE = ("held with it", "the rest of the run goes on")
+
+
+class BundleBaseHolds(unittest.TestCase):
+
+    def setUp(self) -> None:
+        self.fx = sb.StackFoldGit()          # the fixture's real-git setUp/tearDown and helpers
+        self.fx.setUp()
+        self.addCleanup(self.fx.tearDown)
+        self.cfg = self.fx.cfg
+        self.cfg.publisher = dataclasses.replace(self.cfg.publisher, mode="command")
+        self.changes: dict[str, dict[str, str]] = {}   # id → the files its build adds
+        self.no_patch: set[str] = set()                # ids closed with no patch (no-fix)
+        self.after_fold: list[Callable[[], None]] = []   # run once, after the run's next fold
+        self.before_fold: list[Callable[[], None]] = []  # run once, before the run's next fold
+        self.after_build: dict[str, Callable[[], None]] = {}   # id → run once its base built
+        self.after_publish: dict[str, Callable[[], None]] = {}  # id → run once it published
+        self.fetch_fails_for: set[str] = set()         # ids whose own base's fetch fails
+        self.push_refused_for: set[str] = set()        # ids whose own base's push is refused
+        self.checkout_gone_for: set[str] = set()       # ids built with the checkout moved away
+        self.worktree_blocked_for: set[str] = set()    # ids built with no integration worktree
+        self.fetch_down = False                        # every integrate fetch fails from now
+        self.building: str | None = None               # the bundle whose base is being built
+        self.refused: list[str] = []                   # the base branches a push was refused
+        self.folds = 0                                 # the run's folds so far
+        # bundle → (stack base, recorded tip, the run's folds so far) when it was built
+        self.seen: dict[str, tuple[str, str, int]] = {}
+        self._real_run = subprocess.run
+        self._real_publish = flow._publish_bundle
+
+    # -- fixture ---------------------------------------------------------------------------
+
+    def _plan(self, iid: str, files: dict[str, str], *, depends_on: str = "",
+              conflicts_with: str = "", stacks_on: str = "") -> None:
+        sb._brief(self.cfg.bundle(iid),
+                  extra=(f"- **Depends on:** {depends_on}\n" if depends_on else "")
+                  + (f"- **Conflicts with:** {conflicts_with}\n" if conflicts_with else "")
+                  + (f"- **Stacks on:** {stacks_on}\n" if stacks_on else ""))
+        self.changes[iid] = files
+
+    def _a_z_then_b_w(self) -> list[str]:
+        """``A`` and ``Z`` (wave 0, files of their own); ``B`` (``Depends on: A``) and ``W``
+        (``Depends on: Z``) in wave 1, each built on a base of its own. ``W`` has nothing
+        to do with ``B``. Returns the ids."""
+        self._plan("A", {"a.txt": "a\n"})
+        self._plan("Z", {"z.txt": "z\n"})
+        self._plan("B", {"b.txt": "b\n"}, depends_on="A")
+        self._plan("W", {"w.txt": "w\n"}, depends_on="Z")
+        return ["A", "Z", "B", "W"]
+
+    def _rewrite_a_after_the_fold(self) -> list[str]:
+        """Once the fold after wave 0 has put ``A`` on the line, ``fix/A`` is force-pushed to
+        a commit that does not hold the head the line took (#633). Returns a list that gets
+        that old head."""
+        took: list[str] = []
+
+        def rewrite() -> None:
+            took.append(self._head("A"))
+            self.fx._push_from_human({"a2.txt": "A, rebuilt\n"}, to="fix/A", force=True)
+
+        self.after_fold.append(rewrite)
+        return took
+
+    # -- stubs -----------------------------------------------------------------------------
+
+    def _gh_stub(self, args, *a, **kw):
+        """Any ``gh`` call is answered OPEN with the PR's head, its branch's tip on origin;
+        everything else runs for real."""
+        if not (isinstance(args, list) and args[:1] == ["gh"]):
+            return self._real_run(args, *a, **kw)
+        iid = str(args[3]).rsplit("/", 1)[-1]
+        head = self.fx._tip(f"fix/{iid}") if self.fx._has(f"fix/{iid}") else ""
+        return subprocess.CompletedProcess(
+            args, 0, json.dumps({"state": "OPEN", "headRefOid": head}), "")
+
+    def _drive_wave(self, cfg, wave: list[Path], **_kw) -> int:
+        """Build and accept each bundle, recording what it was built on. One of
+        ``no_patch`` is closed with no patch, as a close / no-fix outcome is."""
+        for d in wave:
+            iid = d.name.removeprefix("issue_")
+            self.seen[d.name] = (publish.read_stack_base(d), publish.read_stack_base_tip(d),
+                                 self.folds)
+            if iid in self.no_patch:
+                (d / state.CLOSE_MARKER).write_text("likely-close\n", encoding="utf-8")
+            else:
+                (d / "patch.diff").write_text("".join(
+                    sb._new_file_patch(n, t.rstrip("\n")) for n, t in self.changes[iid].items()),
+                    encoding="utf-8")
+            sb._accept(d)
+        return 1
+
+    def _publish_bundle(self, cfg, d: Path, **kw) -> bool:
+        """What publish does: cut the PR branch from the recorded stack-base tip (else that
+        branch, else the base), push it, record it. The run's brief is kept as it was. A
+        bundle closed with no patch goes through the production publisher, which publishes
+        nothing for it."""
+        iid = d.name.removeprefix("issue_")
+        if iid in self.no_patch:
+            return self._real_publish(cfg, d, **kw)
+        tip, base = publish.read_stack_base_tip(d), publish.read_stack_base(d)
+        cut = tip or (f"origin/{base}" if base else "origin/main")
+        brief = (d / "brief.md").read_text(encoding="utf-8")
+        self.fx._publish(iid, self.changes[iid], cut_from=cut)
+        (d / "brief.md").write_text(brief, encoding="utf-8")
+        self.after_publish.pop(iid, lambda: None)()
+        return True
+
+    def _run(self, ids: list[str]) -> None:
+        """One stack-mode run asked for ``ids``, driving all of them."""
+        self.ids = list(ids)
+        self.line = integrate.integration_branch(self.cfg, "main", ids)
+        self.holds: dict[str, str] = {}
+        real_fold, real_build = integrate.fold, integrate.build_bundle_base
+        real_prepare, real_git = integrate._prepare_worktree, integrate._git
+        refuse = {integrate.bundle_base_branch(self.cfg, "main", ids, f"issue_{i}")
+                  for i in self.push_refused_for}
+
+        def fold(*a, **kw):
+            hooks, self.before_fold = self.before_fold, []
+            for hook in hooks:
+                hook()
+            out = real_fold(*a, **kw)
+            self.folds += 1
+            hooks, self.after_fold = self.after_fold, []
+            for hook in hooks:
+                hook()
+            return out
