+# ----------------------------------------------------------------------------
+# Pre-publish review stage (issue #315) — N parallel review passes over the bundle's
+# FINAL diff, between the T4 gate and the first git step; findings unioned/deduped,
+# rubric-rejected classes dropped, BUG-class findings re-entering Do under a bounded
+# budget; publish proceeds only on a round with every finding fixed or
+# recorded-rejected. Config-gated ([publisher.review]); off by default.
+# ----------------------------------------------------------------------------
+def _prepublish_cfg(cfg: Config) -> tuple[bool, int, int]:
+    """``(enabled, passes, max_iters)`` from ``[publisher.review]`` (#315).
+
+    ``enabled`` is STRICTLY boolean, the ``network_access`` rule (config.py): a quoted
+    ``"true"`` must not silently buy N model passes per publish — it is reported and
+    treated as FALSE (off = today's behaviour, the safe direction). ``getattr`` so a
+    synthetic test Config lacking the field reads as disabled."""
+    spec = getattr(cfg, "prepublish_review", None) or {}
+    enabled = spec.get("enabled", False)
+    if not isinstance(enabled, bool):
+        print(f"publish: [publisher.review] enabled must be a boolean, got {enabled!r} "
+              "— treating it as FALSE (the stage stays off). Write `enabled = true`, "
+              "unquoted.", file=sys.stderr)
+        enabled = False
+    try:
+        passes = max(1, int(spec.get("passes", 3)))
+    except (TypeError, ValueError):
+        passes = 3
+    try:
+        max_iters = max(0, int(spec.get("max_iters", 3)))
+    except (TypeError, ValueError):
+        max_iters = 3
+    return enabled, passes, max_iters
+
+
+def _prepublish_record(d: Path) -> dict:
+    """The stage record, or ``{}`` — tolerant like every other bundle-file read."""
+    try:
+        data = json.loads((d / PREPUBLISH_JSON).read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return {}
+    return data if isinstance(data, dict) else {}
+
+
+def _prepublish_count(record: dict) -> int:
+    """Spent Do re-entry rounds — ``autoiterate.count``'s read, same tolerance."""
+    try:
+        return int(record["count"])
+    except (KeyError, TypeError, ValueError):
+        return 0
+
+
+_PASS_BULLET_RE = re.compile(r"^\s*[-*]\s+(.*\S)\s*$")
+_NO_FINDINGS_RE = re.compile(r"(?i)^\s*no\s+findings?\b")
+
+
+def _pass_findings(text: str) -> list[str]:
+    """The finding bullets of one pass artifact. A bare "No findings." line is not a
+    bullet; a bulleted one is skipped too, so a literal-minded pass can't raise a
+    finding that says there are none."""
+    out: list[str] = []
+    for line in text.splitlines():
+        m = _PASS_BULLET_RE.match(line)
+        if m and not _NO_FINDINGS_RE.match(m.group(1)):
+            out.append(m.group(1))
+    return out
+
+
+def _finding_key(text: str) -> str:
+    """The union/dedup key across passes AND rounds: the finding's NORMALIZED TEXT
+    (case-folded, punctuation/whitespace collapsed). Proposed over file+line (the open
+    question the #315 design records): line numbers shift between rounds precisely
+    because Do re-enters, so a positional key would re-open every carried finding."""
+    return re.sub(r"[^a-z0-9]+", " ", text.lower()).strip()
+
+
+_CF_HEADING_RE = re.compile(r"^## Iteration (\d+) — carry-forward", re.MULTILINE)
+
+
+def _carry_forward_findings(d: Path, open_bugs: list[dict], round_no: int) -> None:
+    """Fold the open BUG-class findings into the brief's carry-forward block — the same
+    ``## Iteration N — carry-forward`` shape ``driver._carry_forward_into_brief`` writes
+    and the builder is contracted to read — so the re-entered Do is not blind about why.
+    Numbered past any existing block (driver- or stage-written), so headings never
+    collide. Best-effort like the driver's: a failure must never break the stage."""
+    brief_path = d / "brief.md"
+    try:
+        text = brief_path.read_text(encoding="utf-8") if brief_path.exists() else ""
+        n = max((int(m) for m in _CF_HEADING_RE.findall(text)), default=0) + 1
+        out = [f"\n## Iteration {n} — carry-forward (pre-publish review round {round_no})\n"]
+        out.append("- Pre-publish review (issue #315): BUG-class finding(s) on the FINAL "
+                   "diff must be fixed before the draft PR opens — update patch.diff "
+                   "(and the test) so they no longer hold:\n")
+        for e in open_bugs:
+            out.append(f"- Finding: {e.get('text', '')}\n")
+        out.append("- Address the above; do NOT re-attempt the rejected approach "
+                   "unchanged. Satisfy the brief's Success criterion (the end result).\n")
+        with brief_path.open("a", encoding="utf-8") as fh:
+            fh.write("".join(out))
+    except Exception:  # noqa: BLE001 — carry-forward is advisory; never break the stage
+        pass
+
+
+def _prepublish_review_passes(cfg: Config, d: Path) -> bool:
+    """The pre-publish review stage (issue #315). True ⇒ proceed to the git steps;
+    False ⇒ refuse the publish (nothing pushed, no PR opened).
+
+    Sits between the T4 gate and the first git step — the seam where the serialized
+    post-publish review churn (~1 new real finding per external re-review round; 13
+    rounds observed on one PR) is paid up front instead. Each round:
+
+    * **N parallel passes** over the bundle's final diff, through the Check reviewer
+      leaf's own sandboxed invocation path (``leaves.run_prepublish_pass`` — the family
+      the instance already configures; never a second model-runner);
+    * **union + dedup** of the passes' findings (key: normalized text — each pass
+      surfaces distinct findings, the union is what counts);
+    * **classification** via ``triage``'s deterministic, rubric-tunable keyword table
+      (#316 — one classifier, no second vocabulary). Where a rubric is configured,
+      findings of the class the instance rubric rejects (NOISE — the class whose
+      keyword list a rubric's exclusion lines retune) are **dropped**; with no rubric
+      the drop step is skipped. Non-BUG classes are **recorded-rejected**: the stage
+      fixes bugs, it does not re-litigate style at the publish boundary — everything
+      is recorded in ``prepublish-review.json`` for the human and for Act;
+    * **BUG-class findings re-enter Do**, bounded: the finding set is folded into the
+      brief's carry-forward block and ``leaves.do_build`` rebuilds, at most
+      ``max_iters`` times per bundle — the ``auto-iterate.json`` budget shape
+      (``count``, bumped, persisted, never archived), so a noisy reviewer cannot spin
+      the loop and the bound holds across publish attempts;
+    * the exit is a **triaged fixpoint**, not reviewer silence: a round whose every
+      finding is fixed (no pass reports it against the rebuilt diff) or
+      recorded-rejected proceeds; an exhausted budget with open BUGs refuses, loudly,
+      leaving the bundle for the human (who may fix, or record-reject a finding by
+      editing its ``status`` in the record).
+
+    Fail CLOSED when no pass at all produced a review — proceeding unreviewed is the
+    exact churn this stage exists to pay down. Disabled (the default) ⇒ zero reads,
+    zero writes: publish is byte-identical to today."""
+    enabled, passes, max_iters = _prepublish_cfg(cfg)
+    if not enabled:
+        return True
+
+    from . import triage  # lazy: triage imports publish at module level (import cycle)
+    rubric_configured = bool(str(getattr(cfg, "rubric_file", "") or "").strip())
+    rubric_text = rubric.load(d, cfg) if rubric_configured else ""
+    table = triage.class_keywords(rubric_text)
+
+    record = _prepublish_record(d)
+    findings: dict[str, dict] = {
+        str(f["key"]): dict(f) for f in record.get("findings", [])
+        if isinstance(f, dict) and f.get("key")
+    }
+    count = _prepublish_count(record)
+
+    def _write(overall: str) -> None:
+        (d / PREPUBLISH_JSON).write_text(json.dumps(
+            {"count": count, "overall": overall, "passes": passes,
+             "max_iters": max_iters,
+             "findings": sorted(findings.values(), key=lambda f: str(f.get("key")))},
+            indent=2) + "\n", encoding="utf-8")
+
+    round_no = 0
+    while True:
+        round_no += 1
+        print(f"publish: pre-publish review — {passes} parallel pass(es) over "
+              f"{d.name}'s diff (round {round_no})…", file=sys.stderr)
+        with ThreadPoolExecutor(max_workers=passes) as ex:
+            produced = list(ex.map(
+                lambda n: (n, leaves.run_prepublish_pass(d, cfg, n, passes)),
+                range(1, passes + 1)))
+        ok_passes = [n for n, ok in produced if ok]
+        if not ok_passes:
+            _write("blocked")
+            print("publish: pre-publish review — NO pass produced a review; refusing "
+                  "to publish unreviewed (fail closed). Fix the reviewer leaf (see the "
+                  "prepublish-review-pass-*.error.log tails) and retry, or disable "
+                  "[publisher.review].", file=sys.stderr)
+            return False
+
+        # Union + dedup across the passes; classify + triage a NEW finding exactly once
+        # (a recorded status — incl. a human-edited "rejected" — is never re-decided).
+        seen: set[str] = set()
+        for n in ok_passes:
+            text = leaves.prepublish_pass_artifact(d, n).read_text(encoding="utf-8")
+            for raw in _pass_findings(text):
+                key = _finding_key(raw)
+                if not key:
+                    continue
+                seen.add(key)
+                entry = findings.get(key)
+                if entry is None:
+                    fnd = triage.Finding(source="prepublish", author=f"pass-{n}",
+                                         text=raw)
+                    triage.classify(fnd, table)
+                    entry = findings[key] = {
+                        "key": key, "text": raw, "class": fnd.cls or "UNCLASSIFIED",
+                        "keyword": fnd.keyword, "passes": [], "round": round_no,
+                        "status": "open", "reason": "",
+                    }
+                    if rubric_configured and entry["class"] == "NOISE":
+                        entry["status"] = "dropped"
+                        entry["reason"] = "class the instance rubric rejects (NOISE)"
+                    elif entry["class"] != "BUG":
+                        entry["status"] = "rejected"
+                        entry["reason"] = (f"non-BUG class ({entry['class']}) "
+                                           "recorded-rejected at the pre-publish stage")
+                if n not in entry.setdefault("passes", []):
+                    entry["passes"].append(n)
+                if entry.get("status") == "fixed":
+                    # A "fixed" finding a pass reports again was NOT fixed — re-open.
+                    entry["status"] = "open"
+                    entry["reason"] = "reappeared after a fix round"
+
+        # A BUG carried into this round that no pass reports any more is fixed — the
+        # fixpoint is judged by RE-REVIEW, never by trusting the fix round.
+        for entry in findings.values():
+            if entry.get("status") == "open" and entry.get("key") not in seen:
+                entry["status"] = "fixed"
+                entry["reason"] = f"no pass reports it against the round-{round_no} diff"
+
+        open_bugs = [e for e in findings.values() if e.get("status") == "open"]
+        if not open_bugs:
+            _write("proceed")
+            done = {s: sum(1 for e in findings.values() if e.get("status") == s)
+                    for s in ("fixed", "rejected", "dropped")}
+            print(f"publish: pre-publish review — proceed ({done['fixed']} fixed, "
+                  f"{done['rejected']} recorded-rejected, {done['dropped']} "
+                  f"rubric-dropped; see {d.name}/{PREPUBLISH_JSON}).", file=sys.stderr)
+            return True
+
+        if count >= max_iters:
+            _write("blocked")
+            print(f"publish: pre-publish review — {len(open_bugs)} BUG-class "
+                  f"finding(s) still open with the Do re-entry budget spent "
+                  f"({count}/{max_iters}); NOT publishing — nothing was pushed, no PR "
+                  f"was opened. Fix them (or record a finding rejected by setting its "
+                  f"status in {d.name}/{PREPUBLISH_JSON}) and re-run `pdca publish`. "
+                  "Open:", file=sys.stderr)
+            for e in open_bugs:
+                print(f"    - {e.get('text', '')}", file=sys.stderr)
+            return False
+
+        # Bounded re-entry to Do: spend one round of the budget (the auto-iterate
+        # shape), fold the findings into the brief's carry-forward block — the one
+        # input the builder reads — and rebuild. The next round re-reviews the diff
+        # the rebuild produced.
+        count += 1
+        _write("iterating")
+        _carry_forward_findings(d, open_bugs, count)
+        print(f"publish: pre-publish review — {len(open_bugs)} BUG-class finding(s); "
+              f"re-entering Do ({count}/{max_iters})…", file=sys.stderr)
+        try:
+            leaves.do_build(d, cfg)
+        except Exception as exc:  # noqa: BLE001 — a failed rebuild refuses, never crashes
+            _write("blocked")
+            print(f"publish: pre-publish review — Do re-entry failed ({exc}); NOT "
+                  "publishing.", file=sys.stderr)
+            return False
+
+
