+# ----------------------------------------------------------------------------
+# Pre-publish review passes (issue #315) — reviewer-shaped, run by `publish` between
+# the T4 gate and the first git step, N in parallel over the bundle's FINAL diff.
+# Same leaf, same sandboxed invocation path as run_review (never a second
+# model-runner); only the prompt and the artifact differ. The stage's union/dedup,
+# classification and bounded Do re-entry live in publish._prepublish_review_passes.
+# ----------------------------------------------------------------------------
+def prepublish_pass_artifact(d: Path, n: int) -> Path:
+    """The artifact pre-publish pass ``n`` writes (parallel to check-review.md)."""
+    return d / f"prepublish-review-pass-{n}.md"
+
+
+def _prepublish_prompt(artifact_name: str, n: int, total: int, rubric: str) -> str:
+    return (
+        f"You are pre-publish review pass {n} of {total} — independent, artifact-only, "
+        "decorrelated from the builder. The accepted fix's FINAL full diff is about to "
+        "open as a draft PR; your findings are the review an external maintainer would "
+        "otherwise serialize AFTER it opens, paid now instead (issue #315). You have "
+        "ONLY patch.diff, brief.md and check-gates.json in this directory "
+        "(build-notes.md is deliberately withheld); ground every cited path:line on "
+        "the target source at $PDCA_TARGET (read-only), never other checkouts. Review "
+        "patch.diff the way an external maintainer reviews a PR. Write "
+        f"{artifact_name} in this directory: one Markdown bullet per finding "
+        "(`- <finding>`, citing path:line), naming REAL defects — a logic bug, a "
+        "missed case, a broken invariant, a weak or vacuous test, a regression risk. "
+        "Word each finding plainly: a genuine defect should say so (bug / incorrect / "
+        "crash / race / regression), polish should say so (nit / cosmetic) — the "
+        "driver classifies findings by keyword and only defect-class findings re-enter "
+        "the build. Do not restate the implementation. If you find nothing, write "
+        "exactly: No findings."
+    ) + rubric
+
+
+def run_prepublish_pass(d: Path, cfg: Config, n: int, total: int) -> bool:
+    """One pre-publish review pass (#315): the Check reviewer leaf, invoked through the
+    same sandboxed path as :func:`run_review`, writing ``prepublish-review-pass-<n>.md``.
+
+    Returns True iff the pass artifact exists in the bundle afterwards. A stub
+    reviewer writes a deterministic no-findings artifact — the offline slice must
+    never fabricate findings. A failed pass returns False and leaves its captured
+    stderr tail in ``prepublish-review-pass-<n>.error.log``; judging what a failed
+    pass means (publish fails CLOSED when no pass at all produced a review) is the
+    stage's job, not this leaf's.
+    """
+    artifact = prepublish_pass_artifact(d, n)
+    artifact.unlink(missing_ok=True)  # a stale pass from a prior round must never count
+    if cfg.reviewer.mode != "command":
+        artifact.write_text(
+            "# Pre-publish review pass — stub\n\nNo findings.\n", encoding="utf-8")
+        return True
+    error_log = d / f"prepublish-review-pass-{n}.error.log"
+    err = _sandboxed_reviewer_invoke(
+        d, cfg,
+        _prepublish_prompt(artifact.name, n, total, rubric_mod.for_reviewer(d, cfg)),
+        artifact.name, error_log, f"pre-publish review {d.name} pass {n}/{total}",
+        # The artifact name + pass number as env too, so a non-prompt-following
+        # command leaf (and the offline test stubs) can address its output file.
+        env_extra={"PDCA_REVIEW_ARTIFACT": artifact.name, "PDCA_REVIEW_PASS": str(n)},
+    )
+    if err is not None:
+        print(f"leaves: {d.name} — pre-publish review pass {n} failed ({err}); see "
+              f"{error_log.name}", file=sys.stderr)
+        return False
+    if not artifact.exists():
+        print(f"leaves: {d.name} — pre-publish review pass {n} produced no "
+              f"{artifact.name}", file=sys.stderr)
+        return False
+    return True
+
