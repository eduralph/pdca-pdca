+    seen = {" ".join(t.split()).casefold() for t in fresh}
+    out: list[str] = []
+    for text in ledger:
+        key = " ".join(text.split()).casefold()
+        if key and key not in seen:
+            seen.add(key)
+            out.append(text)
+    return out
+
