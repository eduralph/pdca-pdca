+    head = [lines[0]] + body[:end]
+    if not head[-1].endswith("\n"):
+        head[-1] += "\n"
+    new_section = "".join(head + [f"- [ ] {item}\n"] + body[end:])
+    summary_path.write_text(text.replace(section, new_section, 1), encoding="utf-8")
+    return True
+
