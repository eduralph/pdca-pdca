 _DIFF_GIT_RE = re.compile(r"^diff --git a/(.+) b/(.+)$")
+_DIFF_GIT_PREFIX = "diff --git "
+# Git's C-quoting escapes (quote.c `sq_lookup`); an octal escape is exactly three digits.
+_C_ESCAPES = {"a": 7, "b": 8, "t": 9, "n": 10, "v": 11, "f": 12, "r": 13, '"': 34, "\\": 92}
+
+
+def _unquote_c(s: str) -> tuple[str, str] | None:
+    """Decode one Git C-quoted string at the start of ``s`` (which begins with ``"``).
+
+    Returns ``(decoded, rest_after_closing_quote)``, or ``None`` when the string is
+    malformed — an unknown escape, a short or out-of-range octal escape, or no closing
+    quote. Octal escapes are bytes; the bytes are decoded as UTF-8 with replacement, so
+    a name that is not valid UTF-8 still yields a (lossy) path instead of an error.
+    """
+    out = bytearray()
+    i = 1
+    while i < len(s):
+        c = s[i]
+        if c == '"':
+            return out.decode("utf-8", errors="replace"), s[i + 1:]
+        if c != "\\":
+            out += c.encode("utf-8", errors="replace")
+            i += 1
+            continue
+        esc = s[i + 1:i + 2]
+        if esc in _C_ESCAPES:
+            out.append(_C_ESCAPES[esc])
+            i += 2
+            continue
+        digits = s[i + 1:i + 4]
+        if len(digits) == 3 and all(d in "01234567" for d in digits) and int(digits, 8) < 256:
+            out.append(int(digits, 8))
+            i += 4
+            continue
+        return None
+    return None
+
+
+def _header_paths(rest: str) -> list[str]:
+    """The ``(old, new)`` paths of one ``diff --git`` header, ``rest`` being the text after
+    ``diff --git ``. Each side is ``a/<path>`` / ``b/<path>``, either plain or C-quoted
+    (``"a/caf\\303\\251.txt"``); a rename can mix the two. An unquoted Git path never
+    holds ``"`` (Git would quote it), so the first ``"`` in an unquoted header starts a
+    quoted side. A malformed header yields ``[]``."""
+    if '"' not in rest:
+        m = _DIFF_GIT_RE.match(_DIFF_GIT_PREFIX + rest)
+        return [q.strip() for q in m.groups()] if m else []
+    if rest.startswith('"'):
+        first = _unquote_c(rest)
+        if first is None or not first[1].startswith(" "):
+            return []
+        old, tail = first[0], first[1][1:]
+    else:
+        q = rest.index('"')
+        if q == 0 or rest[q - 1] != " ":
+            return []
+        old, tail = rest[:q - 1], rest[q:]
+    if tail.startswith('"'):
+        second = _unquote_c(tail)
+        if second is None or second[1].strip():
+            return []
+        new = second[0]
+    else:
+        new = tail.strip()
+    if not (old.startswith("a/") and new.startswith("b/")):
+        return []
+    return [old[2:], new[2:]]
 
 
