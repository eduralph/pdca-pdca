@@ -0,0 +1,155 @@
+"""Offline tests for `waves.diff_files` on Git-quoted ``diff --git`` headers.
+
+Git C-quotes a path holding non-ASCII bytes, a double quote, a backslash or a control
+character (``core.quotePath``): ``diff --git "a/caf\\303\\251.txt" "b/caf\\303\\251.txt"``.
+The parser must return the real repo-relative path for those headers too, so the
+advisory same-wave overlap audit (`flow._audit_wave_overlap`) and the size backstop's
+``patch_files`` count see every file a patch touches. Patches are made with real ``git``
+in a temp repo (no network). Run from the project root:
+    PYTHONPATH=src python -m unittest discover -s tests
+"""
+
+from __future__ import annotations
+
+import io
+import os
+import subprocess
+import tempfile
+import unittest
+from contextlib import redirect_stderr
+from pathlib import Path
+
+from pdca_harness import flow, waves
+
+_GIT_ENV = {
+    "GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@example.invalid",
+    "GIT_COMMITTER_NAME": "t", "GIT_COMMITTER_EMAIL": "t@example.invalid",
+    "GIT_CONFIG_GLOBAL": os.devnull, "GIT_CONFIG_NOSYSTEM": "1",
+}
+
+
+def _git(repo: Path, *args: str) -> str:
+    env = {**os.environ, **_GIT_ENV}
+    return subprocess.run(["git", "-C", str(repo), *args], check=True, env=env,
+                          capture_output=True, text=True, encoding="utf-8").stdout
+
+
+def _repo(root: Path, files: dict[str, str]) -> Path:
+    repo = root / "repo"
+    repo.mkdir()
+    _git(repo, "init", "-q")
+    for name, body in files.items():
+        (repo / name).write_text(body, encoding="utf-8")
+    _git(repo, "add", "-A")
+    _git(repo, "commit", "-q", "-m", "init")
+    return repo
+
+
+def _diff(repo: Path, out: Path, *extra: str) -> Path:
+    # Pin quotePath on: a global `core.quotePath=false` must not make the leg pass on main.
+    out.write_text(_git(repo, "-c", "core.quotePath=true", "diff", *extra), encoding="utf-8")
+    return out
+
+
+class QuotedHeaderTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self._tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self._tmp.name)
+
+    def tearDown(self) -> None:
+        self._tmp.cleanup()
+
+    def _write(self, name: str, text: str) -> Path:
+        p = self.root / name
+        p.write_text(text, encoding="utf-8")
+        return p
+
+    # (a) non-ASCII name, real git with quotePath pinned on
+    def test_non_ascii_path_from_real_git(self) -> None:
+        repo = _repo(self.root, {"café.txt": "x\n"})
+        (repo / "café.txt").write_text("y\n", encoding="utf-8")
+        patch = _diff(repo, self.root / "p.diff")
+        self.assertIn('"a/caf\\303\\251.txt"', patch.read_text(encoding="utf-8"))
+        self.assertEqual(waves.diff_files(patch), {"café.txt"})
+
+    # (b) a double quote, a backslash and a tab each come back decoded
+    def test_quote_backslash_tab_paths_from_real_git(self) -> None:
+        names = ['say"hi".txt', "back\\slash.txt", "tab\there.txt"]
+        repo = _repo(self.root, {n: "x\n" for n in names})
+        for n in names:
+            (repo / n).write_text("y\n", encoding="utf-8")
+        patch = _diff(repo, self.root / "p.diff")
+        text = patch.read_text(encoding="utf-8")
+        self.assertIn('"a/say\\"hi\\".txt"', text)
+        self.assertIn('"a/back\\\\slash.txt"', text)
+        self.assertIn('"a/tab\\there.txt"', text)
+        self.assertEqual(waves.diff_files(patch), set(names))
+
+    def test_newline_escape_decodes(self) -> None:
+        p = self._write("p.diff", 'diff --git "a/new\\nline" "b/new\\nline"\n')
+        self.assertEqual(waves.diff_files(p), {"new\nline"})
+
+    # (c) rename between an unquoted and a quoted name returns both
+    def test_mixed_rename_returns_both_names(self) -> None:
+        repo = _repo(self.root, {"plain.txt": "same content\n" * 5})
+        _git(repo, "mv", "plain.txt", "café.txt")
+        patch = _diff(repo, self.root / "p.diff", "--cached", "-M")
+        text = patch.read_text(encoding="utf-8")
+        self.assertIn('diff --git a/plain.txt "b/caf\\303\\251.txt"', text)
+        self.assertEqual(waves.diff_files(patch), {"plain.txt", "café.txt"})
+
+    def test_mixed_header_quoted_first(self) -> None:
+        p = self._write("p.diff", 'diff --git "a/caf\\303\\251.txt" b/plain.txt\n')
+        self.assertEqual(waves.diff_files(p), {"café.txt", "plain.txt"})
+
+    # (d) unquoted headers, missing file behave as today
+    def test_unquoted_header_unchanged(self) -> None:
+        p = self._write("p.diff", "diff --git a/src/x.py b/src/x.py\n"
+                                  "diff --git a/old.py b/new.py\n")
+        self.assertEqual(waves.diff_files(p), {"src/x.py", "old.py", "new.py"})
+
+    def test_missing_file_is_empty(self) -> None:
+        self.assertEqual(waves.diff_files(self.root / "nope.diff"), set())
+
+    # (f) malformed quoted headers never raise
+    def test_malformed_quoted_headers_never_raise(self) -> None:
+        bad = [
+            'diff --git "a/x\\3" "b/x\\3"',            # lone, short octal escape
+            'diff --git "a/x\\q" "b/x\\q"',            # unknown escape
+            'diff --git "a/unterminated b/unterminated',  # no closing quote
+            'diff --git "a/x" "b/unterminated',        # second side unterminated
+            'diff --git "a/x\\477" "b/x\\477"',        # octal above one byte
+            'diff --git "a/x\\" "b/x\\"',              # trailing backslash eats the quote
+            'diff --git "a/x""b/x"',                   # no separator between sides
+            'diff --git "a/x" "b/x" trailing',         # junk after the second side
+            'diff --git a/x "c/x"',                    # wrong prefix inside quotes
+        ]
+        for line in bad:
+            with self.subTest(line=line):
+                p = self._write("bad.diff", line + "\n")
+                self.assertIsInstance(waves.diff_files(p), set)
+
+    def test_invalid_utf8_octal_decodes_with_replacement(self) -> None:
+        p = self._write("p.diff", 'diff --git "a/x\\377y" "b/x\\377y"\n')
+        self.assertEqual(waves.diff_files(p), {"x�y"})
+
+    # (e) the advisory overlap audit sees a shared quoted path
+    def test_overlap_audit_flags_shared_quoted_path(self) -> None:
+        repo = _repo(self.root, {"café.txt": "a\nb\nc\nd\ne\nf\ng\nh\n"})
+        bundles = []
+        for name, (old, new) in {"issue_1": ("a", "A"), "issue_2": ("h", "H")}.items():
+            body = (repo / "café.txt").read_text(encoding="utf-8")
+            (repo / "café.txt").write_text(body.replace(old, new), encoding="utf-8")
+            b = self.root / name
+            b.mkdir()
+            _diff(repo, b / "patch.diff")
+            _git(repo, "checkout", "-q", "--", ".")
+            bundles.append(b)
+        with redirect_stderr(io.StringIO()) as err:
+            flow._audit_wave_overlap(bundles)
+        self.assertIn("café.txt", err.getvalue())
+        self.assertIn("undeclared conflict", err.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()
