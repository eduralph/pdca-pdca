+    children = flow._lineage_children(record) if record else []
+    if not children:
+        return _Row(d.name, st, "OPEN",
+                    f"split parent — its children are unknown (no readable `children` in "
+                    f"{split.LINEAGE}) — no action; close the issue by hand once its "
+                    "children are done")
+    still_open: list[str] = []
+    unknown: list[str] = []
+    reasons: dict[str, str] = {}
+    for child in children:
+        remote = _issue_state(child, repo) if child.isdigit() else None
+        state_ = str((remote or {}).get("state", "") or "")
