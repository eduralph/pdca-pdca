+        have gated the round, so its `fail` cannot be set aside as non-gating."""
+        failing = self._row("fail")
+        cases = {
+            "gating missing": self._without(failing, "gating"),
+            "gating null": {**failing, "gating": None},
+            "gating a string": {**failing, "gating": "false"},
