+def _sibling_conflicts(child: Child, est) -> int:
+    """How many of ``child``'s declared `Conflicts with` entries are its own siblings.
+
+    Reads the count `sizing.estimate` exposes on the staged estimate once the estimator
+    excludes them from churn (issue #457's `SizeEstimate.sibling_conflicts`) — a caller
+    that instead judged convergence off the (then-excluded) score or `.reasons` would see
+    a clean read on a proposal whose children conflict with every sibling, which is the
+    splitter's own statement that the split separated nothing.
+
+    Falls back to the raw `Conflicts with` count where that field is absent. That is not
+    an approximation: at `preflight` time every ordering ref names a sibling label BY
+    CONSTRUCTION — `_validate_ordering` refuses any reference that is not a child of this
+    very proposal — so before #457 lands the raw count and the sibling-only count are
+    already the same quantity.
+    """
+    exposed = getattr(est, "sibling_conflicts", None)
+    return exposed if exposed is not None else len(child.ordering("Conflicts with"))
+
+
+def convergence_report(parent: Path, children: list[Child], cfg) -> str:
+    """Whether staging ``children`` would actually make them smaller (issue #459).
+
+    Two independent NOT-CONVERGED signals, because a band comparison alone is blind to
+    the second: a proposal whose children conflict with EVERY sibling declares, in its
+    own ordering fields, that the split separated nothing (`leaves.py:1265`) — true
+    whether or not the estimator currently excludes those declarations from the band
+    printed on the very same line (:func:`_sibling_conflicts`).
+
+    Pure and read-only: computed from the proposal alone, nothing written into the
+    instance, no tracker id required. The only caller is :func:`_emit_convergence_report`,
+    which is advisory — this function's OUTPUT never changes what `--accept` does.
+    """
+    from . import sizing  # lazy: sizing imports split, so this must not be a module import
+    labels = [c.label for c in children]
+    parent_est = sizing.estimate(parent / "brief.md", cfg)
+    lines = [f"split convergence report for {parent.name} "
+            f"(parent band: {parent_est.band}):"]
+    not_lower = 0
+    fully_conflicted = 0
+    for child in children:
+        siblings = [label for label in labels if label != child.label]
+        est = _staged_estimate(child, siblings, cfg)
+        conflicts = _sibling_conflicts(child, est)
+        if siblings and conflicts >= len(siblings):
+            fully_conflicted += 1
+        top = sizing.higher(est.band, parent_est.band)
+        if top == parent_est.band and est.band != parent_est.band:
+            cmp_word = "lower than parent"
+        elif est.band == parent_est.band:
+            cmp_word, not_lower = "same as parent", not_lower + 1
+        else:
+            cmp_word, not_lower = "HIGHER than parent", not_lower + 1
+        reasons = "; ".join(est.reasons) or "no structural signal"
+        note = f" [{conflicts} sibling conflict(s) declared]" if conflicts else ""
+        lines.append(f"  {child.label}: band={est.band} ({cmp_word}) — {reasons}{note}")
+    if children and not_lower * 2 > len(children):
+        lines.append(
+            f"NOT CONVERGED: {not_lower} of {len(children)} child(ren) do not band lower "
+            "than the parent — this split may not reduce size.")
+    if len(children) > 1 and fully_conflicted == len(children):
+        lines.append(
+            "NOT CONVERGED: every child conflicts with every sibling — the split "
+            "separated nothing (leaves.py:1265).")
+    return "\n".join(lines)
+
+
+def _emit_convergence_report(parent: Path, children: list[Child], cfg, *,
+                             file=None) -> None:
+    """Print :func:`convergence_report`'s text, and never let it affect acceptance
+    either way (issue #459) — matching the size guard's warn-only stance
+    (`plan_policy.py:88-102`) and the stderr-write guard the filed-ids notice already
+    uses (`cli.py:796-803`) for exactly this reason: a stream that fails PART-WAY through
+    a multi-line report must not escape `preflight` as an aborted split or surface as an
+    unrelated, misleading error.
+
+    ``file`` defaults to `sys.stderr` and exists so a caller can drive this with a stream
+    that fails on demand, without patching the real one out from under the rest of the
+    process.
+    """
+    stream = file if file is not None else sys.stderr
+    try:
+        print(convergence_report(parent, children, cfg), file=stream)
+    except OSError:
+        pass
 
 
