--- /dev/null
+++ b/template/tests/test_split_convergence.py
@@ -0,0 +1,247 @@
+"""The split convergence report (issue #459).
+
+`pdca split <id> --accept` files real, unrevokable tracker sub-issues (or, with
+`--ids`, materialises real bundles) without ever running the size estimate over the
+staged children — a split that leaves every child `oversized` was discovered a full
+cycle later, when each child's own guard fired and the planner was pointed at
+`pdca split` again. `preflight` now reports convergence at the one point BOTH
+acceptance shapes reach before anything irreversible happens.
+
+Only the module is imported, never the new symbols — a `from pdca_harness.split import
+convergence_report` would raise ImportError pre-fix (0 tests run, exit 77
+PDCA-UNVERIFIABLE) instead of a red that proves anything.
+"""
+
+from __future__ import annotations
+
+import io
+import shutil
+import tempfile
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+from pathlib import Path
+from types import SimpleNamespace
+from unittest import mock
+
+from pdca_harness import cli, split, sizing
+from pdca_harness.config import Config, LeafConfig
+
+TEMPLATES = Path(__file__).resolve().parents[1] / "templates"
+
+
+def _proposal(*children: str, version: int = 1) -> str:
+    body = f"<!-- pdca:split-proposal v{version} -->\n# Split proposal\n\n"
+    for i, child in enumerate(children, 1):
+        body += (f"<!-- pdca:child child-{i} -->\n{child}\n"
+                 f"<!-- pdca:end child-{i} -->\n\n")
+    return body
+
+
+class _FailingStream:
+    """A stream whose ``write`` raises on demand — for driving the guard, not sys.stderr.
+
+    Deliberately NOT `io.StringIO` with a patched method: a real object exercises the
+    same `file=` parameter `_emit_convergence_report` takes, the same shape a genuinely
+    broken pipe would present.
+    """
+
+    def __init__(self, fail_at: int) -> None:
+        self.fail_at = fail_at
+        self.calls = 0
+        self.written: list[str] = []
+
+    def write(self, s: str) -> int:
+        self.calls += 1
+        if self.calls == self.fail_at:
+            raise OSError("[Errno 32] Broken pipe")
+        self.written.append(s)
+        return len(s)
+
+    def flush(self) -> None:
+        pass
+
+
+class ConvergenceReport(unittest.TestCase):
+    def setUp(self) -> None:
+        self.tmp = Path(tempfile.mkdtemp())
+        self.cfg = Config(
+            root=self.tmp, bundle_root=self.tmp / "results",
+            process_dir=self.tmp / "process", templates_dir=TEMPLATES,
+            default_branch="main", tracker_system="github",
+            tracker_url="https://github.com/acme/widgets", issue_id_example="#1",
+            builder=LeafConfig(mode="stub"), reviewer=LeafConfig(mode="stub"),
+        )
+        self.parent = self.cfg.bundle("500")
+        self.parent.mkdir(parents=True)
+        (self.parent / "brief.md").write_text(
+            "- **Slug:** parent\n- **Difficulty:** high\n"
+            "- **Conflicts with:** 999\n",
+            encoding="utf-8")
+
+    def tearDown(self) -> None:
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def _write(self, text: str) -> None:
+        (self.parent / split.PROPOSAL).write_text(text, encoding="utf-8")
+
+    def _children(self) -> list:
+        return split.parse((self.parent / split.PROPOSAL).read_text(encoding="utf-8"))
+
+    # -- (a) both acceptance paths reach the report before anything irreversible -------
+
+    def test_the_ids_path_now_reaches_preflight_and_prints_a_report(self) -> None:
+        """Reproduces the rejected attempt exactly: `--accept --ids a,b` used to
+        materialise both children and print nothing but the `pdca flow` follow-up."""
+        self._write(_proposal(
+            "- **Slug:** a\n- **Defect / goal:** x\n",
+            "- **Slug:** b\n- **Defect / goal:** y\n"))
+        err = io.StringIO()
+        with redirect_stderr(err), redirect_stdout(io.StringIO()):
+            rc = cli._split(self.cfg, SimpleNamespace(issue_id="500", accept=True,
+                                                       ids="601,602"))
+        self.assertEqual(rc, 0)
+        self.assertTrue(self.cfg.bundle("601").is_dir())
+        self.assertTrue(self.cfg.bundle("602").is_dir())
+        out = err.getvalue()
+        self.assertIn("convergence report", out.lower())
+        self.assertIn("child-1", out)
+        self.assertIn("child-2", out)
+
+    def test_the_auto_filing_path_prints_the_report_before_a_single_issue_is_filed(
+            self) -> None:
+        self._write(_proposal(
+            "- **Slug:** a\n- **Defect / goal:** x\n",
+            "- **Slug:** b\n- **Defect / goal:** y\n"))
+        err = io.StringIO()
+        seen: dict[str, str] = {}
+
+        def filer(parent, children, cfg, **kw):
+            # The report must already be on the stream by the time filing — the
+            # irreversible step on THIS shape — is reached.
+            seen["before_filing"] = err.getvalue()
+            return ["601", "602"]
+
+        with mock.patch("pdca_harness.split.file_children", filer), \
+             redirect_stderr(err), redirect_stdout(io.StringIO()):
+            rc = cli._split(self.cfg, SimpleNamespace(issue_id="500", accept=True, ids=""))
+        self.assertEqual(rc, 0)
+        self.assertIn("convergence report", seen["before_filing"].lower())
+
+    # -- (b) per-child band against the parent's, and the driving reason ---------------
+
+    def test_reports_each_childs_band_against_the_parents_and_the_driving_reason(
+            self) -> None:
+        # One child names nothing (bands lower); the other keeps the SAME weighted
+        # feature the parent has, so its own driving reason is what a reader must see.
+        small = "- **Slug:** tiny\n- **Defect / goal:** a small fix\n"
+        heavy = ("- **Slug:** heavy\n- **Defect / goal:** z\n- **Difficulty:** high\n"
+                 "- **External dependencies:** `sometool`\n")
+        self._write(_proposal(small, heavy))
+        text = split.convergence_report(self.parent, self._children(), self.cfg)
+        # Cross-checked against the SAME estimator the report itself calls, so this
+        # cannot drift into asserting a band the production code no longer produces.
+        parent_est = sizing.estimate(self.parent / "brief.md", self.cfg)
+        self.assertEqual(parent_est.band, sizing.WATCH)
+        self.assertIn(f"parent band: {parent_est.band}", text)
+        self.assertIn(f"child-1: band={sizing.OK} (lower than parent)", text)
+        self.assertIn("child-2: band=watch (same as parent)", text)
+        self.assertIn("difficulty=high", text)  # child-2's own driving reason, surfaced
+
+    def test_says_plainly_when_most_children_do_not_band_lower(self) -> None:
+        # Both children inherit the same weighted features as the parent — same
+        # difficulty, the same external dependency token apiece — so neither reads any
+        # smaller.
+        heavy = ("- **Slug:** heavy\n- **Defect / goal:** z\n- **Difficulty:** high\n"
+                 "- **External dependencies:** `sometool`\n")
+        self._write(_proposal(heavy, heavy))
+        text = split.convergence_report(self.parent, self._children(), self.cfg)
+        self.assertIn("NOT CONVERGED", text)
+        self.assertIn("do not band lower than the parent", text)
+
+    # -- (c) not blinded by an excluded sibling-conflict count -------------------------
+
+    def test_all_pairwise_conflicts_is_reported_as_not_converged(self) -> None:
+        """Every child conflicts with every sibling — the splitter's own statement that
+        the split separated nothing — reported even though each child's OWN band may
+        still look clean on its `reasons` line."""
+        c1 = "- **Slug:** a\n- **Defect / goal:** x\n- **Conflicts with:** child-2, child-3\n"
+        c2 = "- **Slug:** b\n- **Defect / goal:** y\n- **Conflicts with:** child-1, child-3\n"
+        c3 = "- **Slug:** c\n- **Defect / goal:** z\n- **Conflicts with:** child-1, child-2\n"
+        self._write(_proposal(c1, c2, c3))
+        text = split.convergence_report(self.parent, self._children(), self.cfg)
+        self.assertIn("NOT CONVERGED", text)
+        self.assertIn("every child conflicts with every sibling", text)
+
+    def test_a_partial_conflict_set_is_not_reported_as_all_pairwise(self) -> None:
+        c1 = "- **Slug:** a\n- **Defect / goal:** x\n- **Conflicts with:** child-2\n"
+        c2 = "- **Slug:** b\n- **Defect / goal:** y\n"
+        self._write(_proposal(c1, c2))
+        text = split.convergence_report(self.parent, self._children(), self.cfg)
+        self.assertNotIn("every child conflicts with every sibling", text)
+
+    def test_sibling_conflict_reading_prefers_the_exposed_estimate_field(self) -> None:
+        """Once `sizing.py` exposes `sibling_conflicts` (issue #457), the report reads
+        THAT count rather than re-deriving it — proven directly against the private
+        reader, independent of whether #457 has landed in this checkout yet."""
+        child = split.Child("child-1", "- **Conflicts with:** child-2\n")
+        est = SimpleNamespace(sibling_conflicts=5)
+        self.assertEqual(split._sibling_conflicts(child, est), 5)
+
+    def test_sibling_conflict_reading_falls_back_to_the_raw_count(self) -> None:
+        """Before #457 lands, every ordering ref at `preflight` time is a sibling label
+        by construction, so the raw count already IS the sibling-only count."""
+        child = split.Child("child-1", "- **Conflicts with:** child-2, child-3\n")
+        est = SimpleNamespace()  # no `sibling_conflicts` attribute
+        self.assertEqual(split._sibling_conflicts(child, est), 2)
+
+    # -- (d) the report's own stream can never abort acceptance ------------------------
+
+    def test_a_stream_that_fails_part_way_does_not_escape_preflight(self) -> None:
+        self._write(_proposal(
+            "- **Slug:** a\n- **Defect / goal:** x\n",
+            "- **Slug:** b\n- **Defect / goal:** y\n"))
+        stream = _FailingStream(fail_at=2)   # print() writes the text, then the newline
+        split.preflight(self.parent, self._children(), self.cfg, file=stream)
+        self.assertEqual(stream.calls, 2, "the guard must not have swallowed the write "
+                         "attempt entirely — it should still have tried")
+
+    def test_a_broken_stream_changes_neither_the_exit_code_nor_created_bundles(
+            self) -> None:
+        self._write(_proposal(
+            "- **Slug:** a\n- **Defect / goal:** x\n",
+            "- **Slug:** b\n- **Defect / goal:** y\n"))
+        stream = _FailingStream(fail_at=2)
+        with mock.patch.object(cli.sys, "stderr", stream), \
+             redirect_stdout(io.StringIO()):
+            rc = cli._split(self.cfg, SimpleNamespace(issue_id="500", accept=True,
+                                                       ids="601,602"))
+        self.assertEqual(rc, 0)
+        self.assertTrue(self.cfg.bundle("601").is_dir())
+        self.assertTrue(self.cfg.bundle("602").is_dir())
+
+    # -- (e) advisory and deterministic: never blocks, never changes what is filed -----
+
+    def test_the_report_never_raises_and_never_changes_the_created_set(self) -> None:
+        heavy = ("- **Slug:** heavy\n- **Defect / goal:** z\n- **Difficulty:** high\n"
+                 "- **External dependencies:** `sometool`\n")
+        self._write(_proposal(heavy, heavy))
+        before = split.accept  # sanity: not monkeypatched, the real path runs
+        self.assertIs(split.accept, before)
+        with redirect_stderr(io.StringIO()), redirect_stdout(io.StringIO()):
+            created = split.accept(self.parent, ["601", "602"], self.cfg)
+        self.assertEqual(len(created), 2)
+        self.assertTrue(self.cfg.bundle("601").is_dir())
+        self.assertTrue(self.cfg.bundle("602").is_dir())
+
+    def test_nothing_is_left_behind_by_staging_the_estimate(self) -> None:
+        """The temporary directory `_staged_estimate` uses must not survive it — the
+        proposal alone is read, nothing is written into the instance."""
+        self._write(_proposal("- **Slug:** a\n- **Defect / goal:** x\n"))
+        before = {p.name for p in self.parent.iterdir()}
+        split.convergence_report(self.parent, self._children(), self.cfg)
+        after = {p.name for p in self.parent.iterdir()}
+        self.assertEqual(before, after)
+
+
+if __name__ == "__main__":
+    unittest.main()
