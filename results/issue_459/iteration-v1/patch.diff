+def _staged_estimate(child: Child, sibling_labels: list[str], cfg):
+    """The structural estimate a materialised ``child`` would get, without writing
+    anything into the instance (issue #459).
+
+    No tracker id exists at `preflight` time — every ordering ref is a sibling LABEL by
+    construction (`_validate_ordering` above) — so this stages the child's own body and a
+    lineage record keyed by sibling LABELS (not ids) under a throwaway directory named for
+    the label, then reads it back through the same `sizing.estimate` a real materialised
+    bundle gets. `_LABEL_RE` (module top) pins every label to `child-\\d+`, so it is safe
+    to use as a path component — it cannot traverse out of the `TemporaryDirectory`, which
+    is removed on every exit, success or exception, leaving nothing behind.
+    """
+    from . import sizing  # lazy: sizing imports split, so this must not be a module import
+    with tempfile.TemporaryDirectory(prefix="pdca-split-report-") as tmp:
+        staged = Path(tmp) / child.label
+        staged.mkdir()
+        (staged / "brief.md").write_text(child.body, encoding="utf-8")
+        _write_lineage(staged / LINEAGE, {
+            "version": LINEAGE_VERSION,
+            "id": child.label,
+            "siblings": list(sibling_labels),
+        })
