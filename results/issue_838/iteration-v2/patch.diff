     return 1
 
 
+# The unresolved review threads of a PR, read generically (any reviewer, human or bot) by
+# its URL: GraphQL `resource(url:)` takes the URL `publish.json` records, so no owner /
+# repo / number has to be parsed out of it. The first comment of a thread is its remark.
+# The host serves the threads at most 100 a page; `$cursor` asks for the page after one.
+_THREADS_QUERY = """\
+query($url: URI!, $cursor: String) {
+  resource(url: $url) {
+    ... on PullRequest {
+      reviewThreads(first: 100, after: $cursor) {
+        pageInfo { hasNextPage endCursor }
+        nodes {
+          id isResolved isOutdated path line originalLine
+          comments(first: 1) { nodes { body url author { login } } }
+        }
+      }
+    }
+  }
+}"""
+
+REMARKS_FILE = "merge-remarks.json"
+
+
+def _merge_state(pr_url: str, wait_secs: int, *,
+                 poll_interval: int = 5) -> dict | None:
+    """``gh pr view --json mergeStateStatus,reviewDecision,latestReviews`` of ``pr_url``
+    (``merged._pr_view``), or None when it cannot be read. GitHub computes
+    ``mergeStateStatus`` in the background, so straight after ``gh pr ready`` it can read
+    ``UNKNOWN``: that read is polled through ``_sleep``, bounded by ``wait_secs`` (the
+    ``[driver].merge_wait_secs`` budget the #462 rollup wait uses), and a state still
+    ``UNKNOWN`` when the budget is spent is returned as it is: not blocked by remarks."""
+    waited = 0
+    while True:
+        info = merged._pr_view(pr_url, "mergeStateStatus,reviewDecision,latestReviews")
+        if info is None or info.get("mergeStateStatus") != "UNKNOWN" or waited >= wait_secs:
+            return info
+        step = min(poll_interval, wait_secs - waited)
+        _sleep(step)
+        waited += step
+
+
+def _review_threads(pr_url: str) -> list[dict] | None:
+    """PR ``pr_url``'s UNRESOLVED review threads (``gh api graphql``), one dict per thread
+    — ``id``, ``path``, ``line``, ``outdated``, ``body``, ``author``, ``url`` — or None when
+    a query fails or its answer cannot be read. Every page is read, each one asked for with
+    the end cursor of the page before it: an unresolved thread can sit behind a full page
+    of resolved ones. A next page claimed with no cursor, or with one already followed,
+    cannot be read to the end, so that is None too, never an endless read. An outdated
+    thread has no ``line`` (it is ``null`` once the code under it changed), so its
+    ``originalLine`` is reported; a thread on a whole file has neither."""
+    threads: list[dict] = []
+    cursor = None
+    followed: set[str] = set()
+    while True:
+        cmd = ["gh", "api", "graphql", "-f", f"query={_THREADS_QUERY}", "-f", f"url={pr_url}"]
+        if cursor:
+            cmd += ["-f", f"cursor={cursor}"]
+        r = subprocess.run(cmd, capture_output=True, text=True)
+        if r.returncode != 0:
+            return None
+        try:
+            conn = json.loads(r.stdout or "")["data"]["resource"]["reviewThreads"]
+            nodes, page = conn["nodes"], conn["pageInfo"]
+        except (ValueError, KeyError, TypeError):
+            return None
+        if not isinstance(nodes, list) or not isinstance(page, dict):
+            return None
+        for t in nodes:
+            if not isinstance(t, dict) or t.get("isResolved"):
+                continue
+            first = ((t.get("comments") or {}).get("nodes") or [{}])[0] or {}
+            line = t.get("line")
+            threads.append({
+                "id": t.get("id"),
+                "path": t.get("path"),
+                "line": line if line is not None else t.get("originalLine"),
+                "outdated": bool(t.get("isOutdated")),
+                "body": first.get("body") or "",
+                "author": (first.get("author") or {}).get("login") or "",
+                "url": first.get("url") or "",
+            })
+        if not page.get("hasNextPage"):
+            return threads
+        cursor = page.get("endCursor")
+        if not isinstance(cursor, str) or not cursor or cursor in followed:
+            return None
+        followed.add(cursor)
+
+
+def _remarks_block(d: Path, pr_url: str, wait_secs: int) -> str:
+    """Why ``pr_url``'s failed ``gh pr merge`` is a block by review remarks, or "" when it
+    is not one this can name (issue #838). Only a ``BLOCKED`` merge state is looked into;
+    a block with no unresolved thread and no CHANGES_REQUESTED review (a required approval
+    still missing, a ruleset) returns "" so the caller keeps its generic refusal. When it is
+    a remarks block, the threads and the reviews requesting changes are written to
+    ``d/merge-remarks.json`` and the reason names each thread's path:line. ``_merge_one``
+    removes that file when an attempt starts, so it only ever names the remarks the attempt
+    that wrote it stopped on."""
+    info = _merge_state(pr_url, wait_secs)
+    if not info or info.get("mergeStateStatus") != "BLOCKED":
+        return ""
+    threads = _review_threads(pr_url)
+    reviews = info.get("latestReviews")
+    changes = sorted({str(((r.get("author") or {}).get("login")) or "?")
+                      for r in (reviews if isinstance(reviews, list) else [])
+                      if isinstance(r, dict) and r.get("state") == "CHANGES_REQUESTED"})
+    if not changes and info.get("reviewDecision") == "CHANGES_REQUESTED":
+        changes = ["?"]
+    if not threads and not changes:
+        if threads is None:
+            print(f"   merge: {pr_url} is BLOCKED, and its review threads could not be read "
+                  "(`gh api graphql` failed)", file=sys.stderr)
+        return ""
+    threads = threads or []
+    (d / REMARKS_FILE).write_text(json.dumps({
+        "pr_url": pr_url,
+        "mergeStateStatus": "BLOCKED",
+        "threads": threads,
+        "changes_requested_by": changes,
+    }, indent=2) + "\n", encoding="utf-8")
+    parts = []
+    if threads:
+        where = "; ".join(f"{t['path']}{'' if t['line'] is None else ':' + str(t['line'])}"
+                          f"{' (outdated)' if t['outdated'] else ''} by {t['author'] or '?'}"
+                          for t in threads)
+        parts.append(f"{len(threads)} unresolved review thread(s) — {where}")
+    if changes:
+        parts.append(f"a CHANGES_REQUESTED review by {', '.join(changes)}")
+    return (f"the host blocks its merge: it is blocked by {' and by '.join(parts)}. The "
+            f"remarks are written to {d / REMARKS_FILE}")
+
