+def _remarks_block(d: Path, pr_url: str, wait_secs: int) -> str:
+    """Why ``pr_url``'s failed ``gh pr merge`` is a block by review remarks, or "" when it
+    is not one this can name (issue #838). Only a ``BLOCKED`` merge state is looked into;
+    a block with no unresolved thread and no CHANGES_REQUESTED review (a required approval
+    still missing, a ruleset) returns "" so the caller keeps its generic refusal. When it is
+    a remarks block, the threads and the reviews requesting changes are written to
+    ``d/merge-remarks.json`` and the reason names each thread's path:line. ``_merge_one``
+    removes that file when an attempt starts, so it only ever names the remarks the attempt
+    that wrote it stopped on.
+
+    In that file ``threads`` is a list when the threads were read (``[]``: there are none)
+    and ``null`` when they could not be, beside a review requesting changes: unknown, so
+    nothing reading the file may take it for none. Whichever way this ends the caller still
+    has the PR to return to draft, so a file that cannot be written is reported in the
+    reason, not raised."""
+    info = _merge_state(pr_url, wait_secs)
+    if not info or info.get("mergeStateStatus") != "BLOCKED":
+        return ""
+    threads = _review_threads(pr_url)
+    reviews = info.get("latestReviews")
+    changes = sorted({_login(r) or "?" for r in (reviews if isinstance(reviews, list) else [])
+                      if isinstance(r, dict) and r.get("state") == "CHANGES_REQUESTED"})
+    if not changes and info.get("reviewDecision") == "CHANGES_REQUESTED":
+        changes = ["?"]
+    if not threads and not changes:
+        if threads is None:
+            print(f"   merge: {pr_url} is BLOCKED, and its review threads could not be read "
+                  "(`gh api graphql`)", file=sys.stderr)
+        return ""
+    try:
+        (d / REMARKS_FILE).write_text(json.dumps({
+            "pr_url": pr_url,
+            "mergeStateStatus": "BLOCKED",
+            "threads": threads,
+            "changes_requested_by": changes,
+        }, indent=2) + "\n", encoding="utf-8")
+        written = f"The remarks are written to {d / REMARKS_FILE}"
+    except OSError as e:
+        written = f"The remarks could not be written to {d / REMARKS_FILE} ({e})"
+    parts = []
+    if threads:
+        where = "; ".join(f"{t['path']}{'' if t['line'] is None else ':' + str(t['line'])}"
+                          f"{' (outdated)' if t['outdated'] else ''} by {t['author'] or '?'}"
+                          for t in threads)
+        parts.append(f"{len(threads)} unresolved review thread(s) — {where}")
+    if changes:
+        parts.append(f"a CHANGES_REQUESTED review by {', '.join(changes)}")
+    unread = ("" if threads is not None else " Its review threads could not be read (`gh api "
+              "graphql`), so there may be unresolved ones too.")
+    return (f"the host blocks its merge: it is blocked by {' and by '.join(parts)}.{unread} "
+            f"{written}")
+
