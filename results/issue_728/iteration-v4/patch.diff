+++ b/template/tests/test_flow_carried_prereq_bases.py
@@ -0,0 +1,757 @@
+"""A dependent of a bundle the run carried is built on a base of its own (#728).
+
+Since #727 an in-batch bundle is built on a base holding exactly the accepted work of the
+bundles it is ordered after. A re-issued run carries the ids an earlier run finished onto
+its line before wave 0 (#646), and a closure that reached one of those, or a finished one
+with no patch, kept the run's line: ``D`` (``Depends on: P``) was cut from a line that also
+held ``X``, unrelated. Now a carried bundle is a member of its dependents' bases, held to
+the head the carry took, and a finished bundle with no patch is a node the walk passes
+through, never a member. The carry follows plain ``Depends on`` edges through such a node
+too: what a bundle reaches through it is carried, or, when it is held, so is the bundle,
+and so is a finished bundle built on it (#652). A carried bundle whose PR merged and whose
+branch was deleted has its work on the base when the base has that merge — at the carry,
+or by the time a dependent's base is built: it is walked through as well, never a member,
+and the commits a member built on it brings in are its. Of two finished ``Conflicts with``
+partners, the one whose work is below the commit the other was cut from was built first,
+and only that one is on the other's dependents' bases. A member cut from a base of its own
+brings in what that base held, the work of the bundles it was ordered after, carried or
+not — unless a PR of that work was closed since. A carried branch that brings in other
+work no member owns, or that was rewritten after the carry, stops the dependent instead
+of building it on a wrong base.
+
+Real git on the ``StackFoldGit`` fixture (tests/test_integrate_stack_bases.py, loaded by
+path) through ``flow._drive_and_act``, as tests/test_flow_dependency_scoped_bases.py does:
+build and sign-off stubbed, ``flow._publish_bundle`` cutting each PR branch from the
+recorded stack-base tip, ``gh`` stubbed (a PR is OPEN unless a case says otherwise; its
+head is the branch's tip, or the head it had once a case deletes the branch), the
+publisher not a stub. A re-issue drives only the unfinished ids, as ``pdca flow <ids>``
+does. Only modules are imported, so with the fix reverted these load, run and fail.
+    cd template && PYTHONPATH=src python3 -m unittest tests.test_flow_carried_prereq_bases
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import importlib.util
+import io
+import json
+import subprocess
+import unittest
+from collections.abc import Callable
+from contextlib import ExitStack, redirect_stderr, redirect_stdout
+from pathlib import Path
+from unittest import mock
+
+from pdca_harness import flow, integrate, publish, state
+
+_SPEC = importlib.util.spec_from_file_location(
+    "stack_bases_fixture", Path(__file__).with_name("test_integrate_stack_bases.py"))
+sb = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(sb)
+
+TODAY = "2026-10-17"
+
+
+class CarriedPrereqBases(unittest.TestCase):
+
+    def setUp(self) -> None:
+        self.fx = sb.StackFoldGit()          # the fixture's real-git setUp/tearDown and helpers
+        self.fx.setUp()
+        self.addCleanup(self.fx.tearDown)
+        self.cfg = self.fx.cfg
+        self.cfg.publisher = dataclasses.replace(self.cfg.publisher, mode="command")
+        self.close: set[str] = set()                         # closed with no patch
+        self.failing: set[str] = set()                       # build fails: stays PLANNED
+        self.gh: dict[str, str] = {}                         # PR state by id (else OPEN)
+        self.gh_heads: dict[str, str] = {}                   # PR head by id, its branch gone
+        self.merge_oid: dict[str, str] = {}                  # the commit a PR's merge made
+        self.after_line_fold: Callable[[], None] | None = None   # run once, after a fold
+        # bundle → (stack base, recorded tip, origin's tip of that base) when it was built
+        self.seen: dict[str, tuple[str, str, str | None]] = {}
+        self.err = ""                                        # the last run's stderr
+        self._real_run = subprocess.run
+
+    # -- fixture ---------------------------------------------------------------------------
+
+    def _plan(self, iid: str, *, depends_on: str = "", conflicts_with: str = "") -> Path:
+        """Planned bundle ``iid`` on org/repo @ main, with ``Depends on: depends_on`` and
+        ``Conflicts with: conflicts_with``."""
+        d = self.cfg.bundle(iid)
+        d.mkdir(parents=True, exist_ok=True)
+        (d / "brief.md").write_text(
+            f"- **Slug:** {iid.lower()}\n- **Repo + branch target:** org/repo @ main\n"
+            + (f"- **Depends on:** {depends_on}\n" if depends_on else "")
+            + (f"- **Conflicts with:** {conflicts_with}\n" if conflicts_with else ""),
+            encoding="utf-8")
+        return d
+
+    def _finished(self, iid: str, *, cut_from: str = "origin/main") -> Path:
+        """``iid`` finished in an earlier run: its branch cut from ``cut_from``, published
+        (its PR open) and accepted."""
+        d = self.fx._publish(iid, {f"{iid.lower()}.txt": f"{iid}\n"}, cut_from=cut_from)
+        sb._accept(d)
+        self.assertEqual(state.state(d), state.COMPLETE)
+        return d
+
+    # -- stubs -----------------------------------------------------------------------------
+
+    def _gh_stub(self, args, *a, **kw):
+        """Any ``gh`` call is answered with the PR's state (``self.gh``, else OPEN), its head
+        (``self.gh_heads``, else its branch's tip on origin) and the commit its merge put on
+        the branch it merged into (``self.merge_oid``, else none)."""
+        if not (isinstance(args, list) and args[:1] == ["gh"]):
+            return self._real_run(args, *a, **kw)
+        iid = str(args[3]).rsplit("/", 1)[-1]
+        head = self.gh_heads.get(iid) or (
+            self.fx._tip(f"fix/{iid}") if self.fx._has(f"fix/{iid}") else "")
+        oid = self.merge_oid.get(iid)
+        return subprocess.CompletedProcess(args, 0, json.dumps(
+            {"state": self.gh.get(iid, "OPEN"), "headRefOid": head,
+             "mergeCommit": {"oid": oid} if oid else None}), "")
+
+    def _drive_wave(self, cfg, wave: list[Path], **_kw) -> int:
+        """Record what each bundle is built on, then build and accept it — a failing one is
+        left as it was, a closed one gets no patch."""
+        for d in wave:
+            iid = d.name.removeprefix("issue_")
+            base = publish.read_stack_base(d)
+            self.seen[d.name] = (base, publish.read_stack_base_tip(d),
+                                 self.fx._tip(base) if base and self.fx._has(base) else None)
+            if iid in self.failing:
+                continue
+            if iid in self.close:
+                (d / state.CLOSE_MARKER).write_text("likely-close\n", encoding="utf-8")
+            else:
+                (d / "patch.diff").write_text(
+                    sb._new_file_patch(f"{iid.lower()}.txt", iid), encoding="utf-8")
+            sb._accept(d)
+        return 1
+
+    def _publish_bundle(self, cfg, d: Path, **_kw) -> bool:
+        """What publish does: cut ``fix/<iid>`` from the recorded stack-base tip (else that
+        base, else main), commit the bundle's file signed off, push it and record it."""
+        iid = d.name.removeprefix("issue_")
+        if iid in self.close:
+            return False
+        tip, base = publish.read_stack_base_tip(d), publish.read_stack_base(d)
+        cut = tip or (f"origin/{base}" if base else "origin/main")
+        repo = self.fx.primary
+        sb._git(repo, "fetch", "-q", "origin")
+        sb._git(repo, "checkout", "-q", "-B", f"fix/{iid}", cut)
+        (repo / f"{iid.lower()}.txt").write_text(f"{iid}\n", encoding="utf-8")
+        sb._git(repo, "add", "--all")
+        sb._git(repo, "commit", "-q", "-s", "-m", f"fix {iid}")
+        sb._git(repo, "push", "-q", "origin", f"fix/{iid}")
+        sb._git(repo, "checkout", "-q", "main")
+        (d / "publish.json").write_text(json.dumps(
+            {"mode": "new-pr" if cut == "origin/main" else "stacked-pr",
+             "branch": f"fix/{iid}", "base": "main", "repo": "org/repo",
+             "pr_url": f"https://example.test/pr/{iid}"}), encoding="utf-8")
+        return True
+
+    def _run(self, ids: list[str], *, drive: list[str] | None = None) -> None:
+        """One stack-mode run asked for ``ids``, driving ``drive`` (default: all)."""
+        self.ids = list(ids)
+        self.line = integrate.integration_branch(self.cfg, "main", ids)
+        self.seen = {}
+        real_fold = integrate.fold
+
+        def fold(*a, **kw):
+            out = real_fold(*a, **kw)
+            hook, self.after_line_fold = self.after_line_fold, None
+            if hook is not None:
+                hook()
+            return out
+
+        err = io.StringIO()
+        with ExitStack() as stack:
+            stack.enter_context(mock.patch.object(subprocess, "run", self._gh_stub))
+            stack.enter_context(mock.patch.object(flow, "_drive_wave", self._drive_wave))
+            stack.enter_context(mock.patch.object(flow, "_publish_bundle",
+                                                  self._publish_bundle))
+            stack.enter_context(mock.patch.object(publish, "draft_texts",
+                                                  lambda *a, **k: True))
+            stack.enter_context(mock.patch.object(integrate, "fold", fold))
+            stack.enter_context(redirect_stdout(io.StringIO()))
+            stack.enter_context(redirect_stderr(err))
+            self.results = flow._drive_and_act(
+                self.cfg, [self.cfg.bundle(i) for i in (drive or ids)], do_publish=True,
+                do_act=False, by="T", today=TODAY, batch=ids)
+        self.err = err.getvalue()
+        self.assertNotIn("Traceback", self.err)
+
+    def _first_run(self, ids: list[str], **want: str) -> None:
+        """The earlier run, asked for ``ids``: each id of ``want`` ends in that state."""
+        self._run(ids)
+        for iid, st in want.items():
+            self.assertEqual(self.results[iid], st, (iid, self.err))
+        self.failing.clear()
+
+    def _merged_and_deleted(self, iid: str, *, squash: bool, into: str = "main") -> str:
+        """The maintainer merges ``iid``'s PR into ``into`` (started from main when origin
+        has no such branch) — squashed into one new commit, or with a merge commit — and the
+        host deletes ``fix/<iid>``, as GitHub's auto-delete does. The host then reports the
+        PR MERGED, with the head it merged and the commit the merge made. Returns that
+        commit."""
+        h, head = self.fx.human, self.fx._tip(f"fix/{iid}")
+        sb._git(h, "fetch", "-q", "origin")
+        sb._git(h, "checkout", "-q", "-B", into,
+                f"origin/{into}" if self.fx._has(into) else "origin/main")
+        if squash:
+            sb._git(h, "merge", "-q", "--squash", f"origin/fix/{iid}")
+            sb._git(h, "commit", "-q", "-s", "-m", f"fix {iid} (#{iid})")
+        else:
+            sb._git(h, "merge", "-q", "--no-ff", "--no-edit", f"origin/fix/{iid}")
+        sb._git(h, "push", "-q", "origin", into)
+        self.fx._delete(f"fix/{iid}")
+        self.gh[iid], self.gh_heads[iid] = "MERGED", head
+        self.merge_oid[iid] = self.fx._tip(into)
+        return self.merge_oid[iid]
+
+    # -- helpers ---------------------------------------------------------------------------
+
+    def _base(self, iid: str) -> str:
+        return integrate.bundle_base_branch(self.cfg, "main", self.ids, f"issue_{iid}")
+
+    def _work(self, iid: str, under: tuple[str, ...] = ()) -> list[str]:
+        """Every non-merge commit of ``fix/<iid>`` that main does not have — or, given
+        ``under``, that no branch of ``under`` has either: ``iid``'s own work above them."""
+        work = sb._git(self.fx.origin, "rev-list", "--no-merges", f"fix/{iid}", "--not",
+                       "main", *(f"fix/{u}" for u in under)).split()
+        self.assertTrue(work, iid)
+        return work
+
+    def _holds(self, rev: str, *iids: str) -> None:
+        for iid in iids:
+            self.assertEqual([c for c in self._work(iid) if not self.fx._ancestor(c, rev)], [],
+                             (rev, iid, self.err))
+
+    def _lacks(self, rev: str, *iids: str, under: tuple[str, ...] = ()) -> None:
+        for iid in iids:
+            self.assertEqual([c for c in self._work(iid, under) if self.fx._ancestor(c, rev)],
+                             [], (rev, iid, self.err))
+
+    def _own_base(self, iid: str) -> str:
+        """``iid`` was built on a base of its own — the branch ``bundle_base_branch`` names,
+        never the run's line — at the tip origin had then, and is COMPLETE; returns that
+        tip."""
+        self.assertIn(f"issue_{iid}", self.seen, self.err)
+        base, tip, at = self.seen[f"issue_{iid}"]
+        self.assertNotEqual(base, self.line, self.err)
+        self.assertEqual(base, self._base(iid), self.err)
+        self.assertEqual(tip, at, self.err)
+        self.assertEqual(self.results[iid], state.COMPLETE, self.err)
+        return tip
+
+    def _on_real_base(self, iid: str) -> None:
+        """``iid`` was built on the real base — no stack-base record — and is COMPLETE."""
+        self.assertIn(f"issue_{iid}", self.seen, self.err)
+        self.assertEqual(self.seen[f"issue_{iid}"][:2], ("", ""), self.err)
+        self.assertEqual(self.results[iid], state.COMPLETE, self.err)
+
+    def _stopped(self, iid: str, *parts: str) -> str:
+        """``iid`` was never built: PLANNED, with no stack-base record and no base of its own
+        on origin, and ONE ``STOPPING`` line names each of ``parts``. Returns that line."""
+        self.assertNotIn(f"issue_{iid}", self.seen, self.err)
+        self.assertEqual(self.results[iid], state.PLANNED, self.err)
+        self.assertEqual(publish.read_stack_base(self.cfg.bundle(iid)), "")
+        self.assertFalse(self.fx._has(self._base(iid)), self.err)
+        stop = [x for x in self.err.splitlines() if "STOPPING" in x]
+        self.assertEqual(len(stop), 1, self.err)
+        for part in parts:
+            self.assertIn(part, stop[0])
+        return stop[0]
+
