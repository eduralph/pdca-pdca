+def _holds_work(repo: Path, at: str, tip: str, base_ref: str, since: str, *, every: bool,
+                what: str) -> bool:
+    """Whether commit ``at`` holds the non-merge commits ``tip`` reaches that neither
+    ``base_ref`` nor ``since`` (``""``: none) does: some of them, or with ``every`` each one
+    — never when there are none. False when ``repo`` does not have one of those commits, or
+    ``base_ref``; a git failure raises :class:`integrate.IntegrationError` (``what``: the
+    read)."""
+    if any(integrate._rev(repo, c) is None for c in (at, tip, base_ref, since) if c):
+        return False
+    span = ("rev-list", "--no-merges", tip, "--not", base_ref, *((since,) if since else ()))
+    work = integrate._out(repo, *span, what=what).split()
+    left = integrate._out(repo, *span, at, what=what).split() if work else []
+    return bool(work) and (not left if every else len(left) < len(work))
