+    line = integrate.integration_branch(cfg, base)              # the line's name, unscoped
+    own = integrate.bundle_base_branch(cfg, base, None, m.name)[len(line):]    # "-b<id>"
+    shape = re.escape(line) + r"(?:-r[0-9a-f]+)?" + re.escape(own)    # any batch's (#591)
