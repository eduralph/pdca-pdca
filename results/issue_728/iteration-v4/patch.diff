+        base_ref = f"{cfg.base_remote}/{base}"
+        for n in partners:
+            own = publish.read_stack_base_tip(graph[n][0])
+            what = f"the work of {n} below {m}'s recorded cut point {cut[:12]}"
+            if n in carried:          # some of its own work, above its own cut point
+                below = _holds_work(repo, cut, carried[n], base_ref, own, every=False,
+                                    what=what)
+            else:                     # no patch: all it was built on, if anything
