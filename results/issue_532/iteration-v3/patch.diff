+    print(f"leaves: {d.name} — the builder leaf died of a TRANSIENT infrastructure failure "
+          f"(exit {getattr(exc, 'returncode', '?')}) — infra the harness absorbs, not a "
+          "build that failed on the merits — and it has stopped after "
+          f"{_attempts_spent(exc)} attempt(s). Every attempt's own account is in "
+          f"{BUILD_ERROR_LOG}.", file=sys.stderr)
