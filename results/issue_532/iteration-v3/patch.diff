+def _died_of_a_signal(rc: int) -> bool:
+    """Both spellings of "this process was killed; it did not choose to exit".
+
+    * **negative** — ``subprocess`` reports a signal death of the process IT spawned as
+      ``-N``, and ``progress.TIMEOUT_RC`` (the harness's own kill) sits there too.
+    * **128+N** — the POSIX shell convention. The moment ``argv[0]`` is a WRAPPER (``sh
+      -c …``, ``docker run``, the ``local-build`` executor docs/04-do.md:47 suggests) the
+      process that dies is the wrapper's child, and what reaches the harness is its own exit
+      status: 137 for a SIGKILL, 143 for a SIGTERM. Excluding only the negative form left
+      that door open — an OOM kill retried three times, each repeating what exhausted the
+      bound. The cost of reading 128..255 as a signal is that a leaf choosing such an exit
+      status of its own is not retried: one spawn, re-raised, exactly today's behaviour.
+    """
+    return rc < 0 or rc >= 128
+
