+        with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
+            leaves.run_advisory_leaves(self.d, self.cfg, only_missing=True)
+        self.assertTrue(leaves.advisory_artifact(self.d, "lens").exists())
+
