+def _builder_retryable(exc: Exception) -> bool:
+    """The builder's retry rule: :func:`_transient_death`, minus a death the child did not
+    choose (#506, scope-bounded by #510).
+
+    A leaf killed from outside — the #420 memory cap's SIGKILL is the shipped way to earn
+    one — emits no stream event, so it reads ``transient``. Retrying that is not absorbing
+    infrastructure: it re-runs, twice more, the very build that exhausted its bound, and
+    tells the operator the failure was absorbed infra while ``build.error.log`` says
+    ``Killed``. #510 states a signal death "is neither #506's transient nor #421's
+    preflight" — its own question — so this does not classify it: it declines to retry it,
+    leaving that case exactly where it is today (one spawn, the failure re-raised).
+    """
+    rc = getattr(exc, "returncode", None)
+    return _transient_death(exc) and not (isinstance(rc, int) and _died_of_a_signal(rc))
+
