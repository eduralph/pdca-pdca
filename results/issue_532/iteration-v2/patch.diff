+#: Trailer on an error log whose leaf has NOT finished its retry loop (#506). The record of
+#: the attempt that just failed is flushed BEFORE the next attempt starts, so a run killed in
+#: that window leaves a log for a leaf that neither succeeded nor gave up. Without this
+#: marker the #369 discriminator ("an error log means the leaf ran and FAILED") would retire
+#: a leaf that was merely interrupted — and a bundle could reach sign-off with NO review.
+_LEAF_IN_FLIGHT = "<!-- pdca:leaf-attempt in-flight — the retry loop had not finished -->"
+
+
+def _write_attempt_records(error_log: Path, records: list[str], *, in_flight: bool) -> None:
+    """Persist the failed attempts so far. Called after EVERY failure, so the account of
+    attempt N is on disk while attempt N+1 runs (a retried leaf can be pointed at it) and a
+    run killed mid-retry still leaves one — instead of only once the loop ends. A write that
+    fails must never mask the leaf's own failure, which is returned to the caller either
+    way."""
+    body = "".join(records)
+    if in_flight:
+        body += _LEAF_IN_FLIGHT + "\n"
+    try:
+        error_log.write_text(body, encoding="utf-8")
+    except OSError as exc:
+        print(f"leaves: could not write {error_log.name} ({exc}); the leaf's failure is "
+              "returned unchanged", file=sys.stderr)
+
+
+def leaf_run_incomplete(error_log: Path) -> bool:
+    """True iff ``error_log`` was left by a leaf INTERRUPTED mid-retry (#506).
+
+    Its last write was a per-attempt flush with a retry still pending, so the run ended
+    without the leaf either succeeding or exhausting its budget. Absent/unreadable ⇒ False:
+    a file that is not there says nothing about an in-flight retry."""
+    try:
+        return _LEAF_IN_FLIGHT in error_log.read_text(encoding="utf-8")
+    except OSError:
+        return False
+
+
+def _leaf_ran_and_failed(error_log: Path) -> bool:
+    """The #138 failed-leaf discriminator, #506-aware: an error log means the leaf ran and
+    FAILED — *unless* it is still in flight, which is "interrupted", not "gave up"."""
+    return error_log.exists() and not leaf_run_incomplete(error_log)
+
+
+#: How much of a dead attempt's artifact is kept in the error log. Bounded: the log is read
+#: by a human and shipped in the bundle, and a runaway leaf could write an arbitrarily large
+#: file. Big enough for a full 5/5/1 verdict table many times over.
+_RESIDUE_KEEP = 20_000
+
+
+def _withdraw_residue(artifact: Path | None, attempt: int) -> tuple[str, bool]:
+    """Take a dead attempt's claim on ``artifact`` away, keeping its text: ``(record, ok)``.
+
+    Attempt ownership (#506): the harvest sites copy their artifact ``if it exists``, with
+    no notion of WHICH attempt wrote it — so a truncated verdict a dead attempt left in the
+    sandbox is adopted as the output of the attempt that succeeded. Called after a FAILED
+    attempt, so whatever stands at that path is that attempt's residue and nothing else.
+
+    Preserved, not merely deleted: the text goes into the record this attempt is about to
+    write to the bundle's ``*.error.log`` — bundle-local (the sandbox around it is a
+    :class:`~tempfile.TemporaryDirectory` that dies with the run), archived per round
+    (``state.DOWNSTREAM_GLOBS``) and already named by the failed-leaf placeholder. A real
+    verdict must not be destroyed while the operator is told none was produced.
+
+    Fail **closed**: ``ok`` is False iff the file is still there afterwards, and the caller
+    stops retrying rather than run another attempt over a path it no longer owns —
+    continuing would be exactly the adoption this exists to prevent.
+    """
+    if artifact is None or not artifact.exists():
+        return "", True
+    try:
+        text = artifact.read_text(encoding="utf-8", errors="replace")
+    except OSError as exc:
+        text = f"(unreadable: {exc})"
+    if len(text) > _RESIDUE_KEEP:
+        text = f"{text[:_RESIDUE_KEEP]}\n… truncated ({len(text)} characters in all)"
+    record = (f"----- attempt {attempt} — the {artifact.name} it left behind "
+              f"(withdrawn: a dead attempt's artifact is never harvested) -----\n"
+              f"{text.strip()}\n\n")
+    try:
+        artifact.unlink()
+    except OSError as exc:
+        print(f"leaves: could not withdraw the {artifact.name} attempt {attempt} left "
+              f"behind ({exc}) — stopping the retries rather than run another attempt "
+              "over a file that would be harvested as its output", file=sys.stderr)
+        return record, False
+    return record, True
+
