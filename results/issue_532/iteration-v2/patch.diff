+def _builder_retryable(exc: Exception) -> bool:
+    """The builder's retry rule: :func:`_transient_death`, minus a death the child did not
+    choose (#506, scope-bounded by #510).
+
+    A leaf killed from outside — the #420 memory cap's SIGKILL is the shipped way to earn
+    one — exits on a signal, and having emitted no stream event it reads ``transient``.
+    Retrying that is not absorbing infrastructure: it re-runs, twice more, the very build
+    that exhausted its bound, and tells the operator the failure was absorbed infra while
+    ``build.error.log`` says otherwise. #510 states a signal death "is neither #506's
+    transient nor #421's preflight" — its own question — so this does not classify it: it
+    declines to retry it, leaving that case exactly where it is today (one spawn, the
+    failure re-raised). ``subprocess`` reports a signal death as a NEGATIVE returncode,
+    which is also where ``progress.TIMEOUT_RC`` sits: neither is the child's own exit
+    status, and neither is evidence that a retry would fare differently.
+    """
+    rc = getattr(exc, "returncode", None)
+    return _transient_death(exc) and not (isinstance(rc, int) and rc < 0)
