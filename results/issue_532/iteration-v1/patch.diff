+def _write_attempt_records(error_log: Path, records: list[str]) -> None:
+    """Persist the failed attempts so far. Called after EVERY failure, so the file exists
+    while the next attempt runs — and after a run killed mid-backoff — instead of only once
+    the loop ends. A write that fails must never mask the leaf's own failure, which is
+    returned to the caller either way."""
