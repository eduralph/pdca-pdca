+def _disown_artifact(artifact: Path | None, attempt: int) -> None:
+    """Withdraw any file sitting where this leaf writes its output, before an attempt runs.
+
+    Attempt ownership (#506): the harvest sites copy their artifact ``if it exists``, with
+    no notion of WHICH attempt wrote it — so a truncated verdict a dead attempt left in the
+    sandbox is adopted as the output of the attempt that actually succeeded. Renamed, not
+    deleted: the dead attempt's text stays readable beside it for the run's post-mortem;
+    only its claim to be this leaf's output is withdrawn. ``None`` (the builder) opts out —
+    its residue must stay exactly where it is."""
+    if artifact is None or not artifact.exists():
+        return
+    try:
+        artifact.replace(artifact.with_name(f"{artifact.name}.before-attempt{attempt}"))
+    except OSError as exc:
+        # Fail CLOSED: residue that cannot be set aside must not stay harvestable either,
+        # or the very adoption this prevents happens when the rename is what failed.
+        with contextlib.suppress(OSError):
+            artifact.unlink()
+        print(f"leaves: could not set {artifact.name} aside before attempt {attempt} "
+              f"({exc}); dropped it — a dead attempt's file must never be harvested as "
+              f"a live one's output", file=sys.stderr)
+
