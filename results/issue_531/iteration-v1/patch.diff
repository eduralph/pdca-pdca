+        self.assertEqual(rc, 0, err)
+        b_updated = host.head[PR_B]
+        self.assertNotEqual(b_updated, b_original)                 # B was brought up to date
+        self.assertEqual(host.contains[b_updated], 1)              # ...and contains A's merge
+        self.assertEqual(host.merged, [(PR_A, host.head[PR_A]), (PR_B, b_updated)])
+        update = self._index(host, ["gh", "pr", "update-branch", PR_B])
+        self.assertEqual(host.calls[update], ["gh", "pr", "update-branch", PR_B])  # no --rebase
+        merge_b = self._index(host, ["gh", "pr", "merge", PR_B])
+        self.assertLess(self._index(host, ["gh", "pr", "merge", PR_A]), update)
+        self.assertLess(update, merge_b)
+        # The rollup read between the update and B's merge described the UPDATED head.
+        b_reads = [h for u, h in host.checks if u == PR_B]
+        self.assertTrue(b_reads)
+        self.assertEqual(set(b_reads), {b_updated})
+        checks_b = [i for i, c in enumerate(host.calls) if c[:4] == ["gh", "pr", "checks", PR_B]]
+        self.assertTrue(all(update < i < merge_b for i in checks_b))
+        self.assertEqual(host.calls[merge_b][-2:], ["--match-head-commit", b_updated])
