+# ---- issue #531: merge only a head that contains the base it merges into -------------
+
+PR_A = "https://github.com/org/repo/pull/1"
+PR_B = "https://github.com/org/repo/pull/2"
+
+
+class _Host:
+    """A stateful fake of the GitHub host behind `gh`, keyed by PR URL (issue #531).
+
+    The base is a counter of merges. Every head SHA records how many base commits it
+    contains; a head is behind by (base merges so far) - (what it contains). `gh pr
+    merge` merges unconditionally — like a host whose branch protection does NOT require
+    up-to-date branches, the case where a stale PR silently lands — unless it is pinned
+    (`--match-head-commit`) to a SHA that is no longer the PR's head. `gh pr
+    update-branch` gives the PR a new head that contains the current base. Every `gh pr
+    checks` read is logged with the head it described."""
+
+    def __init__(self, *urls: str) -> None:
+        self.base = 0
+        self.head = {u: f"{n}" * 40 for n, u in enumerate(urls, start=2)}
+        self.contains = {h: 0 for h in self.head.values()}
+        self.calls: list[list[str]] = []
+        self.checks: list[tuple[str, str]] = []        # (url, head the rollup described)
+        self.merged: list[tuple[str, str | None]] = []  # (url, the SHA it was pinned to)
+        self.update_fails: set[str] = set()
+        self.red_heads: set[str] = set()                # heads whose rollup is failing
+        self.push_after_checks: dict[str, int] = {}     # url -> push after N checks reads
+        self.push_at_merge: set[str] = set()            # url -> push races the merge
+
+    def _push(self, url: str) -> None:
+        new = f"p{len(self.contains)}".ljust(40, "0")
+        self.contains[new] = self.contains[self.head[url]]
+        self.head[url] = new
+
+    def __call__(self, cmd: list[str], **kw) -> SimpleNamespace:
+        self.calls.append(list(cmd))
+        ok = SimpleNamespace(returncode=0, stdout="", stderr="")
+        if cmd[:3] == ["gh", "api", "graphql"]:
+            args = dict(a.split("=", 1) for a in cmd[3:] if "=" in a and a[:2] != "qu")
+            return _behind(self.base - self.contains[args["head"]])
+        if cmd[:2] != ["gh", "pr"]:
+            return ok                                  # git fetch
+        verb, url = cmd[2], cmd[3]
+        if verb == "view":
+            return _view(self.head[url])
+        if verb == "update-branch":
+            if url in self.update_fails:
+                return SimpleNamespace(returncode=1, stdout="",
+                                       stderr="merge conflict between base and head")
+            new = f"u{len(self.contains)}".ljust(40, "0")
+            self.contains[new] = self.base
+            self.head[url] = new
+            return ok
+        if verb == "checks":
+            self.checks.append((url, self.head[url]))
+            out = (_rollup(("ci", "fail"), code=1) if self.head[url] in self.red_heads
+                   else _rollup(("ci", "pass")))
+            n = sum(1 for u, _ in self.checks if u == url)
+            if self.push_after_checks.get(url) == n:
+                self._push(url)
+            return out
+        if verb == "merge":
+            if url in self.push_at_merge:
+                self._push(url)
+            pin = (cmd[cmd.index("--match-head-commit") + 1]
+                   if "--match-head-commit" in cmd else None)
+            if pin is not None and pin != self.head[url]:
+                return SimpleNamespace(returncode=1, stdout="",
+                                       stderr="Head branch was modified. Review and try "
+                                              "the merge again.")
+            self.merged.append((url, pin))
+            self.base += 1
+            return ok
+        return ok                                      # ready / ready --undo
+
