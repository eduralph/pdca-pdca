+    except (ValueError, AttributeError):
+        head = None
+    if not isinstance(head, str) or not head:
+        err = (r.stderr or r.stdout or "").strip()[:200]
+        return None, None, f"the PR's head commit could not be read ({err or 'no output'})"
+    c = subprocess.run(["gh", "api", "graphql", "-f", f"query={_BEHIND_QUERY}",
+                        "-f", f"url={pr_url}", "-f", f"head={head}"],
+                       capture_output=True, text=True)
+    try:
+        behind = (json.loads(c.stdout or "")["data"]["resource"]["baseRef"]["compare"]
+                  ["behindBy"]) if c.returncode == 0 else None
+    except (ValueError, KeyError, TypeError):
