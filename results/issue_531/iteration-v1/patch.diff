+# protection requires up-to-date branches, which is exactly the host config this must not
+# depend on.
+_BEHIND_QUERY = (
+    "query($url: URI!, $head: String!) { resource(url: $url) { ... on PullRequest { "
+    "baseRef { compare(headRef: $head) { behindBy } } } } }")
