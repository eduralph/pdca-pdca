+    def _index(self, host: _Host, cmd: list[str]) -> int:
+        return next(i for i, c in enumerate(host.calls) if c[:len(cmd)] == cmd)
+
+    def test_second_member_is_updated_and_reverified_before_it_merges(self) -> None:
+        # (a): A and B are both green against the original base. Once A merges, B is
+        # behind — its rollup never saw A. B must be updated (merge commit, not rebase),
+        # its NEW head's rollup read green, and only then merged, pinned to that head.
+        host = _Host(PR_A, PR_B)
