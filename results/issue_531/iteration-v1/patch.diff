+def _read_head(pr_url: str) -> tuple[str | None, int | None, str]:
+    """Read PR ``pr_url``'s head commit and how many commits of its base's current tip
+    that head lacks (issue #531). Returns ``(head_sha, behind_by, detail)``; on any read
+    that cannot be interpreted, ``head_sha`` or ``behind_by`` is ``None`` and ``detail``
+    says why — the caller refuses (fail-closed), never guesses "up to date"."""
+    r = subprocess.run(["gh", "pr", "view", str(pr_url), "--json", "headRefOid"],
+                       capture_output=True, text=True)
+    try:
