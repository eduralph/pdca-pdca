+        return sha
+
+    def history(self, sha: str) -> set[str]:
+        todo, seen = [sha], set()
+        while todo:
+            c = todo.pop()
+            if c not in seen:
+                seen.add(c)
+                todo.extend(self.parents[c])
+        return seen
