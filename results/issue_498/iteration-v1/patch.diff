diff --git a/template/src/pdca_harness/drive_claim.py b/template/src/pdca_harness/drive_claim.py
new file mode 100644
index 0000000..5a14908
--- /dev/null
+++ b/template/src/pdca_harness/drive_claim.py
@@ -0,0 +1,254 @@
+"""One live driver per bundle (issue #498).
+
+A bundle's state is nothing but the files in ``results/issue_<id>/`` — "nothing is hidden
+in a database" — so two ``pdca flow`` runs over the same bundle have nothing to serialize
+on: they write the same artifacts with no ordering between them. Act's session lock
+(:func:`act.act_session`) states the rule for Act's one shared resource; this module states
+it for bundles, on every CLI drive path (named ids, the CSV batch's in-flight sweep, split
+adoption):
+
+* **A run claims every bundle it drives, for exactly as long as it runs.** A claim is an
+  exclusive, NON-blocking advisory lock (the cross-platform :func:`act._lock_exclusive`
+  Act's session uses) on a per-bundle file, held on an open handle for the run's lifetime.
+  The OS drops it when that handle closes — when the run returns, when it raises, and when
+  its process dies (SIGKILL, a host crash) — so a claim can never outlive its run, and there
+  is no stale-lock cleanup to get wrong. The files themselves are never deleted: unlinking a
+  lock file while another process may already have it open is how two holders of "the same"
+  lock happen.
+* **The RUN owns its claims, not its process.** Two runs in one process — a test driving two
+  flows on two threads — hold separate handles, and the lock refuses the second exactly as it
+  refuses a second process: the mechanism cannot tell them apart and does not try. What a
+  run already holds it never takes again, so a run can never refuse itself, and a bundle it
+  adopts becomes its own under the same rule.
+* **The files live outside every bundle** — ``<process_dir>/.drive-claims/`` — so
+  :func:`state.state` never sees one and no results commit can carry one. They are keyed by
+  the bundle's RESOLVED path, so a ``--rehearse`` bundle root never collides with the real
+  one, and a symlinked alias of a bundle is the same claim as the bundle it aliases.
+* **A claim that cannot be recorded is reported, never a crash** (Act's rule too): the
+  bundle is driven as it always was, unclaimed, and stderr says that nothing is keeping a
+  second run off it.
+
+A run also tells everything it spawns who it is (:data:`RUN_ENV`). That is how ``pdca split
+--accept``, run from inside the run's own Plan session, can tell whether the run it is inside
+will drive the children it has just created (:func:`drives_children`) — and so whether
+printing ``run `pdca flow <child-ids>``` would be an instruction to start a driver this rule
+then refuses.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import errno
+import hashlib
+import os
+import secrets
+import sys
+from collections.abc import Iterator
+from pathlib import Path
+
+from .act import _lock_exclusive, _unlock
+from .config import Config
+
+#: Where the claim files live, under ``cfg.process_dir`` (gitignored in the render).
+CLAIMS_DIR = ".drive-claims"
+
+#: The token of the live ``flow`` run this process is inside — set by :func:`run` for the
+#: run's lifetime and inherited by every leaf and command it spawns.
+RUN_ENV = "PDCA_FLOW_RUN"
+
+#: Set to the run's token only while a CSV batch run is in its Plan session: whatever that
+#: session materialises, the in-flight sweep that follows it will drive (:func:`sweeping`).
+SWEEP_ENV = "PDCA_FLOW_SWEEPS"
+
+#: A non-blocking lock attempt that failed because ANOTHER handle holds it — as opposed to a
+#: filesystem that cannot lock at all. flock reports EWOULDBLOCK; Windows' LK_NBLCK reports
+#: EACCES or EDEADLOCK (== EDEADLK).
+_CONTENDED = {errno.EAGAIN, errno.EWOULDBLOCK, errno.EACCES, errno.EDEADLK}
+
+
+def _key(d: Path) -> str:
+    """The claim-file stem for bundle ``d``: its resolved name plus a digest of its resolved
+    path. Resolved, so an alias and its target share one claim; the digest, so two bundle
+    roots (``results/`` and a ``--rehearse`` one) never share any."""
+    try:
+        real = d.resolve()
+    except (OSError, RuntimeError):  # a symlink loop — name it by its lexical path instead
+        real = d.absolute()
+    digest = hashlib.sha256(str(real).encode("utf-8")).hexdigest()[:12]
+    return f"{real.name}-{digest}"
+
+
+def _claim_file(cfg: Config, d: Path) -> Path:
+    return cfg.process_dir / CLAIMS_DIR / f"{_key(d)}.lock"
+
+
+def _contended(exc: OSError) -> bool:
+    return isinstance(exc, BlockingIOError) or exc.errno in _CONTENDED
+
+
+def _stamp(path: Path) -> tuple[str, str]:
+    """``(token, pid)`` of the run that last took this claim, or ``("", "")``. Only ever a
+    hint on top of the lock (the lock is the claim): best-effort, never raises."""
+    try:
+        lines = path.read_text(encoding="utf-8").splitlines()
+    except (OSError, ValueError):
+        return "", ""
+    return (lines[0].strip() if lines else ""), (lines[1].strip() if len(lines) > 1 else "")
+
+
+def _release(fh) -> None:
+    try:
+        with contextlib.suppress(OSError):
+            _unlock(fh)
+    finally:
+        with contextlib.suppress(OSError):
+            fh.close()
+
+
+class Run:
+    """The bundles one live ``flow`` run holds. Built by :func:`run`, which releases them."""
+
+    def __init__(self, cfg: Config, token: str) -> None:
+        self.cfg = cfg
+        self.token = token
+        self._held: dict[str, object] = {}   # claim key -> the open, locked handle
+
+    def take(self, d: Path) -> str:
+        """Claim bundle ``d`` for this run. ``""`` when this run now holds it — or already
+        did, which is what keeps a run from ever refusing itself. Otherwise the reason it
+        cannot: another live run holds it. Non-blocking, and it never raises."""
+        key = _key(d)
+        if key in self._held:
+            return ""
+        path = self.cfg.process_dir / CLAIMS_DIR / f"{key}.lock"
+        try:
+            path.parent.mkdir(parents=True, exist_ok=True)
+            # "a+", never "w": opening must not rewrite a file another run holds.
+            fh = path.open("a+", encoding="utf-8")
+        except OSError as exc:
+            _unclaimed(d, exc)
+            return ""
+        try:
+            _lock_exclusive(fh, wait=False)
+        except OSError as exc:
+            with contextlib.suppress(OSError):
+                fh.close()
+            if not _contended(exc):
+                _unclaimed(d, exc)
+                return ""
+            _token, pid = _stamp(path)
+            return ("held by another live `flow` run"
+                    + (f" (pid {pid})" if pid.isdigit() else ""))
+        with contextlib.suppress(OSError):
+            fh.seek(0)
+            fh.truncate()
+            fh.write(f"{self.token}\n{os.getpid()}\n")
+            fh.flush()
+        self._held[key] = fh
+        return ""
+
+    def release(self, d: Path) -> None:
+        """Give up the claim on ``d`` — for a bundle this run has stopped driving (a child
+        the reschedule held), so the resume command it is told to run is not refused by
+        the very run that let it go."""
+        fh = self._held.pop(_key(d), None)
+        if fh is not None:
+            _release(fh)
+
+    def close(self) -> None:
+        for fh in self._held.values():
+            _release(fh)
+        self._held.clear()
+
+
+def _unclaimed(d: Path, exc: OSError) -> None:
+    try:
+        print(f"flow: could not record this run's claim on {d.name} ({exc}) — driving it "
+              f"UNCLAIMED: nothing keeps a second `flow` run off it", file=sys.stderr)
+    except OSError:
+        pass
+
+
+@contextlib.contextmanager
+def run(cfg: Config) -> Iterator[Run]:
+    """The claim scope of one live ``flow`` run: every claim taken through the yielded
+    :class:`Run` is released when this exits — normally or by raising — and by the OS if the
+    process dies first. Exports :data:`RUN_ENV` for the same span, so a leaf or a command the
+    run spawns knows which run it is inside. Enter it in the process that DRIVES — after any
+    re-exec, never before one."""
+    token = f"{os.getpid()}-{secrets.token_hex(6)}"
+    prev = os.environ.get(RUN_ENV)
+    os.environ[RUN_ENV] = token
+    claims = Run(cfg, token)
+    try:
+        yield claims
+    finally:
+        claims.close()
+        if prev is None:
+            os.environ.pop(RUN_ENV, None)
+        else:
+            os.environ[RUN_ENV] = prev
+
+
+@contextlib.contextmanager
+def sweeping(claims: Run | None) -> Iterator[None]:
+    """Mark a CSV batch run's Plan session: everything it materialises — a split's children
+    included — is picked up by the in-flight sweep right after it. A no-op without a run."""
+    if claims is None:
+        yield
+        return
+    prev = os.environ.get(SWEEP_ENV)
+    os.environ[SWEEP_ENV] = claims.token
+    try:
+        yield
+    finally:
+        if prev is None:
+            os.environ.pop(SWEEP_ENV, None)
+        else:
+            os.environ[SWEEP_ENV] = prev
+
+
+def _held_now(path: Path) -> bool:
+    """Is this claim file locked by a live holder right now? A free lock is let go at once."""
+    try:
+        fh = path.open("a+", encoding="utf-8")
+    except OSError:
+        return False
+    try:
+        try:
+            _lock_exclusive(fh, wait=False)
+        except OSError as exc:
+            return _contended(exc)
+        with contextlib.suppress(OSError):
+            _unlock(fh)
+        return False
+    finally:
+        with contextlib.suppress(OSError):
+            fh.close()
+
+
+def drives_children(cfg: Config, parent: Path) -> bool:
+    """Will the live ``flow`` run this process is inside drive the children a split of
+    ``parent`` has just materialised?
+
+    True in exactly two cases, both INSIDE a run (:data:`RUN_ENV`):
+
+    * that run is a CSV batch in its Plan session (:func:`sweeping`) — the in-flight sweep
+      after the session picks the children up;
+    * that run holds ``parent``'s claim, live — the parent is in its drive set, so split
+      adoption hands the children to it.
+
+    Anything else — no run at all (an accept typed in a shell), or a run that is not driving
+    this parent — is False, and the caller prints the ``pdca flow <child-ids>`` instruction
+    as it always has. Advisory, so it is total: any failure reads as False.
+    """
+    try:
+        token = os.environ.get(RUN_ENV, "")
+        if not token:
+            return False
+        if os.environ.get(SWEEP_ENV) == token:
+            return True
+        path = _claim_file(cfg, parent)
+        return _stamp(path)[0] == token and _held_now(path)
+    except Exception:  # noqa: BLE001 — a hint must never change an exit code
+        return False
