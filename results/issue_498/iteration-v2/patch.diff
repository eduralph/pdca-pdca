+        (eight / "brief.md").write_text(_brief("slice-8"), encoding="utf-8")
+        rc = self._cli(["8"])
+
+        err = self.err.getvalue()
+        self.assertEqual(rc, 0, err)
+        self.assertEqual(self._held_lines(err, "issue_8"), [], err)
+        self.assertEqual(self._state("8"), state.COMPLETE, err)
