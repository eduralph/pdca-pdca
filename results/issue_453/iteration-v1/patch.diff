diff --git a/template/tests/test_signoff_orphan.py b/template/tests/test_signoff_orphan.py
new file mode 100644
index 0000000..7764b8e
--- /dev/null
+++ b/template/tests/test_signoff_orphan.py
@@ -0,0 +1,166 @@
+"""Offline slice for issue #453 — a `signoff-decision` orphaned by an interrupted
+session is un-consumed input to the driver, not an in-process by-product of the
+session that wrote it (stdlib unittest).
+
+Pre-fix: a bundle halted at AWAITING_SIGNOFF that already carries a valid
+`signoff-decision` (written by an earlier session that then died before the driver
+applied it — a `^C`, a crash) gets offered a FRESH sign-off session on every later
+pass, and that session's write clobbers the orphaned decision — the human's actual
+call is silently discarded. Post-fix: both drive paths — the batch `flow._drive_wave`
+and the single-issue `flow._signoff_and_apply` — read the decision already on disk,
+record §9 and transition the bundle WITHOUT invoking any sign-off leaf; and
+`flow._maybe_auto_iterate` declines (writes no decision, spends no auto-iterate
+budget) while such a file exists. Run from the project root:
+    PYTHONPATH=src python3 -m unittest tests.test_signoff_orphan
+"""
+
+from __future__ import annotations
+
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+
+from pdca_harness import assemble, autoiterate, driver, flow, leaves, signoff, state
+from pdca_harness.config import Config, LeafConfig
+
+
+def _stub_config(root: Path) -> Config:
+    """All six leaves stubbed, gates empty (all-PASS stub rows) — same shape as
+    ``tests.test_flow_slice._stub_config`` (template/tests/test_flow_slice.py:32-55)."""
+    return Config(
+        root=root,
+        bundle_root=root / "results",
+        process_dir=root / "process",
+        templates_dir=root / "templates",  # empty → planner stub uses its fallback brief
+        default_branch="main",
+        tracker_system="github",
+        tracker_url="",
+        issue_id_example="#1",
+        builder=LeafConfig(mode="stub", family="claude"),
+        reviewer=LeafConfig(mode="stub", family="codex"),
+        planner=LeafConfig(mode="stub", family="claude", interactive=True),
+        signoff=LeafConfig(mode="stub", family="claude", interactive=True),
+        publisher=LeafConfig(mode="stub", family="claude", interactive=True),
+        act=LeafConfig(mode="stub", family="claude", interactive=True),
+        repo_checkouts={"example-org/example-repo": str(root / "example-repo")},
+    )
+
+
+class SignoffOrphanSlice(unittest.TestCase):
+    def setUp(self) -> None:
+        self.tmp = Path(tempfile.mkdtemp())
+        self.cfg = _stub_config(self.tmp)
+
+    def tearDown(self) -> None:
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def _awaiting_signoff_bundle(self, issue_id: str) -> Path:
+        """Drive a fresh bundle (stub Plan/Do/Check) to AWAITING_SIGNOFF, with NO
+        sign-off session run — exactly the halt this issue's decision then gets
+        written onto."""
+        d = self.cfg.bundle(issue_id)
+        self.assertTrue(flow._plan_if_unplanned(self.cfg, d, None))
+        self.assertEqual(driver.run_issue(d, self.cfg), state.AWAITING_SIGNOFF)
+        return d
+
+    def test_drive_wave_applies_orphaned_decision_without_a_session(self) -> None:
+        d = self._awaiting_signoff_bundle("ORPHANWAVE")
+        (d / leaves.SIGNOFF_DECISION).write_text(
+            "iterate-do\nnot yet — the gate is wrong\n", encoding="utf-8")
+
+        calls: list[list[Path]] = []
+        orig_batch = leaves.run_signoff_batch
+
+        def spying_batch(cfg: Config, bundles: list[Path]) -> None:
+            calls.append(list(bundles))
+            # If this were ever invoked it would overwrite the orphaned decision — the
+            # exact bug this test exists to catch — so record the call but do NOT
+            # delegate to the stub (the assertion below on `calls` is what matters).
+
+        leaves.run_signoff_batch = spying_batch
+        try:
+            # One pass is enough to prove the point: the orphaned decision must be
+            # pre-applied WITHIN this very pass, before any chunk is offered a session.
+            # (A later pass legitimately rebuilds the now-iterate-do'd bundle and asks
+            # for a genuinely NEW decision — that is ordinary lifecycle, not this bug.)
+            flow._drive_wave(self.cfg, [d], by="t", today="2026-01-01", max_passes=1)
+        finally:
+            leaves.run_signoff_batch = orig_batch
+
+        self.assertEqual(calls, [], "a fresh sign-off session was opened for a bundle "
+                                     "that already carried a decision on disk")
+        self.assertEqual(signoff.outcome_token(d / "SUMMARY.md"), "iterated-to-Do")
+        self.assertEqual(signoff.iteration_delta(d / "SUMMARY.md"),
+                         "not yet — the gate is wrong")
+        self.assertFalse((d / leaves.SIGNOFF_DECISION).exists())  # consumed
+
+    def test_signoff_and_apply_applies_orphaned_decision_without_a_session(self) -> None:
+        d = self._awaiting_signoff_bundle("ORPHANSOLO")
+        (d / leaves.SIGNOFF_DECISION).write_text(
+            "iterate-do\nnot yet — the gate is wrong\n", encoding="utf-8")
+
+        calls: list[Path] = []
+        orig_signoff = leaves.run_signoff
+        leaves.run_signoff = lambda d, cfg: calls.append(d)  # would overwrite the decision
+        try:
+            applied = flow._signoff_and_apply(self.cfg, d, by="t", today="2026-01-01",
+                                              apply_now=False)
+        finally:
+            leaves.run_signoff = orig_signoff
+
+        self.assertEqual(calls, [], "a fresh sign-off session was opened for a bundle "
+                                     "that already carried a decision on disk")
+        self.assertEqual(applied, "iterate-do")
+        self.assertEqual(signoff.outcome_token(d / "SUMMARY.md"), "iterated-to-Do")
+        self.assertFalse((d / leaves.SIGNOFF_DECISION).exists())  # consumed
+
+    def test_c6_blocked_accept_still_falls_through_to_a_fresh_session(self) -> None:
+        # The one documented exception: an `accept` C6 refuses (§6 NEEDS-HUMAN still
+        # open) still needs a human to return, so a fresh session still runs.
+        d = self._awaiting_signoff_bundle("ORPHANBLOCKED")
+        (d / leaves.SIGNOFF_DECISION).write_text("accept\n", encoding="utf-8")
+        # SUMMARY.md's §6 is left with its stub-authored open items — C6 refuses.
+
+        calls: list[Path] = []
+
+        def fresh_session(dd: Path, cfg: Config) -> None:
+            calls.append(dd)
+            leaves._stub_signoff(dd, cfg)  # the human clears §6 and re-decides for real
+
+        orig_signoff = leaves.run_signoff
+        leaves.run_signoff = fresh_session
+        try:
+            applied = flow._signoff_and_apply(self.cfg, d, by="t", today="2026-01-01",
+                                              apply_now=False)
+        finally:
+            leaves.run_signoff = orig_signoff
+
+        self.assertEqual(calls, [d], "a C6-refused accept must still fall through to a "
+                                      "fresh session")
+        self.assertEqual(applied, "accept")
+        self.assertEqual(signoff.outcome_token(d / "SUMMARY.md"), "merged-wider")
+
+    def test_maybe_auto_iterate_declines_while_a_decision_is_on_disk(self) -> None:
+        d = self._awaiting_signoff_bundle("ORPHANAUTO")
+        (d / leaves.SIGNOFF_DECISION).write_text("accept\n", encoding="utf-8")
+        self.cfg.auto_iterate = True
+
+        def must_not_be_called(dd: Path, cfg: Config):
+            raise AssertionError("assemble.collect_needs_human must not run while a "
+                                  "decision is already on disk — auto-iterate must "
+                                  "decline before spending any work")
+
+        orig_collect = assemble.collect_needs_human
+        assemble.collect_needs_human = must_not_be_called
+        try:
+            routed = flow._maybe_auto_iterate(self.cfg, d, by="auto-iterate",
+                                              today="2026-01-01", apply_now=False)
+        finally:
+            assemble.collect_needs_human = orig_collect
+
+        self.assertFalse(routed)
+        self.assertEqual(autoiterate.count(d), 0, "auto-iterate must spend no budget "
+                                                    "while a decision is orphaned on disk")
+        self.assertEqual(leaves.signoff_decision(d), "accept")  # untouched
+        self.assertEqual(state.state(d), state.AWAITING_SIGNOFF)  # not re-driven
