@@ -0,0 +1,419 @@
+"""The stack-mode live check's ``judge`` step reads raw observations and names each failure
+(#625). ``tools/live/stack_mode_live.py`` drives the stack-mode scenario against a real
+GitHub repository and records what it saw in ``observations.json``; ``judge`` turns that
+file into ``report.json`` / ``report.md`` and exits 0 only if every check passes. These
+cases write observation files to a temp dir and run ``judge`` on them as a subprocess, by
+path: the tool is never imported, so with it absent each case still runs and fails on its
+assertions. The last class runs ``setup`` and ``teardown`` the same way, against a stand-in
+``gh`` and local git remotes. No network, no copier.
+
+    python3 -m tests.run_root_suite tests.test_stack_mode_live_tool
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+TOOL = Path(__file__).resolve().parents[1] / "tools" / "live" / "stack_mode_live.py"
+CHECKS = ["E0", "E1", "E1b", "E2", "E3", "E4", "E5"]
+IDS = ["A", "B", "C", "D", "P", "Q", "S"]
+LINE = "pdca-integration/main-r0123456789ab"
+
+HEAD_A, MERGE_A = "a" * 40, "1" * 40
+HEAD_C = "c" * 40
+HEAD_S, MERGE_S = "5" * 40, "6" * 40
+HEADS = {"A": HEAD_A, "C": HEAD_C, "S": HEAD_S}
+
+
+def _branch(iid: str) -> str:
+    return f"fix/{iid}-live-{iid.lower()}"
+
+
+def _pr(iid: str, number: int) -> dict:
+    head = HEADS.get(iid, f"{number:040d}")
+    return {"number": number, "url": f"https://github.com/o/pdca-live-stack-x/pull/{number}",
+            "baseRefName": "main", "headRefName": _branch(iid), "headRefOid": head,
+            "pushed_head": head}
+
+
+def _run(ids: list[str], stderr: str = "") -> dict:
+    return {"ids": ids, "rc": 0, "raised": "", "results": dict.fromkeys(ids, "COMPLETE"),
+            "holds": {}, "stderr": stderr, "stdout": ""}
+
+
+# What run 2's fold prints for a deleted, merged branch it goes on with — both wordings of
+# template/src/pdca_harness/integrate.py (:1434-1436 and :1509-1511), one per branch.
+GONE_A = (f"integrate: issue_A's branch origin/{_branch('A')} is gone and its PR merged at "
+          f"{HEAD_A[:12]} — {LINE} already carries that commit; skipped.")
+GONE_C = (f"integrate: issue_C's branch origin/{_branch('C')} is gone and its PR merged at "
+          f"{HEAD_C[:12]}, which {LINE} did not have — the merged work reaches {LINE} "
+          f"through origin/main.")
+# The carry's line for a finished id it refused (flow.py:1575-1578), here over the
+# IntegrationError of integrate.py:1491: the same opening words as the lines above.
+REFUSED_A = (f"flow: issue_A (finished in an earlier run) is not carried onto {LINE}: "
+             f"issue_A's branch origin/{_branch('A')} is gone and its PR merged at "
+             f"{HEAD_A[:12]}, which {LINE} does not have, but origin/main, which carries that "
+             f"work, does not merge onto {LINE} (conflicts in a.txt; update the clashing "
+             f"PR's branch from the base), then re-run — holding issue_B this run; re-run "
+             f"once its PR is open.")
+RUN2_ERR = "\n".join([
+    "flow: issue_A — already terminal (COMPLETE), skipped",
+    "flow: issue_B — already terminal (COMPLETE), skipped",
+    "flow: issue_C — already terminal (COMPLETE), skipped",
+    GONE_A, GONE_C,
+    f"flow: carried issue_A, issue_C, issue_B (finished in an earlier run) onto {LINE} at "
+    f"{'e' * 40} before wave 0 — this run's o/pdca-live-stack-x @ main bundles build on it.",
+]) + "\n"
+
+
+def _good() -> dict:
+    """Observations of a finished run matching every expectation."""
+    gone = {"delete": "deleted", "branch_gone": True}
+    return {
+        "repo": "o/pdca-live-stack-x", "base": "main", "finished": True, "errors": [],
+        "files": {iid: [f"{iid.lower()}.txt"] for iid in IDS},
+        "prs": {iid: _pr(iid, n) for n, iid in enumerate(IDS, start=1)},
+        "runs": {"run1": _run(["A", "C", "B"]),
+                 "run2": _run(["A", "B", "C", "D"], RUN2_ERR),
+                 "run3": _run(["P", "Q"]), "run4": _run(["S"])},
+        "merged": {"A": {"method": "merge", "branch": _branch("A"), **gone},
+                   "C": {"method": "merge", "branch": _branch("C"), **gone},
+                   "P": {"method": "merge", "branch": _branch("P"), **gone},
+                   "B": {"method": "merge", "branch": _branch("B"), **gone},
+                   "S": {"method": "squash", "branch": _branch("S"), **gone}},
+        "B_files_before_update": ["a.txt", "b.txt"],
+        "B_update_branch": {"head_before": "2" * 40, "head_after": "7" * 40, "moved": True},
+        "B_files_after_update": ["b.txt"],
+        "A_after_merge": {"view": {"state": "MERGED", "headRefOid": HEAD_A,
+                                   "mergeCommit": {"oid": MERGE_A}},
+                          "on_base": {"headRefOid": True, "mergeCommit": True}},
+        "D_built_on": "e" * 40,
+        "D_built_on_holds": {"A": True, "C": True},
+        "Q_files_after_P_merge": ["q.txt"],
+        "after_B_merge": {"on_base": {"A": True, "B": True, "C": True}},
+        "S_after_squash": {"view": {"state": "MERGED", "headRefOid": HEAD_S,
+                                    "mergeCommit": {"oid": MERGE_S}},
+                           "on_base": {"headRefOid": False, "mergeCommit": True}},
+    }
+
+
+class JudgeLiveObservations(unittest.TestCase):
+
+    def _judge(self, obs: dict) -> tuple[int, dict, str]:
+        with tempfile.TemporaryDirectory() as tmp:
+            work = Path(tmp)
+            (work / "observations.json").write_text(json.dumps(obs), encoding="utf-8")
+            r = subprocess.run([sys.executable, str(TOOL), "judge", "--workdir", str(work)],
+                               capture_output=True, text=True, timeout=60)
+            report = work / "report.json"
+            data = json.loads(report.read_text(encoding="utf-8")) if report.is_file() else {}
+            md = work / "report.md"
+            text = md.read_text(encoding="utf-8") if md.is_file() else ""
+        return r.returncode, data, text + r.stdout + r.stderr
+
+    def _results(self, data: dict) -> dict[str, dict]:
+        return {c["id"]: c for c in data.get("checks", [])}
+
+    def _fails(self, obs: dict, observed: dict[str, str],
+               result: str = "FAIL") -> tuple[dict[str, dict], dict, str]:
+        """``judge`` exits non-zero and FAILs exactly the checks of ``observed``, each with
+        its text in the observed value; every other check PASSes. The report's result is
+        ``result``: FAIL for a run that went to its end, INCOMPLETE for one that did not."""
+        rc, data, out = self._judge(obs)
+        self.assertNotEqual(rc, 0, out)
+        res = self._results(data)
+        self.assertEqual(sorted(res), sorted(CHECKS), out)
+        for cid, needle in observed.items():
+            self.assertEqual(res[cid]["result"], "FAIL", (cid, out))
+            self.assertIn(needle, json.dumps(res[cid]["observed"]), (cid, out))
+            self.assertTrue(res[cid]["expected"], out)
+        others = {k: v["result"] for k, v in res.items() if k not in observed}
+        self.assertEqual(set(others.values()), {"PASS"}, (sorted(observed), others, out))
+        self.assertFalse(data.get("passed"), out)
+        self.assertEqual(data.get("result"), result, out)
+        return res, data, out
+
+    # (1) every expectation met → exit 0, every check PASS
+    def test_observations_meeting_every_expectation_pass(self):
+        rc, data, out = self._judge(_good())
+        self.assertEqual(rc, 0, out)
+        res = self._results(data)
+        self.assertEqual(sorted(res), sorted(CHECKS), out)
+        self.assertEqual({k: v["result"] for k, v in res.items()},
+                         dict.fromkeys(CHECKS, "PASS"), out)
+        self.assertTrue(data.get("passed"), out)
+        self.assertEqual(data.get("result"), "PASS", out)
+        self.assertIn("| E2 | PASS |", out)            # report.md has one line per check
+
+    # (2) A's PR, merged and its branch deleted, reports no headRefOid → E2 FAIL
+    def test_a_merged_pr_with_no_head_oid_fails_e2(self):
+        obs = _good()
+        del obs["A_after_merge"]["view"]["headRefOid"]
+        self._fails(obs, {"E2": '"headRefOid": null'})
+
+    # (3) B's files after Update branch still list A's file → E1 FAIL
+    def test_b_still_showing_a_file_of_a_after_update_branch_fails_e1(self):
+        obs = _good()
+        obs["B_files_after_update"] = ["a.txt", "b.txt"]
+        self._fails(obs, {"E1": "a.txt"})
+
+    # (4) a squash-merged S whose headRefOid is on the base → E4 FAIL
+    def test_a_squash_merge_whose_head_is_on_the_base_fails_e4(self):
+        obs = _good()
+        obs["S_after_squash"]["on_base"]["headRefOid"] = True
+        self._fails(obs, {"E4": '"headRefOid on base": true'})
+
+    # (5) a PR opened against the integration line → E0 FAIL
+    def test_a_pr_against_the_integration_line_fails_e0(self):
+        obs = _good()
+        obs["prs"]["D"]["baseRefName"] = LINE
+        self._fails(obs, {"E0": LINE})
+
+    # (6) Q's files after P merged list a file of P's → E1b FAIL
+    def test_q_showing_a_file_of_p_after_p_merged_fails_e1b(self):
+        obs = _good()
+        obs["Q_files_after_P_merge"] = ["p.txt", "q.txt"]
+        self._fails(obs, {"E1b": "p.txt"})
+
+    # -- a PASS needs the whole observation (#625 review, round 1) -------------------------
+
+    # A PR the scenario opens and nobody observed cannot be "against the real base".
+    def test_a_scenario_pr_never_observed_fails_e0(self):
+        obs = _good()
+        del obs["prs"]["Q"]
+        self._fails(obs, {"E0": "Q has no PR (run3: COMPLETE)"})
+
+    # Run 2 that did not finish D — held, failed, or crashed — is no "no stop", even with
+    # the fold's lines and D's base looking right.
+    def test_a_run_2_that_did_not_finish_fails_e3(self):
+        cases = {
+            "held D": ({"rc": 1, "results": {"A": "COMPLETE", "B": "COMPLETE",
+                                             "C": "COMPLETE", "D": "PLANNED"}},
+                       "D is PLANNED"),
+            "a hold": ({"rc": 3, "holds": {"D": "unpushed"}}, '"holds": {"D": "unpushed"}'),
+            "a raise": ({"rc": None, "results": {},
+                         "raised": "Traceback (most recent call last):\nRuntimeError: boom\n"},
+                        "raised RuntimeError: boom"),
+        }
+        for name, (change, needle) in cases.items():
+            with self.subTest(name):
+                obs = _good()
+                obs["runs"]["run2"].update(change)
+                self._fails(obs, {"E3": needle})
+
+    # A refusal opens with the words the fold's success lines open with; it is no
+    # "gone and merged".
+    def test_a_refused_carry_is_not_read_as_gone_and_merged(self):
+        obs = _good()
+        obs["runs"]["run2"]["stderr"] = RUN2_ERR.replace(GONE_A, REFUSED_A)
+        res, _data, out = self._fails(obs, {"E3": '"not carried": ["A"]'})
+        self.assertIsNone(res["E3"]["observed"]["gone and merged"]["A"], out)
+
+    # A run 2 whose fold printed no "gone and merged" line never took the path E3 is about,
+    # however cleanly it finished.
+    def test_a_run_2_that_named_no_branch_gone_fails_e3(self):
+        obs = _good()
+        obs["runs"]["run2"]["stderr"] = RUN2_ERR.replace(GONE_A + "\n", "").replace(
+            GONE_C + "\n", "")
+        self._fails(obs, {"E3": '"gone and merged": {"A": null, "C": null}'})
+
+    # E2 and E3 are read "after the delete": a branch not confirmed gone is not observed.
+    def test_a_branch_not_confirmed_deleted_fails_e2_and_e3(self):
+        obs = _good()
+        obs["merged"]["A"]["branch_gone"] = False
+        self._fails(obs, {"E2": "A's branch was not confirmed deleted",
+                          "E3": "A's branch was not confirmed deleted"})
+
+    # A head git could not judge (exit 128: a commit the clone lacks) is not "off the base".
+    def test_an_unjudged_squash_head_is_not_read_as_off_the_base(self):
+        obs = _good()
+        obs["S_after_squash"]["on_base"]["headRefOid"] = None
+        self._fails(obs, {"E4": '"headRefOid on base": null'})
+
+    # A run that stopped early is INCOMPLETE; what it never reached is "not observed".
+    def test_a_run_that_stopped_early_is_incomplete(self):
+        obs = _good()
+        obs["runs"]["run3"].update({"rc": 1, "results": {"P": "PLANNED", "Q": "PLANNED"}})
+        for key in ("Q_files_after_P_merge", "after_B_merge", "S_after_squash"):
+            del obs[key]
+        for iid in ("P", "Q", "S"):
+            del obs["prs"][iid]
+        for iid in ("P", "B", "S"):
+            del obs["merged"][iid]
+        del obs["runs"]["run4"]
+        obs["finished"] = False
+        obs["errors"] = ["Incomplete: run3 (P Q) did not finish: exit code 1"]
+        res, data, out = self._fails(obs, {"E0": "not observed", "E1b": "run3 did not finish",
+                                           "E4": "run4 did not finish",
+                                           "E5": "B's merge was not"}, result="INCOMPLETE")
+        self.assertFalse(data.get("complete"), out)
+        self.assertIn("**INCOMPLETE**", out)
+        self.assertIn("P has no PR (run3: PLANNED)", json.dumps(res["E0"]["observed"]))
+
+
+# -- setup and teardown, offline (#625 review, round 2) -------------------------------------
+
+# A stand-in for `gh`, first on PATH. It answers the calls `setup` and `teardown` make, logs
+# each call, and keeps the repositories it "created" in repos.json. FAKE_GH_FAIL refuses the
+# call whose arguments start with it; FAKE_GH_LOSE_CREATE makes `repo create` make the
+# repository and still fail, as an answer lost on its way back would.
+FAKE_GH = """\
+import json, os, sys
+from pathlib import Path
+
+args = sys.argv[1:]
+home = Path(os.environ["FAKE_GH_HOME"])
+with (home / "calls.jsonl").open("a", encoding="utf-8") as log:
+    log.write(json.dumps(args) + "\\n")
+store = home / "repos.json"
+repos = json.loads(store.read_text(encoding="utf-8")) if store.exists() else []
+fail = os.environ.get("FAKE_GH_FAIL")
+if fail and " ".join(args).startswith(fail):
+    sys.exit("HTTP 502: Bad Gateway")
+if args[:2] == ["api", "user"]:
+    print("fake-owner")
+elif args[:2] == ["repo", "view"]:
+    sys.exit(0 if args[2] in repos else "GraphQL: Could not resolve to a Repository")
+elif args[:2] == ["repo", "create"]:
+    store.write_text(json.dumps(repos + [args[2]]), encoding="utf-8")
+    if os.environ.get("FAKE_GH_LOSE_CREATE"):
+        sys.exit("HTTP 502: Bad Gateway")
+elif args[:2] == ["repo", "delete"]:
+    if args[2] not in repos:
+        sys.exit("GraphQL: Could not resolve to a Repository")
+    store.write_text(json.dumps([r for r in repos if r != args[2]]), encoding="utf-8")
+elif args[:3] != ["api", "-X", "PATCH"]:
+    sys.exit(f"fake gh: unexpected call {args}")
+"""
+
+
+class SetupLeavesItsRepositoryToTeardown(unittest.TestCase):
+    """``setup`` records the repository it created before any later step can fail, so a
+    setup that stops part-way leaves it to ``teardown`` instead of orphaning it. Offline: the
+    stand-in ``gh`` above, and real ``git`` whose ``https://github.com/`` remotes go to local
+    paths (``remote/<owner>/<name>.git``, absent unless a case makes it, so a push fails)."""
+
+    REPO = "fake-owner/pdca-live-stack-offline"
+
+    def _sandbox(self, **env: str) -> SimpleNamespace:
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        root = Path(tmp.name)
+        bindir, gh_home = root / "bin", root / "gh-home"
+        bindir.mkdir()
+        gh_home.mkdir()
+        gh = bindir / "gh"
+        gh.write_text(f"#!{sys.executable}\n{FAKE_GH}", encoding="utf-8")
+        gh.chmod(0o755)
+        gitconfig = root / "gitconfig"
+        gitconfig.write_text(f'[url "{(root / "remote").as_posix()}/"]\n'
+                             f"\tinsteadOf = https://github.com/\n", encoding="utf-8")
+        kept = {k: v for k, v in os.environ.items()
+                if not k.startswith(("GH_", "GITHUB_", "GIT_"))}
+        full = {**kept, "PATH": f"{bindir}{os.pathsep}{os.environ.get('PATH', '')}",
+                "FAKE_GH_HOME": str(gh_home), "GH_CONFIG_DIR": str(root / "gh-config"),
+                "GIT_CONFIG_GLOBAL": str(gitconfig), "GIT_CONFIG_NOSYSTEM": "1",
+                "GIT_TERMINAL_PROMPT": "0", **env}
+        # The real gh must never answer here: it would create a real repository.
+        self.assertEqual(shutil.which("gh", path=full["PATH"]), str(gh))
+        return SimpleNamespace(work=root / "work", env=full, gh_home=gh_home,
+                               remote=root / "remote")
+
+    def _tool(self, box: SimpleNamespace, step: str,
+              *extra: str) -> subprocess.CompletedProcess:
+        return subprocess.run([sys.executable, str(TOOL), step, "--workdir", str(box.work),
+                               *extra], capture_output=True, text=True, timeout=120,
+                              env=box.env)
+
+    def _setup(self, box: SimpleNamespace) -> subprocess.CompletedProcess:
+        return self._tool(box, "setup", "--repo", self.REPO.split("/")[1])
+
+    @staticmethod
+    def _repos(box: SimpleNamespace) -> list[str]:
+        """The repositories the stand-in ``gh`` holds."""
+        f = box.gh_home / "repos.json"
+        return json.loads(f.read_text(encoding="utf-8")) if f.is_file() else []
+
+    @staticmethod
+    def _calls(box: SimpleNamespace, *head: str) -> list[list[str]]:
+        """The ``gh`` calls made so far whose arguments start with ``head``."""
+        f = box.gh_home / "calls.jsonl"
+        lines = f.read_text(encoding="utf-8").splitlines() if f.is_file() else []
+        return [c for c in map(json.loads, lines) if c[:len(head)] == list(head)]
+
+    def test_a_setup_that_stops_after_creating_its_repository_leaves_it_to_teardown(self):
+        cases = {
+            "GitHub refuses the repository settings": {"FAKE_GH_FAIL": "api -X PATCH"},
+            "the push of the base commit fails": {},     # no remote/<owner>/<name>.git
+        }
+        for name, env in cases.items():
+            with self.subTest(name):
+                box = self._sandbox(**env)
+                r = self._setup(box)
+                out = r.stdout + r.stderr
+                self.assertEqual(r.returncode, 1, out)
+                self.assertEqual(self._repos(box), [self.REPO], out)     # it was created
+                self.assertIn(f"{self.REPO} is left on GitHub", out)
+                self.assertIn(f"teardown --workdir {box.work}", out)
+
+                # `run` drives nothing on a setup that did not finish ...
+                r = self._tool(box, "run")
+                self.assertNotEqual(r.returncode, 0, r.stdout + r.stderr)
+                self.assertIn("did not finish", r.stderr)
+                self.assertFalse((box.work / "observations.json").exists())
+                # ... and a second `setup` in that work directory names what it left.
+                r = self._setup(box)
+                self.assertEqual(r.returncode, 2, r.stdout + r.stderr)
+                self.assertIn(f"did not finish and left {self.REPO}", r.stderr)
+
+                # `teardown` deletes it, once.
+                for _ in range(2):
+                    r = self._tool(box, "teardown")
+                    self.assertEqual(r.returncode, 0, r.stdout + r.stderr)
+                self.assertIn("already deleted", r.stdout)
+                self.assertEqual(self._repos(box), [], r.stdout + r.stderr)
+                self.assertEqual(self._calls(box, "repo", "delete"),
+                                 [["repo", "delete", self.REPO, "--yes"]])
+
+    def test_a_setup_that_finishes_pushes_the_base_and_teardown_deletes_its_repo(self):
+        box = self._sandbox()
+        bare = box.remote / f"{self.REPO}.git"
+        subprocess.run(["git", "init", "-q", "--bare", str(bare)], check=True,
+                       capture_output=True, env=box.env)
+        r = self._setup(box)
+        out = r.stdout + r.stderr
+        self.assertEqual(r.returncode, 0, out)
+        self.assertIn(f"setup: {self.REPO} ready", r.stdout)
+        self.assertNotIn("left on GitHub", out)
+        base = subprocess.run(["git", "--git-dir", str(bare), "show", "main:base.txt"],
+                              capture_output=True, text=True, env=box.env)
+        self.assertEqual(base.stdout, "base\n", base.stderr)
+        r = self._setup(box)                       # a used work directory is refused
+        self.assertEqual(r.returncode, 2, r.stdout + r.stderr)
+        self.assertNotIn("did not finish", r.stderr)
+        r = self._tool(box, "teardown")
+        self.assertEqual(r.returncode, 0, r.stdout + r.stderr)
+        self.assertEqual(self._repos(box), [], r.stdout + r.stderr)
+
+    def test_a_failed_create_names_the_repository_and_how_to_delete_it(self):
+        box = self._sandbox(FAKE_GH_LOSE_CREATE="1")
+        r = self._setup(box)
+        out = r.stdout + r.stderr
+        self.assertEqual(r.returncode, 1, out)
+        self.assertEqual(self._repos(box), [self.REPO], out)     # made, though gh said no
+        self.assertIn(f"gh repo delete {self.REPO} --yes", out)
+        # Not recorded: setup cannot tell its own repository from another's here, so it
+        # leaves the call to the human rather than to `teardown`.
+        self.assertFalse((box.work / "state.json").exists(), out)
+
+
+if __name__ == "__main__":
+    unittest.main()
