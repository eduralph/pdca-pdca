+def _line_lacks_merge(cfg: Config, dep: str, target: tuple[str, str],
+                      line: tuple[str, str | None],
+                      views: dict[tuple[str, str], Path | str]) -> tuple[str, bool] | None:
+    """Why the run's ``line`` — ``(branch, recorded tip)`` for ``target`` — lacks the commit
+    prerequisite ``dep``'s PR merge put on the base, or ``None`` when the tip has it (#655).
+    The reason comes with whether it is KNOWN to lack it (True) or could not be checked.
+
+    The commit is ``merged.merge_commit`` (on the base for a merge, squash or rebase merge
+    alike), asked of ``target``'s checkout as the pre-wave carry reads it
+    (``integrate.carry_view``: fetched first, read-only, so no integration lock). ``views``
+    caches that checkout — or why it could not be fetched — per target for one
+    :func:`_runnable` call. Fail-closed: an unreadable merge commit, a failed fetch or a git
+    failure is a reason, never "on the line". A commit the clone lacks is not on the line
+    (``integrate._carries``)."""
+    branch, tip = line
+    if target not in views:
+        try:
+            views[target] = integrate.carry_view(cfg, target[0], branch)[0]
+        except integrate.IntegrationError as exc:
+            views[target] = f"its checkout could not be fetched: {exc}"
+    view = views[target]
+    if isinstance(view, str):
+        return view, False
+    oid = merged.merge_commit(cfg, dep)
+    if oid is None:
+        return "its PR's merge commit could not be read", False
+    try:
+        if integrate._carries(view, oid, f"{dep}'s merge commit {oid[:12]}", branch,
+                              of=str(tip)):
+            return None
+    except integrate.IntegrationError as exc:
+        return str(exc), False
+    return f"merge commit {oid[:12]}", True
+
