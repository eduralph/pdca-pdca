+def merge_commit(cfg: Config, dep_id: str) -> str | None:
+    """The commit bundle ``dep_id``'s recorded PR merge put on its base, or ``None`` (#655).
+
+    Asks ``gh pr view <pr_url> --json state,mergeCommit`` for the PR in ``publish.json``
+    and returns ``mergeCommit.oid`` only when ``state`` is ``MERGED``. That commit is on the
+    base for a merge, squash or rebase merge alike; :func:`merged_head`'s ``headRefOid`` is
+    not — a squash or rebase merge never puts the PR head on the base. Fail-closed and
+    silent, as :func:`pr_state` is: no recorded PR, a PR not merged, a ``gh`` failure
+    (``gh`` missing included) or output it cannot parse all return ``None``, which
+    ``flow._runnable`` treats as "not known to be on the line", and names."""
+    rec = _publish_record(cfg.find_bundle(dep_id))
+    pr_url = rec.get("pr_url") if isinstance(rec, dict) else None
+    if not pr_url:
+        return None
+    try:
+        r = subprocess.run(["gh", "pr", "view", str(pr_url), "--json", "state,mergeCommit"],
+                           capture_output=True, text=True)
+    except OSError:
+        return None
+    if r.returncode != 0:
+        return None
+    try:
+        info = json.loads(r.stdout or "{}")
+    except ValueError:
+        return None
+    if not isinstance(info, dict) or info.get("state") != "MERGED":
+        return None
+    mc = info.get("mergeCommit")
+    oid = mc.get("oid") if isinstance(mc, dict) else None
+    return oid if isinstance(oid, str) and oid else None
+
