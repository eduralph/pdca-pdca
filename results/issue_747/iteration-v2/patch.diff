+        self._plan("Q", {"q.txt": "q\n"})
+        self._plan("W", {"w.txt": "w\n"})
+        self._plan("Y", {"shared.txt": "y\n"}, depends_on="Q")
+        self._plan("V", {"v.txt": "v\n"}, depends_on="W")
+        self._plan("U", {"u.txt": "u\n"}, depends_on="V")
+        self._run(["F", "Z", "Q", "W", "Y", "V", "U"], finished=("F",))
