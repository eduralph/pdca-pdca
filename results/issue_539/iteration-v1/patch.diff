+#: never reaches the stream), and the set it retries a sub-agent's API-error termination
+#: on is ``new Set(["rate_limit","overloaded","server_error"])`` — ``rate_limit`` being
+#: the mid-session twin of the invocation-time rejection #138 already retried.
+#: ``server_error`` is also what it stamps on a lost connection (``Connection to the API
+#: was lost (<code>)``) and on a response that never came.
+_CLAUDE_TRANSIENT_KINDS = frozenset({"server_error", "overloaded", "rate_limit"})
+#: The kind the CLI's mapper falls back to when it could not classify the failure itself.
+_CLAUDE_UNKNOWN_KIND = "unknown"
+#: HTTP statuses worth another attempt besides 5xx — the API client's own retry rule
+#: (``status===408 || status===409 || status===429 || status>=500``).
+_TRANSIENT_STATUSES = frozenset({408, 409, 429})
+#: The categories the harness retries — a lost or interrupted connection, an overload or
+#: 5xx, a rate-limit rejection — for the one report whose kind says the vendor could not
+#: tell. Run ONLY on the text of a main-session report stamped
+#: :data:`_CLAUDE_UNKNOWN_KIND` that carries no typed ``api_error``: never on a kind the
+#: vendor did classify, never on an unstamped report, never on a ``result``'s prose.
+_TRANSIENT_CAUSE_RE = re.compile(r"""
+      connection\s+(?:to\s+the\s+api\s+)?(?:was\s+)?(?:lost|reset|closed|refused|aborted
+                                                    |dropped|error|failed|interrupted
+                                                    |timed\s*out)
+    | (?:lost|interrupted|dropped|reset)\s+(?:the\s+)?connection
+    | mid-?response
+    | socket\s+hang\s*up
+    | other\s+side\s+closed
+    | premature\s+close
+    | \bterminated\b
+    | fetch\s+failed
+    | network\s+(?:error|failure|timeout|unreachable)
+    | \btimed\s+out\b
+    | \btimeout\b
+    | overload(?:ed)?
+    | (?:temporarily|service|server)\s+unavailable
+    | rate[\s_-]?limit
+    | too\s+many\s+requests
+    | internal\s+server\s+error
+    | bad\s+gateway
+    | gateway\s+time-?\s?out
+    | \b(?:ECONNRESET|ECONNREFUSED|ECONNABORTED|ETIMEDOUT|EPIPE|EAI_AGAIN|ENOTFOUND
+         |EHOSTUNREACH|ENETUNREACH|ENETDOWN|ERR_SOCKET_CLOSED|UND_ERR_SOCKET)\b
+    | \b(?:408|409|429|5\d\d)\b
+""", re.I | re.X)
+
+
+def _reports_transient_cause(line: str | dict, fmt: str = "claude-stream-json") -> bool:
+    """Does this marked record say the leaf died of a cause the **vendor** marks transient?
+
+    The classification companion to :func:`_terminal_error` (which keeps the record) and
+    :func:`_is_session_event`, in their shape: dispatch on ``stream_format``, the drain's
+    shared decode, and ``False`` for every family and record it does not know — so codex
+    and every stream-less family keep exactly today's verdict.
+
+    * A main-session **report** is transient when its kind is one of
+      :data:`_CLAUDE_TRANSIENT_KINDS`. A kind stamped :data:`_CLAUDE_UNKNOWN_KIND` with no
+      typed ``api_error`` is the vendor saying it could not tell, so its text is matched
+      against :data:`_TRANSIENT_CAUSE_RE` — the only door prose comes in through. Any
+      other kind (the permanent ones, one this harness has not read, an ``unknown`` the
+      vendor typed — a gateway sign-in, a provider credential) and an unstamped report
+      are not transient, whatever the text says.
+    * A **sub-agent's** report never is: the CLI recovers a Task's API-error termination
+      itself, so it says nothing about how the session ended.
+    * The ``result`` wrap-up is transient only in its ``success`` variant — the one the CLI
+      builds when the session ended on its own API-error message, and the only one that
+      carries that error's HTTP status — with a status a retry can clear (5xx, or one of
+      :data:`_TRANSIENT_STATUSES`). An ``error_*`` wrap-up ends on whatever threw, so its
+      status, if any, is not the death's.
+    """
+    if fmt != "claude-stream-json":
+        return False
+    ev = _stream_event(line)
+    if ev.get("type") == "assistant" and (ev.get("is_api_error_message")
+                                          or ev.get("isApiErrorMessage")):
+        if _is_subagent_event(ev):
+            return False
+        kind = ev.get("error")
+        if not isinstance(kind, str):
+            return False  # unstamped: the vendor made no judgement to follow
+        if kind in _CLAUDE_TRANSIENT_KINDS:
+            return True
+        if kind != _CLAUDE_UNKNOWN_KIND or ev.get("api_error"):
+            return False
+        return any(_TRANSIENT_CAUSE_RE.search(t)
+                   for t in _claude_message_texts(ev.get("message")))
+    if ev.get("type") == "result" and ev.get("is_error"):
+        status = ev.get("api_error_status")
+        return (ev.get("subtype") == "success" and isinstance(status, int)
+                and (status in _TRANSIENT_STATUSES or 500 <= status <= 599))
+    return False
+
+
+#: The event types that are the session doing turn work. A ``result`` is its wrap-up, so
+#: it is not "the session carried on".
+_WORK_EVENT_TYPES = frozenset({"assistant", "user"})
+
+
+def _is_main_session_work(line: str | dict, fmt: str = "claude-stream-json") -> bool:
+    """Is this line the MAIN session carrying on — so a report before it was not the
+    leaf's death, and whatever fails later is the leaf's own (#539)?
+
+    ``user`` belongs here as much as ``assistant``: a session that recovers and runs a
+    tool answers with a main-session ``tool_result``, emitted as ``type: "user"`` with
+    ``parent_tool_use_id: null``. **Main-session** matters as much: a sub-agent's traffic
+    (:func:`_is_subagent_event`) is a Task still draining, and letting it count would clear
+    the very report that explains the death.
+    """
+    if fmt != "claude-stream-json":
+        return False
+    ev = _stream_event(line)
+    return ev.get("type") in _WORK_EVENT_TYPES and not _is_subagent_event(ev)
+
+
 def _stream_tool_label(line: str | dict, fmt: str = "claude-stream-json") -> str:
     """A human label for the tool-use in one stream line, or "" if none.
     Best-effort: a non-JSON / non-tool line yields ""."""
