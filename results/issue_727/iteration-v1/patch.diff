+def _closure_members(cfg: Config, d: Path, *, built: Mapping[str, tuple[Path, int]],
+                     finished: Collection[str], conflicts: Mapping[str, Collection[str]],
+                     on_line: Collection[str]) -> list[Path] | str:
+    """What bundle ``d`` is built on in stack mode (#727): the members of a base of its own,
+    or why it keeps the run's line.
+
+    ``d`` is ordered after a bundle by a declared edge: ``Depends on`` and ``Depends on
+    (merged)``, transitively, and a ``Conflicts with`` partner (either side declared it:
+    ``conflicts``) built in an earlier wave. Only bundles this run built count (``built``:
+    accepted, not held → ``(directory, wave)``, in wave then name order), and the walk goes
+    only through them. From ``d`` and each member every edge is followed (a member's
+    branch was cut from a base holding its own closure); from a bundle that brought no
+    branch to ``d``'s target only its prerequisite edges, and only when one reached it. An
+    edge out of the drive set, to no id of ``finished``, is an out-of-batch prerequisite:
+    on the real base once merged into it (:func:`_runnable`), it adds nothing.
+
+    Returns the members — those reached whose branch the fold carries on ``d``'s target
+    (:func:`integrate._fold_candidates`), in ``built``'s order; ``[]`` is the real base —
+    or, as a str, the seam that keeps ``d`` on the line as before: a walked bundle that
+    declares ``Stacks on`` or ``Onto branch``, or a member published as an ``Onto branch``
+    commit (no cut point is recorded for one); an edge from a walked bundle to one of
+    ``finished`` (the run's finished named ids: carried, or with no patch — #728 makes
+    them members); a member built on the line (``on_line``), which holds the whole line."""
+    target = publish._resolve_target(d)[:2]
+    cands = integrate._fold_candidates([p for p, _w in built.values()])
+    on_target = {m.name for m, repo, base, _s, _r in cands if (repo, base) == target}
+    onto = {m.name for m, _repo, _base, _s, ref in cands if ref and ref[2]}
+    found: set[str] = set()
+    walked: dict[str, bool] = {}       # name → walked with every edge (True), or prereqs only
+    todo: list[tuple[Path, bool]] = [(d, True)]
+    while todo:
+        m, every = todo.pop()
+        if walked.get(m.name) or (m.name in walked and not every):
+            continue                   # walked already, with at least these edges
+        walked[m.name] = every
+        bp = m / "brief.md"
+        if not bp.exists():
+            continue
+        legacy = next((f for f, on in (("Stacks on", brief.stacks_on(bp)),
+                                       ("Onto branch", brief.onto_branch(bp))) if on), None)
+        if legacy:
+            return f"{m.name} declares `{legacy}`"
+        wave = built[m.name][1] if m.name in built else None   # None: d, after every one
+        edges = [(cfg.bundle(x).name, True)
+                 for x in brief.depends_on(bp) + brief.depends_on_merged(bp)]
+        edges += [(n, False) for n in sorted(conflicts.get(m.name, ()))] if every else []
+        for n, prereq in edges:
+            if n in finished:
+                how = "depends on" if prereq else "`Conflicts with`"
+                return f"{m.name} {how} {n}, finished in an earlier run"
+            if n == d.name or n not in built:
+                continue
+            if not prereq and wave is not None and built[n][1] >= wave:
+                continue               # a partner built after m: m's base did not hold it
+            found.add(n)
+            if n in on_target or prereq:
+                todo.append((built[n][0], n in on_target))
+    members = [p for n, (p, _w) in built.items() if n in found and n in on_target]
+    for m in members:
+        if m.name in onto:
+            return f"{m.name} was published as an `Onto branch` commit"
+        if m.name in on_line:
+            return f"{m.name} was built on the run's line"
+    return members
+
