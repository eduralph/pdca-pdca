+def _line_prs(carried_heads: Mapping[str, str],
+              line_cut: Mapping[str, tuple[tuple[str, str], Mapping[str, str]]],
+              pushed: Collection[str], accepted: list[Path]) -> dict[str, list[str]]:
+    """For each bundle the run's line took a head from (``carried_heads``), the bundles whose
+    PR the run cut from that target's line after it took that head (#727): pointed at the
+    line (``line_cut``) when it had taken that head, and published this run (``pushed``)."""
+    target = {d.name: publish._resolve_target(d)[:2] for d in accepted}
+    return {name: sorted(n for n, (tgt, had) in line_cut.items()
+                         if n in pushed and tgt == target.get(name) and had.get(name) == took)
+            for name, took in carried_heads.items()}
+
