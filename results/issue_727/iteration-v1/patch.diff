+def _bundle_bases(cfg: Config, runnable: list[Path], *, built: Mapping[str, tuple[Path, int]],
+                  finished: list[Path], bundles: list[Path],
+                  integ: dict[tuple[str, str], str],
+                  folded_tips: Mapping[tuple[str, str], str | None],
+                  carried_heads: Mapping[str, str], batch: list[str],
+                  bases: dict[str, tuple[str, dict[str, str]]],
+                  line_cut: dict[str, tuple[tuple[str, str], dict[str, str]]]) -> None:
+    """Point each bundle of ``runnable`` at what it is built on (#727): a base of its own
+    holding exactly the accepted work of the bundles it is ordered after that this run
+    built (:func:`_closure_members`), the real base when none has work on its target, or —
+    a seam — the run's line, as before (:func:`_point_at_integration`).
+
+    A base of its own is :func:`integrate.build_bundle_base` of the members, given the
+    heads the line took (``carried_heads``) as ``carried`` (a member rewritten since is
+    refused, #633) and as ``excluded`` (to name who owns stray work). Every base of the
+    wave is built before any bundle is pointed: an :class:`integrate.IntegrationError`
+    names the bundle and its members and propagates, and the caller stops the run. Then
+    ``bases`` gets ``(branch, {member: the head it took})`` per base — what the later
+    checks hold each member's branch to (#633, #695) — and ``line_cut`` gets ``(target,
+    the heads that line had taken)`` per bundle pointed at a line (:func:`_line_prs`)."""
+    conflicts = waves.conflict_map(cfg, [*bundles, *finished])
+    plans = {d.name: _closure_members(cfg, d, built=built, finished={f.name for f in finished},
+                                      conflicts=conflicts, on_line=set(line_cut))
+             for d in runnable}
+    made: dict[str, tuple[str, str, dict[str, str]]] = {}
+    for d in runnable:
+        members = plans[d.name]
+        if isinstance(members, str) or not members:
+            continue
+        took: dict[str, str] = {}
+        try:
+            branch, tip = integrate.build_bundle_base(cfg, d, members, batch=batch,
+                                                      carried=carried_heads,
+                                                      excluded=carried_heads,
+                                                      merged_heads=took)
+        except integrate.IntegrationError as exc:
+            raise integrate.IntegrationError(
+                f"could not build {d.name}'s own base from "
+                f"{', '.join(m.name for m in members)}: {exc}", cause=exc.cause) from exc
+        made[d.name] = (branch, tip, took)
+    for d in runnable:
+        plan = plans[d.name]
+        if isinstance(plan, str):      # a seam: the run's line, as before #727
+            _point_at_integration(integ, [d], folded_tips)
+            target = publish._resolve_target(d)[:2]
+            if integ.get(target):
+                line_cut[d.name] = (target, dict(carried_heads))
+        elif d.name in made:
+            branch, tip, took = made[d.name]
+            publish.write_stack_base(d, branch, tip)
+            bases[d.name] = (branch, took)
+        else:
+            publish.clear_stack_base(d)
+
