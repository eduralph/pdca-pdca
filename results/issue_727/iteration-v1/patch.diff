+"""In stack mode an in-batch bundle is built on what it declares, not on when it was
+scheduled (#727, for #463).
+
+Before #727 every runnable bundle was pointed at the run's one integration line, which holds
+every bundle an earlier wave accepted: ``B`` (``Depends on: A``) was cut from a line that
+also held ``Z``, a bundle of the same earlier wave it has nothing to do with, so ``B``'s PR
+carried ``Z``'s commits, and merging it landed ``Z`` even after ``Z``'s own PR was closed
+(#630). Now a bundle's base carries exactly the accepted work of the bundles it is ordered
+after by a declared edge that this run built — ``Depends on`` and an in-batch ``Depends on
+(merged)``, transitively; an earlier-wave ``Conflicts with`` partner — built by
+``integrate.build_bundle_base`` (#723); with none of those it is built on the real base. A
+bundle whose closure meets a seam — a bundle this run did not build (a carried one), an
+``Onto branch`` member, a legacy ``Stacks on`` bundle, a ``Conflicts with`` a carried
+bundle — keeps the line, exactly as before, and is built. The #633 (next fold) and #695
+(end of run) rewrite checks hold each branch to the head every bundle's own base took, and
+name that base, that head and that bundle's PR; the line is reported as before, naming the
+PRs cut from it.
+
+These cases drive ``flow._drive_and_act`` through real folds on the ``StackFoldGit`` fixture
+of tests/test_integrate_stack_bases.py (a bare ``origin``, a primary checkout and a scratch
+clone), loaded by path and used as a helper object, as tests/test_flow_same_wave_conflict.py
+does. The build and sign-off leaves are stubbed (the build writes a ``patch.diff`` and
+accepts; a bundle can fail, close with no patch, or be discontinued instead),
+``flow._publish_bundle`` cuts each PR branch from the recorded stack-base tip (else the
+recorded base, else a legacy ``Stacks on`` parent's branch, else the base; an ``Onto
+branch`` bundle commits onto that branch), and ``gh`` is answered by a stub in front of
+``subprocess.run``. The publisher is NOT a stub (a stub turns every fold into a dry-run).
+
+Only modules are imported (never a symbol the fix adds), so with the production change
+reverted these cases still load and run — and fail on their assertions.
+    cd template && PYTHONPATH=src python3 -m unittest tests.test_flow_dependency_scoped_bases
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import importlib.util
+import io
+import json
+import shutil
+import subprocess
+import unittest
+from collections.abc import Callable
+from contextlib import ExitStack, redirect_stderr, redirect_stdout
+from pathlib import Path
+from unittest import mock
+
+from pdca_harness import brief, flow, integrate, publish, signoff, state
+
+_SPEC = importlib.util.spec_from_file_location(
+    "stack_bases_fixture", Path(__file__).with_name("test_integrate_stack_bases.py"))
+sb = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(sb)
+
+TODAY = "2026-10-17"
+TWO = "two commits"
+_FIELDS = {"depends_on": "Depends on", "merged": "Depends on (merged)",
+           "conflicts_with": "Conflicts with", "stacks_on": "Stacks on",
+           "onto": "Onto branch"}
+#: How the run starts the line naming the line's branches its end check could not judge,
+#: and the one naming the heads bundles' own bases took (`flow._report_late_rewrites`).
+UNCHECKED_LINE = "flow: could not check whether a branch this run folded onto its line"
+UNCHECKED_BASE = "flow: could not check whether a branch a bundle's own base took"
+#: Today's wording for the line (`integrate.py`, `flow.py`): never said of a bundle's base.
+LINE_WORDS = ("the commit the line took", "every PR this run cut from")
