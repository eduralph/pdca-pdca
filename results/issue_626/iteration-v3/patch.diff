+# The step for a squash- or rebase-merged PR (#626), in one place so that the fold and the carry
+# give the same bundle the same advice. Its work is on the base, so no carry of it will ever
+# come: the way out is a run without it, whose line is a line of its own
+# (:func:`integration_branch`).
+SQUASH_STEP = ("stack mode needs merge commits: update each branch built on {name} from {base} "
+               "(GitHub's \"Update branch\") or rebuild it from {base}, then re-issue without "
+               "{name}")
+# That step's last part for an ``Onto branch`` record or legacy ``Stacks on:`` PR. Such a record
+# never counts as merged into the base (:func:`merged.merged_into`), so a run without it still
+# holds a bundle naming it.
+DROP_PREREQ = ", and drop {name} from the brief of any bundle that names it as a prerequisite"
+
+
+def _squash_merged(cfg: Config, d: Path, wt: Path, base_ref: str) -> str:
+    """The merge commit of bundle ``d``'s merged PR when ``base_ref`` has it, else "" (#626).
+    The caller has found the PR's head on neither ``base_ref`` nor the line, so a merge commit
+    on the base means the merge put the work there as new commits: a squash or rebase merge.
+    Fail-closed: a merge commit that cannot be read or is empty
+    (:func:`merged.merge_and_head`), or one the base lacks (the PR merged into another
+    branch), is "". The host is asked only here, so only for such a PR."""
+    read = merged.merge_and_head(cfg, d.name.removeprefix("issue_"))
+    oid = read[0] if read else ""
+    if oid and _carries(wt, oid, f"{d.name}'s merge commit {oid}", base_ref, of=base_ref):
+        return oid
+    return ""
+
