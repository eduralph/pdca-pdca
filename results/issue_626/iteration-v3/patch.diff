+    def _stopped(self, a: Path) -> str:
+        """The fold stops on ``a``, names it and pushes nothing. Returns the message."""
+        with mock.patch.object(subprocess, "run", self._gh_stub), \
+                redirect_stderr(io.StringIO()):
