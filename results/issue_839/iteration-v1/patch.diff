+def _merge_way_out(cfg: Config, name: str, repo: str, base: str) -> str:
+    """Merge mode's way out for a dependent on ``repo`` @ ``base`` held for prerequisite
+    ``name``, when the pre-wave merge left no note on it (#839), read from its record: no
+    ``gh`` call."""
