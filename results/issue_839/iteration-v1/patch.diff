+    rec = publish._publish_record(p)
+    if not isinstance(rec, dict) or not rec.get("pr_url"):
+        return (f"it has no PR on record; publish it (`pdca publish {iid}`), merge the PR by "
+                f"hand, then re-run")
+    if tuple(publish._resolve_target(p)[:2]) != (repo, base):
+        return f"it does not target {base} ({repo}); get its work onto {base}, then re-run"
+    if rec.get("merge_eligible") is True:
+        return "let a merge-mode run merge it (it is marked), or merge the PR by hand, then re-run"
+    return ("no merge-mode run may merge it (it is not marked), so merge the PR by hand, then "
+            "re-run")
