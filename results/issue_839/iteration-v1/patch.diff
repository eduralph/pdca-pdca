+    # -- every refusal: "held" on this path, the wave boundary's text on the other ----------
+
+    def _refusal(self, *, fail: str = "", held: str | None = None, **pr) -> str:
+        iid = f"R{len(self.pr)}"    # a bundle and branch of its own for each call
+        d = self._opened(iid, marked=True)
+        self.pr[iid].update(pr)
+        real = self._gh
+
+        def gh(args, *a, **k):
+            if isinstance(args, list) and args[:3] == ["gh", "pr", fail]:
+                return subprocess.CompletedProcess(args, 1, "", "refused")
+            return real(args, *a, **k)
+
+        err = io.StringIO()
+        with mock.patch.object(subprocess, "run", gh), redirect_stdout(io.StringIO()), \
+                redirect_stderr(err):
+            rc = merge._merge_one(self.cfg, d, dry_run=False, method="merge", fetched=set(),
+                                  held=held)
+        self.assertEqual(rc, 1, err.getvalue())
+        return err.getvalue()
