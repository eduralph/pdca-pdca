         return None
 
 
+def _target_grant(bundles: list[Path], cfg: Config, profile) -> list[str]:
+    """The grounding-grant argv admitting the resolved target checkout(s) for
+    ``bundles`` — the reviewer's grant (:2495-2500) generalized to every INTERACTIVE
+    leaf the driver launches (planner, sign-off, publisher, Act), which ran with cwd
+    ``cfg.root`` and no grant at all (issue #494): a human approving an out-of-
+    workspace read there could not have that approval carry over, because it never
+    reached the session that needed it.
+
+    Resolution is :func:`_reviewer_target`'s, reused rather than re-derived: the
+    per-cycle worktree when one exists, else the sibling checkout the brief's
+    "Repo + branch target" field names via ``publish._resolve_target`` /
+    ``_checkout_path``. A bundle with no resolvable target (Plan, before the brief
+    exists) contributes nothing — the grant is never faked. Several bundles (batch
+    sign-off, Act) may each name a different target; each resolved checkout is
+    admitted once, in encounter order — never a directory the config does not name.
+
+    Skipped outright when the profile has no grounding flag (the ``generic``
+    family): that spawn stays byte-identical to today, exactly as the reviewer's
+    own conditional already does.
+    """
+    if not profile.grounding_flag:
+        return []
+    seen: list[Path] = []
+    for d in bundles:
+        target = _reviewer_target(d, cfg)
+        if target is not None and target not in seen:
+            seen.append(target)
+    extra: list[str] = []
+    for p in seen:
+        extra += [profile.grounding_flag, str(p)]
+    return extra
+
+
