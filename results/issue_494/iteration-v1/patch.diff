diff --git a/template/tests/test_leaf_workspace_admission.py b/template/tests/test_leaf_workspace_admission.py
new file mode 100644
index 0000000..7a3b1a7
--- /dev/null
+++ b/template/tests/test_leaf_workspace_admission.py
@@ -0,0 +1,191 @@
+"""Interactive-leaf workspace admission (issue #494, stdlib unittest, no deps).
+
+Every leaf the driver spawns runs with cwd ``cfg.root`` (a claude-family CLI walks up
+from cwd to find ``.claude/agents`` + its hooks — leaves.py:1793-1802). The headless
+leaves (Do, Check reviewer/advisory) are additionally GROUNDED in whatever they must
+read outside that cwd via the family's grounding flag (``--add-dir`` for claude),
+computed at spawn from the config (leaves.py:1802, :1816, :2495-2500). The four
+INTERACTIVE leaves — planner, sign-off (single and batch), publisher, Act — were not:
+they called ``_invoke(<leaf>, cfg.root, …)`` with no ``extra_argv`` at all
+(``do_plan`` :782-783, ``run_signoff`` :3261, ``run_signoff_batch`` :3308,
+``run_publish`` :3465-3466, ``run_act`` :3400 on the pre-fix tree), so a human
+approving an out-of-workspace read (the target checkout sign-off/publish/Plan must
+read to do their job) could never have that approval carry over between sessions —
+it never reached the session that needed it.
+
+This module asserts the composed fix (``leaves._target_grant``, mirroring the
+reviewer's own conditional): every interactive spawn admits the resolved target
+checkout(s) named by the config — and *only* those (criterion ii: an unnamed
+directory is never admitted), skipped outright for a family with no grounding
+mechanism (criterion iii: the grant is never faked).
+
+Run with:
+    PYTHONPATH=src python -m unittest discover -s tests
+"""
+
+from __future__ import annotations
+
+import shutil
+import subprocess as sp
+import tempfile
+import unittest
+from pathlib import Path
+
+from pdca_harness import leaves
+from pdca_harness.config import Config, LeafConfig
+
+
+def _cfg(root: Path, **leaf_cfg) -> Config:
+    base = dict(
+        root=root,
+        bundle_root=root / "results",
+        process_dir=root / "process",
+        templates_dir=root / "templates",
+        default_branch="main",
+        tracker_system="github",
+        tracker_url="",
+        issue_id_example="1",
+        builder=LeafConfig(mode="stub"),
+        reviewer=LeafConfig(mode="stub"),
+        planner=LeafConfig(mode="stub"),
+        signoff=LeafConfig(mode="stub"),
+        publisher=LeafConfig(mode="stub"),
+        act=LeafConfig(mode="stub"),
+        base_remote="origin",
+    )
+    base.update(leaf_cfg)
+    return Config(**base)
+
+
+_CLAUDE = LeafConfig(mode="command", family="claude", argv=["claude", "-p"])
+# The `generic` profile (empty family resolves to it) has no grounding_flag at all —
+# the family with no grounding mechanism criterion (iii) requires the grant skipped
+# for, never faked.
+_GENERIC = LeafConfig(mode="command", family="", argv=["true"])
+
+
+class LeafWorkspaceAdmission(unittest.TestCase):
+    def setUp(self) -> None:
+        self.tmp = Path(tempfile.mkdtemp())
+        self.target = self.tmp / "repo"
+        self.target.mkdir()
+        sp.run(["git", "init", "-q"], cwd=self.target, check=True)
+        # A second checkout the config ALSO names (for a different repo_spec) but that
+        # no bundle in a given test targets — criterion (ii)'s negative case: config
+        # naming *something* must not admit *everything* it names.
+        self.other = self.tmp / "other"
+        self.other.mkdir()
+        sp.run(["git", "init", "-q"], cwd=self.other, check=True)
+
+        self.captured: list[dict] = []
+        self._orig_invoke = leaves._invoke
+
+        def fake_invoke(leaf, workdir, prompt, **kw):
+            self.captured.append({"workdir": workdir, "extra_argv": kw.get("extra_argv")})
+
+        leaves._invoke = fake_invoke
+
+    def tearDown(self) -> None:
+        leaves._invoke = self._orig_invoke
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def _bundle(self, cfg: Config, iid: str, target: str = "org/repo @ main") -> Path:
+        d = cfg.bundle(iid)
+        d.mkdir(parents=True)
+        (d / "brief.md").write_text(
+            f"- **Slug:** s{iid}\n- **Repo + branch target:** {target}\n",
+            encoding="utf-8")
+        return d
+
+    # -- planner ------------------------------------------------------------
+    def test_planner_admits_the_resolved_target_checkout(self) -> None:
+        cfg = _cfg(self.tmp, planner=_CLAUDE)
+        cfg.repo_checkouts = {"org/repo": str(self.target), "org/other": str(self.other)}
+        d = self._bundle(cfg, "1")
+        leaves.do_plan(d, cfg)
+        self.assertEqual(len(self.captured), 1)
+        self.assertEqual(self.captured[0]["workdir"], cfg.root)  # cwd unchanged (iv)
+        self.assertEqual(self.captured[0]["extra_argv"],
+                         ["--add-dir", str(self.target)])  # only the named target (ii)
+
+    def test_planner_with_no_resolvable_target_admits_nothing(self) -> None:
+        # The ordinary Plan trigger (flow._plan_if_unplanned) only ever calls do_plan on
+        # an UNPLANNED bundle — brief.md does not exist yet, so nothing is resolvable.
+        # The grant must not be faked: extra_argv carries no directory at all.
+        cfg = _cfg(self.tmp, planner=_CLAUDE)
+        d = cfg.bundle("2")
+        d.mkdir(parents=True)
+        leaves.do_plan(d, cfg)
+        self.assertEqual(len(self.captured), 1)
+        self.assertEqual(self.captured[0]["extra_argv"], [])
+
+    # -- sign-off -------------------------------------------------------------
+    def test_signoff_admits_the_resolved_target_checkout(self) -> None:
+        cfg = _cfg(self.tmp, signoff=_CLAUDE)
+        cfg.repo_checkouts = {"org/repo": str(self.target), "org/other": str(self.other)}
+        d = self._bundle(cfg, "3")
+        leaves.run_signoff(d, cfg)
+        self.assertEqual(self.captured[-1]["workdir"], cfg.root)
+        self.assertEqual(self.captured[-1]["extra_argv"], ["--add-dir", str(self.target)])
+
+    def test_signoff_batch_admits_every_bundles_target_once(self) -> None:
+        # SIGNOFF_BATCH_SIZE covers several bundles in ONE session (flow.py:73-75);
+        # each bundle's own resolved target is admitted, deduped, not just the first.
+        cfg = _cfg(self.tmp, signoff=_CLAUDE)
+        cfg.repo_checkouts = {"org/repo": str(self.target), "org/other": str(self.other)}
+        d1 = self._bundle(cfg, "4", target="org/repo @ main")
+        d2 = self._bundle(cfg, "5", target="org/other @ main")
+        leaves.run_signoff_batch(cfg, [d1, d2])
+        self.assertEqual(len(self.captured), 1)  # one seeded session over both bundles
+        self.assertEqual(self.captured[-1]["extra_argv"],
+                         ["--add-dir", str(self.target), "--add-dir", str(self.other)])
+
+    def test_signoff_batch_dedupes_a_shared_target(self) -> None:
+        cfg = _cfg(self.tmp, signoff=_CLAUDE)
+        cfg.repo_checkouts = {"org/repo": str(self.target)}
+        d1 = self._bundle(cfg, "6")
+        d2 = self._bundle(cfg, "7")
+        leaves.run_signoff_batch(cfg, [d1, d2])
+        self.assertEqual(self.captured[-1]["extra_argv"], ["--add-dir", str(self.target)])
+
+    # -- publisher --------------------------------------------------------------
+    def test_publisher_admits_the_resolved_target_checkout(self) -> None:
+        cfg = _cfg(self.tmp, publisher=_CLAUDE)
+        cfg.repo_checkouts = {"org/repo": str(self.target), "org/other": str(self.other)}
+        d = self._bundle(cfg, "8")
+        leaves.run_publish(d, cfg)
+        self.assertEqual(self.captured[-1]["workdir"], cfg.root)
+        self.assertEqual(self.captured[-1]["extra_argv"], ["--add-dir", str(self.target)])
+
+    # -- Act ----------------------------------------------------------------------
+    def test_act_admits_the_resolved_target_checkouts(self) -> None:
+        cfg = _cfg(self.tmp, act=_CLAUDE)
+        cfg.act_cadence = 1  # else act_due needs 5 frozen cycles to trigger (unrelated to this)
+        cfg.repo_checkouts = {"org/repo": str(self.target), "org/other": str(self.other)}
+        d1 = self._bundle(cfg, "9", target="org/repo @ main")
+        d2 = self._bundle(cfg, "10", target="org/other @ main")
+        orig_frozen = leaves.act_mod.frozen_bundles
+        # Act reviews COMPLETE (frozen) bundles; state machinery to reach COMPLETE is
+        # unrelated to what this module tests (workspace admission), so the covered
+        # set is substituted the way a fixture substitutes any unrelated collaborator —
+        # `run_act`'s own admission call (the code under test) still runs unmocked.
+        leaves.act_mod.frozen_bundles = lambda cfg: [d1, d2]
+        try:
+            leaves.run_act(cfg, "2026-08-15")
+        finally:
+            leaves.act_mod.frozen_bundles = orig_frozen
+        self.assertEqual(len(self.captured), 1)
+        self.assertEqual(self.captured[-1]["extra_argv"],
+                         ["--add-dir", str(self.target), "--add-dir", str(self.other)])
+
+    # -- criterion (iii): a family with no grounding mechanism is untouched -------
+    def test_generic_family_spawn_is_byte_identical(self) -> None:
+        cfg = _cfg(self.tmp, signoff=_GENERIC)
+        cfg.repo_checkouts = {"org/repo": str(self.target)}
+        d = self._bundle(cfg, "11")
+        leaves.run_signoff(d, cfg)
+        self.assertEqual(self.captured[-1]["extra_argv"], [])  # the grant is skipped, not faked
+
+
+if __name__ == "__main__":
+    unittest.main()
