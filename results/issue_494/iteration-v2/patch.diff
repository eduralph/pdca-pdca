+# ----------------------------------------------------------------------------
+# Workspace admission for the INTERACTIVE leaves (issue #494).
+#
+# Every directory the harness INSTRUCTS a leaf to read must be admitted to that
+# leaf's workspace BY THE HARNESS, via the family's grounding flag. The headless
+# half already does it — the builder's worktree and bundle dir (:1802, :1816), the
+# reviewer's resolved target (:2499-2500), the two advisories — but the six
+# interactive spawns (Plan single/batch, sign-off single/batch, Act, publish) passed
+# no ``extra_argv`` at all, while their prompts point at the target checkout
+# (`_plan_prompt`'s citation line, planner.md.jinja, publisher.md.jinja). Their cwd
+# is ``cfg.root``, so that checkout was outside the workspace and the human was asked
+# to approve the same out-of-workspace read every session, with no way to make the
+# approval stick: a hand-granted rule lives in the operator's untracked
+# ``.claude/settings.local.json``, which a lane worktree never materializes and
+# ``--setting-sources project`` (families.py:100-102) drops by design. The spawn's
+# argv is the durable channel, and it is the one the headless half already uses.
+#
+# The set is DERIVED, never guessed, and both edges of the confinement doctrine bind:
+# under-admission asks the human for a decision that cannot take effect, on the one
+# band that cannot be retried unattended; over-admission hands a leaf reach the
+# configuration never granted (`_plan_fallback_target` :3029-3035 refuses exactly
+# that). So the only sources are the bundles' own briefs and the instance config.
+# ----------------------------------------------------------------------------
+def _primary_checkout(d: Path, cfg: Config) -> Path | None:
+    """The primary target checkout bundle ``d``'s brief names, or ``None``.
+
+    Resolved the way :func:`_plan_fallback_target` resolves it (``publish._resolve_target``
+    → ``publish._checkout_path``, guarded) — deliberately NOT :func:`_reviewer_target`,
+    which the interactive band must not reuse: it prefers ``worktree.path()``, and these
+    leaves run SERIALLY, so ``lane.current()`` is ``None`` (lane.py:26-28) and
+    ``worktree._wt_dir`` (:107-112) names the *unsuffixed* ``<name>.pdca-wt`` — a
+    harness-owned tree left at whatever commit its last user built, owned by no bundle,
+    and not the checkout the human has open in front of them. ``_reviewer_target`` also
+    ``git fetch``es (:1996-1999) for a grounding freshness these leaves do not need,
+    against the human's own checkout, on every spawn.
+
+    Best-effort, like every other grounding resolution here: no brief yet, an
+    unresolvable target field, or a checkout that is not a directory on this disk ⇒
+    ``None``, contributing nothing. The grant is never faked or guessed.
+    """
+    from . import publish  # lazy: publish imports leaves, avoid an import cycle
+    try:
+        repo_spec, _base, _slug = publish._resolve_target(d)
+        if not repo_spec:
+            return None
+        p = publish._checkout_path(cfg, repo_spec)
+    except Exception:  # noqa: BLE001 — admission is best-effort, never fatal
+        return None
+    return p if p.is_dir() else None
+
+
+def _known_targets(cfg: Config) -> list[Path]:
+    """The instance's KNOWN target checkouts — the fallback set for a session with no
+    brief to resolve, which is what Plan is (it authors the first one; the CSV/default
+    batch path picks its ids mid-session, :956-972).
+
+    ``[publisher.checkouts]`` — read through the same ``publish._checkout_path``, so a
+    relative entry resolves against the project root exactly as publish resolves it —
+    union the distinct primaries the instance's EXISTING briefs resolve to, active and
+    archived. Every element is therefore a directory the configuration or an artifact
+    already on disk names: it never derives a repo from the tracker URL, never guesses a
+    sibling that no brief mentions, and never admits a parent.
+    """
+    from . import publish  # lazy: publish imports leaves, avoid an import cycle
+    out: list[Path] = []
+    for spec in sorted(cfg.repo_checkouts):
+        try:
+            p = publish._checkout_path(cfg, spec)
+        except Exception:  # noqa: BLE001 — one bad mapping must not cost the others
+            continue
+        if p.is_dir() and p not in out:
+            out.append(p)
+    for b in sorted(cfg.bundle_root.glob("issue_*")) + \
+            sorted(cfg.bundle_root.glob("completed/issue_*")):
+        p = _primary_checkout(b, cfg)
+        if p is not None and p not in out:
+            out.append(p)
+    return out
+
+
+def _admission_set(bundles: list[Path], cfg: Config) -> list[Path]:
+    """The directories one interactive session may read outside ``cfg.root``: the
+    resolved primary checkout of each bundle the session is ABOUT, deduped, in
+    encounter order — falling back to :func:`_known_targets` when none resolves."""
+    dirs: list[Path] = []
+    for d in bundles:
+        p = _primary_checkout(d, cfg)
+        if p is not None and p not in dirs:
+            dirs.append(p)
+    return dirs or _known_targets(cfg)
+
+
+def _workspace_grant(bundles: list[Path], cfg: Config,
+                     profile: families.FamilyProfile) -> list[str]:
+    """The ``extra_argv`` admitting :func:`_admission_set` to an interactive spawn.
+
+    Shaped on the reviewer's own grant (:2495-2500): the flag is emitted ONLY when the
+    family has one. A family with no grounding mechanism (``generic``, families.py:44
+    /:126) is spawned byte-identically to before this existed — the grant is skipped,
+    not faked with a flag the CLI does not have.
+    """
+    if not profile.grounding_flag:
+        return []
+    extra: list[str] = []
+    for p in _admission_set(bundles, cfg):
+        extra += [profile.grounding_flag, str(p)]
+    return extra
+
+
