+def _would_be(wt: Path, branch: str, d: Path, ref: str) -> str:
+    """The commit publish would push for bundle ``d`` (#395), made in ``wt`` and never
+    pushed: publish's own steps less the fetch and the push — check out ``ref``, where
+    publish puts the patch (:func:`publish.cut_base`), apply ``d``'s ``patch.diff``, stage
+    everything, commit — on a detached HEAD, so it has the parent and the tree of the branch
+    publish pushes (the message differs, and no commit hook runs: it is never pushed). A step
+    that fails raises :class:`IntegrationError`, naming it. Ends with the tree back on
+    ``branch`` at the tip it had, clean, as :func:`_trial` does: one that will not go back
+    raises :class:`_LineBroken`, chained to the error the build was already raising, if any
+    (:func:`_back_on`)."""
+    tip = _rev(wt, "HEAD")
+    if tip is None:
+        raise IntegrationTreeError(f"could not read the tip of {branch} in {wt} — check that "
+                                   f"checkout, then re-run")
+    steps = ((("checkout", "-q", "--detach", ref), f"could not check out {ref}"),
+             (("apply", str((d / "patch.diff").resolve())),
+              f"its patch does not apply onto {ref}"),
+             (("add", "--all"), "`git add --all` failed"),
+             (("commit", "-q", "--no-verify", "-m",
+               f"pdca-integrate: would-be commit of {d.name}"), "`git commit` failed"))
