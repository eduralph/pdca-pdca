+    try:
+        for args, failed in steps:
+            if _git(wt, *args) != 0:
+                cause = f"{d.name}'s would-be commit could not be built: {failed}"
+                raise IntegrationError(f"{cause} (in {wt}) — check that checkout and the "
+                                       f"bundle's patch, then re-run", cause=cause)
