+    paths: list[str] = []
+    unread = [] if files is not None else [d.name]
+    for o in others:
+        theirs = waves.diff_footprint(o / "patch.diff")
+        if theirs is None:
+            unread.append(o.name)
+        if files is None or theirs is None:
+            partners.append(o.name)
+            continue
