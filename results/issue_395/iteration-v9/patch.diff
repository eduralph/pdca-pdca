+            i += 4
+        else:
+            return None
+    return None
+
+
+def _past_hunk(lines: list[str], i: int, old: int, new: int) -> tuple[int, bool]:
+    """``(end, whole)`` for the hunk body that starts at ``lines[i]``, holding ``old``
+    lines of the old side and ``new`` of the new: the index past it, and whether its lines
+    add up to those counts, as ``git apply`` counts them (apply.c ``parse_fragment``: an
+    empty line is an empty context line, a ``\\`` line marks a missing newline)."""
+    while i < len(lines) and (old > 0 or new > 0):
+        mark = lines[i][:1]
+        if mark in (" ", ""):
+            old, new = old - 1, new - 1
+        elif mark == "-":
+            old -= 1
+        elif mark == "+":
+            new -= 1
+        elif mark != "\\":
+            break
+        i += 1
+    while i < len(lines) and lines[i].startswith("\\"):
+        i += 1
+    return i, old == 0 and new == 0
