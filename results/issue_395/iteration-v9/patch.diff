+def _back_on(wt: Path, branch: str, at: str, *, after: str,
+             first: BaseException | None = None) -> None:
+    """Put ``wt`` back on ``branch`` at ``at``, clean (#395): after a step of the same-wave
+    trial (``after`` names it) the line is where the wave found it, whatever the step left —
+    a merge, a detached HEAD, untracked files. One that will not go back raises
+    :class:`_LineBroken`; a tree that cannot even be reset, :class:`IntegrationTreeError`
+    (:func:`_reset_tree`). ``first``: the error the step was already raising, if any. The
+    error raised here is then chained to it (``raise … from``) and keeps its cause in its own
+    words, so what failed first is still reported when the tree will not go back. A ``first``
+    that is no ``Exception`` (a ``^C``, an exit) is never replaced: the tree is put back if it
+    goes, and the caller raises ``first`` on, which the flow does not contain."""
+    if first is not None and not isinstance(first, Exception):
+        with contextlib.suppress(IntegrationError):
+            _back_on(wt, branch, at, after=after)
+        return
+    then = ""
+    if first is not None:
+        first_cause = getattr(first, "cause", None) or str(first) or type(first).__name__
+        then = f" (after an earlier failure: {' '.join(first_cause.split())})"
+    try:
+        _reset_tree(wt, "HEAD")
+    except IntegrationTreeError as exc:
+        if first is None:
+            raise
+        raise IntegrationTreeError(f"{exc}{then}", cause=f"{exc.cause}{then}") from first
+    if (_git(wt, "checkout", "-q", branch) != 0 or _git(wt, "reset", "-q", "--hard", at) != 0
+            or _rev(wt, "HEAD") != at):
+        cause = f"could not put {branch} back at {at} in {wt} after {after}{then}"
+        raise _LineBroken(f"{cause} — check that checkout, then re-run",
+                          cause=cause) from first
