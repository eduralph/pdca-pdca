+        _back_on(wt, branch, tip, after=after, first=exc)
+        raise
+    _back_on(wt, branch, tip, after=after)
+    return head
+
+
+def _wave_holds(wt: Path, branch: str, pre: str, built: Sequence[tuple[str, str]]
+                ) -> dict[str, tuple[list[str], list[str]]]:
+    """What the fold's same-wave rule (#674) holds of ``built`` — ``(name, commit)`` in fold
+    order — merged one after another onto ``branch`` in ``wt``, checked out at ``pre``, the
+    line as the wave found it, as :func:`fold` merges a wave's branches: one whose merge
+    conflicts after others of ``built`` were merged is held, never merged, exactly when
+    :func:`_held_by` says so. One that conflicts with ``pre`` itself is neither held nor
+    merged (the fold judges that against the line, #747). A merge that fails with no
+    conflicting path is a failed git step and raises. Leaves ``branch`` where the merges
+    took it: the caller puts it back."""
+    held: dict[str, tuple[list[str], list[str]]] = {}
+    kept: list[tuple[str, str]] = []
+    for name, head in built:
+        rc, paths = _merge(wt, head, f"pdca-integrate: trial of {name}")
+        if rc == 0:
+            kept.append((name, head))
+        elif not paths:
+            raise IntegrationError(f"could not try merging {name}'s would-be commit in {wt} — "
+                                   f"`git merge` exited {rc} with no conflicting path, so a git "
+                                   f"step failed: check that checkout, then re-run")
+        elif kept:
+            clash = _held_by(wt, branch, head, pre, kept)
+            if clash:
