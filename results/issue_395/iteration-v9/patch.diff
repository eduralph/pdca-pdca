+def same_wave_overlap(d: Path, accepted: Sequence[Path]
+                      ) -> tuple[list[str], list[str], list[str]] | None:
+    """What the flow refuses an accept on when :func:`same_wave_clash` cannot run (#395):
+    ``(partners, paths, unread)`` — the bundles of ``accepted`` with a patch on ``d``'s
+    target whose patch may touch a path ``d``'s does, the paths they share, and the bundles
+    (``d`` too, if so) whose patch names paths that could not all be read — or None when
+    there are no such partners. A textual conflict needs a shared path, so every other
+    bundle is accepted. Paths are read as ``git apply`` reads them
+    (:func:`waves.diff_footprint`), a quoted one (a non-ASCII name) decoded; a patch whose
+    paths are not all known may touch any, so it may overlap every patch it is tried
+    against, never none. A path under a directory the other patch touches as a file counts
+    too: git conflicts on a file one side adds where the other adds a directory."""
+    others = same_wave_siblings(d, accepted)
+    if not others:
+        return None
