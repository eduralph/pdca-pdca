+def _would_be(wt: Path, branch: str, d: Path, ref: str) -> str | None:
+    """The commit publish would push for bundle ``d`` (#395), made in ``wt`` and never
+    pushed: publish's own steps less the push — check out ``ref``, where publish cuts the
+    branch (:func:`publish.cut_base`), apply ``d``'s ``patch.diff``, stage everything,
+    commit — on a detached HEAD, so it has the parent and the tree of the branch publish
+    pushes (the message differs: no commit hooks, a trial commit is never pushed). None when
+    a step fails (``ref`` does not resolve, the patch does not apply, nothing to commit):
+    publish fails at the same step and pushes nothing. Ends with the tree back on ``branch``
+    at the tip it had, clean, as :func:`_trial` does; one that will not go back raises
+    :class:`_LineBroken`."""
+    tip = _rev(wt, "HEAD")
+    if tip is None:
+        raise IntegrationTreeError(f"could not read the tip of {branch} in {wt} — check that "
+                                   f"checkout, then re-run")
+    try:
+        built = (_git(wt, "checkout", "-q", "--detach", ref) == 0
+                 and _git(wt, "apply", str((d / "patch.diff").resolve())) == 0
+                 and _git(wt, "add", "--all") == 0
+                 and _git(wt, "commit", "-q", "--no-verify", "-m",
+                          f"pdca-integrate: trial commit of {d.name}") == 0)
+        return _rev(wt, "HEAD") if built else None
+    finally:
+        _reset_tree(wt, "HEAD")
+        if _git(wt, "checkout", "-q", branch) != 0 or _rev(wt, "HEAD") != tip:
+            raise _LineBroken(f"could not put {branch} back at {tip} in {wt} after building "
+                              f"{d.name}'s would-be commit — check that checkout, then "
+                              f"re-run")
