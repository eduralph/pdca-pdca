+        unbuilt: dict[str, str] = {}
+        cause = f"could not take the integration lock next to {wt.name}"
+        with contextlib.ExitStack() as scope:
+            holder = locks if locks is not None else scope
+            if holder.enter_context(integ_lock(wt)):
+                for attempt in range(_TRIAL_ATTEMPTS):
+                    if attempt:
+                        time.sleep(_FETCH_RETRY_PAUSE)
+                    try:
+                        found, unbuilt = _same_wave_trial(
+                            cfg, repo, base, integration_branch(cfg, base, batch), members,
+                            folded_this_run.get((repo_spec, base)))
+                    except IntegrationError as exc:
+                        found, cause = None, exc.cause
+                        continue
+                    if not unbuilt:
+                        break
+        if found is None:
+            first = members[0][0].name
+            untried.update({d.name: ([first], cause) for d, _remote, _ref in members[1:]})
+            continue
+        held_out.update(found)
+        beside = [d.name for d, _remote, _ref in members
+                  if d.name not in found and d.name not in unbuilt]
+        untried.update({name: (beside, why) for name, why in unbuilt.items()})
