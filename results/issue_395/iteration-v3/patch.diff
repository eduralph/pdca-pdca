+def _same_wave_trial(cfg: Config, repo: Path, base: str, branch: str,
+                     members: Sequence[tuple[Path, str, str]], tip: str | None
+                     ) -> tuple[dict[str, tuple[list[str], list[str]]], dict[str, str]]:
+    """One try of :func:`same_wave_holds` for the bundles of one target, ``members`` (each
+    ``(bundle, remote, cut)``, in fold order), under its lock: fetch, start ``branch`` at
+    ``tip`` (else ``<base_remote>/<base>``), build each would-be commit, then merge them in
+    order as the fold merges, judging one that conflicts by :func:`_held_by`. Returns
+    ``(held, unbuilt)``: name → ``(partners, paths)`` for each one held, and name → what
+    failed for each one whose would-be commit could not be built (:class:`_Unbuilt`), which
+    is not merged. The line is put back at its start, clean, before it returns or raises; any
+    other failed git step raises :class:`IntegrationError`, and so does a try that built no
+    bundle's commit."""
+    wt = _prepare_worktree(repo, cfg.base_remote, base,
+                           remotes=[remote for _d, remote, _ref in members])
+    start = tip or f"{cfg.base_remote}/{base}"
+    _reset_tree(wt, "HEAD")
+    if _git(wt, "checkout", "-B", branch, start) != 0:
+        raise IntegrationTreeError(f"could not put {branch} at {start} in {wt} — check that "
+                                   f"checkout, then re-run")
+    pre = _rev(wt, "HEAD")
+    if pre is None:
+        raise IntegrationTreeError(f"could not read the tip of {branch} in {wt} — check that "
+                                   f"checkout, then re-run")
+    built: list[tuple[str, str]] = []   # each would-be commit, in fold order: (name, head)
+    unbuilt: dict[str, str] = {}        # each one that could not be built → what failed
+    for d, _remote, ref in members:
+        try:
+            built.append((d.name, _would_be(wt, branch, d, ref)))
+        except _Unbuilt as exc:
+            unbuilt[d.name] = exc.cause
+    if not built:
+        raise IntegrationError(f"could not build any would-be commit in {wt} — check that "
+                               f"checkout, then re-run", cause=next(iter(unbuilt.values())))
+    held: dict[str, tuple[list[str], list[str]]] = {}
+    kept: list[tuple[str, str]] = []    # merged so far, as the fold merges them: (name, head)
+    try:
+        for name, head in built:
+            rc, paths = _merge(wt, head, f"pdca-integrate: trial of {name}")
+            if rc == 0:
+                kept.append((name, head))
+            elif not paths:
+                raise IntegrationError(
+                    f"could not try merging {name}'s would-be commit in {wt} — `git merge` "
+                    f"exited {rc} with no conflicting path, so a git step failed: check that "
+                    f"checkout, then re-run")
+            elif kept:
+                clash = _held_by(wt, branch, head, pre, kept)
+                if clash:
+                    held[name] = clash
+    finally:
+        _reset_tree(wt, pre)        # the line back where the wave found it (on `branch`)
+    return held, unbuilt
+
+
+def _would_be(wt: Path, branch: str, d: Path, ref: str) -> str:
+    """The commit publish would push for bundle ``d`` (#395), made in ``wt`` and never
+    pushed: publish's own steps less the push — check out ``ref``, where publish cuts the
+    branch (:func:`publish.cut_base`), apply ``d``'s ``patch.diff``, stage everything,
+    commit — on a detached HEAD, so it has the parent and the tree of the branch publish
+    pushes (the message differs: no commit hooks, a trial commit is never pushed). A step
+    that fails (``ref`` does not resolve, the patch does not apply, a git step fails) raises
+    :class:`_Unbuilt`, naming it: whether publish, in another checkout and later, fails the
+    same way is not known, so ``d`` must not be published as if it had been tried. Ends
+    with the tree back on ``branch`` at the tip it had, clean, as :func:`_trial` does; one
+    that will not go back raises :class:`_LineBroken` instead."""
+    tip = _rev(wt, "HEAD")
+    if tip is None:
+        raise IntegrationTreeError(f"could not read the tip of {branch} in {wt} — check that "
+                                   f"checkout, then re-run")
+    steps = ((("checkout", "-q", "--detach", ref), f"could not check out {ref}"),
+             (("apply", str((d / "patch.diff").resolve())),
+              f"its patch did not apply onto {ref}"),
+             (("add", "--all"), "`git add --all` failed"),
+             (("commit", "-q", "--no-verify", "-m",
+               f"pdca-integrate: trial commit of {d.name}"), "`git commit` failed"))
+    try:
+        for args, failed in steps:
+            if _git(wt, *args) != 0:
+                break
+        else:
+            head = _rev(wt, "HEAD")
+            if head is not None:
+                return head
+            failed = "the commit it made could not be read"
+        cause = f"{d.name}'s would-be commit could not be built in {wt}: {failed}"
+        raise _Unbuilt(f"{cause} — check that checkout, then re-run", cause=cause)
+    finally:
+        _reset_tree(wt, "HEAD")
+        if _git(wt, "checkout", "-q", branch) != 0 or _rev(wt, "HEAD") != tip:
+            raise _LineBroken(f"could not put {branch} back at {tip} in {wt} after building "
+                              f"{d.name}'s would-be commit — check that checkout, then "
+                              f"re-run")
+
+
