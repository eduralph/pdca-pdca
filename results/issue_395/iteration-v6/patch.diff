+def _refused_for_wave(cfg: Config, d: Path, trial: _AcceptTrial) -> bool:
+    """Whether bundle ``d``'s accept is refused because its change would conflict with
+    bundles of its own wave already accepted (#395) — refused as C6 refuses one: an open §6
+    row, the bundle left AWAITING_SIGNOFF, so no PR of it is opened beside theirs.
+
+    "Would conflict" is the fold's own rule, in the fold's order, on the commits publish
+    would push (:func:`integrate.same_wave_clash`): accepting ``d`` would make the fold after
+    the wave hold more bundles than it holds without it. So whichever bundle is accepted
+    first is kept, and the accepted bundles of a wave hold no such conflict unless the human
+    overrides. When that check cannot run for ``d``'s target (a lock, a fetch, a commit
+    that cannot be built), ``d`` is refused only if its patch shares a path with an accepted
+    bundle of the wave on that target (:func:`integrate.same_wave_overlap`), as a textual
+    conflict needs one; otherwise it is accepted, and stderr says so.
+
+    The row names the bundles it conflicts with, the files, and the step: declare
+    ``Conflicts with`` in ``d``'s brief, then iterate-plan. It goes into SUMMARY §6 only
+    (:func:`signoff.ensure_needs_human_item`), never into a Check artifact, so a SUMMARY
+    reassembled later drops it and the next accept tries again. A row already there and
+    ticked is the human's override, as C6 honours every tick: the accept goes on, and the
+    fold holds one of the two (#674). Each refusal is recorded in
+    ``state.SAME_WAVE_REFUSAL`` for :func:`_drive_wave`, which offers the bundle one more
+    sign-off session, not one every pass."""
+    accepted = [s for s in trial.wave
+                if s.name != d.name and state.state(s) == state.COMPLETE]
+    if not accepted:
+        return False
+    cause = ""
+    try:
+        repo_spec, base, _slug = publish._resolve_target(d)
+        clash = integrate.same_wave_clash(cfg, d, accepted,
+                                          tip=trial.folded_tips.get((repo_spec, base)),
+                                          batch=trial.batch)
+    except (integrate.IntegrationError, OSError, ValueError) as exc:
+        cause = " ".join((getattr(exc, "cause", "") or str(exc)).split())
