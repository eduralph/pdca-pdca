+"""A leaf's OWN terminal error report is read and kept (issue #506) — stdlib, no deps.
+
+`progress.run_with_heartbeat` already reads every event a claude leaf's stream emits, and
+used to throw away the one line that explains a death: it parsed stdout for a session flag
+and a tool label and retained only a bounded *stderr* tail. The incident that named this:
+an escalated builder ran ~18 minutes, its API connection dropped mid-response, the CLI
+exited 1 — and `build.error.log` read "(no output captured)". The cause was legible only in
+the CLI's session transcript under `~/.claude/projects/`. Worse, "produced any substantive
+event?" is only a proxy for "died at invocation", and the proxy fails for exactly the long
+sessions where an attempt is most expensive, so that death was classified *substantive* and
+retried zero times.
+
+This suite drives the real spawn path end to end — a stub "leaf" that is a Python
+interpreter emitting chosen stream events on stdout and exiting non-zero — through
+`progress.run_with_heartbeat` and through `leaves._invoke_leaf_resilient` (the
+reviewer/advisory path). Nothing here imports a symbol this fix adds, and every criterion
+has at least one case that builds its events INLINE; the two cases that replay pinned
+vendor bytes skip themselves when `fixtures/` is absent. Run with:
+    cd template && PYTHONPATH=src python3 -m unittest tests.test_terminal_error_classification
+"""
+
+from __future__ import annotations
+
+import contextlib
+import json
+import os
+import shutil
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from pdca_harness import leaves, progress
+from pdca_harness.config import LeafConfig
+
+FIXTURES = Path(__file__).resolve().parent / "fixtures"
+
+# The stub leaf: replay the event lines it is handed on stdout (the stream the drain
+# parses), write anything asked to stderr (the tail the drain already kept), and exit with
+# the given code. It counts its own invocations into $CNT so a case can assert the retries.
+_STUB = (
+    "import os,sys,time;"
+    "cnt=os.environ.get('CNT');"
+    "cnt and open(cnt,'a').write('x');"
+    "sys.stdout.write(open(os.environ['EVENTS']).read());"
+    "sys.stdout.flush();"
+    "sys.stderr.write(os.environ.get('STUB_STDERR',''));"
+    "time.sleep(float(os.environ.get('STUB_SLEEP','0')));"
+    "sys.exit(int(os.environ.get('STUB_RC','1')))"
+)
+
+SID = "31fa2f21-4d73-4810-9c23-ba33bd860167"
+#: A Task's tool_use id — what the CLI puts in `parent_tool_use_id` for everything a
+#: SUBAGENT emits, main-session events carrying `null` there.
+TASK_ID = "toolu_01SubAgentTaskId"
+
+
+# --- inline event builders: the shapes claude-code emits, per tests/fixtures/README.md ---
+def work(text: str = "carrying on") -> dict:
+    """A main-session assistant message — real work, `parent_tool_use_id` null."""
+    return {"type": "assistant", "session_id": SID, "parent_tool_use_id": None,
+            "message": {"role": "assistant",
+                        "content": [{"type": "text", "text": text}]}}
+
+
+def subagent_work(text: str = "subagent chatter") -> dict:
+    """A SUBAGENT's assistant message: same event type, but emitted through the CLI's
+    agent_progress branch, so it carries the Task's tool_use id."""
+    ev = work(text)
+    ev["parent_tool_use_id"] = TASK_ID
+    ev["subagent_type"] = "general-purpose"
+    return ev
+
+
+def report(text: str, kind: str | None = "server_error", *,
+           flag: str = "is_api_error_message", parent: str | None = None) -> dict:
+    """The CLI's own marked API-error message — the record that names the CAUSE.
+    ``parent`` is the Task id when a SUBAGENT reported it (the agent_progress branch
+    forwards the same mark), ``None`` for the main session's own account."""
+    ev = work(text)
+    ev[flag] = True
+    ev["parent_tool_use_id"] = parent
+    if kind is not None:
+        ev["error"] = kind
+    return ev
+
+
+def subagent_report(text: str, kind: str = "overloaded") -> dict:
+    """A marked API-error message a SUBAGENT emitted: same mark, same kinds, but the
+    Task's `parent_tool_use_id` — and the CLI recovers from these itself."""
+    ev = report(text, kind, parent=TASK_ID)
+    ev["subagent_type"] = "general-purpose"
+    return ev
+
+
+def wrapup_api_error(text: str, status: int | None = None) -> dict:
+    """The `success` result variant the engine builds out of a dead API-error message:
+    `is_error` set, its text in `result`, `api_error_status` whatever status there was
+    (null for a connection that dropped before any response)."""
+    return {"type": "result", "subtype": "success", "is_error": True,
+            "api_error_status": status, "result": text, "session_id": SID}
+
+
+def wrapup_execution_error(*errors: str) -> dict:
+    """The `error_during_execution` variant: a free `errors` list, naming no cause."""
+    return {"type": "result", "subtype": "error_during_execution", "is_error": True,
+            "errors": list(errors), "session_id": SID}
+
+
+@contextlib.contextmanager
+def _fd1_parked(path: Path):
+    """Point this process's fd 1 at ``path`` for the block — a child that INHERITS stdout
+    (every stream-less spawn) then writes there instead of into the suite's report."""
+    sys.stdout.flush()
+    saved = os.dup(1)
+    with open(path, "w", encoding="utf-8") as sink:
+        os.dup2(sink.fileno(), 1)
+    try:
+        yield
+    finally:
+        sys.stdout.flush()
+        os.dup2(saved, 1)
+        os.close(saved)
+
+
+class _StubLeafCase(unittest.TestCase):
+    """Shared plumbing: write the events file, run the stub leaf for real."""
+
+    def setUp(self) -> None:
+        self.tmp = Path(tempfile.mkdtemp())
+        self.cnt = self.tmp / "count.txt"
+        self.error_log = self.tmp / "check-review.error.log"
+        self.events = self.tmp / "events.jsonl"
+
+    def tearDown(self) -> None:
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def write_events(self, *events: dict | str) -> None:
+        lines = [ev if isinstance(ev, str) else json.dumps(ev) for ev in events]
+        self.events.write_text("".join(line.rstrip("\n") + "\n" for line in lines),
+                               encoding="utf-8")
+
+    def env(self, rc: int = 1, stderr_text: str = "") -> dict:
+        return {"CNT": str(self.cnt), "EVENTS": str(self.events),
+                "STUB_RC": str(rc), "STUB_STDERR": stderr_text}
+
+    def runs(self) -> int:
+        return len(self.cnt.read_text()) if self.cnt.exists() else 0
+
+    def heartbeat(self, *events: dict | str, rc: int = 1, stderr_text: str = "",
+                  fmt: str = "claude-stream-json", capture: bool = False,
+                  sleep: float = 0.0, timeout: int | None = None):
+        """Drive `progress.run_with_heartbeat` over the stub leaf directly."""
+        self.write_events(*events)
+        env = {**self.env(rc, stderr_text), "STUB_SLEEP": str(sleep)}
+        return progress.run_with_heartbeat(
+            [sys.executable, "-c", _STUB], stream_json=True, capture=capture,
+            stream_format=fmt, timeout=timeout, env={**os.environ, **env})
+
+    def resilient(self, *events: dict | str, rc: int = 1, stderr_text: str = "",
+                  family: str = "claude", attempts: int = 3):
+        """Drive the reviewer/advisory path (`leaves._invoke_leaf_resilient`), which is
+        resilient on any base — the spawn, the retry decision and the error log together."""
+        self.write_events(*events)
+        leaf = LeafConfig(mode="command", family=family,
+                          argv=[sys.executable, "-c", _STUB], interactive=False)
+        # A stream-LESS family's child inherits this process's stdout (that is the
+        # behaviour under test), so fd 1 is parked in a file for the call: the suite's own
+        # stdout stays clean, which is what a gate reads as the run's verdict (#402).
+        with _fd1_parked(self.tmp / "child-stdout.txt"):
+            return leaves._invoke_leaf_resilient(
+                leaf, self.tmp, "review please", error_log=self.error_log,
+                attempts=attempts, backoff=0.0, stream_json=True,
+                env=self.env(rc, stderr_text))
+
+
+class TransientTerminalReport(_StubLeafCase):
+    """(i) A marked terminal report whose cause the vendor calls transient is transient,
+    however much work came first."""
+
+    def test_work_then_connection_lost_is_transient_and_retried(self) -> None:
+        # The incident, inline: an assistant turn of real work, then the CLI's own marked
+        # report, then the session's wrap-up that names no cause, then exit 1.
+        err = self.resilient(
+            work("editing patch.diff"),
+            report("API Error: Connection lost mid-response. The response above may be "
+                   "incomplete.", "server_error"),
+            wrapup_api_error("API Error: Connection lost mid-response.", status=None),
+        )
+        self.assertIsInstance(err, leaves.LeafError)
+        self.assertTrue(err.transient)     # died of infra it reported, not of its work
+        self.assertEqual(self.runs(), 3)   # retried to the attempt budget
+        log = self.error_log.read_text()
+        self.assertIn("Connection lost mid-response", log)   # (iii) retention
+        self.assertNotIn("no output captured", log)
+
+    def test_overload_and_rate_limit_kinds_are_transient(self) -> None:
+        for kind, text in (("overloaded", "API Error: 529 the API is at capacity"),
+                           ("server_error", "API Error: 500 internal server error"),
+                           ("rate_limit", "API Error: Request rejected (429)")):
+            with self.subTest(kind=kind):
+                rc, out, produced = self.heartbeat(work(), report(text, kind))
+                self.assertEqual(rc, 1)
+                self.assertFalse(produced)  # transient despite the work that came first
+                self.assertIn(text, out)
+
+    def test_unclassified_connection_drop_is_transient_by_category(self) -> None:
+        # The CLI leaves a residual fetch abort as `API Error: terminated` with kind
+        # "unknown" — no kind to key on, so the CAUSE is read out of the report's own text.
+        rc, out, produced = self.heartbeat(work(), report("API Error: terminated",
+                                                          "unknown"))
+        self.assertEqual(rc, 1)
+        self.assertFalse(produced)
+        self.assertIn("API Error: terminated", out)
+
+    def test_transcript_spelling_of_the_mark_is_read_too(self) -> None:
+        # The persisted transcript spells it isApiErrorMessage, the stream
+        # is_api_error_message; keying on one alone would leave the incident unfixed.
+        rc, _out, produced = self.heartbeat(
+            work(), report("API Error: Connection lost mid-response.", "server_error",
+                           flag="isApiErrorMessage"))
+        self.assertEqual(rc, 1)
+        self.assertFalse(produced)
+
+    def test_report_survives_the_wrapups_that_name_no_cause(self) -> None:
+        # Both wrap-up shapes follow the death and neither names the cause; read
+        # newest-wins, either would bury the report and restore the pre-fix verdict.
+        for tail in (wrapup_api_error("API Error: Connection lost mid-response."),
+                     wrapup_execution_error("[ede_diagnostic] turn aborted (api_error) "
+                                            "stop_reason=null")):
+            with self.subTest(tail=tail["subtype"]):
+                rc, out, produced = self.heartbeat(
+                    work(),
+                    report("API Error: Connection lost mid-response.", "server_error"),
+                    tail)
+                self.assertEqual(rc, 1)
+                self.assertFalse(produced)
+                self.assertIn("Connection lost mid-response", out)
+
+    def test_wrapup_alone_with_a_retryable_status_is_transient(self) -> None:
+        rc, out, produced = self.heartbeat(
+            work(), wrapup_api_error("API Error: 503 service unavailable", status=503))
+        self.assertEqual(rc, 1)
+        self.assertFalse(produced)
+        self.assertIn("503", out)
+
+    def test_pinned_incident_stream_record_is_transient(self) -> None:
+        fixture = FIXTURES / "claude_api_error_death.stream.jsonl"
+        if not fixture.is_file():
+            self.skipTest(f"vendor fixture absent: {fixture}")
+        rc, out, produced = self.heartbeat(work(), fixture.read_text().strip())
+        self.assertEqual(rc, 1)
+        self.assertFalse(produced)
+        self.assertIn("Connection lost mid-response", out)
+
+
+class NotTheLeafsDeath(_StubLeafCase):
+    """(ii) Everything the classifier must NOT call transient."""
+
+    def test_permanent_kinds_are_retained_but_never_retried(self) -> None:
+        for kind, text in (("invalid_request", "API Error: Prompt is too long"),
+                           ("authentication_failed", "API Error: Invalid API key"),
+                           ("billing_error", "API Error: Credit balance is too low")):
+            with self.subTest(kind=kind):
+                rc, out, produced = self.heartbeat(work(), report(text, kind))
+                self.assertEqual(rc, 1)
+                self.assertTrue(produced)   # permanent: a re-invoke fails identically
+                self.assertIn(text, out)    # (iii) retained all the same
+
+    def test_prose_inside_a_marked_report_cannot_promote_a_permanent_cause(self) -> None:
+        # The vendor already answered the question. A permanent report whose text happens
+        # to quote a transient one must not buy three of the most expensive runs.
+        rc, out, produced = self.heartbeat(work(), report(
+            "API Error: Invalid request — your retry after the connection was lost and "
+            "the 529 overloaded_error is malformed", "invalid_request"))
+        self.assertEqual(rc, 1)
+        self.assertTrue(produced)
+        self.assertIn("Invalid request", out)
+
+    def test_a_leaf_that_merely_quotes_an_error_is_substantive(self) -> None:
+        # A builder fixing THIS defect writes the incident's line into a patch. Unmarked,
+        # it is prose — the mark, not the wording, is the discriminator.
+        err = self.resilient(
+            work("API Error: Connection lost mid-response. The response above may be "
+                 "incomplete. — the line #506 is about"),
+            stderr_text="boom\n")
+        self.assertIsInstance(err, leaves.LeafError)
+        self.assertFalse(err.transient)
+        self.assertEqual(self.runs(), 1)   # not retried
+        self.assertIn("boom", self.error_log.read_text())
+
+    def test_plain_substantive_failure_is_unchanged(self) -> None:
+        err = self.resilient(work("did the work, then failed"), stderr_text="boom\n")
+        self.assertIsInstance(err, leaves.LeafError)
+        self.assertFalse(err.transient)
+        self.assertEqual(self.runs(), 1)
+
+    def test_main_session_work_after_a_report_clears_it(self) -> None:
+        # The CLI hit a retryable error, recovered, carried on — and later failed on its
+        # own merits. That failure is the leaf's, not infrastructure's.
+        err = self.resilient(
+            work("first turn"),
+            report("API Error: Connection lost mid-response.", "server_error"),
+            work("recovered, kept editing"),
+            stderr_text="boom\n")
+        self.assertIsInstance(err, leaves.LeafError)
+        self.assertFalse(err.transient)
+        self.assertEqual(self.runs(), 1)
+
+    def test_a_trailing_subagent_line_does_not_clear_the_report(self) -> None:
+        # Regression guard: chatter from a Task still draining when the session died is
+        # NOT the main session recovering. Counting it would restore the pre-fix outcome
+        # exactly — one line, and the death goes back to being un-retried and unexplained.
+        err = self.resilient(
+            work("first turn"),
+            report("API Error: Connection lost mid-response.", "server_error"),
+            subagent_work(),
+            wrapup_api_error("API Error: Connection lost mid-response."),
+        )
+        self.assertIsInstance(err, leaves.LeafError)
+        self.assertTrue(err.transient)
+        self.assertEqual(self.runs(), 3)
+        self.assertIn("Connection lost mid-response", self.error_log.read_text())
+
+    def test_a_trailing_subagent_report_does_not_overwrite_the_main_sessions(self) -> None:
+        # The refutation this round exists to close. The MAIN session died of a cause the
+        # vendor marked PERMANENT; a Task still draining reported an overload after it.
+        # Read newest-wins, a permanent death buys three of the most expensive runs in the
+        # cycle AND the retained diagnostic names the wrong death — criterion (ii)
+        # inverted, and a log that confidently misnames a death is worse than none.
+        err = self.resilient(
+            work("first turn"),
+            report("API Error: 400 invalid_request — the request body is malformed",
+                   "invalid_request"),
+            subagent_report("API Error: 529 the API is at capacity", "overloaded"),
+            wrapup_api_error("API Error: 400 invalid_request", status=400),
+        )
+        self.assertIsInstance(err, leaves.LeafError)
+        self.assertFalse(err.transient)    # the vendor marked the leaf's own death final
+        self.assertEqual(self.runs(), 1)
+        log = self.error_log.read_text()
+        self.assertIn("400 invalid_request", log)   # the death that actually happened
+        self.assertNotIn("at capacity", log)        # not the Task's blip after it
+
+    def test_a_subagent_report_alone_is_not_the_leafs_death(self) -> None:
+        # The commoner variant, needing no conjunction: a Task hit a 529 (the CLI recovers
+        # from those itself, handing the main loop partial output) and the leaf then failed
+        # on its own merits. Retained as evidence — labelled, so no reader mistakes it for
+        # the cause — and never retried.
+        err = self.resilient(
+            work("first turn"),
+            subagent_report("API Error: 529 the API is at capacity", "overloaded"),
+            stderr_text="boom\n")
+        self.assertIsInstance(err, leaves.LeafError)
+        self.assertFalse(err.transient)
+        self.assertEqual(self.runs(), 1)
+        log = self.error_log.read_text()
+        self.assertIn("boom", log)                             # the stderr tail, as ever
+        self.assertIn("at capacity", log)                      # kept as evidence …
+        # … labelled. The label is spelled out rather than imported from `progress`: a test
+        # that imports a symbol this fix ADDS cannot even load on the red leg, and a leg
+        # that never ran is recorded UNVERIFIABLE, not red.
+        self.assertIn("[sub-agent report, not the leaf's own death]", log)
+
+    def test_the_main_sessions_own_report_still_decides_after_a_subagent_one(self) -> None:
+        # Scoping cuts one way only: a subagent report must not bury the main session's,
+        # and must not stop it being read either. The leaf's own account arrives last here
+        # and is both the verdict and the retained text.
+        rc, out, produced = self.heartbeat(
+            work(),
+            subagent_report("API Error: 529 the API is at capacity", "overloaded"),
+            report("API Error: Connection lost mid-response.", "server_error"))
+        self.assertEqual(rc, 1)
+        self.assertFalse(produced)                        # transient: the leaf's own death
+        self.assertIn("Connection lost mid-response", out)
+        self.assertNotIn("at capacity", out)
+
+    def test_a_second_marked_report_wins_outright(self) -> None:
+        # Regression guard: stickiness protects the cause from the WRAP-UP, not from the
+        # leaf's own newer account. A permanent 400 after a dropped connection is the
+        # death that happened — it must be the one kept, and it must not be retried.
+        err = self.resilient(
+            work("first turn"),
+            report("API Error: Connection lost mid-response.", "server_error"),
+            report("API Error: 400 invalid_request — the request body is malformed",
+                   "invalid_request"),
+            wrapup_api_error("API Error: 400 invalid_request", status=400),
+        )
+        self.assertIsInstance(err, leaves.LeafError)
+        self.assertFalse(err.transient)
+        self.assertEqual(self.runs(), 1)
+        self.assertIn("400 invalid_request", self.error_log.read_text())
+
+    def test_execution_error_wrapup_is_retained_but_substantive(self) -> None:
+        # `error_during_execution` is the session's account of whatever ended it, not a
+        # cause the vendor named: keep the text, never reclassify off its prose.
+        rc, out, produced = self.heartbeat(
+            work(), wrapup_execution_error("Error: connection reset while running tests"))
+        self.assertEqual(rc, 1)
+        self.assertTrue(produced)
+        self.assertIn("connection reset while running tests", out)
+
+    def test_pinned_permanent_stream_record_is_not_retried(self) -> None:
+        fixture = FIXTURES / "claude_api_error_permanent.stream.jsonl"
+        if not fixture.is_file():
+            self.skipTest(f"vendor fixture absent: {fixture}")
+        rc, out, produced = self.heartbeat(work(), fixture.read_text().strip())
+        self.assertEqual(rc, 1)
+        self.assertTrue(produced)                     # model_not_found: permanent
+        self.assertIn("issue with the selected model", out)   # retained regardless
+
+
+class RetentionReachesTheErrorLog(_StubLeafCase):
+    """(iii) The report reaches `*.error.log` by the route the stderr tail already takes."""
+
+    def test_report_and_stderr_tail_both_survive(self) -> None:
+        rc, out, _produced = self.heartbeat(
+            work(), report("API Error: Connection lost mid-response.", "server_error"),
+            stderr_text="node:internal/errors ECONNRESET\n")
+        self.assertEqual(rc, 1)
+        self.assertIn("ECONNRESET", out)                       # the existing tail
+        self.assertIn("Connection lost mid-response", out)     # the leaf's own account
+        self.assertTrue(out.endswith("\n"))
