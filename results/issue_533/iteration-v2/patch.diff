+def _terminal_error(line: str, fmt: str = "claude-stream-json") -> tuple[str, bool, str]:
+    """The leaf's own report of a terminal failure in one stream line: its text, whether
+    the cause is **transient**, and which marked record it is (:data:`_REPORT` /
+    :data:`_SUBAGENT_REPORT` / :data:`_WRAPUP`). ``("", False, "")`` when the line is not
+    such a record (#506).
+
+    The classification companion to :func:`_is_session_event`, in the same shape: dispatch
+    on the family's ``stream_format``, best-effort JSON parse, and a **degrade-to-today**
+    default. Only the claude format has an observed error shape, so codex — and every
+    stream-less family — answers ``("", False, "")`` and keeps the classification it has
+    now instead of guessing at a vendor's error text.
+
+    Two event shapes carry it, both marked by the CLI itself:
+
+    * an ``assistant`` event flagged ``is_api_error_message`` / ``isApiErrorMessage`` —
+      the message the CLI synthesises *for* an API failure, with the failure as its text
+      and the CLI's error kind in ``error``. **Whose** failure it was decides which record
+      it is: the main loop's own emitter hard-codes ``parent_tool_use_id: null``
+      (:data:`_REPORT` — the leaf's own account of its own death), while the
+      ``agent_progress`` branch forwards the same mark for a subagent with the Task's
+      ``parent_tool_use_id`` (:data:`_SUBAGENT_REPORT`);
+    * a ``result`` event with ``is_error`` — the session's own terminal record
+      (:data:`_WRAPUP`).
+
+    The text is returned for **any** such record, so a permanent failure still explains
+    itself in the bundle; only the transient flag decides whether it is retried. The
+    ``result`` branch is where those two rules diverge most: just one of its shapes is a
+    death the CLI marked as infrastructure — the ``success`` variant with ``is_error``,
+    the only one carrying ``api_error_status`` — while the ``error_*`` variants carry a
+    free ``errors`` list (a thrown exception, an aborted turn, turns exhausted), i.e. the
+    session's account of *whatever* ended it. Those are kept and left substantive: reading
+    a cause out of that prose charges a leaf's own failure to infrastructure, and a retry
+    of a substantive builder death costs three of the most expensive runs in the cycle.
+
+    A subagent's report is the same rule seen from the other side: it is kept (labelled),
+    and it is never transient. 2.1.233 terminates an agent on an API error with
+    ``AgentApiErrorTerminationError``, and for its own transient kinds recovers the
+    agent's partial output back into the main loop rather than ending the session — so
+    "a Task hit a 529" is not "the leaf died of a 529". Reading it as one would relabel
+    every leaf that failed on its own merits after a subagent blip, and — arriving after
+    the main session's own report — would name the wrong death in the artifact the cycle
+    keeps.
+    """
+    if fmt != "claude-stream-json":
+        return "", False, ""
+    try:
+        ev = json.loads(line)
+    except (ValueError, TypeError):
+        return "", False, ""
+    if not isinstance(ev, dict):
+        return "", False, ""
+    if ev.get("type") == "assistant" and (ev.get("is_api_error_message")
+                                          or ev.get("isApiErrorMessage")):
+        texts = list(_claude_message_texts(ev.get("message")))
+        kind = str(ev.get("error") or "unknown")
+        text = _report_line(texts) or f"API error ({kind}) reported by the leaf"
+        if ev.get("parent_tool_use_id") is not None:
+            return f"{_SUBAGENT_NOTE}{text}", False, _SUBAGENT_REPORT
+        return text, _kind_is_transient(kind, texts), _REPORT
+    if ev.get("type") == "result" and ev.get("is_error"):
+        texts = list(_claude_result_texts(ev))
+        if not texts:
+            return "", False, ""  # an error record with nothing to say: keep today's read
+        transient = (ev.get("subtype") == "success"
+                     and _transient_status(ev.get("api_error_status")))
+        return _report_line(texts), transient, _WRAPUP
+    return "", False, ""
+
+
+def _kind_is_transient(kind: str, texts: Iterable[str]) -> bool:
+    """Is a marked report's cause one a re-invoke can plausibly clear? **The vendor's own
+    error kind answers first** — both ways. Its transient kinds are transient and its
+    permanent kinds are permanent, so no prose inside a report the CLI already classified
+    can promote a 400/401/billing stop into three more expensive attempts. The text is read
+    only for the kind the CLI leaves ``unknown``, where the category
+    (:data:`_TRANSIENT_CAUSE_RE`) is the only evidence there is — that is the shape a
+    connection aborted mid-body takes (``API Error: terminated``)."""
+    if kind in _CLAUDE_TRANSIENT_ERROR_KINDS:
+        return True
+    if kind in _CLAUDE_PERMANENT_ERROR_KINDS:
+        return False
+    return any(_TRANSIENT_CAUSE_RE.search(t) for t in texts)
+
+
+def _note_terminal(terminal: dict, text: str, transient: bool, shape: str) -> None:
+    """Record one marked terminal record into the drain's ``terminal`` state: newest wins
+    **within a shape**, but a record further from the leaf's own death never overwrites a
+    nearer one (:data:`_TERMINAL_PRECEDENCE`).
+
+    An api-error death does not end the stream. Two kinds of record keep arriving after
+    the report that named the cause, and read newest-wins either buries it:
+
+    * the session's ``result`` wrap-up, which names no cause. With nothing thrown it is
+      the ``success`` variant restating the dead message — ``is_error`` set, its text in
+      ``result``, ``api_error_status`` whatever HTTP status there was, which for a
+      connection that dropped before any response is ``null``; when the turn threw or was
+      aborted it is ``error_during_execution``, carrying only ``errors:
+      ["[ede_diagnostic] turn aborted (…) stop_reason=…"]``. Let it win and the death this
+      fix exists for is retried zero times again, with the suite green. That is also why
+      :data:`_WORK_EVENT_TYPES` excludes ``result``: the wrap-up records the effect, the
+      report before it records the cause, and the cause is what a retry decision and a
+      post-mortem both need;
+    * a **subagent's** report — chatter from a Task that was still draining when the
+      session died. Let it win and a main-session ``invalid_request`` followed by a
+      subagent ``overloaded`` is retried to the attempt budget on a cause the vendor
+      marked permanent, with the error log naming the wrong death.
+
+    Precedence is by shape, not "any later record that disagrees": a SECOND main-session
+    report is the leaf's newer account of its own death and wins outright, so a permanent
+    400 arriving after a dropped connection is the one that is kept — retained in the log,
+    and not retried. Real MAIN-SESSION work after any of them clears the state entirely
+    (the caller's :func:`_is_main_session_work` branch): that is the CLI recovering, and
+    what fails later is the leaf's own.
+    """
+    if _TERMINAL_PRECEDENCE[shape] < _TERMINAL_PRECEDENCE.get(terminal["shape"], 0):
+        return
+    terminal.update(text=text, transient=transient, shape=shape)
+
+
+def _claude_message_texts(message) -> Iterable[str]:
+    """The human-readable text blocks of a claude ``assistant`` event's message — where
+    the CLI puts the API failure it is giving up on."""
+    content = message.get("content") if isinstance(message, dict) else None
+    for block in content if isinstance(content, list) else []:
+        if isinstance(block, dict) and block.get("type") == "text":
+            yield str(block.get("text") or "")
+
+
+def _claude_result_texts(ev: dict) -> Iterable[str]:
+    """The error strings a claude ``result`` event carries: its ``errors`` list (the
+    ``error_*`` variants) or its ``result`` string (the ``success`` variant, where an
+    API-error ending puts the dead message's own text); a plain ``error`` key is read too,
+    as a fallback for a shape neither of those covers."""
+    errors = ev.get("errors")
+    for item in errors if isinstance(errors, list) else []:
+        if isinstance(item, str) and item.strip():
+            yield item
+    for key in ("result", "error"):
+        val = ev.get(key)
+        if isinstance(val, str) and val.strip():
+            yield val
+
+
+def _transient_status(status) -> bool:
+    """Is an attached HTTP status one a re-invoke can plausibly clear (429, 5xx, …)?"""
+    return isinstance(status, int) and (status in _TRANSIENT_STATUSES
+                                        or 500 <= status <= 599)
+
+
+def _report_line(texts: Iterable[str]) -> str:
+    """The first non-empty report, whitespace-flattened and bounded — a diagnostic line
+    for the error log, not a transcript."""
+    for text in texts:
+        flat = " ".join(text.split())
+        if flat:
+            return flat[:_TERMINAL_ERROR_MAX]
+    return ""
+
+
+def _is_main_session_work(line: str, fmt: str = "claude-stream-json") -> bool:
+    """Did this line carry MAIN-SESSION turn work — the CLI itself carrying on after an
+    error report, so that report was not the stream's last word (#506)?
+
+    This is what keeps the signal *terminal* rather than "an error was seen": a session
+    that hits a retryable API error, recovers, and later fails on its own merits is
+    substantive and must not be retried. **Main-session** is load-bearing, not decoration:
+    2.1.233 emits a subagent's messages through its ``agent_progress`` branch with
+    ``parent_tool_use_id: <the Task's tool_use id>``, while the main loop's own
+    ``assistant`` / ``user`` events carry ``parent_tool_use_id: null``. Counting any work
+    event would let one trailing subagent line — chatter from a Task that was still
+    draining when the session died — clear the very report that explains the death, which
+    restores the pre-fix outcome exactly. The same split, read the other way, is what
+    keeps a subagent's *report* out of the verdict (:func:`_terminal_error`): one field,
+    one meaning, on both sides of the rule.
+    """
+    if fmt != "claude-stream-json":
+        return False
+    try:
+        ev = json.loads(line)
+    except (ValueError, TypeError):
+        return False
+    return (isinstance(ev, dict) and ev.get("type") in _WORK_EVENT_TYPES
+            and ev.get("parent_tool_use_id") is None)
+
+
 def _stream_tool_label(line: str, fmt: str = "claude-stream-json") -> str:
     """A human label for the tool-use in one stream line, or "" if none.
     Best-effort: a non-JSON / non-tool line yields ""."""
