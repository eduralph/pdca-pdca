+        entries = {
+            "flow_ids": lambda cfg: flow.flow_ids(cfg, ["500"], do_publish=False,
+                                                  today="2026-08-08"),
+            "flow": lambda cfg: flow.flow(cfg, "500", do_publish=False,
+                                          today="2026-08-08"),
