+#: Trailer on an error log whose leaf's outcome is NOT settled yet (#506). Each failed
+#: attempt's record is flushed BEFORE the next attempt starts, so a run killed in that
+#: window leaves a log for a leaf that neither succeeded nor gave up; and a log kept past a
+#: success stays marked until the caller has filed what the run produced
+#: (`_settle_leaf_record`). Without this marker the #138/#369 discriminator ("an error log
+#: means the leaf ran and FAILED") would retire a leaf the death window merely interrupted
+#: — and a bundle could reach sign-off with NO review of the diff.
+_LEAF_IN_FLIGHT = "<!-- pdca:leaf-attempt in-flight — outcome not settled yet -->"
+
+
+def _defang_in_flight(text: str) -> str:
+    """Neutralize the in-flight marker inside text the harness QUOTES into an error log —
+    a dead attempt's withdrawn artifact, and the leaf's own captured stderr tail.
+
+    Whether a run finished is a property of the harness's own trailer, never of something
+    a leaf happened to write; in THIS repo a reviewer quoting the marker is an ordinary
+    day. Only the marker is touched, so everything else the tail carries — the #420 memory
+    post-mortem that rides in on ``output``, the stderr itself — is preserved verbatim."""
+    return text.replace(_LEAF_IN_FLIGHT, _LEAF_IN_FLIGHT.replace("pdca:", "pdca-quoted:"))
+
+
+def _atomic_write_text(path: Path, body: str) -> None:
+    """Replace ``path``'s contents in ONE observable step: temp sibling + `os.replace`.
+
+    The idiom this repo already uses for its other kill-sensitive record (the review
+    frontier, ``act.mark_reviewed``). It matters here because the file is a DISCRIMINATOR
+    and this write is the one that stamps it (#506): ``write_text`` truncates first and
+    writes after, so a kill in between — SIGKILL, the OOM kill the #420 telemetry exists to
+    explain — leaves a half-written log, commonly 0 bytes and always without its trailer.
+    Such a log reads as "the leaf ran and gave up" (`_leaf_ran_and_failed`), so the leaf the
+    death window merely INTERRUPTED is retired instead of recovered — a bundle reaching
+    sign-off with no review of the diff, which is worse than the missing log the base left
+    in that same window. With `os.replace` every reader sees the previous complete state or
+    the new one, never one in between.
+
+    Scoped to a killed PROCESS, which is the failure this harness actually sees (the leaf
+    scope's OOM kill, a Ctrl-C, a killed session): surviving a power loss would additionally
+    need an fsync of the file and its directory, which the repo's idiom does not do either.
+
+    Raises whatever the write it stands in for would; the temp sibling is removed on that
+    path. A kill can still strand one — inert: it is not the log, and no
+    ``state.DOWNSTREAM_GLOBS`` pattern claims it."""
+    tmp = path.with_name(f"{path.name}.tmp.{os.getpid()}")
+    try:
+        tmp.write_text(body, encoding="utf-8")
+        os.replace(tmp, path)
+    except OSError:
+        with contextlib.suppress(OSError):
+            tmp.unlink(missing_ok=True)
+        raise
+
+
+def _write_attempt_records(error_log: Path, records: list[str], *, in_flight: bool) -> bool:
+    """Persist the failed attempts so far; ``True`` iff the write landed (#506).
+
+    Called after EVERY failed attempt, so the account of attempt N is on disk while
+    attempt N+1 runs and a run killed mid-retry still leaves one — instead of only once
+    the loop ends. ``in_flight`` marks a log whose leaf's outcome is not settled yet:
+    another attempt is pending, or the loop is over but the caller has not filed what it
+    produced (`_settle_leaf_record`).
+
+    Atomic (`_atomic_write_text`) — the marker is what makes an interrupted leaf
+    recoverable, so a kill must never be able to strip it off a log by catching this write
+    half-done.
+
+    The return value is load-bearing: the caller must not start another attempt over a
+    record that did not land. A failed write is reported, never raised — it must not mask
+    the leaf's own failure, which reaches the caller either way.
+    """
+    body = "".join(records)
+    if in_flight:
+        body += _LEAF_IN_FLIGHT + "\n"
+    try:
+        _atomic_write_text(error_log, body)
+    except OSError as exc:
+        note = (" — not starting another attempt without its predecessor's account on "
+                "disk" if in_flight else "")
+        # Guarded: a broken stderr raises BrokenPipeError, an OSError — reporting a
+        # failure must never REPLACE the failure being reported.
+        with contextlib.suppress(OSError):
+            print(f"leaves: could not write {error_log.name} ({exc}){note}; the leaf's "
+                  "own failure is returned unchanged", file=sys.stderr)
+        return False
+    return True
+
+
+def leaf_run_incomplete(error_log: Path) -> bool:
+    """True iff ``error_log`` was left by a leaf whose run was INTERRUPTED (#506).
+
+    Its last write was a per-attempt flush made while the outcome was still unsettled — a
+    retry pending, or the loop over but the caller's harvest not yet filed — so the run
+    ended without this leaf either succeeding *into the bundle* or exhausting its budget.
+    A settled account has no such trailer (`_settle_leaf_record`). Read off the LAST
+    non-blank line, matched WHOLE — the one place the wrapper writes the marker: the body
+    above it quotes the leaf's own text (its stderr tail, and up to `_RESIDUE_KEEP` of a
+    withdrawn artifact), so a substring sniff would let a leaf that MENTIONED the marker
+    describe its own run. Belt and braces with `_defang_in_flight`, which neutralizes the
+    marker in both quoted bodies: an impersonation has to defeat both. Absent or
+    unreadable ⇒ False — a file that is not there says nothing about an in-flight retry."""
+    try:
+        lines = error_log.read_text(encoding="utf-8").splitlines()
+    except OSError:
+        return False
+    tail = [line.strip() for line in lines if line.strip()]
+    return bool(tail) and tail[-1] == _LEAF_IN_FLIGHT
+
+
+def _leaf_ran_and_failed(error_log: Path) -> bool:
+    """The #138 failed-leaf discriminator, #506-aware: an error log means the leaf ran and
+    FAILED — *unless* it is still in flight, which is "interrupted", not "gave up"."""
+    return error_log.exists() and not leaf_run_incomplete(error_log)
+
+
+def _settle_leaf_record(error_log: Path) -> None:
+    """Drop the in-flight trailer — this leaf's outcome is now FILED in the bundle (#506).
+
+    Called by a harvest site once it has written what the run produced: the artifact copied
+    out, or the ``*_unavailable`` placeholder. The wrapper deliberately leaves a kept log in
+    flight through a *successful* return, because until that harvest lands the bundle holds
+    no account of the leaf at all — so a kill in that window has to read as interrupted
+    (the leaf is recovered, #369) and not as spent (retired, and a bundle that can reach
+    sign-off with no review of the diff). The ORDERING is the contract: settle after the
+    outcome, never before, and then no kill on either side of it leaves an interrupted
+    Check looking spent.
+
+    Absent, unreadable or already settled ⇒ nothing to do. A settle that cannot be written
+    is inert rather than dangerous: the outcome it announces is already on disk, so every
+    reader of the marker (`review_never_ran`, ``run_advisory_leaves(only_missing=True)``)
+    is past it."""
+    if not leaf_run_incomplete(error_log):
+        return
+    try:
+        body = error_log.read_text(encoding="utf-8")
+    except OSError:
+        return
+    lines = body.splitlines(keepends=True)
+    while lines and lines[-1].strip() != _LEAF_IN_FLIGHT:
+        lines.pop()   # a blank tail below the trailer, if the file ever grows one
+    if lines:
+        lines.pop()   # the trailer itself: the loop is over AND its outcome is recorded
+    with contextlib.suppress(OSError):
+        _atomic_write_text(error_log, "".join(lines))
+
+
+#: How much of a dead attempt's artifact is kept in the error log. Bounded: the log is read
+#: by a human and shipped in the bundle, and a runaway leaf could write an arbitrarily large
+#: file. Big enough for a full 5/5/1 verdict table many times over.
+_RESIDUE_KEEP = 20_000
+
+
+def _withdraw_residue(artifact: Path | None, attempt: int) -> tuple[str, bool]:
+    """Take a dead attempt's claim on ``artifact`` away, keeping its text: ``(record, ok)``.
+
+    Attempt ownership (#506): the harvest sites copy their artifact ``if it exists``, with
+    no notion of WHICH attempt wrote it — so a truncated verdict a dead attempt left in the
+    sandbox is adopted as the output of the attempt that succeeded. That is the shape the
+    engine's own gate contract forbids outright (``engine/README.md``: a gate never turns
+    "no evidence" into a verdict). Called after a FAILED attempt, so whatever stands at
+    that path is that attempt's residue and nothing else.
+
+    Preserved, not merely deleted: the text goes into the record this attempt is about to
+    write to the bundle's ``*.error.log`` — bundle-local (the sandbox around it is a
+    :class:`~tempfile.TemporaryDirectory` that dies with the run), archived per round
+    (``state.DOWNSTREAM_GLOBS``) and already named by the failed-leaf placeholder. A real
+    verdict must not be destroyed while the operator is told none was produced.
+
+    Fail **closed**: ``ok`` is False iff the file is still there afterwards, and the caller
+    stops retrying rather than run another attempt over a path it no longer owns —
+    continuing would be exactly the adoption this exists to prevent.
+    """
+    if artifact is None or not artifact.exists():
+        return "", True
+    try:
+        text = artifact.read_text(encoding="utf-8", errors="replace")
+    except OSError as exc:
+        text = f"(unreadable: {exc})"
+    if len(text) > _RESIDUE_KEEP:
+        text = f"{text[:_RESIDUE_KEEP]}\n… truncated ({len(text)} characters in all)"
+    record = (f"----- attempt {attempt} — the {artifact.name} it left behind "
+              f"(withdrawn: a dead attempt's artifact is never harvested) -----\n"
+              f"{_defang_in_flight(text.strip())}\n\n")
+    try:
+        artifact.unlink()
+    except OSError as exc:
+        with contextlib.suppress(OSError):  # reporting never masks the leaf's failure
+            print(f"leaves: could not withdraw the {artifact.name} attempt {attempt} left "
+                  f"behind ({exc}) — stopping the retries rather than run another attempt "
+                  "over a file that would be harvested as its output", file=sys.stderr)
+        return record, False
+    return record, True
+
