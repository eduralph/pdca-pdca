+#: Trailer on an error log whose leaf has NOT finished its retry loop (#506). Each failed
+#: attempt's record is flushed BEFORE the next attempt starts, so a run killed in that
+#: window leaves a log for a leaf that neither succeeded nor gave up. Without this marker
+#: the #138/#369 discriminator ("an error log means the leaf ran and FAILED") would retire a
+#: leaf the death window merely interrupted — and a bundle could reach sign-off with NO
+#: review of the diff.
+_LEAF_IN_FLIGHT = "<!-- pdca:leaf-attempt in-flight — the retry loop had not finished -->"
+
+
+def _defang_in_flight(text: str) -> str:
+    """Neutralize the in-flight marker inside text the harness QUOTES into an error log —
+    a dead attempt's withdrawn artifact, and the leaf's own captured stderr tail.
+
+    Whether a run finished is a property of the harness's own trailer, never of something
+    a leaf happened to write; in THIS repo a reviewer quoting the marker is an ordinary
+    day. Only the marker is touched, so everything else the tail carries — the #420 memory
+    post-mortem that rides in on ``output``, the stderr itself — is preserved verbatim."""
+    return text.replace(_LEAF_IN_FLIGHT, _LEAF_IN_FLIGHT.replace("pdca:", "pdca-quoted:"))
+
+
+def _write_attempt_records(error_log: Path, records: list[str], *, in_flight: bool) -> bool:
+    """Persist the failed attempts so far; ``True`` iff the write landed (#506).
+
+    Called after EVERY failed attempt, so the account of attempt N is on disk while
+    attempt N+1 runs and a run killed mid-retry still leaves one — instead of only once
+    the loop ends. ``in_flight`` marks a log whose leaf has neither succeeded nor given up
+    yet.
+
+    The return value is load-bearing: the caller must not start another attempt over a
+    record that did not land. A failed write is reported, never raised — it must not mask
+    the leaf's own failure, which reaches the caller either way.
+    """
+    body = "".join(records)
+    if in_flight:
+        body += _LEAF_IN_FLIGHT + "\n"
+    try:
+        error_log.write_text(body, encoding="utf-8")
+    except OSError as exc:
+        note = (" — not starting another attempt without its predecessor's account on "
+                "disk" if in_flight else "")
+        # Guarded: a broken stderr raises BrokenPipeError, an OSError — reporting a
+        # failure must never REPLACE the failure being reported.
+        with contextlib.suppress(OSError):
+            print(f"leaves: could not write {error_log.name} ({exc}){note}; the leaf's "
+                  "own failure is returned unchanged", file=sys.stderr)
+        return False
+    return True
+
+
+def leaf_run_incomplete(error_log: Path) -> bool:
+    """True iff ``error_log`` was left by a leaf INTERRUPTED mid-retry (#506).
+
+    Its last write was a per-attempt flush with a retry still pending, so the run ended
+    without the leaf either succeeding or exhausting its budget. Read off the LAST
+    non-blank line, matched WHOLE — the one place the wrapper writes the marker: the body
+    above it quotes the leaf's own text (its stderr tail, and up to `_RESIDUE_KEEP` of a
+    withdrawn artifact), so a substring sniff would let a leaf that MENTIONED the marker
+    describe its own run. Belt and braces with `_defang_in_flight`, which neutralizes the
+    marker in both quoted bodies: an impersonation has to defeat both. Absent or
+    unreadable ⇒ False — a file that is not there says nothing about an in-flight retry."""
+    try:
+        lines = error_log.read_text(encoding="utf-8").splitlines()
+    except OSError:
