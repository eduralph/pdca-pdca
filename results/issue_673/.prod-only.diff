+def _own_change(wt: Path, commits: Collection[str], paths: Sequence[str]) -> set[str]:
+    """Which of ``paths`` one of ``commits`` changes itself (#673): the commit leaves the
+    path with content that differs from what EVERY one of its parents has (a root commit:
+    from nothing). Judged against every parent, not only the first, so a merge that takes
+    the path as one parent has it — an "Update branch" merge bringing in the base's revert
+    — changes nothing of its own, while a commit that edits or deletes the path, or a merge
+    that resolves it to new content, does."""
+    if not commits or not paths:
+        return set()
+    spec = [f":(literal){p}" for p in paths]
+    rows = _out(wt, "rev-list", "--no-walk", "--parents", *sorted(commits),
+                what="the parents of a branch's own commits").splitlines()
+    empty = None
+    mine: set[str] = set()
+    for row in rows:
+        c, *parents = row.split()
+        if not parents:
+            empty = empty or _out(wt, "hash-object", "-t", "tree", "--stdin", stdin="",
+                                  what="the empty tree").strip()
+            parents = [empty]
+        sets = [{p for p in _out(wt, "diff", "--no-renames", "--name-only", "-z", par, c,
+                                 "--", *spec, what=f"the paths {c} changes").split("\0") if p}
+                for par in parents]
+        mine |= set.intersection(*sets)
+    return mine
+
