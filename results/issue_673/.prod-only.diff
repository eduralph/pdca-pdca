+def _keep_merge(cfg: Config, wt: Path, d: Path, ref: str, head: str, branch: str,
+                base_ref: str, owners: Sequence[Path]) -> None:
+    """``d``'s branch ``ref`` at ``head`` just merged cleanly onto the line in ``wt`` (#673).
+    Keep that merge unless it removes work from the line the way a base with a revert would
+    (:func:`_undone_paths`, the #623 judgment :func:`_take_in_base` makes of the base merge):
+    a path the line changed since its cut point is back to its content there, and none of
+    the branch's own commits makes that change — the branch brought it from a base that
+    reverted the work. Then the merge is undone (the line reset to the merge's first parent,
+    the tip before it) and this raises, naming the paths, the bundles of ``owners`` whose
+    work they are, and ``d``."""
+    before = _rev(wt, "HEAD^1")
+    if before is None:
+        raise IntegrationTreeError(f"could not read the tip of {branch} before {d.name}'s "
+                                   f"merge in {wt} — check that checkout, then re-run")
+    try:
+        undone = _undone_paths(cfg, wt, before, base_ref, branch, owners, head=head)
+    except IntegrationError:
+        _reset_line(wt, before, branch)
+        raise
+    if not undone:
+        return
+    _reset_line(wt, before, branch)
+    work, paths = _removed(undone, branch)
+    raise IntegrationError(
+        f"merging {d.name}'s branch {ref} would remove {work} from {branch}: {paths} would "
+        f"go back to how {base_ref} had it before the line changed it, and no commit of "
+        f"{d.name}'s own makes that change — its branch brings it in (cut from, or updated "
+        f"from, {base_ref} after a revert there?). Not building the next wave on a line "
+        f"without that work — put the work back on {ref} (say, revert the revert there), "
+        f"or get it back into {base_ref}, then re-run")
+
