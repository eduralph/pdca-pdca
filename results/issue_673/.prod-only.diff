+def _removed(undone: Sequence[tuple[str, list[str], str]], branch: str) -> tuple[str, str]:
+    """How a refusal names :func:`_undone_paths`' result (#623, #673): ``(work, paths)`` —
+    whose work would go (``"issue_A's work"``, or ``"folded work"`` when no bundle is known
+    for it) and each path with the bundles that brought it (or the line commit that last
+    changed it)."""
+    whose = sorted({n for _p, names, _note in undone for n in names})
+    work = f"{', '.join(whose)}'s work" if whose else "folded work"
+    paths = "; ".join(f"{p} ({', '.join(names) or f'{note} on {branch}'})"
+                      for p, names, note in undone)
+    return work, paths
+
