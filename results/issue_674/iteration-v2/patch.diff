+        _reset_tree(wt, "HEAD")
+        if _git(wt, "checkout", "-q", branch) != 0 or _rev(wt, "HEAD") != tip:
+            raise _LineBroken(f"could not put {branch} back at {tip} in {wt} after a trial "
+                              f"merge — check that checkout, then re-run")
