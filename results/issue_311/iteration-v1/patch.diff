+def _host_ci_passes(cfg: Config, d: Path) -> bool:
+    """Run the declared host-only CI commands (``[gates] host_ci``, issue #311) against
+    the bundle's PATCHED tree; ``False`` blocks the publish before anything is pushed.
+
+    The pre-push counterpart of the Check-time host-CI rows (``gates._run_checks``): the
+    same commands re-run against a freshly reconstructed ``base + patch.diff`` worktree
+    (``worktree.for_gate`` — the same reconstruction the bundle-scoped gates trust,
+    #296), because the base can advance between Check and the push and the pushed tree is
+    what the host's CI will judge.
+
+    Nothing declared ⇒ ``True`` with no work at all — an instance that opts out is
+    byte-identical to today. A gating failure names the command on stderr and records
+    every row in the bundle's ``host-ci.json`` (removed again once they pass), so the
+    refusal survives for the human. An ``unverifiable`` row (exit 77 / marker) does NOT
+    block: it already routed to SUMMARY §6 at Check, where the human adjudicated it.
+    Fail CLOSED when no patched tree can be materialized — pushing content the declared
+    CI never saw is the exact blind spot this closes."""
+    if not cfg.host_ci_checks:
+        return True
+    record = d / HOST_CI_JSON
+
+    def _refuse(reason: str, rows: list[dict]) -> bool:
+        record.write_text(json.dumps({"overall": "fail", "reason": reason, "rows": rows},
+                                     indent=2) + "\n", encoding="utf-8")
+        print(f"publish: host CI gate — {reason} — nothing was pushed, no PR was "
+              f"opened; see {d.name}/{HOST_CI_JSON}.", file=sys.stderr)
+        return False
+
+    rows: list[dict] = []
+    with contextlib.ExitStack() as hold:
+        try:
+            wt, ovf_primary = worktree.for_gate(d, cfg, hold=hold)
+        except worktree.WorktreeError as exc:
+            return _refuse(f"no patched tree to run against ({exc})", rows)
+        if wt is None:
+            return _refuse(
+                "[gates] host_ci is declared but no patched worktree can be "
+                "materialized ([driver].worktree off, or the target is not a git "
+                "checkout) — refusing to push content the declared CI never saw", rows)
+        try:
+            for chk in cfg.host_ci_checks:
+                rows.append(gates._run_one(chk, cwd=wt, bundle=d,
+                                           runner=cfg.gates_runner, worktree_path=wt))
+        finally:
+            if ovf_primary is not None:
+                worktree.overflow_remove(ovf_primary, wt)
+    failed = [r for r in rows if r["gating"] and r["result"] == "fail"]
+    if failed:
+        for r in failed:
+            print(f"publish: host CI '{r['rule_id']}' FAILED against the patched tree — "
+                  f"command: {r['oracle']}\n    {r['path_line']}", file=sys.stderr)
+        return _refuse(f"{len(failed)} host CI command(s) failed against the patched "
+                       "tree — fix the tree (or the command) and retry", rows)
+    record.unlink(missing_ok=True)
+    return True
+
+
