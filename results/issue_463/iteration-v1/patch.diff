+        except integrate.IntegrationError as exc:
+            raise integrate.IntegrationError(
+                f"could not build {d.name}'s base {branch} from "
+                f"{', '.join(b.name for b in members)}: {exc}", cause=exc.cause) from exc
+        bases[d.name] = got[0]
+    return bases, tips
