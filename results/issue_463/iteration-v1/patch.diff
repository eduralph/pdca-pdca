+def _bundle_bases(cfg: Config, runnable: list[Path], *, wave_list: list[list[Path]],
+                  bundles: list[Path], carried: Sequence[Path], accepted: list[Path],
+                  held: Collection[str], carried_heads: Mapping[str, str],
+                  batch: list[str]) -> tuple[dict[str, str], dict[str, str | None]]:
+    """Build the base each bundle of ``runnable`` is built on (#463): ``(bases, tips)``,
+    the branch and the commit it was pushed at, by bundle name, for each one whose
+    prerequisite closure (:func:`_closure`) has work to carry on its own target. Those
+    are the bundles of the closure that are accepted this run (``accepted``, in wave then
+    name order), or carried before wave 0 (``carried``, first, in the order asked for),
+    that are not in ``held`` and that the fold can carry (:func:`integrate._fold_candidates`:
+    a patch, a target, a published branch) on the bundle's own ``(repo, base)``. A held
+    one already holds its dependents (:func:`_runnable`); a patchless one, or one on
+    another target, contributes nothing.
+
+    Each such bundle gets ONE fold of exactly those, in that order, onto a branch of its
+    own (:func:`integrate.bundle_base`), started fresh from the base as fetched — with
+    every fold safeguard, the #633 check of the branches the run's line carries
+    (``carried_heads``) included, and under the same lock and worktree as the line's folds
+    — and the tip it pushed, read under that lock. The line's record (``folded_tips``) and
+    ``carried_heads`` are never written. A bundle with no such work, or no usable target,
+    gets nothing: it is built on the real base. An :class:`integrate.IntegrationError`
+    names the bundle and propagates, so the caller stops the run before the wave builds."""
+    waves_of = {b.name: i for i, w in enumerate(wave_list) for b in w}
+    conflicts = waves.conflict_map(cfg, bundles)
+    order = list({b.name: b for b in [*carried, *accepted] if b.name not in held}.values())
+    cands = {b.name: (b, (repo, base)) for b, repo, base, _slug, ref
+             in integrate._fold_candidates(order) if ref is not None}
+    paths = {b.name: b for w in wave_list for b in w} | {b.name: b for b in carried}
+    bases: dict[str, str] = {}
+    tips: dict[str, str | None] = {}
+    for d in runnable:
+        target = publish._resolve_target(d)[:2]
+        if not all(target):
+            continue
+        closure = _closure(cfg, d, waves_of=waves_of, paths=paths, conflicts=conflicts)
+        members = [b for n, (b, t) in cands.items() if n in closure and t == target]
+        if not members:
+            continue
