+# A leaf's own account of a TERMINAL transient death (#506). The CLI writes it into the
+# stream as ordinary text — the incident's line was `API Error: Connection lost
+# mid-response.` after ~18 minutes of real work — so "produced anything?" alone charges an
+# infrastructure failure to the leaf, burns the attempt, and keeps nothing that explains it.
+# TWO patterns, both required: the text must READ as an error report (not prose that
+# mentions one — a builder discussing a rate limit is not dying of one) and must name an
+# infrastructure cause a re-invoke can plausibly clear.
+_ERROR_LEAD_RE = re.compile(
+    r"^\W*(?:api\s+error|error|fatal(?:\s+error)?|request\s+failed"
+    r"|connection\s+(?:error|lost|reset|closed|refused))\b", re.I)
+_TRANSIENT_CAUSE_RE = re.compile(
+    r"""connection\s+(?:error|lost|reset|closed|refused|aborted)
+      | (?:lost|interrupted)\s+mid-response
+      | overloaded
+      | rate[\s_-]?limit
+      | too\s+many\s+requests
+      | internal\s+server\s+error
+      | bad\s+gateway
+      | (?:service|server)\s+(?:is\s+)?(?:temporarily\s+)?unavailable
+      | temporarily\s+unavailable
+      | gateway\s+time-?\s?out
+      | network\s+error
+      | socket\s+hang\s*up
+      | \b(?:429|500|502|503|504|529)\b""", re.I | re.X)
+# One line of post-mortem, not a transcript: the tail is a diagnostic, the same bounded
+# retention the stderr tail already gets (``err_tail``).
+_TERMINAL_ERROR_MAX = 500
+
