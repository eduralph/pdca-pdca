+def _terminal_error_text(line: str, fmt: str = "claude-stream-json") -> str:
+    """The leaf's own report of a TERMINAL transient failure in one stream line, or "".
+
+    The classification companion to :func:`_is_session_event`, in the same shape: dispatch
+    on the family's ``stream_format``, best-effort JSON parse, and a **degrade-to-today**
+    default. Only the claude format has a verified error shape, so codex — and every
+    stream-less family — answers "" and keeps the classification it has now instead of
+    guessing at a vendor's error text.
+    """
+    if fmt != "claude-stream-json":
+        return ""
+    try:
+        ev = json.loads(line)
+    except (ValueError, TypeError):
+        return ""
+    if not isinstance(ev, dict):
+        return ""
+    for text in _claude_event_texts(ev):
+        flat = " ".join(text.split())
+        if _ERROR_LEAD_RE.match(flat) and _TRANSIENT_CAUSE_RE.search(flat):
+            return flat[:_TERMINAL_ERROR_MAX]
+    return ""
+
+
+def _claude_event_texts(line_event: dict) -> Iterable[str]:
+    """The human-readable text a claude stream event carries — an ``assistant`` message's
+    text blocks, or a ``result`` event's summary/error. That is where the CLI puts an API
+    error it is giving up on, which is why the incident's cause was legible in the session
+    transcript and nowhere in the bundle."""
+    kind = line_event.get("type")
+    if kind == "assistant":
+        message = line_event.get("message")
+        content = message.get("content") if isinstance(message, dict) else None
+        for block in content if isinstance(content, list) else []:
+            if isinstance(block, dict) and block.get("type") == "text":
+                yield str(block.get("text") or "")
+    elif kind == "result":
+        for key in ("result", "error"):
+            val = line_event.get(key)
+            if isinstance(val, str):
+                yield val
+
+
+def _work_continued(line: str, fmt: str = "claude-stream-json") -> bool:
+    """Did this line carry TURN WORK — i.e. an earlier error line was *not* the stream's
+    last word, the CLI recovered, and whatever failed afterwards is the leaf's own (#506)?
+
+    This is what keeps the signal "terminal", not merely "an error was seen": a leaf that
+    quotes an API error and then keeps working is substantive, and must not be retried."""
+    if fmt != "claude-stream-json":
+        return False
+    try:
+        ev = json.loads(line)
+    except (ValueError, TypeError):
+        return False
+    return isinstance(ev, dict) and ev.get("type") in _WORK_EVENT_TYPES
