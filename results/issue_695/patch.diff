+        self._assert_reported("A")
+        self._assert_unchecked("Z", f"could not fetch origin in {zrepo}", not_named="issue_A")
+        self.assertEqual(rc, 1, self.err)
+        self.assertEqual(len(failed), 2, failed)      # Z's checkout's fetch, tried twice
