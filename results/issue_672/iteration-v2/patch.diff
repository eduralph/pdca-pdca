+    def _skipped_on_a_prerequisite(self, *, declared: bool) -> None:
+        """P, cut from ``fix/X``, conflicts with the base and is skipped. The commit their
+        branches share is X's, which P was built on: X is still carried, and E with it.
+        ``declared``: P's brief says ``Depends on: X``, and X's branch moved on since P was cut
+        from it, so P's branch no longer holds X's tip; else P declares no edge, and X's
+        branch is as P was cut from it."""
+        self._finished("X", {"x.txt": "x\n"})
+        self._finished_on("P", "X")
+        if declared:
+            self.fx._push_from_human({"x2.txt": "x2\n"}, to="fix/X", off="origin/fix/X")
+        else:
+            sb._brief(self.cfg.bundle("P"))                   # no `Depends on: X`
+            sb._accept(self.cfg.bundle("P"))
+        self.fx._push_from_human({"p.txt": "r\n"}, to="main")     # P adds p.txt as well
+        d, e = self._planned("D", "P"), self._planned("E", "X")
+        self._run([d, e], ["X", "P", "D", "E"])
+        self._held("P", "D", "conflict")
+        self.assertIn("flow: carried issue_X (finished", self.err)
+        tip = self._on_the_line_without("E", self.fx._tip("fix/P"))
+        self.assertTrue(self.fx._ancestor(self.fx._tip("fix/X"), tip))
+
+    def test_the_prerequisite_a_skipped_id_was_cut_from_is_still_carried(self):
+        self._skipped_on_a_prerequisite(declared=False)
+
+    def test_a_declared_prerequisite_that_moved_on_since_is_still_carried(self):
+        self._skipped_on_a_prerequisite(declared=True)
