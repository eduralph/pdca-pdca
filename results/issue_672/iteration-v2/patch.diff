+def _commits(wt: Path, tip: str, base_ref: str, *without: str) -> list[str]:
+    """The commits ``tip`` has that neither ``base_ref`` nor any of ``without`` has, newest
+    first (#672). Merge commits are left out: a merge only joins two histories (the line two
+    branches were both cut from holds merges that are neither one's work), and a branch that
+    holds a bundle's merge commit holds the commits under it too. A git failure raises."""
+    return _out(wt, "rev-list", "--no-merges", tip, "--not", base_ref, *without,
+                what=f"the commits {tip[:12]} adds over {base_ref}").split()
+
+
+def _own_work(cfg: Config, wt: Path, d: Path, head: str, heads: Mapping[str, str | None],
+              base_ref: str) -> list[str]:
+    """The work of bundle ``d``, skipped by the fold with its branch at ``head`` (#672): the
+    commits ``head`` adds over ``base_ref`` (:func:`_commits`) that no bundle of the fold
+    (``heads``: name → its branch's tip) it was built on has — one whose tip ``head`` holds,
+    or one its plain ``Depends on`` names, whose branch may have moved on since (unless that
+    branch holds ``head``: then it was built on ``d``, whatever the brief says). Those are
+    that bundle's own work, which its own merge carries; the base's commits are no bundle's
+    work at all. A git failure raises."""
+    bp = d / "brief.md"
+    named = {cfg.bundle(dep).name for dep in (brief.depends_on(bp) if bp.exists() else [])}
+    under: list[str] = []
+    for name, tip in heads.items():
+        if not tip or name == d.name:
+            continue
+        if _in_line(wt, tip, f"{name}'s head {tip[:12]}", f"{d.name}'s branch", of=head) or (
+                name in named and not _in_line(wt, head, f"{d.name}'s head {head[:12]}",
+                                               f"{name}'s branch", of=tip)):
+            under.append(tip)
+    return _commits(wt, head, base_ref, *under)
+
+
+def _skipped_work(wt: Path, tip: str, own: Mapping[str, Sequence[str]], base_ref: str,
+                  adds: dict[str, set[str]]) -> tuple[str, str] | None:
+    """``(name, commit)`` when the branch at ``tip`` holds work of a bundle the fold skipped
+    (#672) — ``own`` maps each one, in the order skipped, to its work (:func:`_own_work`): the
+    first such bundle, and the newest commit of its work that ``tip`` has. None: it holds
+    none of it. ``adds`` keeps what each tip adds over ``base_ref``, read once."""
+    if tip not in adds:
