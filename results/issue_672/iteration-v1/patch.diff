+    # -- (10): a fold-time skip does not reach the line through a containing branch (#672) --
+
+    def _skipped_in_the_fold(self, *, declared: bool) -> None:
+        """P and Q (cut from ``fix/P``) finished with open PRs; then the base got a change
+        that conflicts with P, and Q's author updated ``fix/Q`` from the base, resolving it
+        in Q's favour — P's author did not. The carry's fold, from the base, skips P (its
+        merge conflicts) while Q merges cleanly, holding P's commit. ``declared``: Q's brief
+        says ``Depends on: P``; otherwise it names no edge, its branch still holds P's work.
+        X beside them is clean and carried; D depends on Q, E on X."""
+        self._finished("P", {"base.txt": "p\n"})
+        self._finished_on("Q", "P")
+        if not declared:
+            sb._brief(self.cfg.bundle("Q"))                  # no `Depends on: P`
+            sb._accept(self.cfg.bundle("Q"))
+            self.assertEqual(state.state(self.cfg.bundle("Q")), state.COMPLETE)
+        self._finished("X", {"x.txt": "x\n"})
+        self.fx._push_from_human({"base.txt": "r\n"}, to="main")
+        human = self.fx.human
+        sb._git(human, "fetch", "-q", "origin")
+        sb._git(human, "checkout", "-q", "-B", "fix/Q", "origin/fix/Q")
+        sb._git(human, "merge", "-q", "-X", "ours", "--no-edit", "origin/main")
+        sb._git(human, "push", "-q", "origin", "fix/Q")
+        p_head, q_head = self.fx._tip("fix/P"), self.fx._tip("fix/Q")
+        self.assertTrue(self.fx._ancestor(p_head, q_head))
+        self.assertTrue(self.fx._ancestor(self.fx._tip("main"), q_head))
+        d, e = self._planned("D", "Q"), self._planned("E", "X")
+        pushes = self.fx._pushes(lambda: self._run([d, e], ["P", "Q", "X", "D", "E"]))
+        held = self._held("Q", "D", "issue_P")
+        self.assertIn("conflict", self._not_carried("P"))
+        self.assertIn("holding no bundle", self._not_carried("P"))
+        self.assertNotIn("get issue_Q's PR open", held)
+        self.assertIn("flow: carried issue_X (finished", self.err)
+        self.assertNotIn("issue_Q", next(x for x in self.err.splitlines()
+                                         if x.startswith("flow: carried")))
+        self.assertTrue(self.fx._has(self.line), self.err)
+        base, tip, line_tip = self._built("E")
+        self.assertEqual((base, tip), (self.line, line_tip), self.err)
+        self.assertEqual(self.results["E"], state.COMPLETE)
+        self.assertTrue(self.fx._ancestor(self.fx._tip("fix/X"), tip))
+        for gone in (p_head, q_head):
+            self.assertFalse(self.fx._ancestor(gone, self.line), self.err)
+            self.assertFalse(self.fx._ancestor(gone, tip), self.err)
+        self.assertEqual(len(pushes), 1, pushes)              # the carry's, never re-done
+
+    def test_a_finished_dependent_of_a_skipped_id_is_held_not_carried(self):
+        # (1) Before: Q was carried with P's commit, and D was built on that line.
+        self._skipped_in_the_fold(declared=True)
+
+    def test_a_branch_holding_a_skipped_ids_work_is_held_without_a_declared_edge(self):
+        # (2) Containment by ancestry, not only the declared `Depends on` edge.
+        self._skipped_in_the_fold(declared=False)
+
 
