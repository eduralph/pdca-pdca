+def _holds_work_of(wt: Path, head: str, other: str, branch: str) -> bool:
+    """Whether branch tip ``head`` holds a commit that ``other`` (a skipped bundle's branch
+    tip) has and the line checked out in ``wt`` does not (#672) — so merging ``head`` would
+    put some of ``other``'s work on the line. Such a commit exists exactly when a merge base
+    of the two is not in the line: every commit both have is an ancestor of one of their
+    merge bases, and a line holding a merge base holds its ancestors too. Two tips with no
+    common commit share no work. A git failure raises (``branch`` names the line in it),
+    so under the carry's ``skipped`` the bundle is skipped rather than merged unchecked."""
+    r = subprocess.run(["git", "-C", str(wt), "merge-base", "--all", head, other],
+                       capture_output=True, text=True)
+    if r.returncode == 1 and not r.stdout.strip():
+        return False
+    if r.returncode != 0:
+        raise IntegrationError(
+            f"could not tell whether {head[:12]} holds work of {other[:12]} — `git "
+            f"merge-base --all` exited {r.returncode} in {wt}: check that checkout, then "
+            f"re-run")
+    return any(not _in_line(wt, mb, f"merge base {mb[:12]}", branch)
+               for mb in r.stdout.split())
+
+
