+def _holding(wt: Path, tip: str, excl: Mapping[str, Sequence[str]], base_ref: str,
+             adds: dict[str, set[str]]) -> tuple[str, str] | None:
+    """``(name, commit)`` when the branch or line at ``tip`` holds work of a bundle the fold
+    leaves out (#672) — ``excl`` maps each one, in the order left out, to its work
+    (:func:`_work`): the first such bundle, and the newest commit of its work ``tip`` has.
+    None: it holds none of it. ``adds`` keeps what each tip adds over ``base_ref``, read
+    once. A git failure raises."""
+    if tip not in adds:
