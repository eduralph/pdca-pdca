+def _gone_work(cfg: Config, wt: Path, d: Path, base_ref: str) -> list[str] | None:
+    """The work of bundle ``d``, whose branch is gone (#672), read from the head its PR
+    merged with (:func:`merged.merged_head`, :func:`_work`): none when ``base_ref`` holds
+    that head. None when the host names no merged head or this clone lacks it: the fold
+    cannot read it."""
