+def _work(wt: Path, d: Path, head: str, base_ref: str) -> list[str]:
+    """Bundle ``d``'s work, its branch at ``head`` (#672): each commit ``head`` adds over
+    ``base_ref``, newest first — merge commits too, since a merge can hold a change of its
+    own (a conflict resolved, an edit made while merging) — except those under the line
+    commit its stack base records (:func:`publish.read_stack_base_tip`), when ``head`` holds
+    it. The run records that commit just before it builds ``d`` on it, and publish cuts the
+    branch from it: what lies under it is the line the run had folded by then (earlier
+    bundles' work and the folds' merges — and, for a bundle a run re-drove onto a line that
+    already held its earlier head, that head), not what ``d``'s branch adds. Nothing else
+    is left out: a commit two branches share counts for each of them, as git cannot tell
+    which bundle made it (one cut from the other, or the other merged back in, look the
+    same). A git failure raises."""
+    cut = publish.read_stack_base_tip(d)
